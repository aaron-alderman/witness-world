}

// ── Stage 5c: Health Classification ──────────────────────────────────────────

process HealthProcess {
  values {
    HealthRunState
    HealthMillId
    HealthHourStart
    HealthNValidChannels
    HealthNBoltsEvaluated
    HealthLoading
    HealthErrorMessage
  }
  handles {
    HealthAnalysisCompleted
    HealthAnalysisFailed
  }
  emits {
    RunHealthAnalysis
  }
}

value HealthRunState: PipelineRunState {
  initial idle
}

value HealthMillId: string {
  initial ""
}

value HealthHourStart: string {
  initial ""
}

value HealthNValidChannels: number {
  initial 0
}

value HealthNBoltsEvaluated: number {
  initial 0
}

value HealthLoading: bool {
  initial false
}

value HealthErrorMessage: string {
  initial ""
}

event HealthAnalysisCompleted {
  payload_schema HealthResultPayload
  payload {
    hour_start: HealthHourStart
    n_valid_channels: HealthNValidChannels
    n_bolts_evaluated: HealthNBoltsEvaluated
  }
  writes {
    HealthRunState: complete
    HealthLoading: false
    HealthErrorMessage: ""
  }
}

event HealthAnalysisFailed {
  payload_schema HealthFailedPayload
  payload {
    message: HealthErrorMessage
  }
  writes {
    HealthRunState: failed
    HealthLoading: false
  }
}

command RunHealthAnalysis {
  request_schema HealthAnalysisRequest
  fields {
    source_name: "engentus.mill.pipeline"
    mill_id: HealthMillId
    hour_start: HealthHourStart
  }
}

adapter HealthSbtp using SBTP {
  command RunHealthAnalysis
  kind command
  route "/api/runtime/materialized-host-operation"
  host_operation engentus.pipeline.health.classify
  request_schema HealthAnalysisRequest
  request_state HealthRequestState
  loading_state HealthLoading
  success_event HealthAnalysisCompleted
  failure_event HealthAnalysisFailed
  refresh_runtime true
}

// ── Stage 5d: Alignment ───────────────────────────────────────────────────────

process AlignmentProcess {
  values {
    AlignmentRunState
