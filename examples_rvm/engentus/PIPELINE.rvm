}

adapter BoltAnalysisSbtp using SBTP {
  command RunBoltAnalysis
  kind command
  route "/api/runtime/materialized-host-operation"
  host_operation engentus.pipeline.bolt
  request_schema BoltAnalysisRequest
  request_state BoltAnalysisRequestState
