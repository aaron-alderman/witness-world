}

value AlignmentRunState: PipelineRunState {
  initial idle
}

value AlignmentMillId: string {
  initial ""
}

value AlignmentOutputDir: string {
  initial "investigations/alignment/"
}

value AlignmentLoading: bool {
  initial false
}

value AlignmentErrorMessage: string {
  initial ""
}

event AlignmentCompleted {
  writes {
    AlignmentRunState: complete
    AlignmentLoading: false
    AlignmentErrorMessage: ""
  }
}

event AlignmentFailed {
  payload_schema AnalysisFailedPayload
  payload {
    message: AlignmentErrorMessage
    stage: "alignment"
  }
  writes {
    AlignmentRunState: failed
    AlignmentLoading: false
  }
}

command RunAlignmentAnalysis {
  request_schema AlignmentRequest
  fields {
    source_name: "engentus.mill.pipeline"
    mill_id: AlignmentMillId
    output_dir: AlignmentOutputDir
  }
}

adapter AlignmentSbtp using SBTP {
  command RunAlignmentAnalysis
  kind command
  route "/api/runtime/materialized-host-operation"
  host_operation engentus.pipeline.alignment
  request_schema AlignmentRequest
  request_state AlignmentRequestState
  loading_state AlignmentLoading
  success_event AlignmentCompleted
  failure_event AlignmentFailed
  refresh_runtime true
}

// ── Stage 3b: Clip / Artifact Detection ──────────────────────────────────────
// Per burst×channel hard/soft/spike clip flags (R stage 03 → burst_channel_stats);
// feeds calibration (clipped samples → NULL) and health. Integer-ADC thresholds.

message ClipDetectionRequest {
  schema_name engentus.pipeline.clip.request
  fields {
    source_name: string
    mill_id: string
    burst_start: timestamptz
    burst_end: timestamptz
  }
}

message ClipDetectionResultPayload {
  fields {
    burst_start: timestamptz
    n_channels_evaluated: int
    n_clipped_channels: int
  }
}

message ClipDetectionFailedPayload {
  fields {
    message: string
  }
}

process ClipDetectionProcess {
  values {
    ClipDetectionRunState
    ClipDetectionMillId
    ClipDetectionBurstStart
    ClipDetectionBurstEnd
    ClipDetectionChannelsEvaluated
    ClipDetectionClippedChannels
    ClipDetectionLoading
    ClipDetectionErrorMessage
  }
  handles {
    ClipDetectionCompleted
    ClipDetectionFailed
  }
  emits {
    RunClipDetection
  }
}

value ClipDetectionRunState: PipelineRunState {
  initial idle
}

value ClipDetectionMillId: string {
  initial ""
}

value ClipDetectionBurstStart: string {
  initial ""
}

value ClipDetectionBurstEnd: string {
  initial ""
}

value ClipDetectionChannelsEvaluated: number {
  initial 0
}

value ClipDetectionClippedChannels: number {
  initial 0
}

value ClipDetectionLoading: bool {
  initial false
}

value ClipDetectionErrorMessage: string {
  initial ""
}

event ClipDetectionCompleted {
  payload_schema ClipDetectionResultPayload
  payload {
    burst_start: ClipDetectionBurstStart
    n_channels_evaluated: ClipDetectionChannelsEvaluated
    n_clipped_channels: ClipDetectionClippedChannels
  }
  writes {
    ClipDetectionRunState: complete
    ClipDetectionLoading: false
    ClipDetectionErrorMessage: ""
  }
}

event ClipDetectionFailed {
  payload_schema ClipDetectionFailedPayload
  payload {
    message: ClipDetectionErrorMessage
  }
  writes {
    ClipDetectionRunState: failed
    ClipDetectionLoading: false
  }
}

command RunClipDetection {
  request_schema ClipDetectionRequest
  fields {
    source_name: "engentus.mill.pipeline"
    mill_id: ClipDetectionMillId
    burst_start: ClipDetectionBurstStart
    burst_end: ClipDetectionBurstEnd
  }
}

adapter ClipDetectionSbtp using SBTP {
  command RunClipDetection
  kind command
  route "/api/runtime/materialized-host-operation"
  host_operation engentus.pipeline.clip.detect
  request_schema ClipDetectionRequest
  request_state ClipDetectionRequestState
  loading_state ClipDetectionLoading
  success_event ClipDetectionCompleted
  failure_event ClipDetectionFailed
  refresh_runtime true
}

// ── Stage 6: Kalman Rotation-Angle Fusion ─────────────────────────────────────
// Dual-sensor (bolt + tx) joint Kalman filter: the PRIMARY rotation-angle estimate
// plus δ_BT loosening diagnostic. Confirmed in BOTH the Python (kalman.py, 4-state
// θ/ω/bias/δ_BT) and R (mill_bolt_angle.R, 3-state) implementations. → burst_kalman.

message KalmanRequest {
  schema_name engentus.pipeline.kalman.request
  fields {
    source_name: string
    mill_id: string
    burst_start: timestamptz
    burst_end: timestamptz
  }
}

message KalmanResultPayload {
  fields {
    burst_start: timestamptz
    omega_burst_rpm: float64
    delta_bt_deg: float64
    bias_combined_dps: float64
    omega_disagree_flag: bool
  }
}

message KalmanFailedPayload {
  fields {
    message: string
  }
}

process KalmanProcess {
  values {
    KalmanRunState
    KalmanMillId
    KalmanBurstStart
    KalmanBurstEnd
    KalmanResultRpm
    KalmanDeltaBtDeg
    KalmanBiasDps
    KalmanDisagreeFlag
    KalmanLoading
    KalmanErrorMessage
  }
  handles {
    KalmanCompleted
    KalmanFailed
  }
  emits {
    RunKalmanAngle
  }
}

value KalmanRunState: PipelineRunState {
  initial idle
}

value KalmanMillId: string {
  initial ""
}

value KalmanBurstStart: string {
  initial ""
}

value KalmanBurstEnd: string {
  initial ""
}

value KalmanResultRpm: number {
  initial 0
}

value KalmanDeltaBtDeg: number {
  initial 0
}

value KalmanBiasDps: number {
  initial 0
}

value KalmanDisagreeFlag: bool {
  initial false
}

value KalmanLoading: bool {
  initial false
}

value KalmanErrorMessage: string {
  initial ""
}

event KalmanCompleted {
  payload_schema KalmanResultPayload
  payload {
    burst_start: KalmanBurstStart
    omega_burst_rpm: KalmanResultRpm
    delta_bt_deg: KalmanDeltaBtDeg
    bias_combined_dps: KalmanBiasDps
    omega_disagree_flag: KalmanDisagreeFlag
  }
  writes {
    KalmanRunState: complete
    KalmanLoading: false
    KalmanErrorMessage: ""
  }
}

event KalmanFailed {
  payload_schema KalmanFailedPayload
  payload {
    message: KalmanErrorMessage
  }
  writes {
    KalmanRunState: failed
    KalmanLoading: false
  }
}

command RunKalmanAngle {
  request_schema KalmanRequest
  fields {
    source_name: "engentus.mill.pipeline"
    mill_id: KalmanMillId
    burst_start: KalmanBurstStart
    burst_end: KalmanBurstEnd
  }
}

adapter KalmanSbtp using SBTP {
  command RunKalmanAngle
  kind command
  route "/api/runtime/materialized-host-operation"
  host_operation engentus.pipeline.kalman
  request_schema KalmanRequest
  request_state KalmanRequestState
  loading_state KalmanLoading
  success_event KalmanCompleted
  failure_event KalmanFailed
  refresh_runtime true
}

// ── Stage 7: Uncertainty ──────────────────────────────────────────────────────
// Parameter covariance / confidence intervals over the burst-fit (mill uncertainty).
// Reads fit artifacts; produces per-burst / per-package uncertainty frames.

message UncertaintyRequest {
  schema_name engentus.pipeline.uncertainty.request
  fields {
    source_name: string
    mill_id: string
    burst_start: timestamptz
    burst_end: timestamptz
  }
}

message UncertaintyResultPayload {
  fields {
    burst_start: timestamptz
    rpm_std: float64
    phase_std: float64
    n_packages: int
  }
}

message UncertaintyFailedPayload {
  fields {
    message: string
  }
}

process UncertaintyProcess {
  values {
    UncertaintyRunState
    UncertaintyMillId
    UncertaintyBurstStart
    UncertaintyBurstEnd
    UncertaintyRpmStd
    UncertaintyPhaseStd
    UncertaintyNPackages
    UncertaintyLoading
    UncertaintyErrorMessage
  }
  handles {
    UncertaintyCompleted
    UncertaintyFailed
  }
  emits {
    RunUncertainty
  }
}

value UncertaintyRunState: PipelineRunState {
  initial idle
}

value UncertaintyMillId: string {
  initial ""
}

value UncertaintyBurstStart: string {
  initial ""
}

value UncertaintyBurstEnd: string {
  initial ""
}

value UncertaintyRpmStd: number {
  initial 0
}

value UncertaintyPhaseStd: number {
  initial 0
}

value UncertaintyNPackages: number {
  initial 0
}

value UncertaintyLoading: bool {
  initial false
}

value UncertaintyErrorMessage: string {
  initial ""
}

event UncertaintyCompleted {
  payload_schema UncertaintyResultPayload
  payload {
    burst_start: UncertaintyBurstStart
    rpm_std: UncertaintyRpmStd
    phase_std: UncertaintyPhaseStd
    n_packages: UncertaintyNPackages
  }
  writes {
    UncertaintyRunState: complete
    UncertaintyLoading: false
    UncertaintyErrorMessage: ""
  }
}

event UncertaintyFailed {
  payload_schema UncertaintyFailedPayload
  payload {
    message: UncertaintyErrorMessage
  }
  writes {
    UncertaintyRunState: failed
    UncertaintyLoading: false
  }
}

command RunUncertainty {
  request_schema UncertaintyRequest
  fields {
    source_name: "engentus.mill.pipeline"
    mill_id: UncertaintyMillId
    burst_start: UncertaintyBurstStart
    burst_end: UncertaintyBurstEnd
  }
}

adapter UncertaintySbtp using SBTP {
  command RunUncertainty
  kind command
  route "/api/runtime/materialized-host-operation"
  host_operation engentus.pipeline.uncertainty
  request_schema UncertaintyRequest
  request_state UncertaintyRequestState
  loading_state UncertaintyLoading
  success_event UncertaintyCompleted
  failure_event UncertaintyFailed
  refresh_runtime true
}

// ── Derived values ────────────────────────────────────────────────────────────

derive IngestIdle {
  kind bool_not
  source IngestLoading
}

derive CalibrationIdle {
  kind bool_not
  source CalibrationLoading
}

derive BurstFitIdle {
  kind bool_not
  source BurstFitLoading
}

derive OverviewIdle {
  kind bool_not
  source OverviewLoading
}

derive BoltAnalysisIdle {
  kind bool_not
  source BoltAnalysisLoading
}

derive HealthIdle {
  kind bool_not
  source HealthLoading
}

derive AlignmentIdle {
  kind bool_not
  source AlignmentLoading
}

derive ClipDetectionIdle {
  kind bool_not
  source ClipDetectionLoading
}

derive KalmanIdle {
  kind bool_not
  source KalmanLoading
}

derive UncertaintyIdle {
  kind bool_not
  source UncertaintyLoading
}

// ── Policies ──────────────────────────────────────────────────────────────────

policy BurstQualityPolicy {
  subject BurstFitProcess
  initial_state idle
  state_field BurstFitRunState
  ready_state complete
  disagreement_state failed
  policy_outcomes {
    complete: ready
    failed: repair_required
  }
}

policy ChannelHealthPolicy {
  subject HealthProcess
  initial_state idle
  state_field HealthRunState
  ready_state complete
  disagreement_state failed
  policy_outcomes {
    complete: ready
    failed: repair_required
  }
}

policy KalmanQualityPolicy {
  subject KalmanProcess
  initial_state idle
  state_field KalmanRunState
  ready_state complete
  disagreement_state failed
  policy_outcomes {
    complete: ready
    failed: repair_required
  }
}
