}

value BoltAnalysisRunState: PipelineRunState {
  initial idle
}

value BoltAnalysisMillId: string {
  initial ""
}

value BoltAnalysisBoltNumber: number {
  initial 0
}

value BoltAnalysisOutputDir: string {
  initial "output/"
}

value BoltAnalysisLoading: bool {
  initial false
}

value BoltAnalysisErrorMessage: string {
  initial ""
}

event BoltAnalysisCompleted {
  writes {
    BoltAnalysisRunState: complete
    BoltAnalysisLoading: false
    BoltAnalysisErrorMessage: ""
