    "engentus:core": "npm run platform:supervised",
    "engentus:mcp": "cargo run --manifest-path substrate/Cargo.toml -p witness-core -- --config witness-core-engentus-mcp.toml",
    "utility:master": "node scripts/run-example-app-worker.mjs examples/master --default-port 4014 --runtime-profile full",
    "test:ui": "node scripts/run-tests.mjs ui",
    "test:all": "node scripts/run-tests.mjs all",
    "test:plugin": "node scripts/run-plugin-tests.mjs",
    "test:plugin:authoring": "node scripts/run-plugin-tests.mjs authoring",
    "test:plugin:authoring-core": "node scripts/run-plugin-tests.mjs authoring-core",
    "test:plugin:bootstrap": "node scripts/run-plugin-tests.mjs bootstrap",
    "test:plugin:capability-authoring": "node scripts/run-plugin-tests.mjs capability-authoring",
    "test:plugin:program-authoring": "node scripts/run-plugin-tests.mjs program-authoring",
    "test:plugin:server-runner-authoring": "node scripts/run-plugin-tests.mjs server-runner-authoring",
    "test:plugin:mcp-authoring": "node scripts/run-plugin-tests.mjs mcp-authoring",
    "test:plugin:proposals": "node scripts/run-plugin-tests.mjs proposals",
    "test:plugin:tutorial": "node scripts/run-plugin-tests.mjs tutorial",
    "test:plugin:inspect": "node scripts/run-plugin-tests.mjs inspect",
    "test:plugin:canvas": "node scripts/run-plugin-tests.mjs canvas",
    "test:plugin:mcp": "node scripts/run-plugin-tests.mjs mcp",
    "test:plugin:eden": "node scripts/run-plugin-tests.mjs eden",
    "test:plugin:chart-runtime": "node scripts/run-plugin-tests.mjs chart-runtime",
    "test:plugin:demo": "node scripts/run-plugin-tests.mjs demo",
    "test:plugin:practical-backend": "node scripts/run-plugin-tests.mjs practical-backend",
    "test:plugin:assets": "node scripts/run-plugin-tests.mjs assets",
    "test:plugin:fs-json": "node scripts/run-plugin-tests.mjs fs-json",
    "test:plugin:jobs": "node scripts/run-plugin-tests.mjs jobs",
    "test:plugin:search": "node scripts/run-plugin-tests.mjs search",
    "test:plugin:notifications": "node scripts/run-plugin-tests.mjs notifications",
    "test:plugin:webhooks": "node scripts/run-plugin-tests.mjs webhooks",
    "test:plugin:http-outbound": "node scripts/run-plugin-tests.mjs http-outbound",
    "test:plugin:oauth": "node scripts/run-plugin-tests.mjs oauth",
    "test:plugin:runtime-config": "node scripts/run-plugin-tests.mjs runtime-config",
    "test:plugin:backend-seams": "node scripts/run-plugin-tests.mjs backend-seams",
    "test:plugin:fs-blob": "node scripts/run-plugin-tests.mjs fs-blob",
    "test:plugin:fs-stream": "node scripts/run-plugin-tests.mjs fs-stream",
    "test:plugin:secret": "node scripts/run-plugin-tests.mjs secret",
    "test:plugin:sql": "node scripts/run-plugin-tests.mjs sql",
    "test:plugin:sqlite": "node scripts/run-plugin-tests.mjs sqlite",
    "test:plugin:pipeline-runtime": "node scripts/run-plugin-tests.mjs pipeline-runtime",
