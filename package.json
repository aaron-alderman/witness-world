{
  "name": "witness-world",
  "version": "0.36.0",
  "type": "module",
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "test:vscode-extension": "node --test test/vscode-extension.test.js",
    "test:vscode-extension:unit": "node --test test/vscode-extension.test.js",
    "test:vscode-extension:host": "node scripts/run-vscode-extension-host-smoke.mjs",
    "bootstrap": "cargo run --manifest-path substrate/Cargo.toml -p witness-core -- --config witness-core-bootstrap.toml",
    "operator": "node src/cli.js operator",
    "tui": "node scripts/run-tui.mjs",
    "tui:shell": "node src/cli.js tui",
    "platform:core": "cargo run --manifest-path substrate/Cargo.toml -p witness-core -- --config witness-core-standalone.toml",
    "platform:supervised": "cargo run --manifest-path substrate/Cargo.toml -p witness-core -- --config witness-core.toml",
    "rust:server": "npm run platform:core",
    "rust:server:supervised": "npm run platform:supervised",
    "authoring:server": "cargo run --manifest-path substrate/Cargo.toml -p witness-core -- --config witness-core-authoring.toml",
    "authoring:probe": "node scripts/mcp-authoring-replay-probe.mjs",
    "desktop": "node src/cli.js desktop",
    "utility:demo": "node scripts/run-example-app-worker.mjs examples/demo-todo-app --default-port 4012 --runtime-profile full",
    "utility:eden": "node scripts/run-example-app-worker.mjs examples/eden --default-port 4013 --runtime-profile full",
    "utility:engentus-worker": "node scripts/run-app-engentus-with-core.mjs",
