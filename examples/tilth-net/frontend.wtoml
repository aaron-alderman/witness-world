# tilth-net frontend: your node's control surface — members + repos to share.
# (No keys, no signing here — the browser reads and toggles; the daemon signs.)

[[defaults]]
context = "frontend"
program = "tilth_net_program"

[[page]]
id = "tilth_net_page"
children = ["tilth_net_title", "tilth_net_intro", "tilth_net_members_title", "tilth_net_members", "tilth_net_repos_title", "tilth_net_repos"]
title = "Tilth-Net — your node"

[[heading]]
id = "tilth_net_title"
text = "Your node"
level = 1

[[text]]
id = "tilth_net_intro"
text = "Your control surface. Identities announce themselves and are recognized by an existing member (Members). You choose which local repos share their gitignored working set to the shared commons (Repos — open/close). The browser holds no key: your daemon does the signing and the syncing."
class = "surface-lede"

# --- members directory ------------------------------------------------------
[[heading]]
id = "tilth_net_members_title"
text = "Members"
level = 2

[[box]]
id = "tilth_net_members"
role = "members-list"
class = "surface-list"

[[box]]
id = "member_item_template"
template = true
children = ["member_item_label", "member_item_meta"]
class = "surface-card"

[[heading]]
id = "member_item_label"
template = true
text = "${item.label} ${item.recognized ? '✓' : '· pending'}"
level = 3

[[text]]
id = "member_item_meta"
template = true
text = "${item.scheme} · ${item.id} · ${item.recognized ? 'recognized by ' + item.recognizedBy : 'awaiting recognition'}"
class = "surface-status"

# --- repos: available to share, opened/closed from here ---------------------
[[heading]]
id = "tilth_net_repos_title"
text = "Repos"
level = 2

[[box]]
id = "tilth_net_repos"
role = "repos-list"
class = "surface-list"

[[box]]
id = "repo_item_template"
template = true
children = ["repo_item_name", "repo_item_meta", "repo_item_toggle"]
class = "${item.open ? 'surface-card desire' : 'surface-card'}"

[[heading]]
id = "repo_item_name"
template = true
text = "${item.repoName}"
level = 3

[[text]]
id = "repo_item_meta"
template = true
text = "${item.fileCount} files · ${item.open ? 'OPEN — sharing to the commons' : 'closed'}${item.remote ? ' · ' + item.remote : ''}"
class = "surface-status"

[[button]]
id = "repo_item_toggle"
template = true
text = "${item.open ? 'Close sync' : 'Open sync'}"
type = "button"
action = "toggleSync"
data-name = "${item.repoName}"
data-target = "${item.open ? 'close' : 'open'}"

[[frontendProgram]]
id = "tilth_net_program"
rootWidget = "tilth_net_page"

# --- load -------------------------------------------------------------------
[[step]]
order = 0
op = "fetchJson"
on = "load"
url = "/api/identities"
into = "identitiesResponse"

[[step]]
order = 1
op = "renderCollection"
on = "load"
widget = "tilth_net_members"
from = "identitiesResponse.identities"
template = "member_item_template"

[[step]]
order = 2
op = "fetchJson"
on = "load"
url = "/api/repos"
into = "reposResponse"

[[step]]
order = 3
op = "renderCollection"
on = "load"
widget = "tilth_net_repos"
from = "reposResponse.repos"
template = "repo_item_template"

# --- click: open/close repo sharing -----------------------------------------
[[step]]
order = 0
op = "postJson"
on = "click:toggleSync"
url = "/api/repos/${event.name}/${event.target}"
method = "POST"
body = {}
into = "toggled"

[[step]]
order = 1
op = "run"
on = "click:toggleSync"
event = "load"
