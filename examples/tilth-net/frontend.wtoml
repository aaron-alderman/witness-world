# tilth-net frontend: your node, two flows, progressively disclosed.
#   Share out — your work moving into the commons   (could put up / put up ✓)
#   Pull in   — peers' work coming to your disk      (could pull / pulled ✓)
#   Members   — identity
# Each group is a collapsible <details> with a live count; conversation cards
# tuck their AI summary behind a toggle. No keys here — the daemon signs/syncs.

[[defaults]]
context = "frontend"
program = "tilth_net_program"

[[page]]
id = "tilth_net_page"
children = ["tn_title", "g_shareout", "g_pullin", "g_members"]
title = "Tilth-Net — your node"

[[heading]]
id = "tn_title"
text = "Your node"
level = 1

# ===== SHARE OUT (collapsible group) ========================================
[[details]]
id = "g_shareout"
children = ["g_shareout_sum", "sh_couldput_h", "tn_convos", "tn_repos", "sh_putup_h", "tn_putup"]

[[summary]]
id = "g_shareout_sum"
text = "Share out"

[[heading]]
id = "sh_couldput_h"
text = "Could put up"
level = 3

[[box]]
id = "tn_convos"
role = "convos-list"
class = "surface-list"

[[box]]
id = "convo_tpl"
template = true
children = ["convo_title", "convo_summary_d", "convo_meta", "convo_btn"]
class = "surface-card"

[[heading]]
id = "convo_title"
template = true
text = "${item.title}"
level = 4

[[details]]
id = "convo_summary_d"
template = true
children = ["convo_summary_sum", "convo_summary_txt"]

[[summary]]
id = "convo_summary_sum"
template = true
text = "AI summary"

[[text]]
id = "convo_summary_txt"
template = true
text = "${item.aiSummary || '(no AI summary yet)'}"
class = "surface-lede"

[[text]]
id = "convo_meta"
template = true
text = "${item.project} · ${item.reposText}"
class = "surface-status"

[[button]]
id = "convo_btn"
template = true
text = "Share conversation"
type = "button"
action = "shareConversation"
data-id = "${item.sessionId}"
data-target = "share"

[[box]]
id = "tn_repos"
role = "repos-list"
class = "surface-list"

[[box]]
id = "repo_tpl"
template = true
children = ["repo_name", "repo_meta", "repo_btn", "repo_live_btn"]
class = "${item.live ? 'surface-card desire' : 'surface-card'}"

[[heading]]
id = "repo_name"
template = true
text = "${item.repoName}"
level = 4

[[text]]
id = "repo_meta"
template = true
text = "${item.fileCount} files${item.sessionsText ? ' · ' + item.sessionsText : ''}"
class = "surface-status"

[[button]]
id = "repo_btn"
template = true
text = "Open sync"
type = "button"
action = "toggleSync"
data-name = "${item.repoName}"
data-target = "open"

[[button]]
id = "repo_live_btn"
template = true
text = "${item.live ? 'Stop live' : 'Go live'}"
type = "button"
action = "toggleLive"
data-name = "${item.repoName}"
data-target = "${item.live ? 'unlive' : 'live'}"

[[heading]]
id = "sh_putup_h"
text = "Put up ✓"
level = 3

[[box]]
id = "tn_putup"
role = "putup-list"
class = "surface-list"

[[box]]
id = "putup_tpl"
template = true
children = ["putup_name", "putup_meta"]
class = "surface-card desire"

[[heading]]
id = "putup_name"
template = true
text = "${item.kind} · ${item.displayName}"
level = 4

[[text]]
id = "putup_meta"
template = true
text = "in the commons · ${item.integrityText}"
class = "surface-status"

# ===== PULL IN (collapsible group, open by default) =========================
[[details]]
id = "g_pullin"
children = ["g_pullin_sum", "tn_folder_current", "tn_folder_form", "pl_couldpull_h", "tn_couldpull", "pl_pulled_h", "tn_pulled"]

[[summary]]
id = "g_pullin_sum"
text = "Pull in"

[[text]]
id = "tn_folder_current"
text = "Pulls sync into: ~/tilth-pulled"
class = "surface-status"

[[form]]
id = "tn_folder_form"
children = ["folder_input", "folder_btn"]
role = "pull-folder-form"

[[input]]
id = "folder_input"
name = "folder"
placeholder = "local folder to sync pulls into (default ~/tilth-pulled)"

[[button]]
id = "folder_btn"
text = "Set sync folder"
type = "submit"

[[heading]]
id = "pl_couldpull_h"
text = "Could pull"
level = 3

[[box]]
id = "tn_couldpull"
role = "couldpull-list"
class = "surface-list"

[[box]]
id = "couldpull_tpl"
template = true
children = ["cp_name", "cp_from", "cp_integrity", "cp_btn"]
class = "surface-card"

[[heading]]
id = "cp_name"
template = true
text = "${item.kind} · ${item.displayName}"
level = 4

[[text]]
id = "cp_from"
template = true
text = "${item.fromText}"
class = "surface-status"

[[text]]
id = "cp_integrity"
template = true
text = "${item.integrityText}"
class = "surface-status"

[[button]]
id = "cp_btn"
template = true
text = "Pull to folder"
type = "button"
action = "pullBundle"
data-name = "${item.name}"
data-signer = "${item.signerId}"

[[heading]]
id = "pl_pulled_h"
text = "Pulled ✓"
level = 3

[[box]]
id = "tn_pulled"
role = "pulled-list"
class = "surface-list"

[[box]]
id = "pulled_tpl"
template = true
children = ["pl_name", "pl_status", "pl_live_btn"]
class = "surface-card desire"

[[heading]]
id = "pl_name"
template = true
text = "${item.kind} · ${item.displayName}"
level = 4

[[text]]
id = "pl_status"
template = true
text = "${item.statusText}${item.live ? ' · live ⇄' : ''}"
class = "surface-status"

[[button]]
id = "pl_live_btn"
template = true
text = "${item.live ? 'Stop live' : 'Go live'}"
type = "button"
action = "toggleLive"
data-name = "${item.name}"
data-target = "${item.live ? 'unlive' : 'live'}"

# ===== MEMBERS (collapsible group) ==========================================
[[details]]
id = "g_members"
children = ["g_members_sum", "tn_addpeer", "tn_members"]

[[summary]]
id = "g_members_sum"
text = "Members"

[[form]]
id = "tn_addpeer"
children = ["addpeer_input", "addpeer_btn"]
role = "add-peer-form"

[[input]]
id = "addpeer_input"
name = "card"
placeholder = "paste a peer's identity card (from their `card` command)"

[[button]]
id = "addpeer_btn"
text = "Add peer"
type = "submit"

[[box]]
id = "tn_members"
role = "members-list"
class = "surface-list"

[[box]]
id = "member_tpl"
template = true
children = ["m_label", "m_meta", "m_btn"]
class = "${item.recognized ? 'surface-card desire' : 'surface-card'}"

[[heading]]
id = "m_label"
template = true
text = "${item.label} ${item.recognized ? '✓' : '· pending'}"
level = 4

[[text]]
id = "m_meta"
template = true
text = "${item.scheme} · ${item.id} · ${item.recognized ? 'recognized by ' + item.recognizedBy : 'awaiting recognition'}"
class = "surface-status"

[[button]]
id = "m_btn"
template = true
text = "${item.recognized ? '✓ recognized' : 'Recognize'}"
type = "button"
action = "recognizeMember"
data-id = "${item.id}"
data-label = "${item.label}"

[[frontendProgram]]
id = "tilth_net_program"
rootWidget = "tilth_net_page"

# --- load -------------------------------------------------------------------
[[step]]
order = 0
op = "fetchJson"
on = "load"
url = "/api/commons"
into = "commonsResponse"

[[step]]
order = 1
op = "fetchJson"
on = "load"
url = "/api/identities"
into = "identitiesResponse"

[[step]]
order = 2
op = "renderCollection"
on = "load"
widget = "tn_convos"
from = "commonsResponse.couldShareConvos"
template = "convo_tpl"

[[step]]
order = 3
op = "renderCollection"
on = "load"
widget = "tn_repos"
from = "commonsResponse.couldOpenRepos"
template = "repo_tpl"

[[step]]
order = 4
op = "renderCollection"
on = "load"
widget = "tn_putup"
from = "commonsResponse.putUp"
template = "putup_tpl"

[[step]]
order = 5
op = "renderCollection"
on = "load"
widget = "tn_couldpull"
from = "commonsResponse.couldPull"
template = "couldpull_tpl"

[[step]]
order = 6
op = "renderCollection"
on = "load"
widget = "tn_pulled"
from = "commonsResponse.pulled"
template = "pulled_tpl"

[[step]]
order = 7
op = "renderCollection"
on = "load"
widget = "tn_members"
from = "identitiesResponse.identities"
template = "member_tpl"

[[step]]
order = 8
op = "setText"
on = "load"
widget = "tn_folder_current"
text = "Pulls sync into: ${state.commonsResponse.pullFolder || '~/tilth-pulled'}"

[[step]]
order = 10
op = "setText"
on = "load"
widget = "g_shareout_sum"
text = "Share out — ${state.commonsResponse.couldShareConvos.length + state.commonsResponse.couldOpenRepos.length} to put up · ${state.commonsResponse.putUp.length} up"

[[step]]
order = 11
op = "setText"
on = "load"
widget = "g_pullin_sum"
text = "Pull in — ${state.commonsResponse.couldPull.length} to pull · ${state.commonsResponse.pulled.length} pulled"

[[step]]
order = 12
op = "setText"
on = "load"
widget = "g_members_sum"
text = "Members — ${state.identitiesResponse.identities.length}"

# --- submit: set the local folder pulls sync into ---------------------------
[[step]]
order = 0
op = "readForm"
on = "submit:tn_folder_form"
widget = "tn_folder_form"
into = "folderDraft"

[[step]]
order = 1
op = "postJson"
on = "submit:tn_folder_form"
url = "/api/commons/pull-folder"
method = "POST"
from = "folderDraft"
pick = ["folder"]
into = "folderSet"

[[step]]
order = 2
op = "run"
on = "submit:tn_folder_form"
event = "load"

# --- click: pull a commons bundle into the sync folder ----------------------
[[step]]
order = 0
op = "postJson"
on = "click:pullBundle"
url = "/api/commons/pull"
method = "POST"
body = { repoName = "${event.name}", signerId = "${event.signer}" }
into = "pullQueued"

[[step]]
order = 1
op = "run"
on = "click:pullBundle"
event = "load"

# --- click: share / unshare a conversation ----------------------------------
[[step]]
order = 0
op = "postJson"
on = "click:shareConversation"
url = "/api/sessions/${event.id}/${event.target}"
method = "POST"
body = {}
into = "shared"

[[step]]
order = 1
op = "run"
on = "click:shareConversation"
event = "load"

# --- click: open/close repo sharing -----------------------------------------
[[step]]
order = 0
op = "postJson"
on = "click:toggleSync"
url = "/api/repos/${event.name}/${event.target}"
method = "POST"
body = {}
into = "toggled"

[[step]]
order = 1
op = "run"
on = "click:toggleSync"
event = "load"

# --- click: go live / stop live on a repo -----------------------------------
[[step]]
order = 0
op = "postJson"
on = "click:toggleLive"
url = "/api/repos/${event.name}/${event.target}"
method = "POST"
body = {}
into = "liveToggled"

[[step]]
order = 1
op = "run"
on = "click:toggleLive"
event = "load"

# --- submit: add a peer by pasting their identity card ----------------------
[[step]]
order = 0
op = "readForm"
on = "submit:tn_addpeer"
widget = "tn_addpeer"
into = "peerCard"

[[step]]
order = 1
op = "postJson"
on = "submit:tn_addpeer"
url = "/api/identity/card"
method = "POST"
from = "peerCard"
pick = ["card"]
into = "addedPeer"

[[step]]
order = 2
op = "run"
on = "submit:tn_addpeer"
event = "load"

# --- click: recognize a pending peer (intent; the daemon signs it) ----------
[[step]]
order = 0
op = "postJson"
on = "click:recognizeMember"
url = "/api/identity/recognize-intent"
method = "POST"
body = { ofLabel = "${event.label}", ofId = "${event.id}" }
into = "recognizeQueued"

[[step]]
order = 1
op = "run"
on = "click:recognizeMember"
event = "load"
