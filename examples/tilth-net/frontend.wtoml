# tilth-net frontend: your node, as four routed pages with a shared nav.
#   /         Activity   — what's flowing through your node
#   /share    Share out  — conversations + repos moving into the commons
#   /pull     Pull in    — the commons catalog + your pulled copies
#   /members  Members    — identity + recognition
# Each page is self-contained (own rootWidget + program + serves); the nav and the
# card templates are shared. No keys here — the daemon signs/syncs.

[[defaults]]
context = "frontend"
program = "tn_activity_program"

# ===== shared: title + nav ==================================================
[[heading]]
id = "tn_title"
text = "Your node"
level = 1

[[box]]
id = "tn_nav"
role = "navigation"
class = "surface-actions"
children = ["nav_activity", "nav_share", "nav_pull", "nav_members"]

[[link]]
id = "nav_activity"
text = "Activity"
href = "/"
class = "surface-inline-link"

[[link]]
id = "nav_share"
text = "Share out"
href = "/share"
class = "surface-inline-link"

[[link]]
id = "nav_pull"
text = "Pull in"
href = "/inbox"
class = "surface-inline-link"

[[link]]
id = "nav_members"
text = "Members"
href = "/members"
class = "surface-inline-link"

# ===== ACTIVITY widgets =====================================================
[[heading]]
id = "act_page_h"
text = "Activity"
level = 2

[[button]]
id = "act_refresh_btn"
text = "Refresh"
type = "button"
action = "refreshNode"

[[box]]
id = "tn_activity"
role = "activity-list"
class = "surface-list"

[[box]]
id = "act_tpl"
template = true
children = ["act_text"]
class = "surface-card"

[[text]]
id = "act_text"
template = true
text = "${item.when} · ${item.text}"
class = "surface-status"

# ===== SHARE OUT widgets ====================================================
[[heading]]
id = "share_page_h"
text = "Share out"
level = 2

[[heading]]
id = "sh_couldput_h"
text = "Could put up"
level = 3

[[box]]
id = "tn_convos"
role = "convos-list"
class = "surface-list"

[[box]]
id = "convo_tpl"
template = true
children = ["convo_title", "convo_summary_d", "convo_meta", "convo_btn"]
class = "surface-card"

[[heading]]
id = "convo_title"
template = true
text = "${item.title}"
level = 4
class = "surface-card-title"

[[details]]
id = "convo_summary_d"
template = true
children = ["convo_summary_sum", "convo_summary_txt"]

[[summary]]
id = "convo_summary_sum"
template = true
text = "AI summary"

[[text]]
id = "convo_summary_txt"
template = true
text = "${item.aiSummary || '(no AI summary yet)'}"
class = "surface-lede"

[[text]]
id = "convo_meta"
template = true
text = "${item.project} · ${item.reposText}"
class = "surface-status"

[[button]]
id = "convo_btn"
template = true
text = "Share conversation"
type = "button"
action = "shareConversation"
data-id = "${item.sessionId}"
data-target = "share"

[[box]]
id = "tn_repos"
role = "repos-list"
class = "surface-list"

[[box]]
id = "repo_tpl"
template = true
children = ["repo_name", "repo_meta", "repo_live_btn"]
class = "${item.live ? 'surface-card desire' : 'surface-card'}"

[[heading]]
id = "repo_name"
template = true
text = "${item.repoName}"
level = 4
class = "surface-card-title"

[[text]]
id = "repo_meta"
template = true
text = "${item.fileCount} files${item.sessionsText ? ' · ' + item.sessionsText : ''}"
class = "surface-status"

[[button]]
id = "repo_live_btn"
template = true
text = "${item.live ? 'Stop live' : 'Go live'}"
type = "button"
action = "toggleLive"
data-name = "${item.repoName}"
data-target = "${item.live ? 'unlive' : 'live'}"

[[heading]]
id = "sh_putup_h"
text = "Put up ✓"
level = 3

[[box]]
id = "tn_putup"
role = "putup-list"
class = "surface-list"

[[box]]
id = "putup_tpl"
template = true
children = ["putup_name", "putup_meta", "putup_live_btn"]
class = "surface-card desire"

[[heading]]
id = "putup_name"
template = true
text = "${item.kind} · ${item.displayName}"
level = 4
class = "surface-card-title"

[[text]]
id = "putup_meta"
template = true
text = "in the commons · ${item.integrityText}${item.live ? ' · live → commons' : ''}"
class = "surface-status"

[[button]]
id = "putup_live_btn"
template = true
text = "${item.live ? 'Stop live' : 'Go live'}"
type = "button"
action = "toggleLive"
data-name = "${item.name}"
data-target = "${item.live ? 'unlive' : 'live'}"

# ===== PULL IN widgets ======================================================
[[heading]]
id = "pull_page_h"
text = "Pull in"
level = 2

[[text]]
id = "tn_folder_current"
text = "Pulls sync into: ~/tilth-pulled"
class = "surface-status surface-mono"

[[form]]
id = "tn_folder_form"
children = ["folder_input", "folder_btn"]
role = "pull-folder-form"
class = "surface-actions"

[[input]]
id = "folder_input"
name = "folder"
placeholder = "local folder to sync pulls into (default ~/tilth-pulled)"

[[button]]
id = "folder_btn"
text = "Set sync folder"
type = "submit"

[[heading]]
id = "pl_couldpull_h"
text = "Could pull"
level = 3

[[box]]
id = "tn_couldpull"
role = "couldpull-list"
class = "surface-list"

[[box]]
id = "couldpull_tpl"
template = true
children = ["cp_name", "cp_from", "cp_integrity", "cp_btn"]
class = "surface-card"

[[heading]]
id = "cp_name"
template = true
text = "${item.kind} · ${item.displayName}"
level = 4
class = "surface-card-title"

[[text]]
id = "cp_from"
template = true
text = "${item.fromText}"
class = "surface-status"

[[text]]
id = "cp_integrity"
template = true
text = "${item.integrityText}"
class = "surface-status"

[[button]]
id = "cp_btn"
template = true
text = "Pull to folder"
type = "button"
action = "pullBundle"
data-name = "${item.name}"
data-signer = "${item.signerId}"

[[heading]]
id = "pl_pulled_h"
text = "Pulled ✓"
level = 3

[[box]]
id = "tn_pulled"
role = "pulled-list"
class = "surface-list"

[[box]]
id = "pulled_tpl"
template = true
children = ["pl_name", "pl_status", "pl_live_btn"]
class = "surface-card desire"

[[heading]]
id = "pl_name"
template = true
text = "${item.kind} · ${item.displayName}"
level = 4
class = "surface-card-title"

[[text]]
id = "pl_status"
template = true
text = "${item.statusText}${item.live ? ' · keeping updated' : ''}"
class = "surface-status"

[[button]]
id = "pl_live_btn"
template = true
text = "${item.live ? 'Stop updating' : 'Keep updated'}"
type = "button"
action = "toggleLive"
data-name = "${item.name}"
data-target = "${item.live ? 'unlive' : 'live'}"

# ===== MEMBERS widgets ======================================================
[[heading]]
id = "members_page_h"
text = "Members"
level = 2

[[form]]
id = "tn_addpeer"
children = ["addpeer_input", "addpeer_btn"]
role = "add-peer-form"
class = "surface-actions"

[[input]]
id = "addpeer_input"
name = "card"
placeholder = "paste a peer's identity card (from their `card` command)"

[[button]]
id = "addpeer_btn"
text = "Add peer"
type = "submit"

[[box]]
id = "tn_members"
role = "members-list"
class = "surface-list"

[[box]]
id = "member_tpl"
template = true
children = ["m_label", "m_meta", "m_btn"]
class = "${item.recognized ? 'surface-card desire' : 'surface-card'}"

[[heading]]
id = "m_label"
template = true
text = "${item.label} ${item.recognized ? '✓' : '· pending'}"
level = 4
class = "surface-card-title"

[[text]]
id = "m_meta"
template = true
text = "${item.scheme} · ${item.id} · ${item.recognized ? 'recognized by ' + item.recognizedBy : 'awaiting recognition'}"
class = "surface-status surface-mono"

[[button]]
id = "m_btn"
template = true
text = "${item.recognized ? '✓ recognized' : 'Recognize'}"
type = "button"
action = "recognizeMember"
data-id = "${item.id}"
data-label = "${item.label}"

# ===== PAGES (one rootWidget per route) =====================================
[[page]]
id = "tn_activity_page"
title = "Tilth-Net — Activity"
children = ["tn_title", "tn_nav", "act_page_h", "act_refresh_btn", "tn_activity"]

[[page]]
id = "tn_share_page"
title = "Tilth-Net — Share out"
children = ["tn_title", "tn_nav", "share_page_h", "sh_couldput_h", "tn_convos", "tn_repos", "sh_putup_h", "tn_putup"]

[[page]]
id = "tn_pull_page"
title = "Tilth-Net — Pull in"
children = ["tn_title", "tn_nav", "pull_page_h", "tn_folder_current", "tn_folder_form", "pl_couldpull_h", "tn_couldpull", "pl_pulled_h", "tn_pulled"]

[[page]]
id = "tn_members_page"
title = "Tilth-Net — Members"
children = ["tn_title", "tn_nav", "members_page_h", "tn_addpeer", "tn_members"]

# ===== PROGRAMS + STEPS =====================================================
[[frontendProgram]]
id = "tn_activity_program"
rootWidget = "tn_activity_page"

[[frontendProgram]]
id = "tn_share_program"
rootWidget = "tn_share_page"

[[frontendProgram]]
id = "tn_pull_program"
rootWidget = "tn_pull_page"

[[frontendProgram]]
id = "tn_members_program"
rootWidget = "tn_members_page"

# --- ACTIVITY: load + refresh ---
[[step]]
program = "tn_activity_program"
order = 0
op = "fetchJson"
on = "load"
url = "/api/commons"
into = "commonsResponse"

[[step]]
program = "tn_activity_program"
order = 1
op = "renderCollection"
on = "load"
widget = "tn_activity"
from = "commonsResponse.activity"
template = "act_tpl"

[[step]]
program = "tn_activity_program"
order = 0
op = "run"
on = "click:refreshNode"
event = "load"

# --- SHARE OUT: load + toggleLive + shareConversation ---
[[step]]
program = "tn_share_program"
order = 0
op = "fetchJson"
on = "load"
url = "/api/commons"
into = "commonsResponse"

[[step]]
program = "tn_share_program"
order = 1
op = "renderCollection"
on = "load"
widget = "tn_convos"
from = "commonsResponse.couldShareConvos"
template = "convo_tpl"

[[step]]
program = "tn_share_program"
order = 2
op = "renderCollection"
on = "load"
widget = "tn_repos"
from = "commonsResponse.couldOpenRepos"
template = "repo_tpl"

[[step]]
program = "tn_share_program"
order = 3
op = "renderCollection"
on = "load"
widget = "tn_putup"
from = "commonsResponse.putUp"
template = "putup_tpl"

[[step]]
program = "tn_share_program"
order = 0
op = "postJson"
on = "click:toggleLive"
url = "/api/repos/${event.name}/${event.target}"
method = "POST"
body = {}
into = "liveToggled"

[[step]]
program = "tn_share_program"
order = 1
op = "run"
on = "click:toggleLive"
event = "load"

[[step]]
program = "tn_share_program"
order = 0
op = "postJson"
on = "click:shareConversation"
url = "/api/sessions/${event.id}/${event.target}"
method = "POST"
body = {}
into = "shared"

[[step]]
program = "tn_share_program"
order = 1
op = "run"
on = "click:shareConversation"
event = "load"

# --- PULL IN: load + folder + pull + toggleLive (Keep updated) ---
[[step]]
program = "tn_pull_program"
order = 0
op = "fetchJson"
on = "load"
url = "/api/commons"
into = "commonsResponse"

[[step]]
program = "tn_pull_program"
order = 1
op = "renderCollection"
on = "load"
widget = "tn_couldpull"
from = "commonsResponse.couldPull"
template = "couldpull_tpl"

[[step]]
program = "tn_pull_program"
order = 2
op = "renderCollection"
on = "load"
widget = "tn_pulled"
from = "commonsResponse.pulled"
template = "pulled_tpl"

[[step]]
program = "tn_pull_program"
order = 3
op = "setText"
on = "load"
widget = "tn_folder_current"
text = "Pulls sync into: ${state.commonsResponse.pullFolder || '~/tilth-pulled'}"

[[step]]
program = "tn_pull_program"
order = 0
op = "readForm"
on = "submit:tn_folder_form"
widget = "tn_folder_form"
into = "folderDraft"

[[step]]
program = "tn_pull_program"
order = 1
op = "postJson"
on = "submit:tn_folder_form"
url = "/api/commons/pull-folder"
method = "POST"
from = "folderDraft"
pick = ["folder"]
into = "folderSet"

[[step]]
program = "tn_pull_program"
order = 2
op = "run"
on = "submit:tn_folder_form"
event = "load"

[[step]]
program = "tn_pull_program"
order = 0
op = "postJson"
on = "click:pullBundle"
url = "/api/commons/pull"
method = "POST"
body = { repoName = "${event.name}", signerId = "${event.signer}" }
into = "pullQueued"

[[step]]
program = "tn_pull_program"
order = 1
op = "run"
on = "click:pullBundle"
event = "load"

[[step]]
program = "tn_pull_program"
order = 0
op = "postJson"
on = "click:toggleLive"
url = "/api/repos/${event.name}/${event.target}"
method = "POST"
body = {}
into = "liveToggled"

[[step]]
program = "tn_pull_program"
order = 1
op = "run"
on = "click:toggleLive"
event = "load"

# --- MEMBERS: load + add peer + recognize ---
[[step]]
program = "tn_members_program"
order = 0
op = "fetchJson"
on = "load"
url = "/api/identities"
into = "identitiesResponse"

[[step]]
program = "tn_members_program"
order = 1
op = "renderCollection"
on = "load"
widget = "tn_members"
from = "identitiesResponse.identities"
template = "member_tpl"

[[step]]
program = "tn_members_program"
order = 0
op = "readForm"
on = "submit:tn_addpeer"
widget = "tn_addpeer"
into = "peerCard"

[[step]]
program = "tn_members_program"
order = 1
op = "postJson"
on = "submit:tn_addpeer"
url = "/api/identity/card"
method = "POST"
from = "peerCard"
pick = ["card"]
into = "addedPeer"

[[step]]
program = "tn_members_program"
order = 2
op = "run"
on = "submit:tn_addpeer"
event = "load"

[[step]]
program = "tn_members_program"
order = 0
op = "postJson"
on = "click:recognizeMember"
url = "/api/identity/recognize-intent"
method = "POST"
body = { ofLabel = "${event.label}", ofId = "${event.id}" }
into = "recognizeQueued"

[[step]]
program = "tn_members_program"
order = 1
op = "run"
on = "click:recognizeMember"
event = "load"
