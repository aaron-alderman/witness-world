# tilth-net backend: the witnessed versioned-canonical-state world.

[[defaults]]
context = "backend"

[[serverRunner]]
id = "tilth_net_server"
backendHost = "backendHost"
frontendHost = "frontendHost"
storage = {}
default = true

[[runtimePluginInstall]]
actor = "aaron"
serverRunner = "tilth_net_server"
plugin = "plugin.tilth-net"

# Browser surface at /
[[route]]
id = "tilth_net_home_route"
method = "GET"
path = "/"
serves = "tilthNetView"
handler = "page.home"
params = { rootWidget = "tilth_net_page", frontendProgram = "tilth_net_program", page = "home" }

[[serve]]
serverRunner = "tilth_net_server"
route = "tilth_net_home_route"

# Docs projection (canonical heads + history) as JSON
[[route]]
id = "tilth_net_docs_read_route"
method = "GET"
path = "/api/docs"
serves = "tilthNetDocs"
handler = "docs.read"

[[serve]]
serverRunner = "tilth_net_server"
route = "tilth_net_docs_read_route"

# Put a new version (signed by a recognized member's daemon)
[[route]]
id = "tilth_net_doc_put_route"
method = "POST"
path = "/api/docs"
serves = "tilthNetDocs"
handler = "doc.put"

[[serve]]
serverRunner = "tilth_net_server"
route = "tilth_net_doc_put_route"

# Membership: self-claim an identity ("I am X")
[[route]]
id = "tilth_net_identity_claim_route"
method = "POST"
path = "/api/identity/claim"
serves = "tilthNetMembers"
handler = "identity.claim"

[[serve]]
serverRunner = "tilth_net_server"
route = "tilth_net_identity_claim_route"

# Membership: add a peer by pasting their identity card (their signed claim)
[[route]]
id = "tilth_net_identity_card_route"
method = "POST"
path = "/api/identity/card"
serves = "tilthNetMembers"
handler = "identity.card"

[[serve]]
serverRunner = "tilth_net_server"
route = "tilth_net_identity_card_route"

# Membership: recognize another member ("I recognize X")
[[route]]
id = "tilth_net_identity_recognize_route"
method = "POST"
path = "/api/identity/recognize"
serves = "tilthNetMembers"
handler = "identity.recognize"

[[serve]]
serverRunner = "tilth_net_server"
route = "tilth_net_identity_recognize_route"

# Membership: record a Recognize-click intent (browser, unsigned; daemon signs it)
[[route]]
id = "tilth_net_recognize_intent_route"
method = "POST"
path = "/api/identity/recognize-intent"
serves = "tilthNetMembers"
handler = "identity.recognize.intent"

[[serve]]
serverRunner = "tilth_net_server"
route = "tilth_net_recognize_intent_route"

# Pending recognize-intents the daemon must sign (projection)
[[route]]
id = "tilth_net_recognize_intents_read_route"
method = "GET"
path = "/api/identity/recognize-intents"
serves = "tilthNetMembers"
handler = "recognize-intents.read"

[[serve]]
serverRunner = "tilth_net_server"
route = "tilth_net_recognize_intents_read_route"

# The recognized roster (projection over claims + recognitions)
[[route]]
id = "tilth_net_recognized_read_route"
method = "GET"
path = "/api/recognized"
serves = "tilthNetMembers"
handler = "recognized.read"

[[serve]]
serverRunner = "tilth_net_server"
route = "tilth_net_recognized_read_route"

# The identity directory: all declared identities, recognized or pending
[[route]]
id = "tilth_net_identities_read_route"
method = "GET"
path = "/api/identities"
serves = "tilthNetMembers"
handler = "identities.read"

[[serve]]
serverRunner = "tilth_net_server"
route = "tilth_net_identities_read_route"

# Repos available to share (daemon announces; projection of open/closed state)
[[route]]
id = "tilth_net_repos_read_route"
method = "GET"
path = "/api/repos"
serves = "tilthNetRepos"
handler = "repos.read"

[[serve]]
serverRunner = "tilth_net_server"
route = "tilth_net_repos_read_route"

# Daemon announces an available repo (sanitized metadata)
[[route]]
id = "tilth_net_repo_announce_route"
method = "POST"
path = "/api/repos/announce"
serves = "tilthNetRepos"
handler = "repo.announce"

[[serve]]
serverRunner = "tilth_net_server"
route = "tilth_net_repo_announce_route"

# Browser toggles sharing open / closed
[[route]]
id = "tilth_net_repo_open_route"
method = "POST"
path = "/api/repos/:name/open"
serves = "tilthNetRepos"
handler = "repo.open"

[[serve]]
serverRunner = "tilth_net_server"
route = "tilth_net_repo_open_route"

[[route]]
id = "tilth_net_repo_close_route"
method = "POST"
path = "/api/repos/:name/close"
serves = "tilthNetRepos"
handler = "repo.close"

[[serve]]
serverRunner = "tilth_net_server"
route = "tilth_net_repo_close_route"

# Browser toggles continuous live sync on / off for a repo
[[route]]
id = "tilth_net_repo_live_route"
method = "POST"
path = "/api/repos/:name/live"
serves = "tilthNetRepos"
handler = "repo.live"

[[serve]]
serverRunner = "tilth_net_server"
route = "tilth_net_repo_live_route"

[[route]]
id = "tilth_net_repo_unlive_route"
method = "POST"
path = "/api/repos/:name/unlive"
serves = "tilthNetRepos"
handler = "repo.unlive"

[[serve]]
serverRunner = "tilth_net_server"
route = "tilth_net_repo_unlive_route"

# Which repos are live (for the daemon to watch/publish/apply)
[[route]]
id = "tilth_net_live_read_route"
method = "GET"
path = "/api/live"
serves = "tilthNetRepos"
handler = "live.read"

[[serve]]
serverRunner = "tilth_net_server"
route = "tilth_net_live_read_route"

# Conversations: DESIRE-marked sessions announced from tilth (projection)
[[route]]
id = "tilth_net_sessions_read_route"
method = "GET"
path = "/api/sessions"
serves = "tilthNetSessions"
handler = "sessions.read"

[[serve]]
serverRunner = "tilth_net_server"
route = "tilth_net_sessions_read_route"

# Daemon announces a DESIRE session (sanitized: id, title, AI summary, project)
[[route]]
id = "tilth_net_session_announce_route"
method = "POST"
path = "/api/sessions/announce"
serves = "tilthNetSessions"
handler = "session.announce"

[[serve]]
serverRunner = "tilth_net_server"
route = "tilth_net_session_announce_route"

# Browser toggles a conversation share open / closed
[[route]]
id = "tilth_net_session_share_route"
method = "POST"
path = "/api/sessions/:id/share"
serves = "tilthNetSessions"
handler = "session.share"

[[serve]]
serverRunner = "tilth_net_server"
route = "tilth_net_session_share_route"

[[route]]
id = "tilth_net_session_unshare_route"
method = "POST"
path = "/api/sessions/:id/unshare"
serves = "tilthNetSessions"
handler = "session.unshare"

[[serve]]
serverRunner = "tilth_net_server"
route = "tilth_net_session_unshare_route"

# Commons: the daemon couriers the bridge feed here (ephemeral observation)
[[route]]
id = "tilth_net_commons_observe_route"
method = "POST"
path = "/api/commons/observe"
serves = "tilthNetCommons"
handler = "commons.observe"

[[serve]]
serverRunner = "tilth_net_server"
route = "tilth_net_commons_observe_route"

# Commons catalog: what's available to pull, verified + recognition-checked
[[route]]
id = "tilth_net_commons_read_route"
method = "GET"
path = "/api/commons"
serves = "tilthNetCommons"
handler = "commons.read"

[[serve]]
serverRunner = "tilth_net_server"
route = "tilth_net_commons_read_route"

# Live sync: canonical head per file (reconcile.rvm over the commons feed)
[[route]]
id = "tilth_net_commons_heads_route"
method = "GET"
path = "/api/commons/heads"
serves = "tilthNetCommons"
handler = "commons.heads.read"

[[serve]]
serverRunner = "tilth_net_server"
route = "tilth_net_commons_heads_route"

# Commons: set the local folder pulls sync into (witnessed setting)
[[route]]
id = "tilth_net_pull_folder_route"
method = "POST"
path = "/api/commons/pull-folder"
serves = "tilthNetCommons"
handler = "commons.pull.folder"

[[serve]]
serverRunner = "tilth_net_server"
route = "tilth_net_pull_folder_route"

# Commons: request a pull (witnessed intent; the daemon writes the files)
[[route]]
id = "tilth_net_pull_route"
method = "POST"
path = "/api/commons/pull"
serves = "tilthNetCommons"
handler = "commons.pull"

[[serve]]
serverRunner = "tilth_net_server"
route = "tilth_net_pull_route"

# Commons: daemon reports a pull result (witnessed completion)
[[route]]
id = "tilth_net_pull_result_route"
method = "POST"
path = "/api/commons/pull/result"
serves = "tilthNetCommons"
handler = "commons.pull.result"

[[serve]]
serverRunner = "tilth_net_server"
route = "tilth_net_pull_result_route"

# Commons: pending pulls for the daemon to perform
[[route]]
id = "tilth_net_pulls_read_route"
method = "GET"
path = "/api/commons/pulls"
serves = "tilthNetCommons"
handler = "commons.pulls.read"

[[serve]]
serverRunner = "tilth_net_server"
route = "tilth_net_pulls_read_route"
