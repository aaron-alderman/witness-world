# Tilth backend: the witnessed world behind the browser app.
# Routes wire HTTP paths to the plugin.tilth dispatch handlers.

[[defaults]]
context = "backend"

[[serverRunner]]
id = "tilth_server"
backendHost = "backendHost"
frontendHost = "frontendHost"
storage = {}
default = true

[[runtimePluginInstall]]
actor = "aaron"
serverRunner = "tilth_server"
plugin = "plugin.tilth"

# Browser surface at /
[[route]]
id = "tilth_home_route"
method = "GET"
path = "/"
serves = "tilthView"
handler = "page.home"
params = { rootWidget = "tilth_page_workbench_v9", frontendProgram = "tilth_program_workbench_v9", page = "home" }

[[serve]]
serverRunner = "tilth_server"
route = "tilth_home_route"

# Focused session detail page.
[[route]]
id = "tilth_session_detail_page_route"
method = "GET"
path = "/session"
serves = "tilthSessionDetailView"
handler = "page.home"
params = { rootWidget = "tilth_session_detail_page", frontendProgram = "tilth_program_session_detail", page = "session" }

[[serve]]
serverRunner = "tilth_server"
route = "tilth_session_detail_page_route"

# Focused repo detail page.
[[route]]
id = "tilth_repo_detail_page_route"
method = "GET"
path = "/repo"
serves = "tilthRepoDetailView"
handler = "page.home"
params = { rootWidget = "tilth_repo_detail_page", frontendProgram = "tilth_program_repo_detail", page = "repo" }

[[serve]]
serverRunner = "tilth_server"
route = "tilth_repo_detail_page_route"

# Sessions projection (JSON the surface fetches)
[[route]]
id = "tilth_sessions_read_route"
method = "GET"
path = "/api/sessions"
serves = "tilthSessions"
handler = "sessions.read"

[[serve]]
serverRunner = "tilth_server"
route = "tilth_sessions_read_route"

# Focused session detail projection.
[[route]]
id = "tilth_session_detail_read_route"
method = "GET"
path = "/api/sessions/detail"
serves = "tilthSessionDetail"
handler = "session.detail.read"

[[serve]]
serverRunner = "tilth_server"
route = "tilth_session_detail_read_route"

# Local job projection across all Tilth request/result queues.
[[route]]
id = "tilth_jobs_read_route"
method = "GET"
path = "/api/jobs"
serves = "tilthJobs"
handler = "jobs.read"

[[serve]]
serverRunner = "tilth_server"
route = "tilth_jobs_read_route"

# Local daemon heartbeat projection.
[[route]]
id = "tilth_daemons_read_route"
method = "GET"
path = "/api/daemons"
serves = "tilthDaemons"
handler = "daemons.read"

[[serve]]
serverRunner = "tilth_server"
route = "tilth_daemons_read_route"

# Import a session (the external tilth-claude-code-daemon POSTs JSON here)
[[route]]
id = "tilth_import_route"
method = "POST"
path = "/api/sessions"
serves = "tilthSessions"
handler = "session.import"

[[serve]]
serverRunner = "tilth_server"
route = "tilth_import_route"

# Mark a session DESIRE-related (the browser button POSTs here)
[[route]]
id = "tilth_mark_desire_route"
method = "POST"
path = "/api/sessions/:id/desire"
serves = "tilthSessions"
handler = "session.markDesire"

[[serve]]
serverRunner = "tilth_server"
route = "tilth_mark_desire_route"

# Request repo-location indexing for a known local session. The external
# daemon performs the filesystem/git scan and reports the result back.
[[route]]
id = "tilth_repo_index_request_route"
method = "POST"
path = "/api/sessions/:id/repo-index/request"
serves = "tilthSessions"
handler = "session.repoIndex.request"

[[serve]]
serverRunner = "tilth_server"
route = "tilth_repo_index_request_route"

# Request a readable text transcript preview. The daemon recovers the local
# JSONL active path and reports the sanitized text back.
[[route]]
id = "tilth_transcript_preview_request_route"
method = "POST"
path = "/api/sessions/:id/transcript-preview/request"
serves = "tilthSessions"
handler = "session.transcriptPreview.request"

[[serve]]
serverRunner = "tilth_server"
route = "tilth_transcript_preview_request_route"

# Request an AI summary for a DESIRE-marked session. The external tilth-daemon
# performs the model call and reports the result back.
[[route]]
id = "tilth_ai_summary_request_route"
method = "POST"
path = "/api/sessions/:id/ai-summary/request"
serves = "tilthSessions"
handler = "session.aiSummary.request"

[[serve]]
serverRunner = "tilth_server"
route = "tilth_ai_summary_request_route"

# Request manual repo recognition. The browser records intent; tilth-daemon
# validates the local git repo and reports the witnessed result.
[[route]]
id = "tilth_repo_recognition_request_route"
method = "POST"
path = "/api/repos/recognitions/request"
serves = "tilthSessions"
handler = "repo.recognition.request"

[[serve]]
serverRunner = "tilth_server"
route = "tilth_repo_recognition_request_route"

# Request a prepared local repo snapshot. Tilth witnesses intent/status only;
# tilth-daemon reads the repo and writes the source snapshot to its local cache.
[[route]]
id = "tilth_repo_snapshot_request_route"
method = "POST"
path = "/api/repos/:repoId/snapshot/request"
serves = "tilthSessions"
handler = "repo.snapshot.request"

[[serve]]
serverRunner = "tilth_server"
route = "tilth_repo_snapshot_request_route"

# Body-based repo snapshot request for repo ids that naturally contain slashes.
[[route]]
id = "tilth_repo_snapshot_request_body_route"
method = "POST"
path = "/api/repo-snapshot/request"
serves = "tilthSessions"
handler = "repo.snapshot.request"

[[serve]]
serverRunner = "tilth_server"
route = "tilth_repo_snapshot_request_body_route"

# Daemon heartbeat reporting from local capability workers.
[[route]]
id = "tilth_daemon_heartbeat_route"
method = "POST"
path = "/api/daemon-heartbeat"
serves = "tilthDaemons"
handler = "daemon.heartbeat"

[[serve]]
serverRunner = "tilth_server"
route = "tilth_daemon_heartbeat_route"

# Pending repo-index jobs for the daemon worker.
[[route]]
id = "tilth_repo_index_requests_read_route"
method = "GET"
path = "/api/repo-index/requests"
serves = "tilthRepoIndexRequests"
handler = "repoIndex.requests.read"

[[serve]]
serverRunner = "tilth_server"
route = "tilth_repo_index_requests_read_route"

# Pending transcript-preview jobs for the daemon worker.
[[route]]
id = "tilth_transcript_preview_requests_read_route"
method = "GET"
path = "/api/transcript-preview/requests"
serves = "tilthTranscriptPreviewRequests"
handler = "transcriptPreview.requests.read"

[[serve]]
serverRunner = "tilth_server"
route = "tilth_transcript_preview_requests_read_route"

# Pending AI-summary jobs for the daemon worker.
[[route]]
id = "tilth_ai_summary_requests_read_route"
method = "GET"
path = "/api/ai-summary/requests"
serves = "tilthAiSummaryRequests"
handler = "aiSummary.requests.read"

[[serve]]
serverRunner = "tilth_server"
route = "tilth_ai_summary_requests_read_route"

# Pending manual repo-recognition jobs for tilth-daemon.
[[route]]
id = "tilth_repo_recognition_requests_read_route"
method = "GET"
path = "/api/repos/recognitions/requests"
serves = "tilthRepoRecognitionRequests"
handler = "repoRecognition.requests.read"

[[serve]]
serverRunner = "tilth_server"
route = "tilth_repo_recognition_requests_read_route"

# Pending repo-snapshot jobs for tilth-daemon.
[[route]]
id = "tilth_repo_snapshot_requests_read_route"
method = "GET"
path = "/api/repo-snapshot/requests"
serves = "tilthRepoSnapshotRequests"
handler = "repoSnapshot.requests.read"

[[serve]]
serverRunner = "tilth_server"
route = "tilth_repo_snapshot_requests_read_route"

# Repo-centric projection: each repo with the DESIRE sessions that mention it.
[[route]]
id = "tilth_repo_index_repos_read_route"
method = "GET"
path = "/api/repo-index/repos"
serves = "tilthRepoIndexRepos"
handler = "repoIndex.repos.read"

[[serve]]
serverRunner = "tilth_server"
route = "tilth_repo_index_repos_read_route"

# Focused repo detail projection.
[[route]]
id = "tilth_repo_index_repo_read_route"
method = "GET"
path = "/api/repo-index/repo"
serves = "tilthRepoIndexRepo"
handler = "repoIndex.repo.read"

[[serve]]
serverRunner = "tilth_server"
route = "tilth_repo_index_repo_read_route"

# Repo-index result reporting from the daemon worker.
[[route]]
id = "tilth_repo_index_result_route"
method = "POST"
path = "/api/repo-index/requests/:requestId/result"
serves = "tilthRepoIndexRequests"
handler = "repoIndex.request.result"

[[serve]]
serverRunner = "tilth_server"
route = "tilth_repo_index_result_route"

# Transcript-preview result reporting from the daemon worker.
[[route]]
id = "tilth_transcript_preview_result_route"
method = "POST"
path = "/api/transcript-preview/requests/:requestId/result"
serves = "tilthTranscriptPreviewRequests"
handler = "transcriptPreview.request.result"

[[serve]]
serverRunner = "tilth_server"
route = "tilth_transcript_preview_result_route"

# AI-summary result reporting from the daemon worker.
[[route]]
id = "tilth_ai_summary_result_route"
method = "POST"
path = "/api/ai-summary/requests/:requestId/result"
serves = "tilthAiSummaryRequests"
handler = "aiSummary.request.result"

[[serve]]
serverRunner = "tilth_server"
route = "tilth_ai_summary_result_route"

# Manual repo-recognition result reporting from tilth-daemon.
[[route]]
id = "tilth_repo_recognition_result_route"
method = "POST"
path = "/api/repos/recognitions/requests/:requestId/result"
serves = "tilthRepoRecognitionRequests"
handler = "repoRecognition.request.result"

[[serve]]
serverRunner = "tilth_server"
route = "tilth_repo_recognition_result_route"

# Repo-snapshot result reporting from tilth-daemon.
[[route]]
id = "tilth_repo_snapshot_result_route"
method = "POST"
path = "/api/repo-snapshot/requests/:requestId/result"
serves = "tilthRepoSnapshotRequests"
handler = "repoSnapshot.request.result"

[[serve]]
serverRunner = "tilth_server"
route = "tilth_repo_snapshot_result_route"
