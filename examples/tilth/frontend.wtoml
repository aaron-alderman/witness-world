# Tilth frontend: conversation sessions plus an inverted repo view.
# Renders at / via page.home.

[[defaults]]
context = "frontend"
program = "tilth_program_workbench_v9"

[[page]]
id = "tilth_page_workbench_v9"
children = ["tilth_title_repo_filters", "tilth_status_repo_filters", "tilth_search_box", "tilth_nav_repo_filters", "tilth_filter_bar_repo_filters", "repo_section_repo_filters", "sessions_section_repo_filters", "jobs_section_ops_v1"]
title = "Tilth"

[[heading]]
id = "tilth_title_repo_filters"
text = "Tilth"
level = 1

[[text]]
id = "tilth_status_repo_filters"
text = ""
class = "status"
role = "app-status"

[[input]]
id = "tilth_search_input"
name = "q"
placeholder = "search sessions, repos, remotes, summaries"
type = "search"

[[box]]
id = "tilth_search_box"
children = ["tilth_search_input", "tilth_search_clear_button"]
role = "search"
class = "surface-actions"

[[button]]
id = "tilth_search_clear_button"
text = "Clear"
type = "button"
action = "clearSearch"

[[box]]
id = "tilth_nav_repo_filters"
children = ["repo_nav_button_repo_filters", "sessions_nav_button_repo_filters", "jobs_nav_button_workbench"]
role = "view-nav"
class = "surface-actions"

[[button]]
id = "repo_nav_button_repo_filters"
text = "Repos ✓"
type = "button"
action = "showRepos"
disabled = true

[[button]]
id = "sessions_nav_button_repo_filters"
text = "Sessions"
type = "button"
action = "showSessions"

[[button]]
id = "jobs_nav_button_workbench"
text = "Jobs"
type = "button"
action = "showJobs"

[[box]]
id = "tilth_filter_bar_repo_filters"
children = ["filter_all_button_repo_filters", "filter_desire_button_repo_filters", "filter_indexed_button_repo_filters"]
role = "filter-bar"
class = "surface-actions"

[[button]]
id = "filter_all_button_repo_filters"
text = "All ✓"
type = "button"
action = "filterAll"
disabled = true

[[button]]
id = "filter_desire_button_repo_filters"
text = "DESIRE"
type = "button"
action = "filterDesire"

[[button]]
id = "filter_indexed_button_repo_filters"
text = "Indexed"
type = "button"
action = "filterIndexed"

[[box]]
id = "repo_section_repo_filters"
children = ["repo_recognition_form", "repo_recognition_status", "repo_index_list_repo_filters"]
role = "repo-view"

[[form]]
id = "repo_recognition_form"
children = ["repo_recognition_input", "repo_recognition_submit"]
role = "repo-recognition-form"
class = "surface-actions"

[[input]]
id = "repo_recognition_input"
name = "path"
placeholder = "recognize repo path, e.g. ~/work/my-repo"

[[button]]
id = "repo_recognition_submit"
text = "Recognize repo"
type = "submit"

[[text]]
id = "repo_recognition_status"
text = ""
class = "surface-status"

[[box]]
id = "repo_index_list_repo_filters"
role = "repo-index-list"
class = "surface-list"

[[box]]
id = "sessions_section_repo_filters"
children = ["sessions_list_repo_filters"]
role = "session-view"
hidden = true

[[box]]
id = "sessions_list_repo_filters"
role = "session-list"
class = "surface-list"

[[box]]
id = "jobs_section_ops_v1"
children = ["ops_summary_bar_workbench", "daemon_status_heading_ops_v1", "daemon_status_list_ops_v1", "jobs_heading_ops_v1", "jobs_filter_bar_workbench", "jobs_list_ops_v1"]
role = "jobs-view"
hidden = true

[[box]]
id = "ops_summary_bar_workbench"
children = ["ops_summary_work_workbench", "ops_summary_artifacts_workbench", "ops_summary_daemons_workbench"]
class = "surface-actions"

[[text]]
id = "ops_summary_work_workbench"
text = "Work: loading"
class = "surface-status"

[[text]]
id = "ops_summary_artifacts_workbench"
text = "Artifacts: loading"
class = "surface-status"

[[text]]
id = "ops_summary_daemons_workbench"
text = "Daemons: loading"
class = "surface-status"

[[heading]]
id = "daemon_status_heading_ops_v1"
text = "Daemons"
level = 2

[[box]]
id = "daemon_status_list_ops_v1"
role = "daemon-list"
class = "surface-list"

[[heading]]
id = "jobs_heading_ops_v1"
text = "Recent work"
level = 2

[[box]]
id = "jobs_filter_bar_workbench"
children = ["jobs_filter_all_workbench", "jobs_filter_failed_workbench", "jobs_filter_pending_workbench", "jobs_filter_completed_workbench"]
class = "surface-actions"

[[button]]
id = "jobs_filter_all_workbench"
text = "All"
type = "button"
action = "filterJobsAll"

[[button]]
id = "jobs_filter_failed_workbench"
text = "Failed"
type = "button"
action = "filterJobsFailed"

[[button]]
id = "jobs_filter_pending_workbench"
text = "Pending"
type = "button"
action = "filterJobsPending"

[[button]]
id = "jobs_filter_completed_workbench"
text = "Completed"
type = "button"
action = "filterJobsCompleted"

[[box]]
id = "jobs_list_ops_v1"
role = "jobs-list"
class = "surface-list"

[[frontendProgram]]
id = "tilth_program_workbench_v9"
rootWidget = "tilth_page_workbench_v9"

# --- detail pages -----------------------------------------------------------
[[page]]
id = "tilth_session_detail_page"
children = ["session_detail_back_link", "session_detail_status", "session_detail_list", "session_detail_repos_heading", "session_detail_repo_list", "session_detail_jobs_heading", "session_detail_jobs_list"]
title = "Tilth session"

[[link]]
id = "session_detail_back_link"
text = "Back to Tilth"
href = "/"
class = "surface-inline-link"

[[text]]
id = "session_detail_status"
text = "Loading session..."
class = "status"

[[box]]
id = "session_detail_list"
class = "surface-list"

[[heading]]
id = "session_detail_repos_heading"
text = "Repos"
level = 2

[[box]]
id = "session_detail_repo_list"
class = "surface-list"

[[heading]]
id = "session_detail_jobs_heading"
text = "Recent work"
level = 2

[[box]]
id = "session_detail_jobs_list"
class = "surface-list"

[[frontendProgram]]
id = "tilth_program_session_detail"
rootWidget = "tilth_session_detail_page"

[[page]]
id = "tilth_repo_detail_page"
children = ["repo_detail_back_link", "repo_detail_status", "repo_detail_list", "repo_detail_sessions_heading", "repo_detail_session_list", "repo_detail_jobs_heading", "repo_detail_jobs_list"]
title = "Tilth repo"

[[link]]
id = "repo_detail_back_link"
text = "Back to Tilth"
href = "/"
class = "surface-inline-link"

[[text]]
id = "repo_detail_status"
text = "Loading repo..."
class = "status"

[[box]]
id = "repo_detail_list"
class = "surface-list"

[[heading]]
id = "repo_detail_sessions_heading"
text = "Sessions"
level = 2

[[box]]
id = "repo_detail_session_list"
class = "surface-list"

[[heading]]
id = "repo_detail_jobs_heading"
text = "Recent work"
level = 2

[[box]]
id = "repo_detail_jobs_list"
class = "surface-list"

[[frontendProgram]]
id = "tilth_program_repo_detail"
rootWidget = "tilth_repo_detail_page"

# --- repo template ----------------------------------------------------------
[[box]]
id = "repo_item_template_clean"
template = true
children = ["repo_item_title_clean", "repo_item_open_link", "repo_item_meta_clean", "repo_item_recognition_clean", "repo_item_snapshot_clean", "repo_item_remote_clean", "repo_item_sessions_clean", "repo_item_paths_preview_clean", "repo_item_paths_details_clean"]
class = "surface-card repo-card"

[[heading]]
id = "repo_item_title_clean"
template = true
text = "${item.name || item.root}"
level = 3

[[text]]
id = "repo_item_meta_clean"
template = true
text = "${item.displayRoot || item.root} · ${item.sessionCount} ${item.sessionCount === 1 ? 'session' : 'sessions'} · ${item.mentionText || (item.mentionCount + ' mentions')}"
class = "surface-status"

[[link]]
id = "repo_item_open_link"
template = true
text = "Open repo"
href = "${'/repo?id=' + encodeURIComponent(item.repoId || item.displayRoot || item.root || '')}"
class = "surface-inline-link"

[[text]]
id = "repo_item_recognition_clean"
template = true
text = "${item.recognitionText || 'Recognition source unknown'}"
class = "surface-status"

[[text]]
id = "repo_item_snapshot_clean"
template = true
text = "${item.snapshotText || 'Snapshot not prepared'}"
class = "surface-status"

[[text]]
id = "repo_item_sessions_clean"
template = true
text = "${item.sessionText || 'No indexed sessions yet'}"
class = "surface-lede"

[[text]]
id = "repo_item_remote_clean"
template = true
text = "${item.remoteText ? 'Remote: ' + item.remoteText : 'Remote: none'}"
class = "surface-status"

[[text]]
id = "repo_item_paths_preview_clean"
template = true
text = "${item.pathPreviewText ? 'Mentioned paths: ' + item.pathPreviewText : 'No displayable mentioned paths'}"
class = "surface-status"

[[details]]
id = "repo_item_paths_details_clean"
template = true
children = ["repo_item_paths_summary_clean", "repo_item_paths_detail_clean"]
class = "repo-paths-panel"

[[summary]]
id = "repo_item_paths_summary_clean"
template = true
text = "Show paths"
class = "surface-card-title"

[[text]]
id = "repo_item_paths_detail_clean"
template = true
text = "${item.pathDetailText || 'No displayable mentioned paths'}"
class = "surface-state-list surface-note surface-mono repo-paths-list"

# --- session template -------------------------------------------------------
[[box]]
id = "session_card_v4_template"
template = true
children = ["session_card_v2_title", "session_card_open_link", "session_card_v2_meta", "session_card_v4_latest", "session_card_v2_preview", "session_card_v2_desire_button", "session_card_v2_transcript_button", "session_card_v2_ai_summary_button", "session_card_v2_repo_button", "session_card_v2_status_line", "session_card_v2_repo_chips", "session_card_v2_ai_summary_details", "session_card_v2_repo_details", "session_card_v2_transcript_details"]
class = "${item.desire ? 'surface-card session-card desire' : 'surface-card session-card'}"

[[heading]]
id = "session_card_v2_title"
template = true
text = "${item.title || item.id}"
level = 3
class = "session-title"

[[link]]
id = "session_card_open_link"
template = true
text = "Open session"
href = "${'/session?id=' + encodeURIComponent(item.id || '')}"
class = "surface-inline-link"

[[text]]
id = "session_card_v2_meta"
template = true
text = "${item.project} · ${item.msgCount} msgs · origin ${item.origin || '—'}${item.lastMessageRelativeText ? ' · updated ' + item.lastMessageRelativeText : ''}${item.lastMessageExactText ? ' · ' + item.lastMessageExactText : ''}${item.desire ? ' · marked by ' + (item.markedBy || '—') : ''}"
class = "surface-status"

[[text]]
id = "session_card_v4_latest"
template = true
text = "${item.lastMessageLine || ''}"
class = "surface-status"

[[text]]
id = "session_card_v2_preview"
template = true
text = "${item.previewBrief || item.preview || ''}"
class = "surface-lede session-preview"

[[button]]
id = "session_card_v2_desire_button"
template = true
text = "${item.desire ? 'DESIRE ✓' : 'Mark DESIRE'}"
type = "button"
action = "markDesire"
data-id = "${item.id}"

[[button]]
id = "session_card_v2_transcript_button"
template = true
text = "${item.transcriptPreview && item.transcriptPreview.actionText ? item.transcriptPreview.actionText : 'Preview text'}"
type = "button"
action = "previewTranscript"
data-id = "${item.id}"

[[button]]
id = "session_card_v2_ai_summary_button"
template = true
text = "${item.aiSummary && item.aiSummary.actionText ? item.aiSummary.actionText : 'Summarize'}"
type = "button"
action = "summarizeSession"
data-id = "${item.id}"

[[button]]
id = "session_card_v2_repo_button"
template = true
text = "${item.repoIndex && item.repoIndex.actionText ? item.repoIndex.actionText : 'Index repos'}"
type = "button"
action = "indexRepos"
data-id = "${item.id}"

[[text]]
id = "session_card_v2_status_line"
template = true
text = "${(item.repoStatusText || 'Repos not indexed') + ' · ' + (item.transcriptStatusText || 'Text not loaded') + ' · ' + (item.aiStatusText || 'Summary not run')}"
class = "surface-status"

[[text]]
id = "session_card_v2_repo_chips"
template = true
text = "${item.repoChipText ? item.repoChipText : ''}"
class = "surface-status surface-mono"

[[details]]
id = "session_card_v2_ai_summary_details"
template = true
children = ["session_card_v2_ai_summary_summary", "session_card_v2_ai_summary_version", "session_card_v2_ai_summary_error", "session_card_v2_ai_summary_text", "session_card_v2_ai_summary_bullets"]
class = "session-transcript-panel"

[[summary]]
id = "session_card_v2_ai_summary_summary"
template = true
text = "Summary"
class = "surface-card-title"

[[text]]
id = "session_card_v2_ai_summary_version"
template = true
text = "${item.aiSummary && item.aiSummary.versionText ? item.aiSummary.versionText : ''}"
class = "surface-status"

[[text]]
id = "session_card_v2_ai_summary_text"
template = true
text = "${item.aiSummary && item.aiSummary.text ? item.aiSummary.text : ''}"
class = "surface-note"

[[text]]
id = "session_card_v2_ai_summary_error"
template = true
text = "${item.aiSummary && item.aiSummary.errorText ? item.aiSummary.errorText : ''}"
class = "surface-state-list surface-note surface-mono session-transcript-preview"

[[text]]
id = "session_card_v2_ai_summary_bullets"
template = true
text = "${item.aiSummary && item.aiSummary.bulletText ? item.aiSummary.bulletText : ''}"
class = "surface-state-list surface-note session-transcript-preview"

[[details]]
id = "session_card_v2_repo_details"
template = true
children = ["session_card_v2_repo_summary", "session_card_v2_repo_version", "session_card_v2_repo_error", "session_card_v2_repo_result"]
class = "session-transcript-panel"

[[summary]]
id = "session_card_v2_repo_summary"
template = true
text = "Repos"
class = "surface-card-title"

[[text]]
id = "session_card_v2_repo_version"
template = true
text = "${item.repoIndex && item.repoIndex.versionText ? item.repoIndex.versionText : ''}"
class = "surface-status"

[[text]]
id = "session_card_v2_repo_error"
template = true
text = "${item.repoIndex && item.repoIndex.errorText ? item.repoIndex.errorText : ''}"
class = "surface-state-list surface-note surface-mono session-transcript-preview"

[[text]]
id = "session_card_v2_repo_result"
template = true
text = "${item.repoIndex && item.repoIndex.detailText ? item.repoIndex.detailText : ''}"
class = "surface-note"

[[details]]
id = "session_card_v2_transcript_details"
template = true
children = ["session_card_v2_transcript_summary", "session_card_v2_transcript_version", "session_card_v2_transcript_error", "session_card_v2_transcript_text"]
class = "session-transcript-panel"

[[summary]]
id = "session_card_v2_transcript_summary"
template = true
text = "Transcript"
class = "surface-card-title"

[[text]]
id = "session_card_v2_transcript_version"
template = true
text = "${item.transcriptPreview && item.transcriptPreview.versionText ? item.transcriptPreview.versionText : ''}"
class = "surface-status"

[[text]]
id = "session_card_v2_transcript_error"
template = true
text = "${item.transcriptPreview && item.transcriptPreview.errorText ? item.transcriptPreview.errorText : ''}"
class = "surface-state-list surface-note surface-mono session-transcript-preview"

[[text]]
id = "session_card_v2_transcript_text"
template = true
text = "${item.transcriptPreview && item.transcriptPreview.text ? item.transcriptPreview.text : ''}"
class = "surface-state-list surface-note surface-mono session-transcript-preview"

# --- job templates ----------------------------------------------------------
[[box]]
id = "daemon_status_template_workbench"
template = true
children = ["daemon_status_title_workbench", "daemon_status_meta_workbench", "daemon_status_detail_workbench", "daemon_status_counters_workbench"]
class = "surface-card"

[[heading]]
id = "daemon_status_title_workbench"
template = true
text = "${item.statusText || item.label || item.daemonId}"
level = 3

[[text]]
id = "daemon_status_meta_workbench"
template = true
text = "${item.metaText || item.statusText || item.status}"
class = "surface-status"

[[text]]
id = "daemon_status_detail_workbench"
template = true
text = "${item.detailText || 'No recent work'}"
class = "surface-lede"

[[text]]
id = "daemon_status_counters_workbench"
template = true
text = "${item.counterSummaryText || item.capabilitiesText || 'No counters reported'}"
class = "surface-status"

[[box]]
id = "job_item_template_workbench"
template = true
children = ["job_item_title_workbench", "job_item_meta_workbench", "job_item_detail_workbench", "job_item_raw_details_workbench"]
class = "surface-card"

[[heading]]
id = "job_item_title_workbench"
template = true
text = "${item.titleText || item.requestId}"
level = 3

[[text]]
id = "job_item_meta_workbench"
template = true
text = "${item.metaText || item.statusText || item.status}${item.errorText ? ' · ' + item.errorText : ''}"
class = "surface-status"

[[text]]
id = "job_item_detail_workbench"
template = true
text = "${item.detailText || item.summary || ''}"
class = "surface-lede"

[[details]]
id = "job_item_raw_details_workbench"
template = true
children = ["job_item_raw_summary_workbench", "job_item_raw_detail_workbench"]
class = "repo-paths-panel"

[[summary]]
id = "job_item_raw_summary_workbench"
template = true
text = "${item.errorDetailText ? 'Show error detail' : 'Show request detail'}"
class = "surface-card-title"

[[text]]
id = "job_item_raw_detail_workbench"
template = true
text = "${item.rawDetailText || item.errorDetailText || item.requestId || ''}"
class = "surface-state-list surface-note surface-mono repo-paths-list"

# --- detail templates -------------------------------------------------------
[[box]]
id = "session_detail_template"
template = true
children = ["session_detail_title", "session_detail_meta", "session_detail_latest", "session_detail_preview", "session_detail_actions", "session_detail_status_line", "session_detail_summary_details", "session_detail_repo_details", "session_detail_transcript_details"]
class = "${item.desire ? 'surface-card session-card desire' : 'surface-card session-card'}"

[[heading]]
id = "session_detail_title"
template = true
text = "${item.title || item.id}"
level = 1
class = "session-title"

[[text]]
id = "session_detail_meta"
template = true
text = "${item.project} · ${item.msgCount} msgs · origin ${item.origin || '—'}${item.lastMessageRelativeText ? ' · updated ' + item.lastMessageRelativeText : ''}${item.lastMessageExactText ? ' · ' + item.lastMessageExactText : ''}${item.desire ? ' · DESIRE' : ''}"
class = "surface-status"

[[text]]
id = "session_detail_latest"
template = true
text = "${item.lastMessageLine || ''}"
class = "surface-status"

[[text]]
id = "session_detail_preview"
template = true
text = "${item.previewBrief || item.preview || ''}"
class = "surface-lede session-preview"

[[box]]
id = "session_detail_actions"
template = true
children = ["session_detail_transcript_button", "session_detail_summary_button", "session_detail_repo_button"]
class = "surface-actions"

[[button]]
id = "session_detail_transcript_button"
template = true
text = "${item.transcriptPreview && item.transcriptPreview.actionText ? item.transcriptPreview.actionText : 'Preview text'}"
type = "button"
action = "previewTranscript"
data-id = "${item.id}"

[[button]]
id = "session_detail_summary_button"
template = true
text = "${item.aiSummary && item.aiSummary.actionText ? item.aiSummary.actionText : 'Summarize'}"
type = "button"
action = "summarizeSession"
data-id = "${item.id}"

[[button]]
id = "session_detail_repo_button"
template = true
text = "${item.repoIndex && item.repoIndex.actionText ? item.repoIndex.actionText : 'Index repos'}"
type = "button"
action = "indexRepos"
data-id = "${item.id}"

[[text]]
id = "session_detail_status_line"
template = true
text = "${(item.repoStatusText || 'Repos not indexed') + ' · ' + (item.transcriptStatusText || 'Text not loaded') + ' · ' + (item.aiStatusText || 'Summary not run')}"
class = "surface-status"

[[details]]
id = "session_detail_summary_details"
template = true
children = ["session_detail_summary_heading", "session_detail_summary_version", "session_detail_summary_error", "session_detail_summary_text", "session_detail_summary_bullets"]
class = "session-transcript-panel"

[[summary]]
id = "session_detail_summary_heading"
template = true
text = "AI summary"
class = "surface-card-title"

[[text]]
id = "session_detail_summary_version"
template = true
text = "${item.aiSummary && item.aiSummary.versionText ? item.aiSummary.versionText : ''}"
class = "surface-status"

[[text]]
id = "session_detail_summary_error"
template = true
text = "${item.aiSummary && item.aiSummary.errorText ? item.aiSummary.errorText : ''}"
class = "surface-state-list surface-note surface-mono session-transcript-preview"

[[text]]
id = "session_detail_summary_text"
template = true
text = "${item.aiSummary && item.aiSummary.text ? item.aiSummary.text : ''}"
class = "surface-note"

[[text]]
id = "session_detail_summary_bullets"
template = true
text = "${item.aiSummary && item.aiSummary.bulletText ? item.aiSummary.bulletText : ''}"
class = "surface-state-list surface-note session-transcript-preview"

[[details]]
id = "session_detail_repo_details"
template = true
children = ["session_detail_repo_heading", "session_detail_repo_version", "session_detail_repo_error", "session_detail_repo_result"]
class = "session-transcript-panel"

[[summary]]
id = "session_detail_repo_heading"
template = true
text = "Repo index"
class = "surface-card-title"

[[text]]
id = "session_detail_repo_version"
template = true
text = "${item.repoIndex && item.repoIndex.versionText ? item.repoIndex.versionText : ''}"
class = "surface-status"

[[text]]
id = "session_detail_repo_error"
template = true
text = "${item.repoIndex && item.repoIndex.errorText ? item.repoIndex.errorText : ''}"
class = "surface-state-list surface-note surface-mono session-transcript-preview"

[[text]]
id = "session_detail_repo_result"
template = true
text = "${item.repoIndex && item.repoIndex.detailText ? item.repoIndex.detailText : ''}"
class = "surface-note"

[[details]]
id = "session_detail_transcript_details"
template = true
children = ["session_detail_transcript_heading", "session_detail_transcript_version", "session_detail_transcript_error", "session_detail_transcript_text"]
class = "session-transcript-panel"

[[summary]]
id = "session_detail_transcript_heading"
template = true
text = "Transcript"
class = "surface-card-title"

[[text]]
id = "session_detail_transcript_version"
template = true
text = "${item.transcriptPreview && item.transcriptPreview.versionText ? item.transcriptPreview.versionText : ''}"
class = "surface-status"

[[text]]
id = "session_detail_transcript_error"
template = true
text = "${item.transcriptPreview && item.transcriptPreview.errorText ? item.transcriptPreview.errorText : ''}"
class = "surface-state-list surface-note surface-mono session-transcript-preview"

[[text]]
id = "session_detail_transcript_text"
template = true
text = "${item.transcriptPreview && item.transcriptPreview.text ? item.transcriptPreview.text : ''}"
class = "surface-state-list surface-note surface-mono session-transcript-preview"

[[box]]
id = "session_detail_repo_link_template"
template = true
children = ["session_detail_repo_link_title", "session_detail_repo_link_meta", "session_detail_repo_link_paths"]
class = "surface-card repo-card"

[[link]]
id = "session_detail_repo_link_title"
template = true
text = "${item.name || item.displayRoot || item.repoId}"
href = "${'/repo?id=' + encodeURIComponent(item.repoId || item.displayRoot || item.root || '')}"
class = "surface-card-title"

[[text]]
id = "session_detail_repo_link_meta"
template = true
text = "${(item.displayRoot || item.root || '') + ' · ' + (item.mentionText || '')}"
class = "surface-status"

[[text]]
id = "session_detail_repo_link_paths"
template = true
text = "${item.pathPreviewText || ''}"
class = "surface-status"

[[box]]
id = "repo_detail_template"
template = true
children = ["repo_detail_title", "repo_detail_meta", "repo_detail_recognition", "repo_detail_snapshot", "repo_detail_remote", "repo_detail_paths_details"]
class = "surface-card repo-card"

[[heading]]
id = "repo_detail_title"
template = true
text = "${item.name || item.displayRoot || item.repoId}"
level = 1
class = "session-title"

[[text]]
id = "repo_detail_meta"
template = true
text = "${(item.displayRoot || item.root || '') + ' · ' + item.sessionCount + ' ' + (item.sessionCount === 1 ? 'session' : 'sessions') + ' · ' + (item.mentionText || '')}"
class = "surface-status"

[[text]]
id = "repo_detail_recognition"
template = true
text = "${item.recognitionText || 'Recognition source unknown'}"
class = "surface-status"

[[text]]
id = "repo_detail_snapshot"
template = true
text = "${item.snapshotText || 'Snapshot not prepared'}"
class = "surface-status"

[[text]]
id = "repo_detail_remote"
template = true
text = "${item.remoteText ? 'Remote: ' + item.remoteText : 'Remote: none'}"
class = "surface-status"

[[details]]
id = "repo_detail_paths_details"
template = true
children = ["repo_detail_paths_summary", "repo_detail_paths_text"]
class = "repo-paths-panel"

[[summary]]
id = "repo_detail_paths_summary"
template = true
text = "Mentioned paths"
class = "surface-card-title"

[[text]]
id = "repo_detail_paths_text"
template = true
text = "${item.pathDetailText || 'No displayable mentioned paths'}"
class = "surface-state-list surface-note surface-mono repo-paths-list"

[[box]]
id = "repo_detail_session_link_template"
template = true
children = ["repo_detail_session_link_title", "repo_detail_session_link_meta", "repo_detail_session_link_paths"]
class = "surface-card session-card"

[[link]]
id = "repo_detail_session_link_title"
template = true
text = "${item.title || item.id}"
href = "${'/session?id=' + encodeURIComponent(item.id || '')}"
class = "surface-card-title"

[[text]]
id = "repo_detail_session_link_meta"
template = true
text = "${(item.project || '') + ' · ' + (item.mentionText || '')}"
class = "surface-status"

[[text]]
id = "repo_detail_session_link_paths"
template = true
text = "${item.pathText || ''}"
class = "surface-status"

# --- detail page loads ------------------------------------------------------
[[step]]
program = "tilth_program_session_detail"
order = 0
op = "fetchJson"
on = "load"
url = "${'/api/sessions/detail?id=' + encodeURIComponent(new URLSearchParams(window.location.search).get('id') || '')}"
into = "sessionDetailResponse"
allowFailure = true

[[step]]
program = "tilth_program_session_detail"
order = 1
op = "renderCollection"
on = "load"
widget = "session_detail_list"
from = "sessionDetailResponse.sessions"
template = "session_detail_template"

[[step]]
program = "tilth_program_session_detail"
order = 2
op = "renderCollection"
on = "load"
widget = "session_detail_repo_list"
from = "sessionDetailResponse.repos"
template = "session_detail_repo_link_template"

[[step]]
program = "tilth_program_session_detail"
order = 3
op = "renderCollection"
on = "load"
widget = "session_detail_jobs_list"
from = "sessionDetailResponse.jobs"
template = "job_item_template_workbench"

[[step]]
program = "tilth_program_session_detail"
order = 4
op = "setText"
on = "load"
widget = "session_detail_status"
text = "${state.sessionDetailResponse && state.sessionDetailResponse.session ? 'Session detail · ' + state.sessionDetailResponse.repos.length + ' repos · ' + state.sessionDetailResponse.jobs.length + ' jobs' : 'Session not found'}"

[[step]]
program = "tilth_program_repo_detail"
order = 0
op = "fetchJson"
on = "load"
url = "${'/api/repo-index/repo?id=' + encodeURIComponent(new URLSearchParams(window.location.search).get('id') || '')}"
into = "repoDetailResponse"
allowFailure = true

[[step]]
program = "tilth_program_repo_detail"
order = 1
op = "renderCollection"
on = "load"
widget = "repo_detail_list"
from = "repoDetailResponse.repos"
template = "repo_detail_template"

[[step]]
program = "tilth_program_repo_detail"
order = 2
op = "renderCollection"
on = "load"
widget = "repo_detail_session_list"
from = "repoDetailResponse.sessions"
template = "repo_detail_session_link_template"

[[step]]
program = "tilth_program_repo_detail"
order = 3
op = "renderCollection"
on = "load"
widget = "repo_detail_jobs_list"
from = "repoDetailResponse.jobs"
template = "job_item_template_workbench"

[[step]]
program = "tilth_program_repo_detail"
order = 4
op = "setText"
on = "load"
widget = "repo_detail_status"
text = "${state.repoDetailResponse && state.repoDetailResponse.repo ? 'Repo detail · ' + state.repoDetailResponse.sessions.length + ' sessions · ' + state.repoDetailResponse.jobs.length + ' jobs' : 'Repo not found'}"

# --- load -------------------------------------------------------------------
[[step]]
order = 0
op = "setText"
on = "load"
widget = "tilth_status_repo_filters"
text = "Loading..."

[[step]]
order = 1
op = "fetchJson"
on = "load"
url = "/api/sessions"
into = "sessionsResponse"

[[step]]
order = 2
op = "fetchJson"
on = "load"
url = "/api/repo-index/repos"
into = "repoIndexResponse"

[[step]]
order = 3
op = "fetchJson"
on = "load"
url = "/api/jobs"
into = "jobsResponse"

[[step]]
order = 4
op = "fetchJson"
on = "load"
url = "/api/daemons"
into = "daemonsResponse"

[[step]]
order = 5
op = "renderCollection"
on = "load"
widget = "repo_index_list_repo_filters"
from = "repoIndexResponse.repos"
template = "repo_item_template_clean"

[[step]]
