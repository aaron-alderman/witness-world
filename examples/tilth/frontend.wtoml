# Tilth frontend: conversation sessions plus an inverted repo view.
# Renders at / via page.home.

[[defaults]]
context = "frontend"
program = "tilth_program_workbench_v7"

[[page]]
id = "tilth_page_workbench_v7"
children = ["tilth_title_repo_filters", "tilth_status_repo_filters", "tilth_search_box", "tilth_nav_repo_filters", "tilth_filter_bar_repo_filters", "repo_section_repo_filters", "sessions_section_repo_filters"]
title = "Tilth"

[[heading]]
id = "tilth_title_repo_filters"
text = "Tilth"
level = 1

[[text]]
id = "tilth_status_repo_filters"
text = ""
class = "status"
role = "app-status"

[[input]]
id = "tilth_search_input"
name = "q"
placeholder = "search sessions, repos, remotes, summaries"
type = "search"

[[box]]
id = "tilth_search_box"
children = ["tilth_search_input", "tilth_search_clear_button"]
role = "search"
class = "surface-actions"

[[button]]
id = "tilth_search_clear_button"
text = "Clear"
type = "button"
action = "clearSearch"

[[box]]
id = "tilth_nav_repo_filters"
children = ["repo_nav_button_repo_filters", "sessions_nav_button_repo_filters"]
role = "view-nav"
class = "surface-actions"

[[button]]
id = "repo_nav_button_repo_filters"
text = "Repos ✓"
type = "button"
action = "showRepos"
disabled = true

[[button]]
id = "sessions_nav_button_repo_filters"
text = "Sessions"
type = "button"
action = "showSessions"

[[box]]
id = "tilth_filter_bar_repo_filters"
children = ["filter_all_button_repo_filters", "filter_desire_button_repo_filters", "filter_indexed_button_repo_filters"]
role = "filter-bar"
class = "surface-actions"

[[button]]
id = "filter_all_button_repo_filters"
text = "All ✓"
type = "button"
action = "filterAll"
disabled = true

[[button]]
id = "filter_desire_button_repo_filters"
text = "DESIRE"
type = "button"
action = "filterDesire"

[[button]]
id = "filter_indexed_button_repo_filters"
text = "Indexed"
type = "button"
action = "filterIndexed"

[[box]]
id = "repo_section_repo_filters"
children = ["repo_recognition_form", "repo_recognition_status", "repo_index_list_repo_filters"]
role = "repo-view"

[[form]]
id = "repo_recognition_form"
children = ["repo_recognition_input", "repo_recognition_submit"]
role = "repo-recognition-form"
class = "surface-actions"

[[input]]
id = "repo_recognition_input"
name = "path"
placeholder = "recognize repo path, e.g. ~/work/my-repo"

[[button]]
id = "repo_recognition_submit"
text = "Recognize repo"
type = "submit"

[[text]]
id = "repo_recognition_status"
text = ""
class = "surface-status"

[[box]]
id = "repo_index_list_repo_filters"
role = "repo-index-list"
class = "surface-list"

[[box]]
id = "sessions_section_repo_filters"
children = ["sessions_list_repo_filters"]
role = "session-view"
hidden = true

[[box]]
id = "sessions_list_repo_filters"
role = "session-list"
class = "surface-list"

[[frontendProgram]]
id = "tilth_program_workbench_v7"
rootWidget = "tilth_page_workbench_v7"

# --- repo template ----------------------------------------------------------
[[box]]
id = "repo_item_template_clean"
template = true
children = ["repo_item_title_clean", "repo_item_meta_clean", "repo_item_recognition_clean", "repo_item_snapshot_clean", "repo_item_remote_clean", "repo_item_sessions_clean", "repo_item_paths_preview_clean", "repo_item_paths_details_clean"]
class = "surface-card repo-card"

[[heading]]
id = "repo_item_title_clean"
template = true
text = "${item.name || item.root}"
level = 3

[[text]]
id = "repo_item_meta_clean"
template = true
text = "${item.displayRoot || item.root} · ${item.sessionCount} ${item.sessionCount === 1 ? 'session' : 'sessions'} · ${item.mentionText || (item.mentionCount + ' mentions')}"
class = "surface-status"

[[text]]
id = "repo_item_recognition_clean"
template = true
text = "${item.recognitionText || 'Recognition source unknown'}"
class = "surface-status"

[[text]]
id = "repo_item_snapshot_clean"
template = true
text = "${item.snapshotText || 'Snapshot not prepared'}"
class = "surface-status"

[[text]]
id = "repo_item_sessions_clean"
template = true
text = "${item.sessionText || 'No indexed sessions yet'}"
class = "surface-lede"

[[text]]
id = "repo_item_remote_clean"
template = true
text = "${item.remoteText ? 'Remote: ' + item.remoteText : 'Remote: none'}"
class = "surface-status"

[[text]]
id = "repo_item_paths_preview_clean"
template = true
text = "${item.pathPreviewText ? 'Mentioned paths: ' + item.pathPreviewText : 'No displayable mentioned paths'}"
class = "surface-status"

[[details]]
id = "repo_item_paths_details_clean"
template = true
children = ["repo_item_paths_summary_clean", "repo_item_paths_detail_clean"]
class = "repo-paths-panel"

[[summary]]
id = "repo_item_paths_summary_clean"
template = true
text = "Show paths"
class = "surface-card-title"

[[text]]
id = "repo_item_paths_detail_clean"
template = true
text = "${item.pathDetailText || 'No displayable mentioned paths'}"
class = "surface-state-list surface-note surface-mono repo-paths-list"

# --- session template -------------------------------------------------------
[[box]]
id = "session_card_v3_template"
template = true
children = ["session_card_v2_title", "session_card_v2_meta", "session_card_v2_preview", "session_card_v2_desire_button", "session_card_v2_transcript_button", "session_card_v2_ai_summary_button", "session_card_v2_repo_button", "session_card_v2_status_line", "session_card_v2_repo_chips", "session_card_v2_ai_summary_details", "session_card_v2_repo_details", "session_card_v2_transcript_details"]
class = "${item.desire ? 'surface-card session-card desire' : 'surface-card session-card'}"

[[heading]]
id = "session_card_v2_title"
template = true
text = "${item.title || item.id}"
level = 3
class = "session-title"

[[text]]
id = "session_card_v2_meta"
template = true
text = "${item.project} · ${item.msgCount} msgs · origin ${item.origin || '—'}${item.desire ? ' · marked by ' + (item.markedBy || '—') : ''}"
class = "surface-status"

[[text]]
id = "session_card_v2_preview"
template = true
text = "${item.previewBrief || item.preview || ''}"
class = "surface-lede session-preview"

[[button]]
id = "session_card_v2_desire_button"
template = true
text = "${item.desire ? 'DESIRE ✓' : 'Mark DESIRE'}"
type = "button"
action = "markDesire"
data-id = "${item.id}"

[[button]]
id = "session_card_v2_transcript_button"
template = true
text = "${item.transcriptPreview && item.transcriptPreview.actionText ? item.transcriptPreview.actionText : 'Preview text'}"
type = "button"
action = "previewTranscript"
data-id = "${item.id}"

[[button]]
id = "session_card_v2_ai_summary_button"
template = true
text = "${item.aiSummary && item.aiSummary.actionText ? item.aiSummary.actionText : 'Summarize'}"
type = "button"
action = "summarizeSession"
data-id = "${item.id}"

[[button]]
id = "session_card_v2_repo_button"
template = true
text = "${item.repoIndex && item.repoIndex.actionText ? item.repoIndex.actionText : 'Index repos'}"
type = "button"
action = "indexRepos"
data-id = "${item.id}"

[[text]]
id = "session_card_v2_status_line"
template = true
text = "${(item.repoStatusText || 'Repos not indexed') + ' · ' + (item.transcriptStatusText || 'Text not loaded') + ' · ' + (item.aiStatusText || 'Summary not run')}"
class = "surface-status"

[[text]]
id = "session_card_v2_repo_chips"
template = true
text = "${item.repoChipText ? item.repoChipText : ''}"
class = "surface-status surface-mono"

[[details]]
id = "session_card_v2_ai_summary_details"
template = true
children = ["session_card_v2_ai_summary_summary", "session_card_v2_ai_summary_error", "session_card_v2_ai_summary_text", "session_card_v2_ai_summary_bullets"]
class = "session-transcript-panel"

[[summary]]
id = "session_card_v2_ai_summary_summary"
template = true
text = "Summary"
class = "surface-card-title"

[[text]]
id = "session_card_v2_ai_summary_text"
template = true
text = "${item.aiSummary && item.aiSummary.text ? item.aiSummary.text : ''}"
class = "surface-note"

[[text]]
id = "session_card_v2_ai_summary_error"
template = true
text = "${item.aiSummary && item.aiSummary.errorText ? item.aiSummary.errorText : ''}"
class = "surface-state-list surface-note surface-mono session-transcript-preview"

[[text]]
id = "session_card_v2_ai_summary_bullets"
template = true
text = "${item.aiSummary && item.aiSummary.bulletText ? item.aiSummary.bulletText : ''}"
class = "surface-state-list surface-note session-transcript-preview"

[[details]]
id = "session_card_v2_repo_details"
template = true
children = ["session_card_v2_repo_summary", "session_card_v2_repo_error", "session_card_v2_repo_result"]
class = "session-transcript-panel"

[[summary]]
id = "session_card_v2_repo_summary"
template = true
text = "Repos"
class = "surface-card-title"

[[text]]
id = "session_card_v2_repo_error"
template = true
text = "${item.repoIndex && item.repoIndex.errorText ? item.repoIndex.errorText : ''}"
class = "surface-state-list surface-note surface-mono session-transcript-preview"

[[text]]
id = "session_card_v2_repo_result"
template = true
text = "${item.repoIndex && item.repoIndex.detailText ? item.repoIndex.detailText : ''}"
class = "surface-note"

[[details]]
id = "session_card_v2_transcript_details"
template = true
children = ["session_card_v2_transcript_summary", "session_card_v2_transcript_error", "session_card_v2_transcript_text"]
class = "session-transcript-panel"

[[summary]]
id = "session_card_v2_transcript_summary"
template = true
text = "Transcript"
class = "surface-card-title"

[[text]]
id = "session_card_v2_transcript_error"
template = true
text = "${item.transcriptPreview && item.transcriptPreview.errorText ? item.transcriptPreview.errorText : ''}"
class = "surface-state-list surface-note surface-mono session-transcript-preview"

[[text]]
id = "session_card_v2_transcript_text"
template = true
text = "${item.transcriptPreview && item.transcriptPreview.text ? item.transcriptPreview.text : ''}"
class = "surface-state-list surface-note surface-mono session-transcript-preview"

# --- load -------------------------------------------------------------------
[[step]]
order = 0
op = "setText"
on = "load"
widget = "tilth_status_repo_filters"
text = "Loading..."

[[step]]
order = 1
op = "fetchJson"
on = "load"
url = "/api/sessions"
into = "sessionsResponse"

[[step]]
order = 2
op = "fetchJson"
on = "load"
url = "/api/repo-index/repos"
into = "repoIndexResponse"

[[step]]
order = 3
op = "renderCollection"
on = "load"
widget = "repo_index_list_repo_filters"
from = "repoIndexResponse.repos"
template = "repo_item_template_clean"

[[step]]
order = 4
op = "renderCollection"
on = "load"
widget = "sessions_list_repo_filters"
from = "sessionsResponse.sessions"
template = "session_card_v3_template"

[[step]]
order = 5
op = "setText"
on = "load"
widget = "tilth_status_repo_filters"
text = "${state.sessionsResponse && state.sessionsResponse.sessions ? state.sessionsResponse.sessions.length + ' conversations · ' + ((state.repoIndexResponse && state.repoIndexResponse.repos) ? state.repoIndexResponse.repos.length : 0) + ' repos' : 'No conversations yet'}"

# --- nav --------------------------------------------------------------------
[[step]]
order = 0
op = "setHidden"
on = "click:showRepos"
widget = "repo_section_repo_filters"
hidden = false

[[step]]
order = 1
op = "setHidden"
on = "click:showRepos"
widget = "sessions_section_repo_filters"
hidden = true

[[step]]
order = 2
op = "setText"
on = "click:showRepos"
widget = "repo_nav_button_repo_filters"
text = "Repos ✓"

[[step]]
order = 3
op = "setText"
on = "click:showRepos"
widget = "sessions_nav_button_repo_filters"
text = "Sessions"

[[step]]
order = 4
op = "setDisabled"
on = "click:showRepos"
widget = "repo_nav_button_repo_filters"
disabled = true

[[step]]
order = 5
op = "setDisabled"
on = "click:showRepos"
widget = "sessions_nav_button_repo_filters"
disabled = false

[[step]]
order = 0
op = "setHidden"
on = "click:showSessions"
widget = "repo_section_repo_filters"
hidden = true

[[step]]
order = 1
op = "setHidden"
on = "click:showSessions"
widget = "sessions_section_repo_filters"
hidden = false

[[step]]
order = 2
op = "setText"
on = "click:showSessions"
widget = "repo_nav_button_repo_filters"
text = "Repos"

[[step]]
order = 3
op = "setText"
on = "click:showSessions"
widget = "sessions_nav_button_repo_filters"
text = "Sessions ✓"

[[step]]
order = 4
op = "setDisabled"
on = "click:showSessions"
widget = "repo_nav_button_repo_filters"
disabled = false

[[step]]
order = 5
op = "setDisabled"
on = "click:showSessions"
widget = "sessions_nav_button_repo_filters"
disabled = true

# --- filters ----------------------------------------------------------------
[[step]]
order = 0
op = "setText"
on = "click:filterAll"
widget = "tilth_status_repo_filters"
text = "Loading all..."

[[step]]
order = 1
op = "fetchJson"
on = "click:filterAll"
url = "/api/sessions"
into = "sessionsResponse"

[[step]]
order = 2
op = "fetchJson"
on = "click:filterAll"
url = "/api/repo-index/repos"
into = "repoIndexResponse"

[[step]]
order = 3
op = "renderCollection"
on = "click:filterAll"
widget = "repo_index_list_repo_filters"
from = "repoIndexResponse.repos"
template = "repo_item_template_clean"

[[step]]
order = 4
op = "renderCollection"
on = "click:filterAll"
widget = "sessions_list_repo_filters"
from = "sessionsResponse.sessions"
template = "session_card_v3_template"

[[step]]
order = 5
op = "setText"
on = "click:filterAll"
widget = "tilth_status_repo_filters"
text = "${state.sessionsResponse && state.sessionsResponse.sessions ? 'All · ' + state.sessionsResponse.sessions.length + ' conversations · ' + ((state.repoIndexResponse && state.repoIndexResponse.repos) ? state.repoIndexResponse.repos.length : 0) + ' repos' : 'All'}"

[[step]]
order = 6
op = "setText"
on = "click:filterAll"
widget = "filter_all_button_repo_filters"
text = "All ✓"

[[step]]
order = 7
op = "setText"
on = "click:filterAll"
widget = "filter_desire_button_repo_filters"
text = "DESIRE"

[[step]]
order = 8
op = "setText"
on = "click:filterAll"
widget = "filter_indexed_button_repo_filters"
text = "Indexed"

[[step]]
order = 9
op = "setDisabled"
on = "click:filterAll"
widget = "filter_all_button_repo_filters"
disabled = true

[[step]]
order = 10
op = "setDisabled"
on = "click:filterAll"
widget = "filter_desire_button_repo_filters"
disabled = false

[[step]]
order = 11
op = "setDisabled"
on = "click:filterAll"
widget = "filter_indexed_button_repo_filters"
disabled = false

[[step]]
order = 12
op = "setValue"
on = "click:filterAll"
widget = "tilth_search_input"
value = ""

[[step]]
order = 0
op = "setText"
on = "click:filterDesire"
widget = "tilth_status_repo_filters"
text = "Loading DESIRE..."

[[step]]
order = 1
op = "fetchJson"
on = "click:filterDesire"
url = "/api/sessions?filter=desire"
into = "sessionsResponse"

[[step]]
order = 2
op = "fetchJson"
on = "click:filterDesire"
url = "/api/repo-index/repos?filter=desire"
into = "repoIndexResponse"

[[step]]
order = 3
op = "renderCollection"
on = "click:filterDesire"
widget = "repo_index_list_repo_filters"
from = "repoIndexResponse.repos"
template = "repo_item_template_clean"

[[step]]
order = 4
op = "renderCollection"
on = "click:filterDesire"
widget = "sessions_list_repo_filters"
from = "sessionsResponse.sessions"
template = "session_card_v3_template"

[[step]]
order = 5
op = "setText"
on = "click:filterDesire"
widget = "tilth_status_repo_filters"
text = "${state.sessionsResponse && state.sessionsResponse.sessions ? 'DESIRE · ' + state.sessionsResponse.sessions.length + ' conversations · ' + ((state.repoIndexResponse && state.repoIndexResponse.repos) ? state.repoIndexResponse.repos.length : 0) + ' repos' : 'DESIRE'}"

[[step]]
order = 6
op = "setText"
on = "click:filterDesire"
widget = "filter_all_button_repo_filters"
text = "All"

[[step]]
order = 7
op = "setText"
on = "click:filterDesire"
widget = "filter_desire_button_repo_filters"
text = "DESIRE ✓"

[[step]]
order = 8
op = "setText"
on = "click:filterDesire"
widget = "filter_indexed_button_repo_filters"
text = "Indexed"

[[step]]
order = 9
op = "setDisabled"
on = "click:filterDesire"
widget = "filter_all_button_repo_filters"
disabled = false

[[step]]
order = 10
op = "setDisabled"
on = "click:filterDesire"
widget = "filter_desire_button_repo_filters"
disabled = true

[[step]]
order = 11
op = "setDisabled"
on = "click:filterDesire"
widget = "filter_indexed_button_repo_filters"
disabled = false

[[step]]
order = 12
op = "setValue"
on = "click:filterDesire"
widget = "tilth_search_input"
value = ""

[[step]]
order = 0
op = "setText"
on = "click:filterIndexed"
widget = "tilth_status_repo_filters"
text = "Loading indexed..."

[[step]]
order = 1
op = "fetchJson"
on = "click:filterIndexed"
url = "/api/sessions?filter=indexed"
into = "sessionsResponse"

[[step]]
order = 2
op = "fetchJson"
on = "click:filterIndexed"
url = "/api/repo-index/repos?filter=indexed"
into = "repoIndexResponse"

[[step]]
order = 3
op = "renderCollection"
on = "click:filterIndexed"
widget = "repo_index_list_repo_filters"
from = "repoIndexResponse.repos"
template = "repo_item_template_clean"

[[step]]
order = 4
op = "renderCollection"
on = "click:filterIndexed"
widget = "sessions_list_repo_filters"
from = "sessionsResponse.sessions"
template = "session_card_v3_template"

[[step]]
order = 5
op = "setText"
on = "click:filterIndexed"
widget = "tilth_status_repo_filters"
text = "${state.sessionsResponse && state.sessionsResponse.sessions ? 'Indexed · ' + state.sessionsResponse.sessions.length + ' conversations · ' + ((state.repoIndexResponse && state.repoIndexResponse.repos) ? state.repoIndexResponse.repos.length : 0) + ' repos' : 'Indexed'}"

[[step]]
order = 6
op = "setText"
on = "click:filterIndexed"
widget = "filter_all_button_repo_filters"
text = "All"

[[step]]
order = 7
op = "setText"
on = "click:filterIndexed"
widget = "filter_desire_button_repo_filters"
text = "DESIRE"

[[step]]
order = 8
op = "setText"
on = "click:filterIndexed"
widget = "filter_indexed_button_repo_filters"
text = "Indexed ✓"

[[step]]
order = 9
op = "setDisabled"
on = "click:filterIndexed"
widget = "filter_all_button_repo_filters"
disabled = false

[[step]]
order = 10
op = "setDisabled"
on = "click:filterIndexed"
widget = "filter_desire_button_repo_filters"
disabled = false

[[step]]
order = 11
op = "setDisabled"
on = "click:filterIndexed"
widget = "filter_indexed_button_repo_filters"
disabled = true

[[step]]
order = 12
op = "setValue"
on = "click:filterIndexed"
widget = "tilth_search_input"
value = ""

# --- search -----------------------------------------------------------------
[[step]]
order = 0
op = "setText"
on = "input:tilth_search_input"
widget = "tilth_status_repo_filters"
text = "${event.value ? 'Searching: ' + event.value + '...' : 'Loading all...'}"

[[step]]
order = 1
op = "fetchJson"
on = "input:tilth_search_input"
url = "/api/sessions?q=${encodeURIComponent(event.value || '')}"
into = "sessionsResponse"

[[step]]
order = 2
op = "fetchJson"
on = "input:tilth_search_input"
url = "/api/repo-index/repos?q=${encodeURIComponent(event.value || '')}"
into = "repoIndexResponse"

[[step]]
order = 3
op = "renderCollection"
on = "input:tilth_search_input"
widget = "repo_index_list_repo_filters"
from = "repoIndexResponse.repos"
template = "repo_item_template_clean"

[[step]]
order = 4
op = "renderCollection"
on = "input:tilth_search_input"
widget = "sessions_list_repo_filters"
from = "sessionsResponse.sessions"
template = "session_card_v3_template"

[[step]]
order = 5
op = "setText"
on = "input:tilth_search_input"
widget = "tilth_status_repo_filters"
text = "${state.sessionsResponse && state.sessionsResponse.sessions ? (event.value ? 'Search · ' + state.sessionsResponse.sessions.length + ' conversations · ' + ((state.repoIndexResponse && state.repoIndexResponse.repos) ? state.repoIndexResponse.repos.length : 0) + ' repos' : state.sessionsResponse.sessions.length + ' conversations · ' + ((state.repoIndexResponse && state.repoIndexResponse.repos) ? state.repoIndexResponse.repos.length : 0) + ' repos') : 'No matches'}"

[[step]]
order = 6
op = "setText"
on = "input:tilth_search_input"
widget = "filter_all_button_repo_filters"
text = "All ✓"

[[step]]
order = 7
op = "setText"
on = "input:tilth_search_input"
widget = "filter_desire_button_repo_filters"
text = "DESIRE"

[[step]]
order = 8
op = "setText"
on = "input:tilth_search_input"
widget = "filter_indexed_button_repo_filters"
text = "Indexed"

[[step]]
order = 9
op = "setDisabled"
on = "input:tilth_search_input"
widget = "filter_all_button_repo_filters"
disabled = true

[[step]]
order = 10
op = "setDisabled"
on = "input:tilth_search_input"
widget = "filter_desire_button_repo_filters"
disabled = false

[[step]]
order = 11
op = "setDisabled"
on = "input:tilth_search_input"
widget = "filter_indexed_button_repo_filters"
disabled = false

[[step]]
order = 0
op = "setValue"
on = "click:clearSearch"
widget = "tilth_search_input"
value = ""

[[step]]
order = 1
op = "fetchJson"
on = "click:clearSearch"
url = "/api/sessions"
into = "sessionsResponse"

[[step]]
order = 2
op = "fetchJson"
on = "click:clearSearch"
url = "/api/repo-index/repos"
into = "repoIndexResponse"

[[step]]
order = 3
op = "renderCollection"
on = "click:clearSearch"
widget = "repo_index_list_repo_filters"
from = "repoIndexResponse.repos"
template = "repo_item_template_clean"

[[step]]
order = 4
op = "renderCollection"
on = "click:clearSearch"
widget = "sessions_list_repo_filters"
from = "sessionsResponse.sessions"
template = "session_card_v3_template"

[[step]]
order = 5
op = "setText"
on = "click:clearSearch"
widget = "tilth_status_repo_filters"
text = "${state.sessionsResponse && state.sessionsResponse.sessions ? state.sessionsResponse.sessions.length + ' conversations · ' + ((state.repoIndexResponse && state.repoIndexResponse.repos) ? state.repoIndexResponse.repos.length : 0) + ' repos' : 'No conversations yet'}"

[[step]]
order = 6
op = "setText"
on = "click:clearSearch"
widget = "filter_all_button_repo_filters"
text = "All ✓"

[[step]]
order = 7
op = "setText"
on = "click:clearSearch"
widget = "filter_desire_button_repo_filters"
text = "DESIRE"

[[step]]
order = 8
op = "setText"
on = "click:clearSearch"
widget = "filter_indexed_button_repo_filters"
text = "Indexed"

[[step]]
order = 9
op = "setDisabled"
on = "click:clearSearch"
widget = "filter_all_button_repo_filters"
disabled = true

[[step]]
order = 10
op = "setDisabled"
on = "click:clearSearch"
widget = "filter_desire_button_repo_filters"
disabled = false

[[step]]
order = 11
op = "setDisabled"
on = "click:clearSearch"
widget = "filter_indexed_button_repo_filters"
disabled = false

# --- submit: manually recognize a repo path ---------------------------------
[[step]]
order = 0
op = "readForm"
on = "submit:repo_recognition_form"
widget = "repo_recognition_form"
into = "repoRecognitionDraft"

[[step]]
order = 1
op = "setText"
on = "submit:repo_recognition_form"
widget = "repo_recognition_status"
text = "Queueing repo recognition..."

[[step]]
order = 2
op = "postJson"
on = "submit:repo_recognition_form"
url = "/api/repos/recognitions/request"
method = "POST"
body = { path = "${state.repoRecognitionDraft.path || ''}" }
into = "repoRecognitionResponse"

[[step]]
order = 3
op = "setText"
on = "submit:repo_recognition_form"
widget = "repo_recognition_status"
text = "${state.repoRecognitionResponse && state.repoRecognitionResponse.requestId ? 'Repo recognition queued.' : 'Repo recognition queued.'}"

[[step]]
order = 4
op = "clearForm"
on = "submit:repo_recognition_form"
widget = "repo_recognition_form"

# --- click: mark a session DESIRE-related -----------------------------------
[[step]]
order = 0
op = "setText"
on = "click:markDesire"
widget = "tilth_status_repo_filters"
text = "Marking..."

[[step]]
order = 1
op = "postJson"
on = "click:markDesire"
url = "/api/sessions/${event.id}/desire"
method = "POST"
body = {}
into = "marked"

[[step]]
order = 2
op = "run"
on = "click:markDesire"
event = "load"

# --- click: request repo-location indexing ---------------------------------
[[step]]
order = 0
op = "setText"
on = "click:indexRepos"
widget = "tilth_status_repo_filters"
text = "Requesting repo index..."

[[step]]
order = 1
op = "postJson"
on = "click:indexRepos"
url = "/api/sessions/${event.id}/repo-index/request"
method = "POST"
body = {}
into = "repoIndexRequest"

[[step]]
order = 2
op = "setText"
on = "click:indexRepos"
widget = "tilth_status_repo_filters"
text = "Repo index requested. Refresh in a few seconds."

# --- click: request readable transcript preview ----------------------------
[[step]]
