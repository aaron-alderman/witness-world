from = "jobsResponse.jobs"
template = "job_item_template_workbench"

[[step]]
order = 9
op = "setText"
on = "load"
widget = "tilth_status_repo_filters"
text = "${state.sessionsResponse && state.sessionsResponse.sessions ? state.sessionsResponse.sessions.length + ' conversations · ' + ((state.repoIndexResponse && state.repoIndexResponse.repos) ? state.repoIndexResponse.repos.length : 0) + ' repos · ' + ((state.jobsResponse && state.jobsResponse.jobs) ? state.jobsResponse.jobs.length : 0) + ' jobs' : 'No conversations yet'}"

[[step]]
order = 10
op = "setText"
on = "load"
widget = "ops_summary_work_workbench"
text = "${state.jobsResponse && state.jobsResponse.summary ? state.jobsResponse.summary.workText : 'Work: unavailable'}"

[[step]]
order = 11
op = "setText"
on = "load"
widget = "ops_summary_artifacts_workbench"
text = "${state.jobsResponse && state.jobsResponse.summary ? state.jobsResponse.summary.artifactText : 'Artifacts: unavailable'}"

[[step]]
order = 12
op = "setText"
on = "load"
widget = "ops_summary_daemons_workbench"
text = "${state.jobsResponse && state.jobsResponse.summary ? state.jobsResponse.summary.daemonText : 'Daemons: unavailable'}"

