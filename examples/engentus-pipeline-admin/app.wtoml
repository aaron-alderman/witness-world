[app]
id = "engentus_pipeline_admin"
imports = ["../_lib/common.wtoml"]
spawn = ["backend", "frontend"]

[[serverRunner]]
actor = "aaron"
id = "pipeline_admin_server"
backendHost = "backendHost"
frontendHost = "frontendHost"
default = true
allowActorHeader = true

[[runtimePluginInstall]]
actor = "aaron"
serverRunner = "pipeline_admin_server"
plugin = "plugin.pipeline-runtime"

[[route]]
actor = "aaron"
id = "pipeline_admin_home"
method = "GET"
path = "/"
serves = "pipelineAdmin"
handler = "page.pipelineAdmin"

[[serve]]
actor = "aaron"
serverRunner = "pipeline_admin_server"
route = "pipeline_admin_home"

[[desktopTarget]]
id = "engentus_pipeline_admin_desktop"
label = "Engentus Pipeline Admin"
serverRunner = "pipeline_admin_server"
default = true
