[[defaults]]
context = "backend"

[[route]]
actor = "adam"
id = "eden_canvas_route"
method = "GET"
path = "/eden-canvas"
serves = "edenCanvasView"
handler = "page.edenCanvas"
params = { neighborhood = "eden.neighborhood.home" }

[[serve]]
actor = "adam"
serverRunner = "demo_server"
route = "eden_canvas_route"

[[route]]
actor = "adam"
id = "eden_personal_box_read_route"
method = "GET"
path = "/api/eden/personal-box"
serves = "edenPersonalBox"
handler = "edenPersonalBox.read"
