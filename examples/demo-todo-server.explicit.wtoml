# Witness-world demo todo server definition.
# The UI is composed from primitive widgets; composites are just witnessed attachment trees.

[[todoServer]]
actor = "adam"
id = "demo_todo_server"
backendHost = "backendHost"
frontendHost = "frontendHost"
rootWidget = "todo_app_widget"
frontendProgram = "todo_frontend_program"
storeName = "witness-world-demo-todos.json"
actors = [{ id = "aaron", label = "Aaron" }, { id = "callan", label = "Callan" }]

[[widget]]
actor = "adam"
id = "todo_app_widget"
kind = "Page"
props = { title = "Witness Todo" }

# Session panel = Box + Text + Form + Select + Buttons + Status Text
[[widget]]
actor = "adam"
id = "todo_session"
kind = "Box"
props = { class = "session-panel", role = "session-panel" }

[[widget]]
actor = "adam"
id = "todo_session_title"
kind = "Text"
props = { text = "Personal Projection" }

[[widget]]
actor = "adam"
id = "todo_session_form"
kind = "Form"
props = { role = "login-form" }

[[widget]]
actor = "adam"
id = "todo_actor_select"
kind = "Select"
props = { name = "actor", role = "actor-select" }

[[widget]]
actor = "adam"
id = "todo_open_button"
kind = "Button"
props = { text = "Open", type = "submit" }

[[widget]]
actor = "adam"
id = "todo_logout_button"
kind = "Button"
props = { text = "Logout", type = "button", action = "logout" }

[[widget]]
actor = "adam"
id = "todo_session_status"
kind = "Text"
props = { text = "", role = "session-status" }

[[widget]]
actor = "adam"
id = "todo_title"
kind = "Heading"
props = { text = "Witness Todo", level = 1 }

# Todo form = Form + Input + Button
[[widget]]
actor = "adam"
id = "todo_form"
kind = "Form"
props = { role = "todo-form" }

[[widget]]
actor = "adam"
id = "todo_input"
kind = "Input"
props = { name = "title", placeholder = "New todo" }

[[widget]]
actor = "adam"
id = "todo_add_button"
kind = "Button"
props = { text = "Add", type = "submit" }

[[widget]]
actor = "adam"
id = "todo_status"
kind = "Text"
props = { text = "", class = "status" }

[[widget]]
actor = "adam"
id = "todo_list"
kind = "List"
props = { role = "todo-list" }

# Private notes = Box + Heading + Form + Input + Button + List host
[[widget]]
actor = "adam"
id = "todo_private_notes"
kind = "Box"
props = { class = "private-notes", role = "private-notes" }

[[widget]]
actor = "adam"
id = "todo_private_notes_title"
kind = "Heading"
props = { text = "Private Notes", level = 2 }

[[widget]]
actor = "adam"
id = "todo_private_notes_form"
kind = "Form"
props = { role = "private-note-form" }

[[widget]]
actor = "adam"
id = "todo_private_note_input"
kind = "Input"
props = { name = "text", placeholder = "Only your perspective can see this" }

[[widget]]
actor = "adam"
id = "todo_private_note_button"
kind = "Button"
props = { text = "Save note", type = "submit" }

[[widget]]
actor = "adam"
id = "todo_private_note_list"
kind = "Box"
props = { class = "private-note-list", role = "private-note-list" }

# Witness inspector = Box + Heading + List host
[[widget]]
actor = "adam"
id = "todo_witnesses"
kind = "Box"
props = { class = "witness-inspector", role = "witness-inspector" }

[[widget]]
actor = "adam"
id = "todo_witnesses_title"
kind = "Heading"
props = { text = "Witness Inspector", level = 2 }

[[widget]]
actor = "adam"
id = "todo_witness_list"
kind = "Box"
props = { class = "witness-list", role = "witness-list" }

# Widget editor = Box + Heading + Form + inputs + select + button
[[widget]]
actor = "adam"
id = "todo_widget_editor"
kind = "Box"
props = { class = "widget-editor", role = "widget-editor" }

[[widget]]
actor = "adam"
id = "todo_widget_editor_title"
kind = "Heading"
props = { text = "Widget Editor", level = 2 }

[[widget]]
actor = "adam"
id = "todo_widget_editor_form"
kind = "Form"
props = { role = "widget-editor-form" }

[[widget]]
actor = "adam"
id = "todo_widget_kind"
kind = "Input"
props = { name = "kind", placeholder = "Widget kind, e.g. Text or Heading" }

[[widget]]
actor = "adam"
id = "todo_widget_text"
kind = "Input"
props = { name = "text", placeholder = "Widget text" }

[[widget]]
actor = "adam"
id = "todo_widget_parent"
kind = "Input"
props = { name = "parent", placeholder = "Parent widget id, blank = root" }

[[widget]]
actor = "adam"
id = "todo_widget_editor_button"
kind = "Button"
props = { text = "Add widget", type = "submit" }

# Attach root children
[[attachWidget]]
actor = "adam"
parent = "todo_app_widget"
child = "todo_session"
order = 0

[[attachWidget]]
actor = "adam"
parent = "todo_app_widget"
child = "todo_title"
order = 1

[[attachWidget]]
actor = "adam"
parent = "todo_app_widget"
child = "todo_form"
order = 2

[[attachWidget]]
actor = "adam"
parent = "todo_app_widget"
child = "todo_status"
order = 3

[[attachWidget]]
actor = "adam"
parent = "todo_app_widget"
child = "todo_list"
order = 4

[[attachWidget]]
actor = "adam"
parent = "todo_app_widget"
child = "todo_private_notes"
order = 5

[[attachWidget]]
actor = "adam"
parent = "todo_app_widget"
child = "todo_widget_editor"
order = 6

[[attachWidget]]
actor = "adam"
parent = "todo_app_widget"
child = "todo_witnesses"
order = 7

# Attach composites
[[attachWidget]]
actor = "adam"
parent = "todo_session"
child = "todo_session_title"
order = 0
[[attachWidget]]
actor = "adam"
parent = "todo_session"
child = "todo_session_form"
order = 1
[[attachWidget]]
actor = "adam"
parent = "todo_session"
child = "todo_session_status"
order = 2
[[attachWidget]]
actor = "adam"
parent = "todo_session_form"
child = "todo_actor_select"
order = 0
[[attachWidget]]
actor = "adam"
parent = "todo_session_form"
child = "todo_open_button"
order = 1
[[attachWidget]]
actor = "adam"
parent = "todo_session_form"
child = "todo_logout_button"
order = 2

[[attachWidget]]
actor = "adam"
parent = "todo_form"
child = "todo_input"
order = 0
[[attachWidget]]
actor = "adam"
parent = "todo_form"
child = "todo_add_button"
order = 1

[[attachWidget]]
actor = "adam"
parent = "todo_private_notes"
child = "todo_private_notes_title"
order = 0
[[attachWidget]]
actor = "adam"
parent = "todo_private_notes"
child = "todo_private_notes_form"
order = 1
[[attachWidget]]
actor = "adam"
parent = "todo_private_notes"
child = "todo_private_note_list"
order = 2
[[attachWidget]]
actor = "adam"
parent = "todo_private_notes_form"
child = "todo_private_note_input"
order = 0
[[attachWidget]]
actor = "adam"
parent = "todo_private_notes_form"
child = "todo_private_note_button"
order = 1

[[attachWidget]]
actor = "adam"
parent = "todo_witnesses"
child = "todo_witnesses_title"
order = 0
[[attachWidget]]
actor = "adam"
parent = "todo_witnesses"
child = "todo_witness_list"
order = 1

[[attachWidget]]
actor = "adam"
parent = "todo_widget_editor"
child = "todo_widget_editor_title"
order = 0
[[attachWidget]]
actor = "adam"
parent = "todo_widget_editor"
child = "todo_widget_editor_form"
order = 1
[[attachWidget]]
actor = "adam"
parent = "todo_widget_editor_form"
child = "todo_widget_kind"
order = 0
[[attachWidget]]
actor = "adam"
parent = "todo_widget_editor_form"
child = "todo_widget_text"
order = 1
[[attachWidget]]
actor = "adam"
parent = "todo_widget_editor_form"
child = "todo_widget_parent"
order = 2
[[attachWidget]]
actor = "adam"
parent = "todo_widget_editor_form"
child = "todo_widget_editor_button"
order = 3

[[frontendProgram]]
actor = "adam"
id = "todo_frontend_program"
rootWidget = "todo_app_widget"

[[frontendStep]]
actor = "adam"
program = "todo_frontend_program"
event = "load"
order = 0
op = "initSession"
params = {}

[[frontendStep]]
actor = "adam"
program = "todo_frontend_program"
event = "load"
order = 1
op = "renderSession"
params = { widget = "todo_session" }

[[frontendStep]]
actor = "adam"
program = "todo_frontend_program"
event = "load"
order = 2
op = "setText"
params = { widget = "todo_status", text = "Loading..." }

[[frontendStep]]
actor = "adam"
program = "todo_frontend_program"
event = "load"
order = 3
op = "fetchJson"
params = { url = "/api/todos", into = "todoResponse" }

[[frontendStep]]
actor = "adam"
program = "todo_frontend_program"
event = "load"
order = 4
op = "renderList"
params = { widget = "todo_list", from = "todoResponse.todos", itemTextPath = "title" }

[[frontendStep]]
actor = "adam"
program = "todo_frontend_program"
event = "load"
order = 5
op = "fetchJson"
params = { url = "/api/witnesses", into = "witnessResponse" }

[[frontendStep]]
actor = "adam"
program = "todo_frontend_program"
event = "load"
order = 6
op = "renderWitnesses"
params = { widget = "todo_witnesses", from = "witnessResponse.witnesses" }

[[frontendStep]]
actor = "adam"
program = "todo_frontend_program"
event = "load"
order = 7
op = "fetchJson"
params = { url = "/api/private-notes", into = "privateNotesResponse" }

[[frontendStep]]
actor = "adam"
program = "todo_frontend_program"
event = "load"
order = 8
op = "renderPrivateNotes"
params = { widget = "todo_private_notes", from = "privateNotesResponse.notes" }

[[frontendStep]]
actor = "adam"
program = "todo_frontend_program"
event = "load"
order = 9
op = "setText"
params = { widget = "todo_status", text = "Ready" }

[[frontendStep]]
actor = "adam"
program = "todo_frontend_program"
event = "submit:todo_form"
order = 0
op = "readForm"
params = { widget = "todo_form", into = "draftTodo" }
[[frontendStep]]
actor = "adam"
program = "todo_frontend_program"
event = "submit:todo_form"
order = 1
op = "setText"
params = { widget = "todo_status", text = "Saving..." }
[[frontendStep]]
actor = "adam"
program = "todo_frontend_program"
event = "submit:todo_form"
order = 2
op = "postJson"
params = { url = "/api/todos", method = "POST", from = "draftTodo", pick = ["title"], into = "createdTodo" }
[[frontendStep]]
actor = "adam"
program = "todo_frontend_program"
event = "submit:todo_form"
order = 3
op = "clearForm"
params = { widget = "todo_form" }
[[frontendStep]]
actor = "adam"
program = "todo_frontend_program"
event = "submit:todo_form"
order = 4
op = "run"
params = { event = "load" }

[[frontendStep]]
actor = "adam"
program = "todo_frontend_program"
event = "click:toggleTodo"
order = 0
op = "setText"
params = { widget = "todo_status", text = "Updating..." }
[[frontendStep]]
actor = "adam"
program = "todo_frontend_program"
event = "click:toggleTodo"
order = 1
op = "patchJson"
params = { url = "/api/todos/${event.id}", body = { done = "${event.done}" }, into = "updatedTodo" }
[[frontendStep]]
actor = "adam"
program = "todo_frontend_program"
event = "click:toggleTodo"
order = 2
op = "run"
params = { event = "load" }

[[frontendStep]]
actor = "adam"
program = "todo_frontend_program"
event = "click:deleteTodo"
order = 0
op = "setText"
params = { widget = "todo_status", text = "Deleting..." }
[[frontendStep]]
actor = "adam"
program = "todo_frontend_program"
event = "click:deleteTodo"
order = 1
op = "deleteJson"
params = { url = "/api/todos/${event.id}", into = "deletedTodo" }
[[frontendStep]]
actor = "adam"
program = "todo_frontend_program"
event = "click:deleteTodo"
order = 2
op = "run"
params = { event = "load" }

[[frontendStep]]
actor = "adam"
program = "todo_frontend_program"
event = "submit:todo_session_form"
order = 0
op = "readForm"
params = { widget = "todo_session_form", into = "sessionDraft" }
[[frontendStep]]
actor = "adam"
program = "todo_frontend_program"
event = "submit:todo_session_form"
order = 1
op = "setSession"
params = { from = "sessionDraft", path = "actor" }
[[frontendStep]]
actor = "adam"
program = "todo_frontend_program"
event = "submit:todo_session_form"
order = 2
op = "run"
params = { event = "load" }

[[frontendStep]]
actor = "adam"
program = "todo_frontend_program"
event = "click:logout"
order = 0
op = "logout"
params = {}
[[frontendStep]]
actor = "adam"
program = "todo_frontend_program"
event = "click:logout"
order = 1
op = "run"
params = { event = "load" }

[[frontendStep]]
actor = "adam"
program = "todo_frontend_program"
event = "submit:todo_private_notes_form"
order = 0
op = "readForm"
params = { widget = "todo_private_notes_form", into = "privateNoteDraft" }
[[frontendStep]]
actor = "adam"
program = "todo_frontend_program"
event = "submit:todo_private_notes_form"
order = 1
op = "postJson"
params = { url = "/api/private-notes", from = "privateNoteDraft", pick = ["text"], into = "privateNoteCreated" }
[[frontendStep]]
actor = "adam"
program = "todo_frontend_program"
event = "submit:todo_private_notes_form"
order = 2
op = "clearForm"
params = { widget = "todo_private_notes_form" }
[[frontendStep]]
actor = "adam"
program = "todo_frontend_program"
event = "submit:todo_private_notes_form"
order = 3
op = "run"
params = { event = "load" }

[[frontendStep]]
actor = "adam"
program = "todo_frontend_program"
event = "submit:todo_widget_editor_form"
order = 0
op = "readForm"
params = { widget = "todo_widget_editor_form", into = "widgetDraft" }
[[frontendStep]]
actor = "adam"
program = "todo_frontend_program"
event = "submit:todo_widget_editor_form"
order = 1
op = "postWidgetDefinition"
params = { from = "widgetDraft", into = "widgetCreated" }
[[frontendStep]]
actor = "adam"
program = "todo_frontend_program"
event = "submit:todo_widget_editor_form"
order = 2
op = "clearForm"
params = { widget = "todo_widget_editor_form" }
[[frontendStep]]
actor = "adam"
program = "todo_frontend_program"
event = "submit:todo_widget_editor_form"
order = 3
op = "run"
params = { event = "load" }

# Versioned widget playground. The stable soul is todo_versioned_banner; active version can change at runtime.
[[widgetVersion]]
actor = "adam"
soul = "todo_versioned_banner"
version = "todo_versioned_banner_v1"
kind = "Text"
index = 0
props = { text = "Versioned widget: v1", class = "versioned-banner" }

[[widgetVersion]]
actor = "adam"
soul = "todo_versioned_banner"
version = "todo_versioned_banner_v2"
kind = "Text"
index = 1
props = { text = "Versioned widget: v2", class = "versioned-banner" }

[[activateWidgetVersion]]
actor = "adam"
soul = "todo_versioned_banner"
version = "todo_versioned_banner_v1"

[[widget]]
actor = "adam"
id = "todo_version_playground"
kind = "Box"
props = { class = "version-playground" }

[[widget]]
actor = "adam"
id = "todo_version_title"
kind = "Heading"
props = { text = "Live Widget Versions", level = 2 }

[[widget]]
actor = "adam"
id = "todo_activate_v1"
kind = "Button"
props = { text = "Activate v1", type = "button", action = "activateWidgetVersion", eventSoul = "todo_versioned_banner", eventVersion = "todo_versioned_banner_v1" }

[[widget]]
actor = "adam"
id = "todo_activate_v2"
kind = "Button"
props = { text = "Activate v2", type = "button", action = "activateWidgetVersion", eventSoul = "todo_versioned_banner", eventVersion = "todo_versioned_banner_v2" }

[[attachWidget]]
actor = "adam"
parent = "todo_app_widget"
child = "todo_version_playground"
order = 8

[[attachWidget]]
actor = "adam"
parent = "todo_version_playground"
child = "todo_version_title"
order = 0

[[attachWidget]]
actor = "adam"
parent = "todo_version_playground"
child = "todo_versioned_banner"
order = 1

[[attachWidget]]
actor = "adam"
parent = "todo_version_playground"
child = "todo_activate_v1"
order = 2

[[attachWidget]]
actor = "adam"
parent = "todo_version_playground"
child = "todo_activate_v2"
order = 3

[[frontendStep]]
actor = "adam"
program = "todo_frontend_program"
event = "click:activateWidgetVersion"
order = 0
op = "setText"
params = { widget = "todo_status", text = "Activating widget version..." }

[[frontendStep]]
actor = "adam"
program = "todo_frontend_program"
event = "click:activateWidgetVersion"
order = 1
op = "activateWidgetVersion"
params = { soul = "${event.soul}", version = "${event.version}", into = "activatedWidgetVersion" }

[[frontendStep]]
actor = "adam"
program = "todo_frontend_program"
event = "click:activateWidgetVersion"
order = 2
op = "reloadPage"
params = {}
