# Backend server/runtime definition.

[[defaults]]
context = "backend"

[[serverRunner]]
id = "demo_server"
backendHost = "backendHost"
frontendHost = "frontendHost"
handlerSet = "demo"
storage = { todoProjection = "witness-world-demo-todos.json", privateNotesProjection = "witness-world-demo-todos.private-notes.json" }

[[route]]
id = "home_page_route"
method = "GET"
path = "/"
serves = "todoAppView"
handler = "page.home"
params = { rootWidget = "todo_app_widget", frontendProgram = "todo_frontend_program", page = "home", excludeWidgetRoles = ["world-graph-body"] }

[[serve]]
serverRunner = "demo_server"
route = "home_page_route"

[[route]]
id = "world_page_route"
method = "GET"
path = "/world"
serves = "worldGraphView"
handler = "page.world"
params = { rootWidget = "world_graph_page", frontendProgram = "world_graph_program", page = "world" }

[[serve]]
serverRunner = "demo_server"
route = "world_page_route"

[[route]]
id = "process_page_route"
method = "GET"
path = "/process"
serves = "processView"
handler = "page.process"

[[serve]]
serverRunner = "demo_server"
route = "process_page_route"

[[route]]
id = "canvas_page_route"
method = "GET"
path = "/canvas"
serves = "canvasView"
handler = "page.canvas"

[[serve]]
serverRunner = "demo_server"
route = "canvas_page_route"

[[route]]
id = "session_read_route"
method = "GET"
path = "/api/session"
serves = "session"
handler = "session.read"

[[serve]]
serverRunner = "demo_server"
route = "session_read_route"

[[route]]
id = "session_open_route"
method = "POST"
path = "/api/session"
serves = "session"
handler = "session.open"

[[serve]]
serverRunner = "demo_server"
route = "session_open_route"

[[route]]
id = "session_logout_route"
method = "DELETE"
path = "/api/session"
serves = "session"
handler = "session.logout"

[[serve]]
serverRunner = "demo_server"
route = "session_logout_route"

[[route]]
id = "todos_list_route"
method = "GET"
path = "/api/todos"
serves = "todoStore"
handler = "todos.list"

[[serve]]
serverRunner = "demo_server"
route = "todos_list_route"

[[route]]
id = "todos_create_route"
method = "POST"
path = "/api/todos"
serves = "todoStore"
handler = "todos.create"

[[serve]]
serverRunner = "demo_server"
route = "todos_create_route"

[[route]]
id = "todos_update_route"
method = "PATCH"
path = "/api/todos/:id"
serves = "todoStore"
handler = "todos.update"

[[serve]]
serverRunner = "demo_server"
route = "todos_update_route"

[[route]]
id = "todos_delete_route"
method = "DELETE"
path = "/api/todos/:id"
serves = "todoStore"
handler = "todos.delete"

[[serve]]
serverRunner = "demo_server"
route = "todos_delete_route"

[[route]]
id = "private_notes_list_route"
method = "GET"
path = "/api/private-notes"
serves = "privateNotes"
handler = "privateNotes.list"

[[serve]]
serverRunner = "demo_server"
route = "private_notes_list_route"

[[route]]
id = "private_notes_create_route"
method = "POST"
path = "/api/private-notes"
serves = "privateNotes"
handler = "privateNotes.create"

[[serve]]
serverRunner = "demo_server"
route = "private_notes_create_route"

[[route]]
id = "widgets_create_route"
method = "POST"
path = "/api/widgets"
serves = "widgetEditor"
handler = "widgets.create"
params = { rootWidget = "todo_app_widget" }

[[serve]]
serverRunner = "demo_server"
route = "widgets_create_route"

[[route]]
id = "widget_versions_activate_route"
method = "POST"
path = "/api/widget-versions/:soul/activate"
serves = "widgetVersion"
handler = "widgetVersions.activate"

[[serve]]
serverRunner = "demo_server"
route = "widget_versions_activate_route"

[[route]]
id = "widget_versions_rollback_route"
method = "POST"
path = "/api/widget-versions/:soul/rollback"
serves = "widgetVersion"
handler = "widgetVersions.rollback"

[[serve]]
serverRunner = "demo_server"
route = "widget_versions_rollback_route"

[[route]]
id = "network_simulate_route"
method = "GET"
path = "/api/simulate-network-error"
serves = "networkFailure"
handler = "network.simulateError"

[[serve]]
serverRunner = "demo_server"
route = "network_simulate_route"

[[route]]
id = "witnesses_list_route"
method = "GET"
path = "/api/witnesses"
serves = "witnessLog"
handler = "witnesses.list"

[[serve]]
serverRunner = "demo_server"
route = "witnesses_list_route"

[[route]]
id = "world_graph_read_route"
method = "GET"
path = "/api/world-graph"
serves = "worldGraph"
handler = "worldGraph.read"

[[serve]]
serverRunner = "demo_server"
route = "world_graph_read_route"

[[route]]
id = "process_view_read_route"
method = "GET"
path = "/api/process-view"
serves = "processView"
handler = "processView.read"

[[serve]]
serverRunner = "demo_server"
route = "process_view_read_route"

[[route]]
id = "process_run_read_route"
method = "GET"
path = "/api/process-runs/:runId"
serves = "processRun"
handler = "processRun.read"

[[serve]]
serverRunner = "demo_server"
route = "process_run_read_route"

[[route]]
id = "process_events_record_route"
method = "POST"
path = "/api/process-events"
serves = "processTrace"
handler = "processEvents.record"

[[serve]]
serverRunner = "demo_server"
route = "process_events_record_route"

[[route]]
id = "source_read_route"
method = "GET"
path = "/api/source"
serves = "sourceFile"
handler = "source.read"

[[serve]]
serverRunner = "demo_server"
route = "source_read_route"

[[route]]
id = "canvas_read_route"
method = "GET"
path = "/api/canvas"
serves = "canvasView"
handler = "canvas.read"

[[serve]]
serverRunner = "demo_server"
route = "canvas_read_route"

[[route]]
id = "canvas_perspectives_route"
method = "GET"
path = "/api/canvas/perspectives"
serves = "canvasView"
handler = "canvas.perspectives.list"

[[serve]]
serverRunner = "demo_server"
route = "canvas_perspectives_route"

[[route]]
id = "canvas_process_route"
method = "POST"
path = "/api/canvas/process"
serves = "canvasView"
handler = "canvas.process"

[[serve]]
serverRunner = "demo_server"
route = "canvas_process_route"
