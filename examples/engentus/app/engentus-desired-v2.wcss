lowering
  backend browser
    asset shell
      slice shell-base
        mode native-browser
        group foundation
        group toolbar
        group "shared views"
        group "chart scaffold"
        group "floating windows"
        group "controls and editor"
        seam "shared views"
        seam "controls and editor"
        family chrome.toolbar -> toolbar
        family interactive.toolbar_button -> "controls and editor"

      native shell-base
        rule identity ShellBaseGlobalReset
          box-sizing = border-box
          margin = 0
          padding = 0
        rule identity ShellBaseThemeRoot
          --dk = #2C3C63
          --mid = #344C6C
          --brd = #3D5880
          --brdl = #e2e8f0
          --t1 = #f1f5f9
          --t2 = #94a3b8
          --t3 = #475569
          --tdark = #1e293b
          --blue = #8CC4D4
          --blu2 = #5AAABF
          --bluf = #DCF0F5
          --red = #dc2626
          --grn = #16a34a
          --ylw = #EC7424
          --pur = #7c3aed
          --sw = 284px
          --th = 44px
          --sch = 50px
        rule identity ShellBaseDocumentBody
          font-family = -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif
          background = var(--dk)
          color = var(--t1)
          height = 100vh
          overflow = hidden
          display = flex
          flex-direction = column
          font-size = 12.5px
        rule identity ShellBaseLinkSurface
          color = inherit
          text-decoration = none
        rule identity ShellBaseToolbarBrandImage
          width = auto
          flex-shrink = 0
        rule identities EngentusHomeChrome EngentusAppChrome EngentusModuleChrome
          height = var(--th)
          background = var(--dk)
          border-bottom = 1px solid var(--brd)
          display = flex
          align-items = center
          flex-shrink = 0
          z-index = 50
        rule identities EngentusAppBrand EngentusHomeBrand
          padding = 0 14px
          min-width = var(--sw)
          border-right = 1px solid var(--brd)
          height = 100%
          display = flex
          align-items = center
          gap = 8px
          letter-spacing = -.02em
          transition = background .15s
          user-select = none
        rule identity ShellBaseToolbarBrandClickable
          cursor = pointer
        rule identity ShellBaseToolbarBrandClickableHover
          background = rgba(255,255,255,.05)
        rule identity EngentusToolbarBrandDivider
          width = 1px
          height = 24px
          background = var(--brd)
          flex-shrink = 0
        rule trait mode-pill
          display = flex
          background = var(--mid)
          border-radius = 6px
          padding = 2px
          margin = 0 12px
          gap = 2px
        rule trait mode-btn
          background = none
          border = none
          color = var(--t2)
          padding = 4px 14px
          border-radius = 4px
          cursor = pointer
          font-size = 12px
          font-weight = 500
          transition = all .15s
        rule identity ShellBaseModeButtonOn
          background = var(--blue)
          color = var(--dk)
        rule trait tbw
          background = none
          border = 1px solid transparent
          border-radius = 6px
          color = var(--t2)
          padding = 5px 10px
          cursor = pointer
          font-size = 12px
          font-weight = 500
          transition = all .15s
          display = flex
          align-items = center
          gap = 5px
        rule trait tbw pseudo hover
          border-color = var(--brd)
          color = var(--t1)
        rule identity ShellBaseToolbarWindowButtonOn
          background = var(--mid)
          border-color = var(--blue)
          color = var(--blue)
        rule identity EngentusProfileSummary
          display = flex
          align-items = center
          gap = 8px
          padding = 0 14px
          cursor = pointer
          border-left = 1px solid var(--brd)
          height = 100%
          flex-shrink = 0
          user-select = none
          transition = background .15s
          position = relative
        rule identity EngentusProfileSummary pseudo hover
          background = rgba(255,255,255,.04)
        rule identity EngentusProfileAvatar
          width = 28px
          height = 28px
          border-radius = 50%
          background = var(--blue)
          display = flex
          align-items = center
          justify-content = center
          font-size = 10px
          font-weight = 700
          color = var(--dk)
          flex-shrink = 0
        rule identity EngentusProfileInfo
          display = flex
          flex-direction = column
          gap = 1px
        rule identity EngentusProfileName
          font-size = 11.5px
          font-weight = 600
          color = var(--t1)
          line-height = 1.2
        rule identity EngentusProfileRole
          font-size = 9.5px
          color = var(--t2)
          line-height = 1.2
        rule identity EngentusProfileCaret
          font-size = 9px
          color = transparent
          margin-left = 2px
          position = relative
        rule identity EngentusProfileCaret pseudo before
          content = "\25BE"
          color = var(--t2)
          position = absolute
          inset = 0
        rule identity EngentusProfileMenu
          position = absolute
          top = calc(100% + 2px)
          right = 0
          background = var(--mid)
          border = 1px solid var(--brd)
          border-radius = 8px
          min-width = 170px
          z-index = 200
          box-shadow = 0 8px 24px rgba(0,0,0,.3)
          padding = 4px
          display = none
        rule identity EngentusProfileMenu variant open
          display = block
        rule trait up-mi
          display = flex
          align-items = center
          gap = 8px
          padding = 7px 10px
          border-radius = 5px
          font-size = 12px
          color = var(--t1)
          cursor = pointer
          transition = background .1s
        rule trait up-mi pseudo hover
          background = rgba(255,255,255,.07)
        rule trait up-mi-icon
          font-size = 13px
          width = 16px
          text-align = center
          flex-shrink = 0
          color = var(--t2)
        rule trait up-sep
          height = 1px
          background = var(--brd)
          margin = 3px 0
        rule trait up-mi-signout
          color = #f87171
        rule identity ShellBaseSharedRouteViews
          flex = 1
          display = flex
          flex-direction = column
          overflow = hidden
        rule identity ShellBaseSharedBodies
          flex = 1
          display = flex
          overflow = hidden
        rule identity ShellBaseSharedSidebars
          width = var(--sw)
          background = var(--mid)
          border-right = 1px solid var(--brd)
          display = flex
          flex-direction = column
          overflow = hidden
        rule identity ShellBaseSharedFixedSidebars
          min-width = var(--sw)
        rule identity ShellBaseSharedSidebarScrollRegion
          flex = 1
          overflow-y = auto
          overflow-x = hidden
        rule identity ShellBaseSharedSidebarScrollbar
          width = 4px
        rule identity ShellBaseSharedSidebarScrollbarThumb
          background = var(--brd)
          border-radius = 2px
        rule trait ssec
          padding = 10px 12px
          border-bottom = 1px solid var(--brd)
        rule traits ssec-title metric-group-title
          font-size = 9.5px
          font-weight = 700
          text-transform = uppercase
          letter-spacing = .08em
          color = var(--t2)
          margin-bottom = 8px
          display = flex
          align-items = center
          justify-content = space-between
        rule trait ssec-title tag button
          background = none
          border = none
          color = var(--blue)
          cursor = pointer
          font-size = 11px
          font-weight = 600
          padding = 0
        rule trait ssec-title tag button pseudo hover
          color = var(--blu2)
        rule traits sidebar-list metric-list
          list-style = none
          display = grid
          gap = 7px
          line-height = 1.42
          font-size = 11px
        rule trait sidebar-note
          font-size = 9.5px
          color = var(--t2)
          margin-top = 6px
        rule identity ShellBaseMillViewer
          flex = 1
          display = flex
          overflow = hidden
          background = var(--dk)
        rule identity ShellBaseMillForceChartArea
          flex = 1
          display = flex
          flex-direction = column
          background = var(--dk)
          overflow = hidden
        rule identity ShellBaseMillForceChartFrame
          position = absolute
          inset = 0
          width = 100%
          height = 100%
          border = 0
          display = block
        rule identity ShellBaseChartOverlayCanvas
          pointer-events = none
        rule trait fw
          position = absolute
          pointer-events = all
          background = #fff
          border-radius = 10px
          box-shadow = 0 8px 32px rgba(0,0,0,.22), 0 0 0 1px rgba(0,0,0,.07)
          display = flex
          flex-direction = column
          overflow = hidden
          min-width = 300px
          min-height = 140px
        rule trait fw-tb
          background = var(--dk)
          padding = 7px 9px
          display = flex
          align-items = center
          gap = 7px
          cursor = grab
          flex-shrink = 0
          border-radius = 10px 10px 0 0
          user-select = none
        rule trait fw-tb pseudo active
          cursor = grabbing
        rule trait fw-title
          flex = 1
          font-size = 12px
          font-weight = 600
          color = var(--t1)
        rule trait fw-btn
          width = 18px
          height = 18px
          border-radius = 3px
          border = none
          background = rgba(255,255,255,.1)
          color = var(--t2)
          cursor = pointer
          font-size = 10px
          display = flex
          align-items = center
          justify-content = center
          transition = background .1s
        rule trait fw-btn pseudo hover
          background = rgba(255,255,255,.2)
          color = var(--t1)
        rule trait fw-body
          flex = 1
          overflow = auto
          position = relative
        rule trait fw-rz
          position = absolute
          right = 0
          bottom = 0
          width = 16px
          height = 16px
          cursor = nwse-resize
          background = linear-gradient(135deg, transparent 50%, #e2e8f0 50%)
        rule trait stbl
          width = 100%
          border-collapse = collapse
          font-size = 11.5px
        rule trait stbl tag th
          background = #f8fafc
          color = #475569
          font-weight = 600
          padding = 6px 8px
          text-align = left
          border-bottom = 1px solid var(--brdl)
          font-size = 10px
          text-transform = uppercase
          letter-spacing = .04em
        rule trait stbl tag td
          padding = 5px 8px
          border-bottom = 1px solid #f1f5f9
          color = #1e293b
        rule trait stbl tag tr pseudo last-child tag td
          border-bottom = none
        rule trait num
          font-variant-numeric = tabular-nums
          text-align = right
        rule trait sc-dot
          display = inline-block
          width = 8px
          height = 8px
          border-radius = 50%
          margin-right = 5px
        rule trait anova-meta
          display = flex
          gap = 12px
          flex-wrap = wrap
          padding = 10px 12px
          background = #f8fafc
          border-bottom = 1px solid var(--brdl)
        rule trait anova-kv
          display = flex
          flex-direction = column
          gap = 2px
        rule trait anova-k
          font-size = 9.5px
          text-transform = uppercase
          letter-spacing = .05em
          color = #64748b
          font-weight = 600
        rule trait anova-v
          font-size = 16px
          font-weight = 700
          color = #0f172a
          font-variant-numeric = tabular-nums
        rule trait anova-sig
          font-size = 10px
          padding = 2px 7px
          border-radius = 3px
          font-weight = 600
          align-self = center
        rule trait anova-note
          font-size = 10.5px
          color = #64748b
          padding = 6px 12px
          border-bottom = 1px solid var(--brdl)
        rule trait leg-row
          display = flex
          align-items = center
          gap = 6px
          margin-bottom = 4px
        rule trait leg-row tag span
          font-size = 10.5px
          color = var(--t2)
        rule trait leg-sw
          width = 13px
          height = 13px
          border-radius = 3px
          flex-shrink = 0
          opacity = .85
        rule trait info-box
          background = rgba(0,0,0,.2)
          border-radius = 5px
          padding = 8px 10px
          margin-top = 4px
        rule trait info-row
          display = flex
          justify-content = space-between
          font-size = 11px
          color = var(--t2)
          margin-bottom = 3px
        rule trait info-row pseudo last-child
          margin-bottom = 0
        rule trait info-value
          color = var(--blue)
          font-size = 12px
          font-weight = 600
          font-variant-numeric = tabular-nums
        rule trait mc-row
          display = flex
          justify-content = space-between
          align-items = center
          padding = 6px 0
          font-size = 11px
        rule trait mc-row tag label
          color = var(--t2)
        rule identity ShellBaseMonteCarloNumberInput
          width = 70px
          background = var(--dk)
          color = var(--t1)
          border = 1px solid var(--brd)
          border-radius = 3px
          padding = 3px 5px
          font-size = 11px
          text-align = right
        rule trait run-row
          display = flex
          gap = 5px
          margin-top = 8px
        rule trait rbtn
          flex = 1
          padding = 7px
          border-radius = 5px
          border = none
          cursor = pointer
          font-size = 11.5px
          font-weight = 600
          transition = all .15s
        rule identity ShellBaseRunButtonGo
          background = var(--grn)
          color = #fff
        rule identity ShellBaseRunButtonGo pseudo hover
          background = #15803d
        rule identity ShellBaseRunButtonGoDisabled
          opacity = .4
          cursor = not-allowed
        rule identity ShellBaseRunButtonPause
          background = var(--ylw)
          color = #fff
        rule identity ShellBaseRunButtonStop
          background = #dc2626
          color = #fff
        rule identity ShellBaseRunButtonDisabled
          opacity = .4
          cursor = not-allowed
        rule trait prog-wrap
          height = 4px
          margin = 7px 0 16px
          position = relative
          background = var(--brd)
          border-radius = 2px
          overflow = visible
        rule trait prog-fill
          position = absolute
          left = 0
          top = 0
          bottom = 0
          width = 0
          background = var(--blue)
          transition = width .2s, opacity .15s
        rule identities ShellBaseProgressFillReady ShellBaseProgressFillRunning
          width = 0
          background = var(--blue)
          opacity = 1
        rule identity ShellBaseProgressFillPaused
          width = 0
          background = var(--blue)
          opacity = .4
        rule identity ShellBaseProgressFillDone
          width = 100%
          background = var(--grn)
          opacity = 1
        rule identity ShellBaseProgressFillStopped
          width = 0
          background = var(--ylw)
          opacity = 1
        rule trait prog-lbl
          display = block
          margin-top = 3px
          font-size = 10px
          color = var(--t2)
          font-variant-numeric = tabular-nums
          text-align = right
        rule trait save-sim-btn
          width = 100%
          margin-top = 10px
          padding = 6px 0
          background = var(--blue)
          color = var(--dk)
          border = none
          border-radius = 6px
          font-size = 11.5px
          font-weight = 600

      slice auth
        mode native-browser
        group auth
        seam auth
        family auth.button.primary -> auth
        family auth.button.microsoft -> auth
        family auth.field -> auth

      native auth
        rule trait surface-auth-view
          flex = 1
          min-height = 100vh
        rule identity EngentusLogin
          perspective = 2200px
          perspective-origin = 50% 50%
        rule identity EngentusSignout
          perspective = 2200px
          perspective-origin = 50% 50%
        rule trait auth-book
          width = 100%
          height = 100%
          display = flex
          flex-shrink = 0
          position = relative
          transform-origin = right center
          transition = transform 0.9s cubic-bezier(0.77, 0, 0.175, 1)
          backface-visibility = hidden
          will-change = transform
        rule trait auth-book pseudo after
          content = ""
          position = absolute
          inset = 0
          background = linear-gradient(to left, rgba(0,0,0,.6) 0%, rgba(0,0,0,.15) 18%, transparent 45%)
          pointer-events = none
          opacity = 0
          transition = opacity 0.9s cubic-bezier(0.77, 0, 0.175, 1)
        rule trait auth-book variant folding pseudo after
          opacity = 1
        rule trait auth-book variant folding
          transform = rotateY(-90deg)
        rule trait auth-book variant incoming
          transform = rotateY(90deg)
          animation = authBookIncoming 0.9s cubic-bezier(0.77, 0, 0.175, 1) forwards
        keyframes authBookIncoming
          step to
            transform = rotateY(0deg)
        keyframes authSpin
          step to
            transform = rotate(360deg)
        rule identity EngentusSignout trait auth-book
          transform-origin = left center
        rule identity EngentusSignout trait auth-book pseudo after
          background = linear-gradient(to right, rgba(0,0,0,.6) 0%, rgba(0,0,0,.15) 18%, transparent 45%)
        rule trait auth-left
          flex = 0 0 55%
          background = linear-gradient(160deg, rgba(12,20,42,0.91) 0%, rgba(36,54,90,0.86) 55%, rgba(18,28,55,0.93) 100%), url(/app-static/img/main.png) center / cover no-repeat
          display = flex
          flex-direction = column
          padding = 32px 40px
          position = relative
          overflow = hidden
        rule trait auth-left pseudo before
          content = ""
          position = absolute
          inset = 0
          background-image = linear-gradient(rgba(140,196,212,.035) 1px, transparent 1px), linear-gradient(90deg, rgba(140,196,212,.035) 1px, transparent 1px)
          background-size = 44px 44px
          pointer-events = none
        rule trait auth-right
          flex = 1
          background = #f8fafc
          display = flex
          align-items = center
          justify-content = center
          padding = 40px 36px
        rule trait auth-brand
          display = flex
          align-items = center
          gap = 10px
          position = relative
          z-index = 1
        rule trait auth-brand-div
          width = 1px
          height = 20px
          background = rgba(140,196,212,.35)
        rule trait auth-hero
          flex = 1
          display = flex
          flex-direction = column
          justify-content = center
          position = relative
          z-index = 1
          padding = 0 8px
        rule traits auth-hero auth-form-logo tag img
          align-self = flex-start
        rule trait auth-tagline
          font-size = 28px
          font-weight = 700
          color = var(--t1)
          line-height = 1.22
          margin-bottom = 14px
          letter-spacing = -.025em
        rule trait auth-tagline tag em
          color = var(--blue)
          font-style = normal
        rule trait auth-sub
          font-size = 13px
          color = rgba(148,163,184,.85)
          line-height = 1.65
          margin-bottom = 34px
          max-width = 380px
        rule trait auth-bullets
          list-style = none
          display = flex
          flex-direction = column
          gap = 12px
        rule trait auth-bullet
          display = flex
          align-items = center
          gap = 11px
          font-size = 12.5px
          color = rgba(241,245,249,.78)
        rule trait auth-bullet-dot
          width = 6px
          height = 6px
          border-radius = 50%
          background = var(--blue)
          flex-shrink = 0
          box-shadow = 0 0 0 3px rgba(140,196,212,.18)
        rule trait auth-footer
          font-size = 10px
          color = rgba(148,163,184,.45)
          position = relative
          z-index = 1
        rule trait auth-form-wrap
          width = 100%
          max-width = 372px
        rule trait auth-form-logo
          margin-bottom = 26px
        rule traits auth-form-title auth-so-title
          font-size = 22px
          font-weight = 700
          color = #0f172a
          margin-bottom = 5px
          letter-spacing = -.025em
        rule traits auth-form-sub auth-so-sub
          font-size = 12px
          color = #64748b
          margin-bottom = 26px
        rule trait ms-btn
          width = 100%
          display = flex
          align-items = center
          justify-content = center
          gap = 11px
          padding = 12px 18px
          background = #2f2f2f
          color = #fff
          border = none
          border-radius = 6px
          font-size = 13.5px
          font-weight = 500
          cursor = pointer
          transition = background .15s
          letter-spacing = .01em
          margin-bottom = 20px
          font-family = inherit
        rule trait ms-btn pseudo hover
          background = #1a1a1a
        rule trait ms-btn variant pending
          pointer-events = none
          opacity = 0.92
        rule trait ms-btn variant pending tag svg
          display = none
        rule trait ms-btn variant pending pseudo before
          content = ""
          display = inline-block
          width = 13px
          height = 13px
          border = 2px solid rgba(255,255,255,.28)
          border-top-color = rgba(255,255,255,.9)
          border-radius = 50%
          animation = authSpin 0.65s linear infinite
          vertical-align = -2px
          margin-right = 5px
          flex-shrink = 0
        rule trait auth-divider
          display = flex
          align-items = center
          gap = 12px
          margin-bottom = 20px
        rule trait auth-divider-line
          flex = 1
          height = 1px
          background = #e2e8f0
        rule trait auth-divider-text
          font-size = 11px
          color = #94a3b8
          white-space = nowrap
        rule trait auth-field
          margin-bottom = 14px
        rule trait auth-field tag label
          display = block
          font-size = 11.5px
          font-weight = 600
          color = #374151
          margin-bottom = 5px
        rule trait auth-input
          width = 100%
          padding = 10px 12px
          border = 1px solid #d1d5db
          border-radius = 6px
          font-size = 13px
          color = #0f172a
          background = #fff
          transition = border-color .15s, box-shadow .15s
          outline = none
          font-family = inherit
        rule trait auth-input pseudo focus
          border-color = var(--blue)
          box-shadow = 0 0 0 3px rgba(140,196,212,.2)
        rule trait auth-pw-wrap
          position = relative
        rule trait auth-pw-toggle
          position = absolute
          right = 10px
          top = 50%
          transform = translateY(-50%)
          background = none
          border = none
          cursor = pointer
          color = #94a3b8
          font-size = 14px
          padding = 2px
          line-height = 1
        rule trait auth-pw-toggle pseudo hover
          color = #475569
        rule trait auth-forgot
          text-align = right
          margin-top = -8px
          margin-bottom = 20px
        rule trait auth-forgot tag a
          font-size = 11px
          color = var(--blu2)
          text-decoration = none
        rule trait auth-forgot tag a pseudo hover
          text-decoration = underline
        rule trait auth-submit
          width = 100%
          display = inline-block
          align-items = center
          justify-content = center
          gap = 11px
          padding = 11.5px
          background = var(--dk)
          color = #fff
          border = none
          border-radius = 6px
          font-size = 13.5px
          font-weight = 600
          cursor = pointer
          transition = background .15s
          letter-spacing = .015em
          font-family = inherit
        rule trait auth-submit pseudo hover
          background = #1e2f52
        rule trait auth-form-footer
          margin-top = 22px
          font-size = 10.5px
          color = #94a3b8
          text-align = center
          line-height = 1.65
        rule trait auth-form-footer tag a
          color = var(--blu2)
          text-decoration = none
        rule trait auth-form-footer tag a pseudo hover
          text-decoration = underline
        rule trait auth-so-title
          font-size = 21px
          font-weight = 700
          color = #0f172a
          margin-bottom = 9px
          letter-spacing = -.025em
          text-align = center
        rule trait auth-so-sub
          font-size = 12.5px
          color = #64748b
          text-align = center
          margin-bottom = 28px
          line-height = 1.55
        media "(max-width: 980px)"
          rule trait auth-book
            flex-direction = column
          rule traits auth-left auth-right
            flex = none

      slice home
        mode native-browser
        group home
        seam home
        family chrome.sidebar -> home
        family surface.module_card -> home
        family surface.news_item -> home

      native home
        rule identity EngentusHome
          flex = 1
          display = flex
          flex-direction = column
          overflow = hidden
        rule identity NewsPanel
          width = var(--sw)
          min-width = var(--sw)
          background = var(--mid)
          border-right = 1px solid var(--brd)
          display = flex
          flex-direction = column
          overflow = hidden
        rule trait news-hdr
          padding = 11px 13px
          border-bottom = 1px solid var(--brd)
          font-size = 9.5px
          font-weight = 700
          text-transform = uppercase
          letter-spacing = .08em
          color = var(--t2)
          display = flex
          align-items = center
          justify-content = space-between
        rule trait news-live
          display = flex
          align-items = center
          gap = 5px
          font-size = 9px
          color = #4ade80
          font-weight = 600
        rule trait news-live-dot
          width = 5px
          height = 5px
          border-radius = 50%
          background = #4ade80
          animation = livepulse 2s infinite
        keyframes livepulse
          step "0%, 100%"
            opacity = 1
          step "50%"
            opacity = .3
        rule trait news-list
          flex = 1
          overflow-y = auto
          overflow-x = hidden
          padding = 8px
        rule trait news-list pseudo -webkit-scrollbar
          width = 4px
        rule trait news-list pseudo -webkit-scrollbar-thumb
          background = var(--brd)
          border-radius = 2px
        rule trait news-item
          background = rgba(0,0,0,.18)
          border-radius = 6px
          padding = 9px 10px
          margin-bottom = 7px
          border-left = 3px solid transparent
          cursor = pointer
          transition = background .12s
        rule trait news-item pseudo hover
          background = rgba(0,0,0,.3)
        rule trait news-item variant ni-alert
          border-left-color = var(--ylw)
        rule trait news-item variant ni-product
          border-left-color = #4ade80
        rule trait news-item variant ni-industry
          border-left-color = #a78bfa
        rule trait news-item variant ni-platform
          border-left-color = var(--blue)
        rule trait ni-cat
          font-size = 8.5px
          font-weight = 700
          text-transform = uppercase
          letter-spacing = .05em
          margin-bottom = 3px
        rule trait news-item variant ni-alert trait ni-cat
          color = var(--ylw)
        rule trait news-item variant ni-product trait ni-cat
          color = #4ade80
        rule trait news-item variant ni-industry trait ni-cat
          color = #a78bfa
        rule trait news-item variant ni-platform trait ni-cat
          color = var(--blue)
        rule trait ni-title
          font-size = 11.5px
          color = var(--t1)
          line-height = 1.38
          margin-bottom = 4px
        rule trait ni-time
          font-size = 9.5px
          color = var(--t2)
        rule identity EngentusHomeMain
          flex = 1
          overflow-y = auto
          padding = 22px 24px
        rule identity EngentusHomeMain pseudo -webkit-scrollbar
          width = 5px
        rule identity EngentusHomeMain pseudo -webkit-scrollbar-thumb
          background = var(--brd)
          border-radius = 3px
        rule trait mod-area-hdr
          margin-bottom = 18px
        rule trait mod-area-hdr tag h2
          font-size = 15px
          font-weight = 700
          color = var(--t1)
          margin-bottom = 5px
        rule trait mod-area-meta
          display = flex
          align-items = center
          gap = 10px
        rule trait mod-area-meta tag p
          font-size = 11px
          color = var(--t2)
        rule trait mill-pill
          display = inline-flex
          align-items = center
          gap = 5px
          background = rgba(140,196,212,.1)
          border = 1px solid rgba(140,196,212,.22)
          border-radius = 4px
          padding = 2px 9px
          font-size = 10px
          color = var(--blue)
          font-weight = 600
        rule identity ModuleGrid
          display = grid
          grid-template-columns = repeat(4, 1fr)
          gap = 12px
        rule trait mod-card
          background = var(--mid)
          border = 1px solid var(--brd)
          border-radius = 10px
          padding = 16px 14px 13px
          display = flex
          flex-direction = column
          align-items = center
          gap = 7px
          text-align = center
          transition = all .18s
          position = relative
          min-height = 148px
        rule trait mod-card variant active
          border-color = rgba(140,196,212,.45)
          cursor = pointer
          background = rgba(140,196,212,.06)
        rule trait mod-card variant active pseudo hover
          background = rgba(140,196,212,.13)
          border-color = var(--blue)
          transform = translateY(-2px)
          box-shadow = 0 6px 20px rgba(0,0,0,.25)
        rule trait mod-card variant locked
          opacity = .35
        rule trait mod-icon
          width = 64px
          height = 50px
          border-radius = 6px
          overflow = hidden
          flex-shrink = 0
        rule trait mod-icon tag svg
          width = 100%
          height = 100%
          display = block
        rule trait mod-name
          font-size = 11.5px
          font-weight = 600
          color = var(--t1)
          line-height = 1.3
        rule trait mod-desc
          font-size = 9.5px
          color = var(--t2)
          line-height = 1.4
        rule trait mod-lock
          position = absolute
          top = 9px
          right = 9px
          font-size = 10px
          color = var(--t2)
          opacity = .55
        rule trait mod-status
          font-size = 8.5px
          padding = 2px 8px
          border-radius = 3px
          font-weight = 600
          margin-top = auto
        rule trait mod-status variant ms-open
          background = rgba(140,196,212,.18)
          color = var(--blue)
        rule trait mod-status variant ms-soon
          background = rgba(255,255,255,.05)
          color = var(--t2)
        media "(max-width: 980px)"
          rule identities EngentusHome EngentusHomeBody
            flex-direction = column
          rule identity NewsPanel
            width = auto
            min-width = 0
          rule identity ModuleGrid
            grid-template-columns = 1fr

      slice goodman
        mode native-browser
        group "goodman toolbar"
        group "goodman view"
        group "goodman chart scaffold"
        group "goodman windows"
        seam "goodman view"
        family chrome.sidebar -> "goodman toolbar"
        family chrome.section -> "goodman view"
        family goodman.simulation_row -> "goodman view"
        family goodman.status_badge -> "goodman view"
        family goodman.bolt_set_card -> "goodman view"
        family surface.editor_group -> "goodman view"
        family surface.chart_stage -> "goodman chart scaffold"
        family surface.window -> "goodman windows"
        family chart.page_tooltip -> "goodman chart scaffold"

      native goodman
        rule trait engentus-app
          flex = 1
          display = flex
          flex-direction = column
          overflow = hidden
        rule identity GoodmanWindowToolbar
          display = flex
          gap = 2px
          margin-left = auto
          padding-right = 8px
          align-items = center
        rule identity GoodmanChartArea
          flex = 1
          display = flex
          flex-direction = column
          overflow = hidden
        rule identity GoodmanChartRegion
          flex = 1
          background = #fff
          margin = 0 8px 8px
          border-radius = 0 0 8px 8px
          position = relative
          overflow = hidden
          box-shadow = 0 1px 4px rgba(0,0,0,.15)
        rule identity GoodmanScrubber
          height = var(--sch)
          background = var(--mid)
          border-bottom = 1px solid var(--brd)
          display = flex
          align-items = center
          gap = 9px
          padding = 0 12px
          margin = 7px 8px 0
          border-radius = 8px 8px 0 0
          flex-shrink = 0
        rule trait goodman-play-action
          width = 26px
          height = 26px
          border-radius = 50%
          border = none
          background = var(--blue)
          color = var(--dk)
          cursor = pointer
          font-size = 11px
          flex-shrink = 0
          transition = background .15s
          display = flex
          align-items = center
          justify-content = center
        rule trait goodman-play-action pseudo hover
          background = var(--blu2)
        rule trait goodman-time-slider
          flex = 1
        rule trait goodman-time-label
          font-size = 11px
          font-weight = 600
          font-variant-numeric = tabular-nums
          min-width = 54px
          text-align = left
          color = var(--t1)
        rule trait fail-badge
          font-size = 10.5px
          min-width = 80px
          text-align = right
          color = #f87171
          font-variant-numeric = tabular-nums
        rule identity GoodmanSpeedGroup
          display = flex
          align-items = center
          gap = 4px
          flex-shrink = 0
        rule identity GoodmanSpeedGroup tag label
          font-size = 10.5px
          color = var(--t2)
          cursor = pointer
        rule trait goodman-speed-slider
          width = 72px
        rule trait goodman-speed-label
          min-width = 34px
          text-align = right
          color = var(--t1)
          font-size = 10.5px
          font-variant-numeric = tabular-nums
        rule trait goodman-trail-toggle
          display = flex
          align-items = center
          gap = 3px
          flex-shrink = 0
          cursor = pointer
        rule trait goodman-trail-toggle tag label
          font-size = 10.5px
          color = var(--t2)
          cursor = pointer
        rule trait goodman-trail-toggle tag input
          accent-color = var(--blue)
          cursor = pointer
        rule identity GoodmanWindowLayer
          position = fixed
          top = 0
          left = 0
          width = 100%
          height = 100%
          pointer-events = none
          z-index = 200
        rule trait goodman-window
          top = 88px
          left = 420px
          width = 420px
          max-width = calc(100vw - 460px)
          pointer-events = all
          z-index = 220
        rule identity GoodmanStatsWindow
          top = 118px
          left = 460px
        rule identity GoodmanAnovaWindow
          top = 148px
          left = 500px
        rule trait goodman-window-empty
          min-height = 180px
          display = flex
          align-items = center
          justify-content = center
          padding = 18px
          color = #94a3b8
          text-align = center
        rule trait goodman-window-empty-text
          margin = 0
          font-size = 12px
        rule trait goodman-window-empty-message
          padding = 12px
          margin = 0
          font-size = 11.5px
          color = #94a3b8
        rule trait goodman-fatigue-legend-note
          font-size = 9.5px
          color = var(--t2)
          margin-top = 6px
          line-height = 1.5
        rule trait goodman-probe-intro
          display = flex
          gap = 2px
          font-size = 10.5px
          color = var(--t2)
          margin-bottom = 6px
        rule trait goodman-probe-bolt
          border = 1px solid var(--brd)
          border-radius = 5px
          padding = 6px 7px
          background = rgba(0,0,0,.12)
        rule trait goodman-probe-bolt-name
          font-size = 11px
          font-weight = 700
          margin-bottom = 5px
        rule trait goodman-probe-bolt-name--primary
          color = #dc2626
        rule trait goodman-probe-bolt-name--maintenance
          color = #8CC4D4
        rule identity GoodmanRunProgressFill
          position = absolute
          left = 0
          top = 0
          bottom = 0
          width = 0
          background = var(--blue)
          transition = width .2s, opacity .15s
        rule identity GoodmanRunProgressFill variant ready
          width = 0
          background = var(--blue)
          opacity = 1
        rule identity GoodmanRunProgressFill variant running
          width = 0
          background = var(--blue)
          opacity = 1
        rule identity GoodmanRunProgressFill variant paused
          width = 0
          background = var(--blue)
          opacity = .4
        rule identity GoodmanRunProgressFill variant done
          width = 100%
          background = var(--grn)
          opacity = 1
        rule identity GoodmanRunProgressFill variant stopped
          width = 0
          background = var(--ylw)
          opacity = 1
        rule identity GoodmanBoltSetPrimarySwatch
          background = #dc2626
        rule identity GoodmanBoltSetMaintenanceSwatch
          background = #8CC4D4
        rule identity GoodmanLegendInfiniteSwatch
          background = #bbf7d0
          border = 1px solid #86efac
        rule identity GoodmanLegendFiniteSwatch
          background = #d9f99d
          border = 1px solid #bef264
        rule identity GoodmanLegendShortSwatch
          background = #fef08a
          border = 1px solid #fde047
        rule identity GoodmanLegendImminentSwatch
          background = #fde68a
          border = 1px solid #fbbf24
        rule trait bs-item
          border = 1px solid var(--brd)
          border-radius = 6px
          margin-bottom = 6px
          background = rgba(0,0,0,.12)
          overflow = hidden
        rule trait bs-head
          display = flex
          align-items = center
          gap = 8px
          padding = 7px 9px
          cursor = pointer
          border-radius = 5px
          transition = background .1s
        rule trait bs-head pseudo hover
          background = rgba(255,255,255,.07)
        rule trait bs-dot
          width = 10px
          height = 10px
          border-radius = 50%
          flex-shrink = 0
        rule trait bs-name
          flex = 1
          font-size = 12px
          font-weight = 500
        rule trait bs-actions
          display = flex
          gap = 2px
        rule trait bs-act
          background = none
          border = none
          color = var(--t2)
          cursor = pointer
          font-size = 12px
          line-height = 1
          width = 22px
          height = 22px
          display = inline-flex
          align-items = center
          justify-content = center
          border-radius = 4px
        rule trait bs-act pseudo hover
          background = rgba(255,255,255,.1)
          color = var(--t1)
        rule trait bs-edit-form
          display = none
          padding = 6px 8px 8px
          background = rgba(0,0,0,.18)
          border-top = 1px solid var(--brd)
        rule trait bs-edit-form variant open
          display = block
        rule trait bs-params
          display = none
          padding = 6px 8px 8px
          border-top = 1px solid var(--brd)
        rule trait bs-params variant open
          display = block
        rule trait bs-chev
          appearance = none
          border = 0
          background = transparent
          color = var(--t2)
          cursor = pointer
          font = inherit
          padding = 0 2px
          line-height = 1
        rule trait bs-chev pseudo hover
          color = var(--t1)
        rule trait bs-ef-row
          display = flex
          align-items = center
          gap = 6px
          margin-bottom = 5px
        rule trait bs-ef-row tag label
          font-size = 10px
          color = var(--t2)
          width = 40px
          flex-shrink = 0
        rule selector ".bs-ef-row input[type=text]"
          flex = 1
          background = var(--dk)
          color = var(--t1)
          border = 1px solid var(--brd)
          border-radius = 3px
          padding = 3px 6px
          font-size = 11px
        rule selector ".bs-ef-row input[type=color]"
          width = 32px
          height = 22px
          border = none
          background = none
          cursor = pointer
          padding = 0
          border-radius = 3px
        rule trait bs-ef-save
          background = var(--blue)
          color = var(--dk)
          border = none
          border-radius = 3px
          padding = 3px 10px
          font-size = 10px
          cursor = pointer
          font-weight = 600

      slice mill-charge
        mode native-browser
        group "mill charge"
        seam "mill charge"
        family chrome.sidebar -> "mill charge"
        family surface.metric_group -> "mill charge"

      native mill-charge
        rule identity MillChargeCanvasWrap
          flex = 1
          display = flex
          align-items = center
          justify-content = center
          padding = 16px
          min-width = 0
        rule identity MillChargeMetrics
          width = 190px
          min-width = 190px
          background = var(--mid)
          border-left = 1px solid var(--brd)
          display = flex
          flex-direction = column
          overflow = hidden
        rule identity MillChargeMetricsHeader
          padding = 10px 12px
          border-bottom = 1px solid var(--brd)
          font-size = 9.5px
          font-weight = 700
          text-transform = uppercase
          letter-spacing = .08em
          color = var(--t2)
        rule identity MillChargeMetricsPanel
          padding = 10px 12px
        rule trait prow
          margin = 8px 0
          display = flex
          flex-direction = column
          gap = 4px
        rule trait prow-top
          display = flex
          justify-content = space-between
          align-items = center
        rule trait plabel
          font-size = 11px
          color = var(--t2)
        rule trait pval
          font-size = 11px
          color = var(--blue)
          font-weight = 600
        rule traits mill-slider mill-force-slider goodman-static-control-input goodman-time-slider goodman-speed-slider
          height = 16px
          appearance = none
          -webkit-appearance = none
          background = transparent
          cursor = pointer
          margin = 0
        rule traits mill-slider mill-force-slider goodman-static-control-input
          width = 100%
        rule selector ".mill-slider::-webkit-slider-runnable-track, .mill-force-slider::-webkit-slider-runnable-track, .goodman-static-control-input::-webkit-slider-runnable-track, .goodman-time-slider::-webkit-slider-runnable-track, .goodman-speed-slider::-webkit-slider-runnable-track"
          height = 4px
          border-radius = 999px
          background = rgba(140,196,212,.25)
          border = none
          overflow = hidden
        rule selector ".mill-slider::-webkit-slider-thumb, .mill-force-slider::-webkit-slider-thumb, .goodman-static-control-input::-webkit-slider-thumb, .goodman-time-slider::-webkit-slider-thumb, .goodman-speed-slider::-webkit-slider-thumb"
          -webkit-appearance = none
          appearance = none
          width = 10px
          height = 4px
          margin-top = 0
          border-radius = 999px
          background = #ffffff
          border = none
          box-shadow = -1000px 0 0 1000px var(--blue)
          cursor = pointer
        rule selector ".mill-slider::-moz-range-track, .mill-force-slider::-moz-range-track, .goodman-static-control-input::-moz-range-track, .goodman-time-slider::-moz-range-track, .goodman-speed-slider::-moz-range-track"
          height = 4px
          border-radius = 999px
          background = rgba(140,196,212,.25)
          border = none
        rule selector ".mill-slider::-moz-range-progress, .mill-force-slider::-moz-range-progress, .goodman-static-control-input::-moz-range-progress, .goodman-time-slider::-moz-range-progress, .goodman-speed-slider::-moz-range-progress"
          height = 4px
          border-radius = 999px
          background = var(--blue)
        rule selector ".mill-slider::-moz-range-thumb, .mill-force-slider::-moz-range-thumb, .goodman-static-control-input::-moz-range-thumb, .goodman-time-slider::-moz-range-thumb, .goodman-speed-slider::-moz-range-thumb"
          width = 12px
          height = 12px
          border-radius = 999px
          background = #ffffff
          border = none
          box-shadow = 0 1px 2px rgba(0,0,0,.35)
          cursor = pointer
        rule trait mill-preset-btn
          display = block
          width = 100%
          text-align = left
          padding = 6px 8px
          margin-bottom = 4px
          background = rgba(0,0,0,.18)
          border = 1px solid var(--brd)
          border-radius = 5px
          color = var(--t1)
          font-size = 11.5px
          cursor = pointer
          transition = background .1s, border-color .1s
        rule trait mill-preset-btn pseudo hover
          background = rgba(140,196,212,.12)
          border-color = rgba(140,196,212,.35)
        rule trait mill-metric-row
          display = flex
          justify-content = space-between
          align-items = center
          margin-bottom = 9px
        rule trait mill-metric-lbl
          font-size = 11px
          color = var(--t2)
        rule trait mill-metric-val
          font-size = 12px
          font-weight = 600
          color = var(--blue)
          font-variant-numeric = tabular-nums
        rule trait mill-regime-badge
          margin-top = 10px
          padding = 6px 10px
          border-radius = 6px
          font-size = 11px
          font-weight = 700
          letter-spacing = .06em
          text-align = center
        rule trait mill-regime-badge variant rolling
          background = #14532d
          color = #4ade80
        rule trait mill-regime-badge variant cascading
          background = #78350f
          color = #fbbf24
        rule trait mill-regime-badge variant cataracting
          background = #7f1d1d
          color = #f87171
        rule trait mill-regime-badge variant centrifuging
          background = #3b0764
          color = #c084fc
        rule trait mill-regime-badge variant pooling
          background = #1e3a5f
          color = #60a5fa
        rule trait mill-regime-badge variant slipping
          background = #3f3700
          color = #fde047
        media "(max-width: 980px)"
          rule identity MillChargeBody
            flex-direction = column
          rule identities MillChargeSidebar MillChargeMetrics
            width = auto
            min-width = 0

      slice mill-force
        mode native-browser
        group "mill force"
        seam "mill force"
        family chrome.sidebar -> "mill force"
        family interactive.pill -> "mill force"
        family surface.result_row -> "mill force"

      native mill-force
        rule trait mill-force-mode-pills
          display = flex
          gap = 6px
          padding = 6px 0
        rule trait mill-force-pill
          background = var(--dk)
          border = 1px solid var(--brd)
          color = var(--t2)
          padding = 4px 12px
          border-radius = 3px
          cursor = pointer
          font-size = 11px
          transition = all 0.15s
        rule trait mill-force-pill pseudo hover
          background = rgba(140,196,212,.08)
          border-color = var(--brd)
        rule trait mill-force-pill variant active
          background = rgba(140,196,212,.12)
          color = var(--blue)
          border-color = rgba(140,196,212,.35)
        rule trait mill-force-model-radios
          display = flex
          gap = 12px
          padding = 4px 0
        rule trait mill-force-model-option
          display = flex
          align-items = center
          gap = 5px
          cursor = pointer
          font-size = 11px
        rule trait mill-force-model-grounded-text
          color = var(--blue)
        rule trait mill-force-model-faithful-text
          color = var(--ylw)
        rule trait mill-force-mc-toggle
          cursor = pointer
          display = flex
          justify-content = space-between
          align-items = center
        rule trait mill-force-mc-toggle pseudo hover
          color = var(--blue)
        rule identity MillForceTabs
          display = flex
          gap = 0
          padding = 8px 12px
          border-bottom = 1px solid var(--brd)
          background = var(--mid)
          flex-shrink = 0
        rule trait mill-force-cht-tab
          background = none
          border = 1px solid transparent
          color = var(--t2)
          padding = 5px 12px
          border-radius = 3px
          cursor = pointer
          font-size = 11px
          transition = all 0.15s
        rule trait mill-force-cht-tab pseudo hover
          color = var(--t1)
        rule trait mill-force-cht-tab variant active
          background = rgba(140,196,212,.12)
          color = var(--blue)
          border-color = rgba(140,196,212,.35)
        rule identity MillForceChartWrap
          flex = 1
          overflow = hidden
          position = relative
          background = var(--dk)
        rule trait mill-force-result-row
          display = flex
          justify-content = space-between
          padding = 5px 0
          font-size = 11px
          gap = 8px
        rule trait mill-force-rl
          color = var(--t2)
        rule trait mill-force-rv
          color = var(--blue)
          font-size = 12px
          font-weight = 600
          font-variant-numeric = tabular-nums
          margin-left = auto
        rule trait mill-force-rd
          color = var(--ylw)
          font-size = 10px
        media "(max-width: 980px)"
          rule identity MillForceBody
            flex-direction = column
          rule identity MillForceSidebar
            width = auto
            min-width = 0

      slice platform-config
        mode native-browser
        group "platform config"
        seam "platform config"
        family platform.page_shell -> "platform config"
        family platform.sidebar_card -> "platform config"
        family platform.sidebar_link -> "platform config"
        family platform.content_card -> "platform config"
        family platform.notice -> "platform config"
        family platform.field -> "platform config"
        family platform.output_panel -> "platform config"
        family platform.data_table -> "platform config"

      native platform-config
        rule identities EngentusPlatformConfigBody PlatformConfigSecretsBody PlatformConfigDatasourcesBody PlatformConfigScriptsBody PlatformConfigAccessBody
          background = var(--dk)
          padding = 18px
          gap = 14px
          align-items = stretch
        rule trait platform-config-main
          min-width = 0
          flex = 1
          display = flex
          flex-direction = column
          gap = 14px
          overflow = auto
          padding-right = 4px
        rule trait platform-config-hero
          display = flex
          flex-direction = column
          gap = 6px
        rule trait platform-config-title
          font-size = 24px
          color = var(--t1)
          letter-spacing = -.03em
        rule trait platform-config-intro
          font-size = 12.5px
          line-height = 1.6
          color = var(--t2)
          max-width = 920px
        rule trait platform-config-notice
          border-radius = 8px
          padding = 11px 13px
          border = 1px solid var(--brd)
          background = var(--mid)
          color = var(--t1)
          font-size = 12px
          line-height = 1.5
        rule trait platform-config-notice variant success
          border-color = rgba(22,163,74,.4)
          background = rgba(22,163,74,.12)
          color = #4ade80
        rule trait platform-config-notice variant error
          border-color = rgba(220,38,38,.4)
          background = rgba(220,38,38,.12)
          color = #f87171
        rule trait platform-config-notice variant warn
          border-color = rgba(236,116,36,.4)
          background = rgba(236,116,36,.12)
          color = #fbbf24
        rule trait platform-config-content-card
          background = var(--mid)
          border = 1px solid var(--brd)
          border-radius = 8px
          padding = 16px
        rule trait platform-config-sidebar
          width = 220px
          flex = 0 0 220px
          background = var(--mid)
          border = 1px solid var(--brd)
          border-radius = 8px
          padding = 14px
          display = flex
          flex-direction = column
          gap = 10px
        rule traits platform-config-sidebar-title platform-config-section-title
          font-size = 15px
          font-weight = 700
          color = var(--t1)
          margin-bottom = 8px
          letter-spacing = -.02em
        rule trait platform-config-sidebar-hint
          font-size = 11px
          line-height = 1.55
          color = var(--t2)
        rule trait platform-config-sidebar-nav
          display = flex
          flex-direction = column
          gap = 8px
        rule trait platform-config-side-link
          width = 100%
          justify-content = flex-start
          border = 1px solid var(--brd)
          background = rgba(255,255,255,.04)
          color = var(--t1)
        rule trait platform-config-side-link variant active
          background = rgba(140,196,212,.16)
          border-color = rgba(140,196,212,.35)
          color = var(--blue)
        rule trait platform-config-field
          margin-bottom = 10px
        rule traits platform-config-field platform-config-checkbox tag label
          color = var(--t2)
        rule trait platform-config-input
          background = var(--dk)
          color = var(--t1)
          border = 1px solid var(--brd)
          border-radius = 6px
        rule trait platform-config-input pseudo focus
          border-color = var(--blue)
          box-shadow = 0 0 0 3px rgba(140,196,212,.2)
        rule trait platform-config-hint
          font-size = 11px
          line-height = 1.55
          color = var(--t2)
          margin-top = 4px
        rule trait platform-config-field-stack
          display = flex
          flex-direction = column
        rule trait platform-config-actions
          flex-wrap = wrap
        rule trait platform-config-actions trait rbtn
          min-width = 108px
        rule trait platform-config-checkbox
          margin = 10px 0
        rule trait platform-config-output
          margin-top = 10px
          padding = 12px
          min-height = 148px
          background = #0f172a
          color = #d8e5f2
          border-radius = 8px
          overflow = auto
          white-space = pre-wrap
          word-break = break-word
          font-size = 11px
          line-height = 1.5
        rule trait platform-config-output pseudo -webkit-scrollbar
          width = 6px
          height = 6px
        rule trait platform-config-output pseudo -webkit-scrollbar-thumb
          background = rgba(140,196,212,.35)
          border-radius = 999px
        rule trait platform-config-table
          width = 100%
          border-collapse = collapse
          margin = 8px 0 14px
          font-size = 12px
          background = var(--mid)
          border = 1px solid var(--brd)
          border-radius = 8px
          overflow = hidden
        rule trait platform-config-table tags th td
          padding = 10px 12px
          border-bottom = 1px solid rgba(255,255,255,.08)
          text-align = left
          vertical-align = middle
          color = var(--t1)
        rule trait platform-config-table tag th
          font-size = 11px
          text-transform = uppercase
          letter-spacing = .04em
          color = var(--t2)
          background = rgba(255,255,255,.05)
        rule trait platform-config-table tag tr pseudo last-child tag td
          border-bottom = none
        rule trait platform-config-row-action
          min-width = 72px
        media "(max-width: 980px)"
          rule identities EngentusPlatformConfigBody PlatformConfigSecretsBody PlatformConfigDatasourcesBody PlatformConfigScriptsBody PlatformConfigAccessBody
            flex-direction = column
          rule trait platform-config-sidebar
            width = auto
            flex-basis = auto

      group foundation
        rule "*, *::before, *::after"
          box-sizing = border-box
          margin = 0
          padding = 0
        rule ":root"
          --dk = #2C3C63
          --mid = #344C6C
          --brd = #3D5880
          --brdl = #e2e8f0
          --t1 = #f1f5f9
          --t2 = #94a3b8
          --t3 = #475569
          --tdark = #1e293b
          --blue = #8CC4D4
          --blu2 = #5AAABF
          --bluf = #DCF0F5
          --red = #dc2626
          --grn = #16a34a
          --ylw = #EC7424
          --pur = #7c3aed
          --sw = 284px
          --th = 44px
          --sch = 50px
        rule body
          font-family = -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif
          background = var(--dk)
          color = var(--t1)
          height = 100vh
          overflow = hidden
          display = flex
          flex-direction = column
          font-size = 12.5px
        rule a
          color = inherit
          text-decoration = none
        rule "#tb-brand img, .auth-brand img"
          width = auto
          flex-shrink = 0
      group toolbar
        rule "#tb"
          height = var(--th)
          background = var(--dk)
          border-bottom = 1px solid var(--brd)
          display = flex
          align-items = center
          flex-shrink = 0
          z-index = 50
        rule "#tb-brand"
          padding = 0 14px
          min-width = var(--sw)
          border-right = 1px solid var(--brd)
          height = 100%
          display = flex
          align-items = center
          gap = 8px
          letter-spacing = -.02em
          transition = background .15s
          user-select = none
          rule "&.clickable"
            cursor = pointer
          rule "&.clickable:hover"
            background = rgba(255,255,255,.05)
        rule "#tb-divider"
          width = 1px
          height = 24px
          background = var(--brd)
          flex-shrink = 0
        rule ".tb-site-summary"
          font-size = 11px
          color = var(--t2)
          padding-left = 12px
        rule ".mode-pill"
          display = flex
          background = var(--mid)
          border-radius = 6px
          padding = 2px
          margin = 0 12px
          gap = 2px
        rule ".mode-btn"
          background = none
          border = none
          color = var(--t2)
          padding = 4px 14px
          border-radius = 4px
          cursor = pointer
          font-size = 12px
          font-weight = 500
          transition = all .15s
          rule "&.on"
            background = var(--blue)
            color = var(--dk)
        rule ".tbw"
          background = none
          border = 1px solid transparent
          border-radius = 6px
          color = var(--t2)
          padding = 5px 10px
          cursor = pointer
          font-size = 12px
          font-weight = 500
          transition = all .15s
          display = flex
          align-items = center
          gap = 5px
          rule "&:hover"
            border-color = var(--brd)
            color = var(--t1)
          rule "&.on"
            background = var(--mid)
            border-color = var(--blue)
            color = var(--blue)
        rule "#user-prof"
          display = flex
          align-items = center
          gap = 8px
          padding = 0 14px
          cursor = pointer
          border-left = 1px solid var(--brd)
          height = 100%
          flex-shrink = 0
          user-select = none
          transition = background .15s
          position = relative
          rule "&:hover"
            background = rgba(255,255,255,.04)
        rule "#up-avatar"
          width = 28px
          height = 28px
          border-radius = 50%
          background = var(--blue)
          display = flex
          align-items = center
          justify-content = center
          font-size = 10px
          font-weight = 700
          color = var(--dk)
          flex-shrink = 0
        rule "#up-info"
          display = flex
          flex-direction = column
          gap = 1px
        rule "#up-name"
          font-size = 11.5px
          font-weight = 600
          color = var(--t1)
          line-height = 1.2
        rule "#up-role"
          font-size = 9.5px
          color = var(--t2)
          line-height = 1.2
        rule "#up-caret"
          font-size = 9px
          color = transparent
          margin-left = 2px
          position = relative
          rule "&::before"
            content = "\25BE"
            color = var(--t2)
            position = absolute
            inset = 0
        rule "#up-menu"
          position = absolute
          top = calc(100% + 2px)
          right = 0
          background = var(--mid)
          border = 1px solid var(--brd)
          border-radius = 8px
          min-width = 170px
          z-index = 200
          box-shadow = 0 8px 24px rgba(0,0,0,.3)
          padding = 4px
          display = none
          rule "&.open"
            display = block
        rule ".up-mi"
          display = flex
          align-items = center
          gap = 8px
          padding = 7px 10px
          border-radius = 5px
          font-size = 12px
          color = var(--t1)
          cursor = pointer
          transition = background .1s
          rule "&:hover"
            background = rgba(255,255,255,.07)
        rule ".up-mi-icon"
          font-size = 13px
          width = 16px
          text-align = center
          flex-shrink = 0
          color = var(--t2)
        rule ".up-sep"
          height = 1px
          background = var(--brd)
          margin = 3px 0
        rule ".up-mi-signout"
          color = #f87171
      group "goodman toolbar"
        rule "#tb-goodman-tools"
          display = flex
          align-items = center
          flex = 1
        rule "#tb-wins"
          display = flex
          gap = 2px
          margin-left = auto
          padding-right = 8px
          align-items = center
      group "shared views"
        rule "#view-mill, #view-mill-force, #view-platform-config, #view-platform-config-secrets, #view-platform-config-datasources, #view-platform-config-scripts, #view-platform-config-access"
          flex = 1
          display = flex
          flex-direction = column
          overflow = hidden
        rule "#body, #mill-body, #mill-force-body, #platform-config-body, #platform-config-secrets-body, #platform-config-datasources-body, #platform-config-scripts-body, #platform-config-access-body"
          flex = 1
          display = flex
          overflow = hidden
        rule "#sb, #mill-sb, #mill-force-sb"
          width = var(--sw)
          background = var(--mid)
          border-right = 1px solid var(--brd)
          display = flex
          flex-direction = column
          overflow = hidden
        rule "#sb, #mill-sb"
          min-width = var(--sw)
        rule "#mill-force-sb"
          flex-shrink = 0
        rule ".ssec"
          padding = 10px 12px
          border-bottom = 1px solid var(--brd)
        rule ".ssec-title, .metric-group-title"
          font-size = 9.5px
          font-weight = 700
          text-transform = uppercase
          letter-spacing = .08em
          color = var(--t2)
          margin-bottom = 8px
          display = flex
          align-items = center
          justify-content = space-between
        rule ".ssec-title button"
          background = none
          border = none
          color = var(--blue)
          cursor = pointer
          font-size = 11px
          font-weight = 600
          padding = 0
          rule "&:hover"
            color = var(--blu2)
        rule ".sidebar-list, .metric-list"
          list-style = none
          display = grid
          gap = 7px
          line-height = 1.42
          font-size = 11px
        rule ".sidebar-note"
          font-size = 9.5px
          color = var(--t2)
          margin-top = 6px
      group "goodman view"
        rule "#view-goodman"
          flex = 1
          display = flex
          flex-direction = column
          overflow = hidden
      group "chart scaffold"
        rule "#mill-main"
          flex = 1
          display = flex
          overflow = hidden
          background = var(--dk)
        rule "#mill-force-chart-area"
          flex = 1
          display = flex
          flex-direction = column
          background = var(--dk)
          overflow = hidden
        rule "#mill-force-chart-wrap iframe"
          position = absolute
          inset = 0
          width = 100%
          height = 100%
          border = 0
          display = block
        rule ".chart-page__overlay-canvas"
          pointer-events = none
      group "goodman chart scaffold"
        rule "#chart-area"
          flex = 1
          display = flex
          flex-direction = column
          overflow = hidden
        rule "#chart-wrap"
          flex = 1
          background = #fff
          margin = 0 8px 8px
          border-radius = 0 0 8px 8px
          position = relative
          overflow = hidden
          box-shadow = 0 1px 4px rgba(0,0,0,.15)
        rule "#scr.hidden + #chart-wrap"
          margin-top = 8px
          border-radius = 8px
        rule "#chart-svg"
          position = absolute
          inset = 0
          width = 100%
          height = 100%
          border = 0
          display = block
        rule "#mc-canvas"
          pointer-events = none
        rule "#chart-tip"
          position = absolute
          pointer-events = none
          background = rgba(15,23,42,.9)
          color = var(--t1)
          padding = 6px 10px
          border-radius = 6px
          font-size = 11px
          opacity = 0
          transition = opacity .1s
          line-height = 1.7
          z-index = 20
          white-space = nowrap
        rule "#scr"
          height = var(--sch)
          background = var(--mid)
          border-bottom = 1px solid var(--brd)
          display = flex
          align-items = center
          gap = 9px
          padding = 0 12px
          margin = 7px 8px 0
          border-radius = 8px 8px 0 0
          flex-shrink = 0
        rule "#scr.hidden, #scr[hidden]"
          display = none
        rule "#play-btn"
          width = 26px
          height = 26px
          border-radius = 50%
          border = none
          background = var(--blue)
          color = var(--dk)
          cursor = pointer
          font-size = 11px
          flex-shrink = 0
          transition = background .15s
          display = flex
          align-items = center
          justify-content = center
          rule "&:hover"
            background = var(--blu2)
        rule "#time-sl"
          flex = 1
        rule "#t-lbl"
          font-size = 11px
          font-weight = 600
          font-variant-numeric = tabular-nums
          min-width = 54px
          text-align = left
          color = var(--t1)
        rule ".goodman-time-prefix"
          font-size = 11px
          font-weight = 600
          color = var(--t1)
          margin-left = 2px
          margin-right = -7px
          white-space = nowrap
        rule ".fail-badge"
          font-size = 10.5px
          min-width = 80px
          text-align = right
          color = #f87171
          font-variant-numeric = tabular-nums
        rule "#spd-wrap"
          display = flex
          align-items = center
          gap = 4px
          flex-shrink = 0
        rule "#spd-wrap label, #trail-wrap label"
          font-size = 10.5px
          color = var(--t2)
          cursor = pointer
        rule "#spd-sl"
          width = 72px
          accent-color = var(--blue)
          cursor = pointer
        rule "#spd-lbl"
          min-width = 34px
          text-align = right
          color = var(--t1)
          font-size = 10.5px
          font-variant-numeric = tabular-nums
        rule "#trail-wrap"
          display = flex
          align-items = center
          gap = 3px
          flex-shrink = 0
          cursor = pointer
        rule "#trail-cb"
          accent-color = var(--blue)
          cursor = pointer
      group "floating windows"
        rule ".fw"
          position = absolute
          pointer-events = all
          background = #fff
          border-radius = 10px
          box-shadow = 0 8px 32px rgba(0,0,0,.22), 0 0 0 1px rgba(0,0,0,.07)
          display = flex
          flex-direction = column
          overflow = hidden
          min-width = 300px
          min-height = 140px
        rule ".fw-tb"
          background = var(--dk)
          padding = 7px 9px
          display = flex
          align-items = center
          gap = 7px
          cursor = grab
          flex-shrink = 0
          border-radius = 10px 10px 0 0
          user-select = none
          rule "&:active"
            cursor = grabbing
        rule ".fw-title"
          flex = 1
          font-size = 12px
          font-weight = 600
          color = var(--t1)
        rule ".fw-btn"
          width = 18px
          height = 18px
          border-radius = 3px
          border = none
          background = rgba(255,255,255,.1)
          color = var(--t2)
          cursor = pointer
          font-size = 10px
          display = flex
          align-items = center
          justify-content = center
          transition = background .1s
          rule "&:hover"
            background = rgba(255,255,255,.2)
            color = var(--t1)
        rule ".fw-body"
          flex = 1
          overflow = auto
          position = relative
        rule ".fw-rz"
          position = absolute
          right = 0
          bottom = 0
          width = 16px
          height = 16px
          cursor = nwse-resize
          background = linear-gradient(135deg, transparent 50%, #e2e8f0 50%)
        rule ".stbl"
          width = 100%
          border-collapse = collapse
          font-size = 11.5px
        rule ".stbl th"
          background = #f8fafc
          color = #475569
          font-weight = 600
          padding = 6px 8px
          text-align = left
          border-bottom = 1px solid var(--brdl)
          font-size = 10px
          text-transform = uppercase
          letter-spacing = .04em
        rule ".stbl td"
          padding = 5px 8px
          border-bottom = 1px solid #f1f5f9
          color = #1e293b
        rule ".stbl .num"
          font-variant-numeric = tabular-nums
          text-align = right
        rule ".stbl tr:last-child td"
          border-bottom = none
        rule ".sc-dot"
          display = inline-block
          width = 8px
          height = 8px
          border-radius = 50%
          margin-right = 5px
        rule ".anova-stat"
          display = flex
          gap = 12px
          flex-wrap = wrap
          padding = 10px 12px
          background = #f8fafc
          border-bottom = 1px solid var(--brdl)
        rule ".anova-kv"
          display = flex
          flex-direction = column
          gap = 2px
        rule ".anova-k"
          font-size = 9.5px
          text-transform = uppercase
          letter-spacing = .05em
          color = #64748b
          font-weight = 600
        rule ".anova-v"
          font-size = 16px
          font-weight = 700
          color = #0f172a
          font-variant-numeric = tabular-nums
        rule ".anova-sig"
          font-size = 10px
          padding = 2px 7px
          border-radius = 3px
          font-weight = 600
          align-self = center
        rule ".anova-sig.yes"
          background = #dcfce7
          color = #15803d
        rule ".anova-sig.no"
          background = #f1f5f9
          color = #64748b
        rule ".anova-note"
          font-size = 10.5px
          color = #64748b
          padding = 6px 12px
          border-bottom = 1px solid var(--brdl)
        rule ".leg-row"
          display = flex
          align-items = center
          gap = 6px
          margin-bottom = 4px
        rule ".leg-sw"
          width = 13px
          height = 13px
          border-radius = 3px
          flex-shrink = 0
          opacity = .85
        rule ".leg-row span"
          font-size = 10.5px
          color = var(--t2)
        rule ".info-box"
          background = rgba(0,0,0,.2)
          border-radius = 5px
          padding = 8px 10px
          margin-top = 4px
        rule ".info-row"
          display = flex
          justify-content = space-between
          font-size = 11px
          color = var(--t2)
          margin-bottom = 3px
        rule ".info-row:last-child"
          margin-bottom = 0
        rule ".info-value"
          font-weight = 600
          font-variant-numeric = tabular-nums
      group "goodman windows"
        rule "#wl"
          position = fixed
          top = 0
          left = 0
          width = 100%
          height = 100%
          pointer-events = none
          z-index = 200
        rule ".goodman-window"
          top = 88px
          left = 420px
          width = 420px
          max-width = calc(100vw - 460px)
          pointer-events = all
          z-index = 220
        rule ".goodman-window.stats-window"
          top = 118px
          left = 460px
        rule ".goodman-window.anova-window"
          top = 148px
          left = 500px
        rule ".goodman-window[hidden]"
          display = none
        rule ".goodman-window-empty"
          min-height = 180px
          display = flex
          align-items = center
          justify-content = center
          padding = 18px
          color = #94a3b8
          text-align = center
        rule ".goodman-window-empty-text"
          margin = 0
          font-size = 12px
        rule ".goodman-window-empty-message"
          padding = 12px
          margin = 0
          font-size = 11.5px
          color = #94a3b8
        rule ".goodman-anova-box-plot"
          min-height = 150px
        rule ".goodman-fatigue-legend-note"
          font-size = 9.5px
          color = var(--t2)
          margin-top = 6px
          line-height = 1.5
        rule ".goodman-param-summary"
          gap = 8px
          align-items = baseline
        rule ".goodman-param-summary .info-value"
          color = var(--t1)
          font-size = 10.5px
          text-align = right
        rule ".goodman-probe-intro"
          display = flex
          gap = 2px
          font-size = 10.5px
          color = var(--t2)
          margin-bottom = 6px
        rule ".goodman-probe-comparison-rows"
          display = grid
          gap = 6px
        rule ".goodman-probe-bolt"
          border = 1px solid var(--brd)
          border-radius = 5px
          padding = 6px 7px
          background = rgba(0,0,0,.12)
        rule ".goodman-probe-bolt-name"
          font-size = 11px
          font-weight = 700
          margin-bottom = 5px
        rule ".goodman-probe-bolt-name--primary"
          color = #dc2626
        rule ".goodman-probe-bolt-name--maintenance"
          color = #8CC4D4
      group "controls and editor"
        rule ".mc-row"
          display = flex
          justify-content = space-between
          align-items = center
          padding = 6px 0
          font-size = 11px
        rule ".mc-row label"
          color = var(--t2)
        rule ".mc-row input[type=number]"
          width = 70px
          background = var(--dk)
          color = var(--t1)
          border = 1px solid var(--brd)
          border-radius = 3px
          padding = 3px 5px
          font-size = 11px
          text-align = right
        rule ".run-row"
          display = flex
          gap = 5px
          margin-top = 8px
        rule ".rbtn"
          flex = 1
          padding = 7px
          border-radius = 5px
          border = none
          cursor = pointer
          font-size = 11.5px
          font-weight = 600
          transition = all .15s
        rule ".rbtn.go"
          background = var(--grn)
          color = #fff
        rule ".rbtn.go:hover"
          background = #15803d
        rule ".rbtn.go:disabled"
          opacity = .4
          cursor = not-allowed
        rule ".rbtn.pause"
          background = var(--ylw)
          color = #fff
        rule ".rbtn.stop"
          background = #dc2626
          color = #fff
        rule ".rbtn:disabled"
          opacity = .4
          cursor = not-allowed
        rule ".prog-wrap"
          height = 4px
          margin = 7px 0 16px
          position = relative
          background = var(--brd)
          border-radius = 2px
          overflow = visible
        rule ".prog-fill"
          position = absolute
          left = 0
          top = 0
          bottom = 0
          width = 0
          background = var(--blue)
          transition = width .2s, opacity .15s
        rule ".prog-fill.ready, .prog-fill.running"
          width = 0
          background = var(--blue)
          opacity = 1
        rule ".prog-fill.paused"
          width = 0
          background = var(--blue)
          opacity = .4
        rule ".prog-fill.done"
          width = 100%
          background = var(--grn)
          opacity = 1
        rule ".prog-fill.stopped"
          width = 0
          background = var(--ylw)
          opacity = 1
        rule ".prog-lbl"
          display = block
          margin-top = 3px
          font-size = 10px
          color = var(--t2)
          font-variant-numeric = tabular-nums
          text-align = right
        rule ".save-sim-btn"
          width = 100%
          margin-top = 10px
          padding = 6px 0
          background = var(--blue)
          color = var(--dk)
          border = none
          border-radius = 6px
          font-size = 11.5px
          font-weight = 600
          cursor = pointer
          letter-spacing = .3px
          opacity = .9
          rule "&:hover"
            opacity = 1
        rule ".bs-item"
          border = 1px solid var(--brd)
          border-radius = 6px
          margin-bottom = 6px
          background = rgba(0,0,0,.12)
          overflow = hidden
        rule ".bs-head"
          display = flex
          align-items = center
          gap = 8px
          padding = 7px 9px
          cursor = pointer
          border-radius = 5px
          transition = background .1s
          rule "&:hover"
            background = rgba(255,255,255,.07)
        rule ".bs-dot"
          width = 10px
          height = 10px
          border-radius = 50%
          flex-shrink = 0
        rule ".bs-name"
          flex = 1
          font-size = 12px
          font-weight = 500
        rule ".bs-actions"
          display = flex
          gap = 3px
        rule ".bs-act"
          background = none
          border = none
          color = var(--t2)
          cursor = pointer
          font-size = 11px
          padding = 1px 4px
          border-radius = 3px
          rule "&:hover"
            background = rgba(255,255,255,.1)
            color = var(--t1)
        rule ".bs-edit-form"
          display = none
          padding = 6px 8px 8px
          background = rgba(0,0,0,.18)
          border-top = 1px solid var(--brd)
        rule ".bs-edit-form.open"
          display = block
        rule ".bs-params"
          display = none
          padding = 6px 8px 8px
          border-top = 1px solid var(--brd)
        rule ".bs-params.open"
          display = block
        rule ".bs-chev"
          appearance = none
          border = 0
          background = transparent
          color = var(--t2)
          cursor = pointer
          font = inherit
          padding = 0 2px
          line-height = 1
          rule "&:hover"
            color = var(--t1)
        rule ".bs-ef-row"
          display = flex
          align-items = center
          gap = 6px
          margin-bottom = 5px
        rule ".bs-ef-row label"
          font-size = 10px
          color = var(--t2)
          width = 40px
          flex-shrink = 0
        rule ".bs-ef-row input[type=text]"
          flex = 1
          background = var(--dk)
          color = var(--t1)
          border = 1px solid var(--brd)
          border-radius = 3px
          padding = 3px 6px
          font-size = 11px
        rule ".bs-ef-row input[type=color]"
          width = 32px
          height = 22px
          border = none
          background = none
          cursor = pointer
          padding = 0
          border-radius = 3px
        rule ".bs-ef-save"
          background = var(--blue)
          color = var(--dk)
          border = none
          border-radius = 3px
          padding = 3px 10px
          font-size = 10px
          cursor = pointer
          font-weight = 600
        rule ".edit-group"
          background = rgba(0,0,0,.2)
          border-radius = 5px
          padding = 8px 9px
          margin-bottom = 7px
        rule ".edit-group-title"
          font-size = 9px
          font-weight = 700
          text-transform = uppercase
          letter-spacing = .07em
          color = var(--t2)
          margin-bottom = 6px
        rule ".efield-row"
          display = flex
          align-items = center
          gap = 6px
          margin-bottom = 4px
        rule ".efield-row label"
          font-size = 10px
          color = var(--t2)
          flex = 1
        rule ".efield-row input[type=text]"
          flex = 2
          background = var(--dk)
          color = var(--t1)
          border = 1px solid var(--brd)
          border-radius = 3px
          padding = 2px 5px
          font-size = 11px
        rule ".efield-row input[type=number]"
          width = 52px
          background = var(--dk)
          color = var(--t1)
          border = 1px solid var(--brd)
          border-radius = 3px
          padding = 2px 5px
          font-size = 11px
          text-align = right
        rule ".efield-row input[type=color]"
          width = 30px
          height = 20px
          border = none
          background = none
          cursor = pointer
          padding = 0
        rule ".annot-list"
          margin-top = 4px
        rule ".annot-row"
          display = flex
          align-items = center
          gap = 4px
          margin-bottom = 3px
          background = rgba(255,255,255,.04)
          border-radius = 3px
          padding = 3px 5px
        rule ".annot-row input[type=text]"
          flex = 1
          background = var(--dk)
          color = var(--t1)
          border = 1px solid var(--brd)
          border-radius = 3px
          padding = 2px 4px
          font-size = 10.5px
        rule ".annot-row input[type=number]"
          width = 46px
          background = var(--dk)
          color = var(--t1)
          border = 1px solid var(--brd)
          border-radius = 3px
          padding = 2px 4px
          font-size = 10.5px
          text-align = right
        rule ".annot-del"
          background = none
          border = none
          color = var(--t2)
          cursor = pointer
          padding = 1px 3px
          border-radius = 2px
          font-size = 10px
          rule "&:hover"
            background = rgba(220,38,38,.2)
            color = #f87171
        rule ".add-annot-btn"
          width = 100%
          padding = 5px
          background = rgba(140,196,212,.1)
          border = 1px dashed rgba(140,196,212,.35)
          border-radius = 4px
          color = var(--blue)
          font-size = 11px
          cursor = pointer
          font-weight = 500
          margin-top = 4px
          transition = all .15s
          rule "&:hover"
            background = rgba(140,196,212,.2)
        rule "body.edit-mode #chart-svg"
          cursor = crosshair
        rule "body.edit-mode #chart-svg [data-editable]"
          cursor = pointer
        rule "body.edit-mode #chart-svg [data-editable]:hover"
          opacity = .75
        rule ".edit-selected"
          outline = 2px dashed var(--blue)
        rule ".free-tog"
          display = inline-flex
          align-items = center
          gap = 3px
          cursor = pointer
          flex-shrink = 0
        rule ".tog-track"
          width = 24px
          height = 13px
          background = var(--brd)
          border-radius = 7px
          position = relative
          transition = background .15s
          flex-shrink = 0
        rule ".tog-track.on"
          background = var(--blue)
        rule ".tog-knob"
          width = 9px
          height = 9px
          background = #fff
          border-radius = 50%
          position = absolute
          top = 2px
          left = 2px
          transition = left .15s
        rule ".tog-track.on .tog-knob"
          left = 13px
        rule ".tog-lbl"
          font-size = 9px
          color = var(--t2)
        rule ".dist-box"
          background = rgba(0,0,0,.25)
          border-radius = 4px
          padding = 5px 7px
          margin-top = 3px
          display = none
        rule ".dist-box.open"
          display = block
        rule ".dist-sel"
          width = 100%
          background = var(--dk)
          color = var(--t1)
          border = 1px solid var(--brd)
          border-radius = 3px
          padding = 3px 5px
          font-size = 11px
          margin-bottom = 4px
        rule ".dist-inputs"
          display = flex
          gap = 5px
          flex-wrap = wrap
        rule ".dig"
          display = flex
          flex-direction = column
          gap = 2px
          flex = 1
          min-width = 58px
        rule ".dig label"
          font-size = 9px
          color = var(--t2)
        rule ".dig input"
          background = var(--dk)
          color = var(--t1)
          border = 1px solid var(--brd)
          border-radius = 3px
          padding = 2px 5px
          font-size = 11px
          width = 100%
        rule ".toggle-chk-row"
          display = inline-flex
          align-items = center
          gap = 6px
          cursor = pointer
        rule ".goodman-simulation-empty"
          font-size = 11px
          color = var(--t2)
          padding = 4px 0
          margin = 0
        rule ".sim-row"
          display = flex
          align-items = center
          gap = 7px
          padding = 5px 7px
          border-radius = 5px
          cursor = pointer
          margin-bottom = 2px
          transition = background .1s
          rule "&:hover"
            background = rgba(255,255,255,.05)
          rule "&.on"
            background = rgba(140,196,212,.15)
        rule ".sim-dot"
          width = 8px
          height = 8px
          border-radius = 50%
          flex-shrink = 0
        rule ".sim-name"
          flex = 1
          font-size = 12px
          color = var(--t1)
          white-space = nowrap
          overflow = hidden
          text-overflow = ellipsis
        rule ".sim-badge"
          font-size = 9px
          padding = 1px 5px
          border-radius = 3px
          font-weight = 600
          flex-shrink = 0
        rule ".sim-badge.idle"
          background = rgba(255,255,255,.1)
          color = var(--t2)
        rule ".sim-badge.running"
          background = rgba(140,196,212,.3)
          color = #6CBDCF
        rule ".sim-badge.done"
          background = rgba(22,163,74,.2)
          color = #86efac
        rule ".sim-badge.stale"
          background = rgba(236,116,36,.2)
          color = #FDBA74
        rule ".sim-badge.stopped"
          background = rgba(220,38,38,.15)
          color = #fca5a5
        rule ".add-sim-btn"
          width = 100%
          padding = 6px
          background = rgba(140,196,212,.12)
          border = 1px dashed rgba(140,196,212,.4)
          border-radius = 5px
          color = var(--blue)
          font-size = 11.5px
          cursor = pointer
          font-weight = 500
          transition = all .15s
          margin-top = 4px
          rule "&:hover"
            background = rgba(140,196,212,.22)
      group "mill charge"
        rule "#mill-canvas-wrap"
          flex = 1
          display = flex
          align-items = center
          justify-content = center
          padding = 16px
          min-width = 0
        rule "#mill-canvas"
          width = 100%
          height = 100%
          display = block
          border = 0
          border-radius = 10px
        rule "#mill-metrics"
          width = 190px
          min-width = 190px
          background = var(--mid)
          border-left = 1px solid var(--brd)
          display = flex
          flex-direction = column
          overflow = hidden
        rule "#mill-metrics-hdr"
          padding = 10px 12px
          border-bottom = 1px solid var(--brd)
          font-size = 9.5px
          font-weight = 700
          text-transform = uppercase
          letter-spacing = .08em
          color = var(--t2)
        rule "#mill-metrics-panel"
          padding = 10px 12px
        rule ".prow"
          margin = 8px 0
          display = flex
          flex-direction = column
          gap = 4px
        rule ".prow-top"
          display = flex
          justify-content = space-between
          align-items = center
        rule ".plabel"
          font-size = 11px
          color = var(--t2)
        rule ".pval"
          font-size = 11px
          color = var(--blue)
          font-weight = 600
        rule "input[type=range], .mill-slider"
          width = 100%
          accent-color = var(--blue)
          height = 3px
          cursor = pointer
        rule ".mill-preset-btn"
          display = block
          width = 100%
          text-align = left
          padding = 6px 8px
          margin-bottom = 4px
          background = rgba(0,0,0,.18)
          border = 1px solid var(--brd)
          border-radius = 5px
          color = var(--t1)
          font-size = 11.5px
          cursor = pointer
          transition = background .1s, border-color .1s
          rule "&:hover"
            background = rgba(140,196,212,.12)
            border-color = rgba(140,196,212,.35)
        rule ".mill-metric-row"
          display = flex
          justify-content = space-between
          align-items = center
          margin-bottom = 9px
        rule ".mill-metric-lbl"
          font-size = 11px
          color = var(--t2)
        rule ".mill-metric-val"
          font-size = 12px
          font-weight = 600
          color = var(--blue)
          font-variant-numeric = tabular-nums
        rule ".mill-regime-badge"
          margin-top = 10px
          padding = 6px 10px
          border-radius = 6px
          font-size = 11px
          font-weight = 700
          letter-spacing = .06em
          text-align = center
        rule ".mill-regime-badge.rolling"
          background = #14532d
          color = #4ade80
        rule ".mill-regime-badge.cascading"
          background = #78350f
          color = #fbbf24
        rule ".mill-regime-badge.cataracting"
          background = #7f1d1d
          color = #f87171
        rule ".mill-regime-badge.centrifuging"
          background = #3b0764
          color = #c084fc
        rule ".mill-regime-badge.pooling"
          background = #1e3a5f
          color = #60a5fa
        rule ".mill-regime-badge.slipping"
          background = #3f3700
          color = #fde047
        rule ".metric-group"
          background = rgba(0,0,0,.2)
          border-radius = 5px
          padding = 8px 10px
          margin-bottom = 8px
        media "(max-width: 980px)"
          rule "#mill-body"
            flex-direction = column
          rule "#mill-sb, #mill-metrics"
            width = auto
            min-width = 0
      group "mill force"
        rule "#mill-force-chart-tabs"
          display = flex
          gap = 0
          padding = 8px 12px
          border-bottom = 1px solid var(--brd)
          background = var(--mid)
          flex-shrink = 0
        rule ".mill-force-mode-pills"
          display = flex
          gap = 6px
          padding = 6px 0
        rule ".mill-force-pill"
          background = var(--dk)
          border = 1px solid var(--brd)
          color = var(--t2)
          padding = 4px 12px
          border-radius = 3px
          cursor = pointer
          font-size = 11px
          transition = all 0.15s
          rule "&:hover"
            background = rgba(140,196,212,.08)
            border-color = var(--brd)
          rule "&.active"
            background = rgba(140,196,212,.12)
            color = var(--blue)
            border-color = rgba(140,196,212,.35)
        rule ".mill-force-model-radios"
          display = flex
          gap = 12px
          padding = 4px 0
        rule ".mill-force-model-option"
          display = flex
          align-items = center
          gap = 5px
          cursor = pointer
          font-size = 11px
        rule ".mill-force-model-grounded-text"
          color = var(--blue)
        rule ".mill-force-model-faithful-text"
          color = var(--ylw)
        rule ".mill-force-mc-toggle"
          cursor = pointer
          display = flex
          justify-content = space-between
          align-items = center
          rule "&:hover"
            color = var(--blue)
        rule ".mill-force-cht-tab"
          background = none
          border = 1px solid transparent
          color = var(--t2)
          padding = 5px 12px
          border-radius = 3px
          cursor = pointer
          font-size = 11px
          transition = all 0.15s
          rule "&:hover"
            color = var(--t1)
          rule "&.active"
            background = rgba(140,196,212,.12)
            color = var(--blue)
            border-color = rgba(140,196,212,.35)
        rule "#mill-force-chart-wrap"
          flex = 1
          overflow = hidden
          position = relative
          background = var(--dk)
        rule "#mill-force-mc-canvas"
          position = absolute
          top = 0
          left = 0
        rule "#mill-force-tip"
          position = absolute
          background = rgba(29,39,83,.95)
          color = #f1f5f9
          padding = 8px 12px
          border-radius = 5px
          font-size = 10.5px
          z-index = 100
          pointer-events = none
          display = none
          border = 1px solid var(--brd)
          box-shadow = 0 4px 12px rgba(0,0,0,.4)
        rule "#mill-force-svg-cross, #mill-force-svg-force, #mill-force-svg-rose"
          width = 100%
          height = 100%
        rule ".mill-force-slider"
          width = 100%
          height = 4px
          border-radius = 2px
          background = var(--brd)
          cursor = pointer
        rule ".mill-force-result-row"
          display = flex
          justify-content = space-between
          padding = 5px 0
          font-size = 11px
          gap = 8px
        rule ".mill-force-rl"
          color = var(--t2)
        rule ".mill-force-rv"
          color = var(--t1)
          font-weight = 600
          margin-left = auto
        rule ".mill-force-rd"
          color = var(--ylw)
          font-size = 10px
        media "(max-width: 980px)"
          rule "#mill-force-body"
            flex-direction = column
          rule "#mill-force-sb"
            width = auto
            min-width = 0
    asset chart
      slice chart-pages
        mode native-browser
        group "chart tokens"
        group "chart foundation"
        group "chart surfaces"
        seam "chart foundation"
        seam "chart surfaces"
        family chart.page_frame -> "chart foundation"
        family chart.page_host -> "chart foundation"
        family chart.page_mount -> "chart surfaces"
        family chart.page_tooltip -> "chart surfaces"

      native chart-pages
        rule identity ChartPageThemeRoot
          --dk = #2C3C63
          --mid = #344C6C
          --brd = #3D5880
          --t1 = #f1f5f9
          --t2 = #94a3b8
          --t3 = #475569
          --blue = #8CC4D4
        rule identity ChartPageHtmlDocument
          margin = 0
          height = 100%
          overflow = hidden
        rule identity ChartPageBody
          margin = 0
          height = 100%
          overflow = hidden
          font-family = -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif
          background = #fff
          color = var(--t3)
        rule identity ChartPageViewport
          position = relative
          width = 100%
          height = 100%
          overflow = hidden
        rule identity ChartPageHost
          position = relative
          width = 100%
          height = 100%
          overflow = hidden
        rule identity ChartPageMountSurface
          display = block
        rule identity ChartPageOverlayCanvasSurface
          display = block
        rule identity ChartPageTooltipSurface
          opacity = 0
        rule identity GoodmanDiagram
          position = absolute
          top = 0
          left = 0
          width = 100%
          height = 100%
          display = block
        rule identity GoodmanChartOverlayCanvas
          position = absolute
          top = 0
          left = 0
          width = 100%
          height = 100%
          display = block
          pointer-events = none
        rule identity GoodmanChartTooltip
          position = absolute
          pointer-events = none
          background = rgba(15,23,42,.9)
          color = var(--t1)
          padding = 6px 10px
          border-radius = 6px
          font-size = 11px
          opacity = 0
          transition = opacity .1s
          line-height = 1.7
          z-index = 20
          white-space = nowrap
        rule identity MillChargeCrossSection
          width = 100%
          height = 100%
          display = block
          border-radius = 10px
        rule identity MillForceAngle
          width = 100%
          height = 100%
        rule identity MillForceCross
          width = 100%
          height = 100%
        rule identity MillForceRose
          width = 100%
          height = 100%
        rule identity MillForceAngleOverlayCanvas
          position = absolute
          top = 0
          left = 0
        rule identity MillForceCrossOverlayCanvas
          position = absolute
          top = 0
          left = 0
        rule identity MillForceRoseOverlayCanvas
          position = absolute
          top = 0
          left = 0
        rule identity MillForceAngleTooltip
          position = absolute
          pointer-events = none
          background = rgba(29,39,83,.95)
          color = #f1f5f9
          padding = 8px 12px
          border-radius = 5px
          font-size = 10.5px
          z-index = 100
          display = none
          border = 1px solid var(--brd)
          box-shadow = 0 4px 12px rgba(0,0,0,.4)
        rule identity MillForceCrossTooltip
          position = absolute
          pointer-events = none
          background = rgba(29,39,83,.95)
          color = #f1f5f9
          padding = 8px 12px
          border-radius = 5px
          font-size = 10.5px
          z-index = 100
          display = none
          border = 1px solid var(--brd)
          box-shadow = 0 4px 12px rgba(0,0,0,.4)
        rule identity MillForceRoseTooltip
          position = absolute
          pointer-events = none
          background = rgba(29,39,83,.95)
          color = #f1f5f9
          padding = 8px 12px
          border-radius = 5px
          font-size = 10.5px
          z-index = 100
          display = none
          border = 1px solid var(--brd)
          box-shadow = 0 4px 12px rgba(0,0,0,.4)
        rule identity GoodmanChartHost
          background = #fff
        rule identity MillChargeChartHost
          background = #fff
        rule identity MillForceChartHost
          background = #fff


