theme engentus

tokens
  color.chrome.bg              = #2C3C63
  color.chrome.panel           = #344C6C
  color.chrome.edge            = #3D5880
  color.surface.base           = #ffffff
  color.surface.soft           = #f8fafc
  color.ink.primary            = #f1f5f9
  color.ink.secondary          = #94a3b8
  color.ink.body               = #475569
  color.ink.dark               = #0f172a
  color.accent.cool            = #8CC4D4
  color.accent.cool.strong     = #5AAABF
  color.accent.warm            = #EC7424
  color.success                = #16a34a
  color.notice                 = #f87171
  color.product                = #4ade80
  color.industry               = #a78bfa

  size.toolbar.height          = 44px
  size.sidebar.width           = 284px
  size.metrics.width           = 190px
  size.scrubber.height         = 50px
  size.auth.card.width         = 372px
  size.auth.hero.width         = 55%
  size.platform.sidebar.width  = 220px

  radius.sm                    = 4px
  radius.md                    = 6px
  radius.lg                    = 8px
  radius.xl                    = 10px
  radius.xxl                   = 12px
  radius.pill                  = 999px

  font.body                    = -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif
  font.size.app                = 12.5px
  font.size.small              = 11px
  font.size.tiny               = 9.5px
  font.size.title              = 15px
  font.size.auth.title         = 22px
  font.size.auth.hero          = 28px
  font.size.platform.title     = 24px

  chart.chrome.grid.stroke                 = #f1f5f9
  chart.chrome.axis.stroke                 = #cbd5e1
  chart.chrome.tick.stroke                 = #e2e8f0
  chart.chrome.tickLabel.fill              = #64748b
  chart.chrome.axisLabel.fill              = #64748b
  chart.chrome.title.fill                  = #0f172a
  chart.chrome.annotation.fill             = #1e293b
  chart.chrome.polarGrid.stroke            = #e2e8f0
  chart.chrome.disc.background             = #0d1a2e
  chart.chrome.disc.shellStroke            = #64748b
  chart.chrome.disc.centerFill             = #475569
  chart.typography.bodyFontFamily          = -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif
  chart.typography.headingFontFamily       = -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif

  chart.goodman.chrome.grid.stroke         = #f1f5f9
  chart.goodman.chrome.axis.stroke         = #cbd5e1
  chart.goodman.chrome.tick.stroke         = #e2e8f0
  chart.goodman.chrome.tickLabel.fill      = #64748b
  chart.goodman.chrome.axisLabel.fill      = #64748b
  chart.goodman.chrome.title.fill          = #0f172a
  chart.goodman.chrome.annotation.fill     = #1e293b
  chart.goodman.chrome.polarGrid.stroke    = #e2e8f0
  chart.goodman.chrome.disc.background     = #0d1a2e
  chart.goodman.chrome.disc.shellStroke    = #64748b
  chart.goodman.chrome.disc.centerFill     = #475569
  chart.goodman.typography.bodyFontFamily  = -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif
  chart.goodman.typography.headingFontFamily = -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif

  chart.millCharge.chrome.grid.stroke        = #f1f5f9
  chart.millCharge.chrome.axis.stroke        = #cbd5e1
  chart.millCharge.chrome.tick.stroke        = #e2e8f0
  chart.millCharge.chrome.tickLabel.fill     = #64748b
  chart.millCharge.chrome.axisLabel.fill     = #64748b
  chart.millCharge.chrome.title.fill         = #0f172a
  chart.millCharge.chrome.annotation.fill    = #1e293b
  chart.millCharge.chrome.polarGrid.stroke   = #e2e8f0
  chart.millCharge.chrome.disc.background    = #0d1a2e
  chart.millCharge.chrome.disc.shellStroke   = #64748b
  chart.millCharge.chrome.disc.centerFill    = #475569
  chart.millCharge.typography.bodyFontFamily = -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif
  chart.millCharge.typography.headingFontFamily = -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif

