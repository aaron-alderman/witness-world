import desire/v3-alpha

// ── Mill liner force model ─────────────────────────────────────────────────────
//
// ONE model over a `method` axis (faithful | grounded). Most of it is honest
// dataflow that stays in the IR; the faithful/grounded duality reduces to a
// method-keyed sign (tangential_sign) plus THREE irreducible numerical kernels
// at the symmetry break — fill_angle, gravity_area, cf_mass_moment — lowered to
// app/chart-functions/mill-force-kernels.js. Faithful to
// example-ports/engentus/js/mill_force_model.js (DEFAULT_INPUTS).

model MillForce {
  // ── axes ──
  axis segment = sweep(1, N_segments, 1)
  axis method  = category(faithful, grounded)
  axis sample  = ensemble(n_samples)
  axis guidePoint = sweep(0, 1, 1)

  // ── params (DEFAULT_INPUTS) ──
  param percent_crit   = 0.9
  param mu             = 0.3
  param radius         = 6.0
  param beta_prime_deg = 50.0
  param N_segments     = 39
  param J_total        = 0.3
  param J_balls        = 0.1
  param J_voids        = 0.4
  param percent_solids = 0.75
  param rho_ball       = 7.8
  param rho_ore        = 3.1
  param g              = 9.81
  param depth          = 1.5
  param m_liner        = 0.0
  param height         = 0.5
  param active_method  = grounded
  param mc_method      = grounded
  param analysis_mode  = static
  param n_samples      = 200
  param mc_J_total_free        = false
  param mc_percent_crit_free   = false
  param mc_percent_solids_free = false
  param mc_height_free         = false

  // ── honest geometry (stays in IR) ──
  derive omega   = sqrt(g / radius) * percent_crit
  derive rInner  = radius - height
  derive rCompareMid = rInner + height / 2
  derive dTheta  = 2 * pi / N_segments
  derive J_ore   = J_total - J_balls
  derive rho_pulp  = rho_ore / ((1 - percent_solids) * rho_ore + percent_solids)
  derive rhoCharge = (J_balls / J_total * rho_ball + J_ore / J_total * rho_ore) * (1 - J_voids) + J_voids * rho_pulp
  derive beta  = (90 - beta_prime_deg) * pi / 180
  derive alpha = atan(mu)
  derive phi   = asin(sin(beta + alpha) * omega^2 * radius / g) + alpha + beta

  // ── fill angle: the FIRST kernel (grid vs root-find) ──
  derive gamma    = fill_angle(J_total, radius, height, method) over method
  derive phiPrime = phi - gamma over method

  // ── fill chord (honest: polar→cartesian slope/intercept) ──
  derive x1 = rInner * sin(phi)
  derive y1 = 0 - rInner * cos(phi)
  derive x2 = rInner * sin(phiPrime) over method
  derive y2 = 0 - rInner * cos(phiPrime) over method
  derive mFill = (y2 - y1) / (x2 - x1) over method
  derive cFill = y1 - mFill * x1 over method

  // ── per-segment angles (honest) ──
  derive t1   = phi - dTheta * (segment - 1) over segment
  derive t2   = max(phiPrime, t1 - dTheta) over segment, method
  derive tBar = (t1 + t2) / 2 over segment, method
  derive display_angle_deg = physical_display_deg(segment, phi, dTheta) over segment
  reduce phiPrimeGrounded = pick_grounded(phiPrime) over method
  derive charge_zone_phi_deg = force_chart_display_deg(phi)
  derive charge_zone_phi_prime_deg = force_chart_display_deg(phiPrimeGrounded)
  derive charge_zone_x0 = min(charge_zone_phi_deg, charge_zone_phi_prime_deg)
  derive charge_zone_x1 = max(charge_zone_phi_deg, charge_zone_phi_prime_deg)
  derive force_zero_kN = 0

  // ── per-segment charge mass: gravity_area is the SECOND kernel ──
  derive A_gravity = gravity_area(t1, t2, rInner, radius, mFill, cFill, dTheta, phi, phiPrime, method) over segment, method
  derive m_charge  = A_gravity * depth * rhoCharge * 1000 over segment, method
  derive m_total   = m_charge + m_liner over segment, method

  // ── gravity force (honest; tangential sign is the parameterised half) ──
  derive Fw_r = cos(tBar) * m_total * g over segment, method
  derive Fw_t = tangential_sign(method) * sin(tBar) * m_total * g over segment, method

  // ── centrifugal force: cf_mass_moment is the THIRD kernel ──
  derive M_cf = cf_mass_moment(t1, t2, rInner, radius, mFill, cFill, dTheta, phi, phiPrime, depth, rhoCharge, method) over segment, method
  derive Fc_r = omega^2 * (M_cf + radius * m_liner) over segment, method

  // ── resultant (honest) ──
  derive F_r = Fw_r + Fc_r over segment, method
  derive F_t = Fw_t over segment, method
  derive F_resultant = sqrt(F_r^2 + F_t^2) over segment, method
  derive F_r_kN = F_r / 1000 over segment, method
  derive F_t_kN = F_t / 1000 over segment, method
  derive F_resultant_kN = F_resultant / 1000 over segment, method

  // ── scalar readouts for the authored results panel ──
  // Method-indexed values are reduced through the active authored model param,
  // keeping the selection in dataflow rather than a page-local controller.
  derive phiText = deg_text(phi)
  derive omegaText = omega_text(omega)
  derive rhoChargeText = rho_charge_text(rhoCharge)
  reduce gammaActive = pick_method(gamma, active_method) over method
  reduce phiPrimeActive = pick_method(phiPrime, active_method) over method
  derive gammaText = deg_text(gammaActive)
  derive phiPrimeText = deg_text(phiPrimeActive)
  reduce gammaDeltaText = deg_delta_text(gamma) over method
  reduce phiPrimeDeltaText = deg_delta_text(phiPrime) over method
  reduce gammaDeltaPercentText = pct_delta_text(gamma) over method
  reduce phiPrimeDeltaPercentText = pct_delta_text(phiPrime) over method
  reduce F_r_max_by_method = pmax(F_r) over segment
  reduce F_r_max_active = pick_method(F_r_max_by_method, active_method) over method
  derive F_r_max_text = force_kn_text(F_r_max_active)
  reduce F_r_max_delta_text = force_delta_kn_text(F_r_max_by_method) over method
  reduce F_resultant_max_by_method = pmax(F_resultant) over segment
  reduce F_resultant_max_active = pick_method(F_resultant_max_by_method, active_method) over method
  derive F_resultant_max_text = force_kn_text(F_resultant_max_active)
  derive F_resultant_scale_max_text = force_kn0_text(F_resultant_max_active)
  reduce F_resultant_min_by_method = pmin(F_resultant) over segment
  reduce F_resultant_min_active = pick_method(F_resultant_min_by_method, active_method) over method
  derive F_resultant_scale_min_text = force_kn0_text(F_resultant_min_active)
  derive F_resultant_scale_title = force_abs_label()
  reduce F_resultant_max_delta_text = force_delta_kn_text(F_resultant_max_by_method) over method

  // ── cross-section force bars (reference straight-sided radial rectangles) ──
  derive F_r_abs = abs(F_r) over segment, method
  reduce F_r_abs_max_all = pmax(F_r_abs) over segment, method
  derive force_bar_half_width = dTheta * 0.25
  derive force_bar_theta0 = tBar - force_bar_half_width over segment, method
  derive force_bar_theta1 = tBar + force_bar_half_width over segment, method
  derive force_bar_max_len = radius * 0.55
  derive force_bar_len = F_r_abs / max(F_r_abs_max_all, 1) * force_bar_max_len over segment, method
  derive force_bar_inner = max(0, rInner - force_bar_len) over segment, method

  // ── cross-section reference guide geometry ──
  derive fill_chord_theta = phi + (phiPrime - phi) * guidePoint over guidePoint, method
  derive fill_chord_r = rInner over guidePoint
  derive radial_guide_r = radius * guidePoint over guidePoint
  derive shoulder_guide_theta = phi over guidePoint
  derive toe_guide_theta = phiPrime over guidePoint, method
  derive angle_label_r = radius * 1.06
  derive cardinal_label_r = radius * 1.13

  // ── Monte Carlo cross-section overlay ──
  //
  // The reference overlays p10/p90 radial-force bars on the cross-section. The
  // authored version keeps that as dataflow: sample the same four MC controls,
  // run the grounded force chain per sample, then collapse the sample axis into
  // segment-wise percentile radii consumed by the existing annular-wedge mark.
  derive J_total_s = normal_param(sample, J_total, mc_J_total_free, 0.030, 11) over sample
  derive percent_crit_s = normal_param(sample, percent_crit, mc_percent_crit_free, 0.050, 17) over sample
  derive percent_solids_s = normal_param(sample, percent_solids, mc_percent_solids_free, 0.050, 23) over sample
  derive height_s = normal_param(sample, height, mc_height_free, 0.020, 31) over sample
  derive omega_s = sqrt(g / radius) * percent_crit_s over sample
  derive rInner_s = radius - height_s over sample
  derive J_ore_s = J_total_s - J_balls over sample
  derive rho_pulp_s = rho_ore / ((1 - percent_solids_s) * rho_ore + percent_solids_s) over sample
  derive rhoCharge_s = (J_balls / J_total_s * rho_ball + J_ore_s / J_total_s * rho_ore) * (1 - J_voids) + J_voids * rho_pulp_s over sample
  derive phi_s = asin(sin(beta + alpha) * omega_s^2 * radius / g) + alpha + beta over sample
  derive gamma_s = fill_angle(J_total_s, radius, height_s, mc_method) over sample
  derive phiPrime_s = phi_s - gamma_s over sample
  derive x1_s = rInner_s * sin(phi_s) over sample
  derive y1_s = 0 - rInner_s * cos(phi_s) over sample
  derive x2_s = rInner_s * sin(phiPrime_s) over sample
  derive y2_s = 0 - rInner_s * cos(phiPrime_s) over sample
  derive mFill_s = (y2_s - y1_s) / (x2_s - x1_s) over sample
  derive cFill_s = y1_s - mFill_s * x1_s over sample
  derive t1_s = phi_s - dTheta * (segment - 1) over segment, sample
  derive t2_s = max(phiPrime_s, t1_s - dTheta) over segment, sample
  derive tBar_s = (t1_s + t2_s) / 2 over segment, sample
  derive A_gravity_s = gravity_area(t1_s, t2_s, rInner_s, radius, mFill_s, cFill_s, dTheta, phi_s, phiPrime_s, mc_method) over segment, sample
  derive m_charge_s = A_gravity_s * depth * rhoCharge_s * 1000 over segment, sample
  derive m_total_s = m_charge_s + m_liner over segment, sample
  derive Fw_r_s = cos(tBar_s) * m_total_s * g over segment, sample
  derive M_cf_s = cf_mass_moment(t1_s, t2_s, rInner_s, radius, mFill_s, cFill_s, dTheta, phi_s, phiPrime_s, depth, rhoCharge_s, mc_method) over segment, sample
  derive Fc_r_s = omega_s^2 * (M_cf_s + radius * m_liner) over segment, sample
  derive F_r_s = Fw_r_s + Fc_r_s over segment, sample
  reduce F_r_p10 = percentile(F_r_s, 10) over sample
  reduce F_r_p90 = percentile(F_r_s, 90) over sample
  derive F_r_p10_abs = abs(F_r_p10) over segment
  derive F_r_p90_abs = abs(F_r_p90) over segment
  reduce F_r_p10_abs_max = pmax(F_r_p10_abs) over segment
  reduce F_r_p90_abs_max = pmax(F_r_p90_abs) over segment
  derive F_r_p10_abs_max_text = force_kn_text(F_r_p10_abs_max)
  derive F_r_p90_abs_max_text = force_kn_text(F_r_p90_abs_max)
  reduce mc_sample_count = count(percent_crit_s) over sample
  derive mc_sample_count_text = samples_computed_text(mc_sample_count)
  reduce tBar_mc = mean(tBar_s) over sample
  reduce rInner_mc = mean(rInner_s) over sample
  derive mc_half_width = dTheta * 0.35
  derive mc_theta0 = tBar_mc - mc_half_width over segment
  derive mc_theta1 = tBar_mc + mc_half_width over segment
  derive mc_bar_max_len = radius * 0.55
  derive mc_p90_len = abs(F_r_p90) / max(F_r_abs_max_all, 1) * mc_bar_max_len over segment
  derive mc_p10_len = abs(F_r_p10) / max(F_r_abs_max_all, 1) * mc_bar_max_len over segment
  derive mc_p90_inner = max(0, rInner_mc - mc_p90_len) over segment
  derive mc_p10_r = max(0, rInner_mc - mc_p10_len) over segment
}
