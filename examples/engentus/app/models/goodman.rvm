import desire/v3-alpha

// ── Goodman bolt-fatigue model ─────────────────────────────────────────────────
//
// A product-type dataflow graph (DESIRE `model` form). Output is a product over
// named axes: `sm` (mean-stress sweep) and `lifetime` (the band boundaries).
// Goodman has NO symmetry break — every leaf below is an honest composition of
// std-lib functions (sn_hannover, goodman_sa, …). The only helper-level
// symmetry break in this model is the visual Goodman band-zone selection:
// current dataflow has no indexed/case expression, so the four reference
// background zones are selected by app-owned pure helpers rather than by a
// shell/controller runtime.

model BoltFatigue {
  // ── axes: the named dimensions of the output tensor ──
  axis sm       = sweep(0, 650, 1.6)
  axis lifetime = category(0.5, 2, 6)
  axis band_zone = category(0, 1, 2, 3)
  axis cloud_sample = ensemble(120)

  // ── params (scalars; the `sample` ensemble axis attaches a dist later) ──
  param rpm                 = 11
  param sigma_lim           = 50
  param m_slope             = 4.6
  param uts                 = 1040
  param ys                  = 600
  param preload_stress_MPa  = 600
  param F_alt_applied_N     = 10000
  param n_bolts             = 4
  param n_interfaces        = 2
  param mu_joint            = 0.30
  param angular_span_factor = 1.0
  param A_s_nom             = 0.001473
  param preload_utilisation = 0.65
  param L_grip              = 0.105
  param D_Shank             = 0.048
  param D_minor             = 0.041
  param E_bolt_GPa          = 200
  param head_direction      = 0
  param length_factor       = 1.190
  param rubber_shoreA       = 70
  param rubber_nu           = 0.49
  param rubber_area_m2      = 0.020
  param rubber_thickness_m  = 0.010
  param probe_sm            = 300

  // ── Goodman background bands (pure composition over sm × lifetime) ──
  derive cycles    = months_to_cycles(lifetime, rpm) over lifetime
  derive fat_limit = sn_hannover(cycles, sigma_lim, m_slope) over lifetime
  derive band      = goodman_sa(sm, fat_limit, uts, ys) over sm, lifetime
  derive fat_limit_0_5 = sn_hannover(months_to_cycles(0.5, rpm), sigma_lim, m_slope)
  derive fat_limit_2 = sn_hannover(months_to_cycles(2, rpm), sigma_lim, m_slope)
  derive fat_limit_6 = sn_hannover(months_to_cycles(6, rpm), sigma_lim, m_slope)
  derive band_zone_y0 = goodman_band_y0(band_zone, sm, fat_limit_0_5, fat_limit_2, fat_limit_6, uts, ys) over sm, band_zone
  derive band_zone_y1 = goodman_band_y1(band_zone, sm, fat_limit_0_5, fat_limit_2, fat_limit_6, uts, ys) over sm, band_zone

  // ── yield line (chart.js: y = 600 - x) ──
  derive yield_line = ys - sm over sm

  // ── bolt mechanical response: stiffness-share γ → F_shear → σa(sm) ──
  derive E_r0     = shore_a_to_E_pa(rubber_shoreA)
  derive G_r      = E_r0 / (2 * (1 + rubber_nu))
  derive k_rub    = G_r * rubber_area_m2 / rubber_thickness_m
  derive I_shank  = pi * D_Shank^4 / 64
  derive k_blt    = bolt_bending_stiffness(E_bolt_GPa * 1e9, I_shank, L_grip, head_direction) * n_bolts
  derive gamma    = k_blt / (k_blt + k_rub)
  derive k_jemtec = 44e9 * 8846.725e-6 / rubber_thickness_m
  derive gamma_jemtec = k_blt / (k_blt + k_rub + k_jemtec)
  derive F_per_bolt = F_alt_applied_N / n_bolts * angular_span_factor
  derive F_friction = mu_joint * (sm * 1e6 * A_s_nom) * n_interfaces over sm
  derive F_shear    = max(gamma * F_per_bolt, F_per_bolt - F_friction) over sm
  derive F_shear_jemtec = max(gamma_jemtec * F_per_bolt, F_per_bolt - F_friction) over sm
  derive curve      = bolt_bending_sigma_a(F_shear, L_grip, D_Shank, D_minor, head_direction, length_factor) over sm
  derive curve_jemtec = bolt_bending_sigma_a(F_shear_jemtec, L_grip, D_Shank, D_minor, head_direction, length_factor) over sm
  derive damage_per_million = miner_dpc(curve, sm, sigma_lim, m_slope, uts) * 1000000 over sm
  derive damage_per_million_jemtec = miner_dpc(curve_jemtec, sm, sigma_lim, m_slope, uts) * 1000000 over sm

  // ── reference static distribution cloud ──
  //
  // The oracle samples 120 visible/free bolt instances at t=0 and draws small
  // operating-point circles in static/edit modes. Keep this as authored
  // dataflow, not a page-local canvas/controller path.
  derive cloud_preload_stress = normal_salt(cloud_sample, preload_stress_MPa, 30, 101) over cloud_sample
  derive cloud_preload_utilisation = uniform_salt(cloud_sample, 0.50, 0.85, 103) over cloud_sample
  derive cloud_F_alt_applied_N = normal_salt(cloud_sample, F_alt_applied_N, 1000, 107) over cloud_sample
  derive cloud_mu_joint = normal_salt(cloud_sample, mu_joint, 0.025, 109) over cloud_sample
  derive cloud_rubber_shoreA = normal_salt(cloud_sample, rubber_shoreA, 2.5, 113) over cloud_sample
  derive cloud_rubber_thickness_m = normal_salt(cloud_sample, rubber_thickness_m, 0.0005, 127) over cloud_sample
  derive cloud_L_grip = normal_salt(cloud_sample, L_grip, 0.0025, 131) over cloud_sample
  derive cloud_sigma_m = cloud_preload_stress * cloud_preload_utilisation over cloud_sample
  derive cloud_E_r0 = shore_a_to_E_pa(cloud_rubber_shoreA) over cloud_sample
  derive cloud_G_r = cloud_E_r0 / (2 * (1 + rubber_nu)) over cloud_sample
  derive cloud_k_rub = cloud_G_r * rubber_area_m2 / cloud_rubber_thickness_m over cloud_sample
  derive cloud_I_shank = pi * D_Shank^4 / 64
  derive cloud_k_blt = bolt_bending_stiffness(E_bolt_GPa * 1e9, cloud_I_shank, cloud_L_grip, head_direction) * n_bolts over cloud_sample
  derive cloud_gamma = cloud_k_blt / (cloud_k_blt + cloud_k_rub) over cloud_sample
  derive cloud_k_jemtec = 44e9 * 8846.725e-6 / cloud_rubber_thickness_m over cloud_sample
  derive cloud_gamma_jemtec = cloud_k_blt / (cloud_k_blt + cloud_k_rub + cloud_k_jemtec) over cloud_sample
  derive cloud_F_per_bolt = cloud_F_alt_applied_N / n_bolts * angular_span_factor over cloud_sample
  derive cloud_F_friction = cloud_mu_joint * (cloud_sigma_m * 1e6 * A_s_nom) * n_interfaces over cloud_sample
  derive cloud_F_shear = max(cloud_gamma * cloud_F_per_bolt, cloud_F_per_bolt - cloud_F_friction) over cloud_sample
  derive cloud_F_shear_jemtec = max(cloud_gamma_jemtec * cloud_F_per_bolt, cloud_F_per_bolt - cloud_F_friction) over cloud_sample
  derive cloud_sigma_a = bolt_bending_sigma_a(cloud_F_shear, cloud_L_grip, D_Shank, D_minor, head_direction, length_factor) over cloud_sample
  derive cloud_sigma_a_jemtec = bolt_bending_sigma_a(cloud_F_shear_jemtec, cloud_L_grip, D_Shank, D_minor, head_direction, length_factor) over cloud_sample

  // ── reference chart labels / probe markers as authored scalar geometry ──
  derive probe_F_friction = mu_joint * (probe_sm * 1e6 * A_s_nom) * n_interfaces
  derive probe_F_shear = max(gamma * F_per_bolt, F_per_bolt - probe_F_friction)
  derive curve_probe = bolt_bending_sigma_a(probe_F_shear, L_grip, D_Shank, D_minor, head_direction, length_factor)
  derive probe_damage_per_million = miner_dpc(curve_probe, probe_sm, sigma_lim, m_slope, uts) * 1000000
  derive probe_mean_stress_text = mpa_text(probe_sm)
  derive probe_alt_stress_text = mpa_text(curve_probe)
  derive probe_shear_text = newton_text(probe_F_shear)
  derive probe_damage_text = damage_per_million_text(probe_damage_per_million)
  derive curve_label_x = 533
  derive curve_label_F_friction = mu_joint * (curve_label_x * 1e6 * A_s_nom) * n_interfaces
  derive curve_label_F_shear = max(gamma * F_per_bolt, F_per_bolt - curve_label_F_friction)
  derive curve_label_F_shear_jemtec = max(gamma_jemtec * F_per_bolt, F_per_bolt - curve_label_F_friction)
  derive curve_label_y = bolt_bending_sigma_a(curve_label_F_shear, L_grip, D_Shank, D_minor, head_direction, length_factor)
  derive curve_label_jemtec_x = 533
  derive curve_label_jemtec_y = bolt_bending_sigma_a(curve_label_F_shear_jemtec, L_grip, D_Shank, D_minor, head_direction, length_factor)
  derive yield_label_x = ys * 0.38
  derive yield_label_y = ys * 0.62

  // ── slip threshold: friction yields to bending (vertical rule, scalar) ──
  derive slip = F_per_bolt / (mu_joint * 1e6 * A_s_nom * n_interfaces)
  derive slip_label_x = slip + 3
  derive slip_label_y = 5
  derive slip_threshold_text = slip_text(slip)
}

// ── Goodman bolt-fatigue, Monte-Carlo sibling ──────────────────────────────────
//
// The SAME honest bolt-response composition as BoltFatigue (zero kernels), now over an
// added `sample = ensemble(N)` axis: the applied alternating force is drawn per sample
// from a lognormal (the injected seeded `lognormal` sampler), propagated through the
// model, and collapsed back to p10/p50/p90 σa bands with `reduce … over sample`. This is
// the Monte-Carlo proof: stochasticity is "just another axis" + an injected sampler, and
// the percentile reductions are generic stats in the evaluator. BoltFatigue itself is
// untouched (its deterministic 1e-6 proof + page stay pristine).

model BoltFatigueMC {
  // ── axes: the mean-stress sweep × the ensemble of samples ──
  axis sm     = sweep(0, 650, 1.6)
  axis sample = ensemble(n_samples)

  // ── ensemble config ──
  param n_samples   = 96
  param F_alt_sigma = 0.12

  // ── mechanical params (same as BoltFatigue) ──
  param F_alt_applied_N     = 10000
  param n_bolts             = 4
  param n_interfaces        = 2
  param mu_joint            = 0.30
  param angular_span_factor = 1.0
  param A_s_nom             = 0.001473
  param L_grip              = 0.105
  param D_Shank             = 0.048
  param D_minor             = 0.041
  param E_bolt_GPa          = 200
  param head_direction      = 0
  param length_factor       = 1.190
  param rubber_shoreA       = 70
  param rubber_nu           = 0.49
  param rubber_area_m2      = 0.020
  param rubber_thickness_m  = 0.010

  // ── stiffness-share γ + friction (honest composition; same chain as BoltFatigue) ──
  derive E_r0       = shore_a_to_E_pa(rubber_shoreA)
  derive G_r        = E_r0 / (2 * (1 + rubber_nu))
  derive k_rub      = G_r * rubber_area_m2 / rubber_thickness_m
  derive I_shank    = pi * D_Shank^4 / 64
  derive k_blt      = bolt_bending_stiffness(E_bolt_GPa * 1e9, I_shank, L_grip, head_direction) * n_bolts
  derive gamma      = k_blt / (k_blt + k_rub)
  derive F_friction = mu_joint * (sm * 1e6 * A_s_nom) * n_interfaces over sm

  // ── sampled input → per-sample bolt response (the ensemble propagation) ──
  derive F_alt_s      = lognormal(sample, F_alt_applied_N, F_alt_sigma) over sample
  derive F_per_bolt_s = F_alt_s / n_bolts * angular_span_factor over sample
  derive F_shear_s    = max(gamma * F_per_bolt_s, F_per_bolt_s - F_friction) over sm, sample
  derive curve_s      = bolt_bending_sigma_a(F_shear_s, L_grip, D_Shank, D_minor, head_direction, length_factor) over sm, sample

  // ── reductions: collapse the sample axis into percentile bands over sm ──
  reduce sa_p10 = percentile(curve_s, 10) over sample
  reduce sa_p50 = percentile(curve_s, 50) over sample
  reduce sa_p90 = percentile(curve_s, 90) over sample
  reduce mc_sample_count = count(F_alt_s) over sample
  reduce mc_sa_p10_min = pmin(sa_p10) over sm
  reduce mc_sa_p50_mean = mean(sa_p50) over sm
  reduce mc_sa_p50_std = std(sa_p50) over sm
  reduce mc_sa_p90_max = pmax(sa_p90) over sm
  derive mc_sample_count_text = integer_text(mc_sample_count)
  derive mc_sa_p10_min_text = mpa_text(mc_sa_p10_min)
  derive mc_sa_p50_mean_text = mpa_text(mc_sa_p50_mean)
  derive mc_sa_p50_std_text = mpa_text(mc_sa_p50_std)
  derive mc_sa_p90_max_text = mpa_text(mc_sa_p90_max)
}
