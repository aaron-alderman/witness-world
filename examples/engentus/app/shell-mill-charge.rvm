import desire/v3-alpha

view MillChargeParameterTitle {
  kind text
  class ssec-title
  prop tag = "div"
  prop text = "Mill Parameters"
}

view MillChargeSpeedLabel {
  kind text
  class plabel
  prop tag = "span"
  prop text = "Speed N/N_c"
}

view MillChargeSpeedValue {
  kind text
  class pval
  prop tag = "span"
  prop domId = "mill-pval-speedFrac"
  prop text = "75%"
  bindings {
    text from projection MillChargeSpeedText
  }
}

view MillChargeSpeedTop {
  kind row
  class prow-top
  children {
    MillChargeSpeedLabel
    MillChargeSpeedValue
  }
}

view MillChargeSpeedInput {
  kind input
  class mill-slider
  prop tag = "input"
  prop domId = "mill-param-speedFrac"
  prop inputType = "range"
  prop min = 0.40
  prop max = 0.99
  prop step = 0.01
  prop value = 0.75
  bindings {
    value from state MillChargeSpeedFrac
  }
  interactions {
    on input self set MillChargeSpeedFrac eventValue
  }
}

view MillChargeSpeedRow {
  kind control-row
  class prow
  children {
    MillChargeSpeedTop
    MillChargeSpeedInput
  }
}

view MillChargeFillLabel {
  kind text
  class plabel
  prop tag = "span"
  prop text = "Fill fraction J"
}

view MillChargeFillValue {
  kind text
  class pval
  prop tag = "span"
  prop domId = "mill-pval-fillFrac"
  prop text = "30%"
  bindings {
    text from projection MillChargeFillText
  }
}

view MillChargeFillTop {
  kind row
  class prow-top
  children {
    MillChargeFillLabel
    MillChargeFillValue
  }
}

view MillChargeFillInput {
  kind input
  class mill-slider
  prop tag = "input"
  prop domId = "mill-param-fillFrac"
  prop inputType = "range"
  prop min = 0.10
  prop max = 0.50
  prop step = 0.01
  prop value = 0.30
  bindings {
    value from state MillChargeFillFrac
  }
  interactions {
    on input self set MillChargeFillFrac eventValue
  }
}

view MillChargeFillRow {
  kind control-row
  class prow
  children {
    MillChargeFillTop
    MillChargeFillInput
  }
}

view MillChargeSlurryLabel {
  kind text
  class plabel
  prop tag = "span"
  prop text = "Slurry content S_w"
}

view MillChargeSlurryValue {
  kind text
  class pval
  prop tag = "span"
  prop domId = "mill-pval-slurryContent"
  prop text = "0.20"
  bindings {
    text from projection MillChargeSlurryText
  }
}

view MillChargeSlurryTop {
  kind row
  class prow-top
  children {
    MillChargeSlurryLabel
    MillChargeSlurryValue
  }
}

view MillChargeSlurryInput {
  kind input
  class mill-slider
  prop tag = "input"
  prop domId = "mill-param-slurryContent"
  prop inputType = "range"
  prop min = 0.00
  prop max = 1.00
  prop step = 0.01
  prop value = 0.20
  bindings {
    value from state MillChargeSlurryContent
  }
  interactions {
    on input self set MillChargeSlurryContent eventValue
  }
}

view MillChargeSlurryRow {
  kind control-row
  class prow
  children {
    MillChargeSlurryTop
    MillChargeSlurryInput
  }
}

view MillChargeWallFrictionLabel {
  kind text
  class plabel
  prop tag = "span"
  prop text = "Wall friction μ"
}

view MillChargeWallFrictionValue {
  kind text
  class pval
  prop tag = "span"
  prop domId = "mill-pval-wallFriction"
  prop text = "0.50"
  bindings {
    text from projection MillChargeWallFrictionText
  }
}

