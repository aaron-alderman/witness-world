view MillForceModelTitle {
  kind text
  class ssec-title
  prop tag = "div"
  prop text = "Model"
}

view MillForceModelGroundedInput {
  kind input
  prop tag = "input"
  prop inputType = "radio"
  prop name = "mill-force-model-sel"
  prop value = "grounded"
  bindings {
    checked from state MillForceActiveModel map grounded true default false
  }
  interactions {
    on change self deliver MillForceSelectGroundedModelRequested
  }
}

view MillForceModelGroundedText {
  kind text
  class mill-force-model-grounded-text
  prop tag = "span"
  prop text = "Grounded"
}

view MillForceModelGroundedLabel {
  kind label
  class mill-force-model-option
  prop tag = "label"
  children {
    MillForceModelGroundedInput
    MillForceModelGroundedText
  }
}

view MillForceModelFaithfulInput {
  kind input
  prop tag = "input"
  prop inputType = "radio"
  prop name = "mill-force-model-sel"
  prop value = "faithful"
  bindings {
    checked from state MillForceActiveModel map faithful true default false
  }
  interactions {
