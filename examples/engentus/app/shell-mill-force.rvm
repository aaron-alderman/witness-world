view MillForceMcRunAction {
  kind action
  class rbtn go
  prop tag = "button"
  prop buttonType = "button"
  prop label = "▶ Run"
  interactions {
    on click self deliver MillForceRunMonteCarloRequested
  }
}

view MillForceMcClearAction {
  kind action
  class rbtn stop
  prop tag = "button"
  prop buttonType = "button"
  prop label = "✕ Clear"
  prop disabled = true
  bindings {
    disabled from state MillForceMcStatusState map running false default true
  }
  interactions {
    on click self deliver MillForceClearMonteCarloRequested
  }
}

view MillForceMcActions {
  kind action-row
  class run-row
  children {
    MillForceMcRunAction
    MillForceMcClearAction
  }
}

view MillForceMcStatusReadyText {
  kind text
  class mill-force-rd
  prop tag = "span"
  prop text = "Ready"
  bindings {
    visible from state MillForceMcStatusState map ready true default false
  }
}

view MillForceMcStatusCalculatingText {
  kind text
  class mill-force-rd
  prop tag = "span"
  prop text = "Running…"
  bindings {
    visible from state MillForceMcStatusState map calculating true default false
  }
}

