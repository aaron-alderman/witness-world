  kind text
  prop tag = "span"
  prop text = "Monte Carlo Config"
}

view MillForceMcChevron {
  kind text
  prop tag = "span"
  prop text = "▼"
  bindings {
    text from state MillForceMcConfigOpen map true "▲" default "▼"
  }
}

view MillForceMcTitleText {
  kind action
  class ssec-title mill-force-mc-toggle
  prop tag = "div"
  interactions {
    on click self set MillForceMcConfigOpen toggle
  }
  children {
    MillForceMcTitleLabel
    MillForceMcChevron
  }
}

view MillForceMcSamplesRow {
  kind form-field
  class mc-row
  prop label = "Samples"
  prop inputType = "number"
  prop inputId = "mill-force-mc-n"
  prop inputStyle = "width:70px"
  prop min = 50
  prop max = 2000
  prop step = 50
  prop value = 200
  bindings {
    value from state MillForceMcSamples
  }
  interactions {
    on input self set MillForceMcSamples eventValue
  }
}

