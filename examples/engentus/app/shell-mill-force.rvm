import desire/v3-alpha

view MillForceModeTitle {
  kind text
  class ssec-title
  prop tag = "div"
  prop text = "Analysis Mode"
}

view MillForceModeSingle {
  kind action
  class mill-force-pill
  prop tag = "button"
  prop buttonType = "button"
  prop label = "Single"
  bindings {
    className from state MillForceActiveAnalysisMode map static active default ""
  }
  interactions {
    on click self deliver MillForceShowSingleModeRequested
  }
}

view MillForceModeCompare {
  kind action
  class mill-force-pill
  prop tag = "button"
  prop buttonType = "button"
  prop label = "Compare"
  bindings {
    className from state MillForceActiveAnalysisMode map compare active default ""
  }
  interactions {
    on click self deliver MillForceShowCompareModeRequested
  }
}

view MillForceModeMonteCarlo {
  kind action
  class mill-force-pill
  prop tag = "button"
  prop buttonType = "button"
  prop label = "Monte Carlo"
  bindings {
    className from state MillForceActiveAnalysisMode map mc active default ""
  }
  interactions {
    on click self deliver MillForceShowMonteCarloModeRequested
  }
}

view MillForceModePills {
  kind action-row
  class mill-force-mode-pills
  children {
    MillForceModeSingle
    MillForceModeCompare
    MillForceModeMonteCarlo
  }
}

view MillForceModeSection {
  kind section
  class ssec
  children {
    MillForceModeTitle
    MillForceModePills
  }
}

view MillForceInputsTitle {
  kind text
  class ssec-title
  prop tag = "div"
  prop text = "Inputs"
}

view MillForceSpeedLabel {
  kind text
  class plabel
  prop tag = "span"
  prop text = "Speed N/Nc"
}

view MillForceSpeedValue {
  kind text
  class pval
  prop tag = "span"
  prop text = "0.90"
  bindings {
    text from projection MillForcePercentCritText
  }
}

view MillForceSpeedTop {
  kind row
  class prow-top
  children {
    MillForceSpeedLabel
    MillForceSpeedValue
  }
}

view MillForceSpeedInput {
  kind input
  class mill-force-slider
  prop tag = "input"
  prop inputType = "range"
  prop min = 0.50
  prop max = 1.00
  prop step = 0.01
  prop value = 0.90
  bindings {
    value from state MillForcePercentCrit
  }
  interactions {
    on input self set MillForcePercentCrit eventValue
  }
}

view MillForceSpeedRow {
  kind control-row
  class prow
  children {
    MillForceSpeedTop
    MillForceSpeedInput
  }
}

view MillForceMuLabel {
  kind text
  class plabel
  prop tag = "span"
