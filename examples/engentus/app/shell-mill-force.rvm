  class mill-force-controls
  prop domId = "mill-force-sb"
  prop scrollDomId = "mill-force-sb-scroll"
  children {
    MillForceControlHost
    MillForceModelHost
  }
}

view MillForceTabCrossSection {
  kind tab
  class mill-force-cht-tab
  prop label = "Cross-section"
  prop tabKey = "cross"
  bindings {
    className from state MillForceActiveChartTab map cross active default ""
  }
  interactions {
    on click self deliver MillForceShowCrossSectionRequested
  }
}

view MillForceTabForceVsAngle {
  kind tab
  class mill-force-cht-tab
  prop label = "Force vs Angle"
  prop tabKey = "force"
  bindings {
    className from state MillForceActiveChartTab map force active default ""
  }
  interactions {
    on click self deliver MillForceShowForceVsAngleRequested
  }
}

view MillForceTabForceRose {
  kind tab
  class mill-force-cht-tab
  prop label = "Force Rose"
  prop tabKey = "rose"
  bindings {
    className from state MillForceActiveChartTab map rose active default ""
  }
  interactions {
    on click self deliver MillForceShowForceRoseRequested
  }
}

view MillForceTabs {
  kind tab-strip
  class mill-force-chart-tabs
  prop domId = "mill-force-chart-tabs"
  children {
    MillForceTabCrossSection
    MillForceTabForceVsAngle
    MillForceTabForceRose
  }
}

view MillForceChartWrap {
  kind viewer
  class mill-force-chart-wrap
  prop domId = "mill-force-chart-wrap"
  children {
    MillForceCross
    MillForceAngle
    MillForceRose
  }
}

view MillForceChartArea {
  kind viewer
  class mill-force-viewer
  prop domId = "mill-force-chart-area"
  children {
    MillForceTabs
    MillForceChartWrap
  }
}

view MillForceBody {
  kind body
  class mill-force-body
  prop domId = "mill-force-body"
  children {
    MillForceSidebar
    MillForceChartArea
  }
}

view EngentusMillForceApp {
  kind app-shell
  class engentus-mill-force
  process EngentusShellNavigation
  capabilities {
    chart.render
  }
  prop domId = "view-mill-force"
  prop documentTitle = "Mill Force Analysis"
  prop routeKey = "mill-force"
  prop routePath = "/engentus/mill-force"
  prop mountMode = "mounted-panel"
  children {
    EngentusModuleChrome
    MillForceBody
  }
}




