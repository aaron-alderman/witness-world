  prop tag = "input"
  prop inputType = "range"
  prop min = 5
  prop max = 20
  prop step = 0.5
  prop value = 11
  bindings {
    value from state GoodmanStaticRpm
  }
  interactions {
    on input self set GoodmanStaticRpm eventValue
  }
}

