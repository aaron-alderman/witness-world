import desire/v3-alpha

view GoodmanModeStatic {
  kind toolbar-mode
  class mode-btn
  prop tag = "button"
  prop buttonType = "button"
  prop label = "Static"
  prop modeKey = "static"
  bindings {
    className from state GoodmanActiveMode map static on default ""
  }
  interactions {
    on click self deliver GoodmanShowStaticRequested
  }
}

view GoodmanModeMonteCarlo {
  kind toolbar-mode
  class mode-btn
  prop tag = "button"
  prop buttonType = "button"
  prop label = "Monte Carlo"
  prop modeKey = "mc"
  bindings {
    className from state GoodmanActiveMode map mc on default ""
  }
  interactions {
    on click self deliver GoodmanShowMonteCarloRequested
  }
}

view GoodmanModeEdit {
  kind toolbar-mode
  class mode-btn
  prop tag = "button"
  prop buttonType = "button"
  prop label = "Edit"
  prop modeKey = "edit"
  bindings {
    className from state GoodmanActiveMode map edit on default ""
  }
  interactions {
    on click self deliver GoodmanShowEditRequested
  }
}

view GoodmanModesToolbar {
  kind toolbar-modes
  class mode-pill goodman-modes
  children {
    GoodmanModeStatic
    GoodmanModeMonteCarlo
    GoodmanModeEdit
  }
}

view GoodmanActionCdf {
  kind toolbar-action
  class tbw goodman-action-cdf
  prop label = "📈 CDF"
  prop actionKey = "cdf"
  prop tag = "button"
  prop buttonType = "button"
  interactions {
    on click self deliver GoodmanToggleCdfWindowRequested
  }
}

view GoodmanActionStats {
  kind toolbar-action
  class tbw goodman-action-stats
  prop label = "📊 Stats"
  prop actionKey = "stats"
  prop tag = "button"
  prop buttonType = "button"
  interactions {
    on click self deliver GoodmanToggleStatsWindowRequested
  }
}

view GoodmanActionAnova {
  kind toolbar-action
  class tbw goodman-action-anova
  prop label = "🔬 ANOVA"
  prop actionKey = "anova"
  prop tag = "button"
  prop buttonType = "button"
  interactions {
    on click self deliver GoodmanToggleAnovaWindowRequested
  }
}

view GoodmanWindowToolbar {
  kind toolbar-actions
  class goodman-window-toolbar
  prop domId = "tb-wins"
  children {
    GoodmanActionCdf
    GoodmanActionStats
    GoodmanActionAnova
  }
}

view GoodmanScenarioTitle {
  kind text
  class ssec-title
  prop tag = "div"
  prop text = "Scenario View"
}

view GoodmanScenarioSection {
  kind section
  class ssec goodman-scenario-section
  bindings {
    visible from state GoodmanActiveMode map static true default false
  }
  children {
    GoodmanScenarioTitle
    GoodmanStaticAppliedShearField
    GoodmanStaticRpmField
    GoodmanStaticEnduranceLimitField
    GoodmanStaticSlopeField
    GoodmanStaticProbeMeanStressField
    GoodmanProbeComparisonBox
    GoodmanSaveStaticSimulationAction
  }
}

view GoodmanStaticAppliedShearLabel {
  kind text
  class plabel
  prop tag = "span"
  prop text = "Applied shear F"
}

view GoodmanStaticAppliedShearValue {
  kind text
  class pval
  prop tag = "span"
  prop text = "10000 N"
  bindings {
    text from projection GoodmanStaticAppliedShearText
  }
}

view GoodmanStaticAppliedShearTop {
  kind row
  class prow-top
  children {
    GoodmanStaticAppliedShearLabel
    GoodmanStaticAppliedShearValue
  }
}

view GoodmanStaticAppliedShearInput {
  kind input
  class goodman-static-control-input
  prop tag = "input"
  prop inputType = "range"
  prop min = 500
  prop max = 100000
  prop step = 500
  prop value = 10000
  bindings {
    value from state GoodmanStaticAppliedShear
  }
  interactions {
    on input self set GoodmanStaticAppliedShear eventValue
  }
}

view GoodmanStaticAppliedShearField {
  kind control-row
  class prow goodman-static-control
  children {
    GoodmanStaticAppliedShearTop
    GoodmanStaticAppliedShearInput
  }
}

view GoodmanStaticRpmLabel {
  kind text
  class plabel
  prop tag = "span"
  prop text = "Mill speed"
}

view GoodmanStaticRpmValue {
