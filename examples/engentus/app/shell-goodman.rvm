  kind text
  prop tag = "th"
  prop text = "Mean Tf"
}

view GoodmanStatsHeadStd {
  kind text
  prop tag = "th"
  prop text = "Std"
}

view GoodmanStatsHeadP10 {
  kind text
  prop tag = "th"
  prop text = "P10"
}

view GoodmanStatsHeadP50 {
  kind text
  prop tag = "th"
  prop text = "P50"
}

view GoodmanStatsHeadP90 {
  kind text
  prop tag = "th"
  prop text = "P90"
}

view GoodmanStatsTableBody {
  kind table-body
  prop tag = "tbody"
  children {
    GoodmanStatsDataRow
  }
}

view GoodmanStatsDataRow {
  kind table-row
  prop tag = "tr"
  children {
    GoodmanStatsDataSimulation
    GoodmanStatsDataBoltSet
    GoodmanStatsDataN
    GoodmanStatsDataFailed
    GoodmanStatsDataMean
    GoodmanStatsDataStd
    GoodmanStatsDataP10
    GoodmanStatsDataP50
    GoodmanStatsDataP90
  }
}

view GoodmanStatsDataSimulation {
  kind text
  prop tag = "td"
  prop text = "Current run"
}

view GoodmanStatsDataBoltSet {
  kind text
  prop tag = "td"
  prop text = "Primary Bolt Set"
}

view GoodmanStatsDataN {
  kind text
  prop tag = "td"
  prop text = "500"
  bindings {
    text from capability GoodmanMCBands.mc_sample_count_text
  }
}

view GoodmanStatsDataFailed {
  kind text
  prop tag = "td"
  prop text = "-"
}

view GoodmanStatsDataMean {
  kind text
  prop tag = "td"
  prop text = "-"
  bindings {
    text from capability GoodmanMCBands.mc_sa_p50_mean_text
  }
}

view GoodmanStatsDataStd {
  kind text
  prop tag = "td"
  prop text = "-"
  bindings {
    text from capability GoodmanMCBands.mc_sa_p50_std_text
  }
}

view GoodmanStatsDataP10 {
  kind text
  prop tag = "td"
  prop text = "-"
  bindings {
    text from capability GoodmanMCBands.mc_sa_p10_min_text
  }
}

view GoodmanStatsDataP50 {
  kind text
  prop tag = "td"
  prop text = "-"
  bindings {
    text from capability GoodmanMCBands.mc_sa_p50_mean_text
  }
}

view GoodmanStatsDataP90 {
  kind text
  prop tag = "td"
  prop text = "-"
  bindings {
    text from capability GoodmanMCBands.mc_sa_p90_max_text
  }
}

view GoodmanStatsWindow {
  kind floating-window
  class fw goodman-window stats-window
  prop hidden = true
  bindings {
    visible from state GoodmanStatsWindowVisible
  }
  children {
    GoodmanStatsWindowHeader
    GoodmanStatsWindowBody
  }
}

view GoodmanAnovaWindowTitle {
  kind text
  class fw-title
  prop tag = "div"
  prop text = "🔬 ANOVA — Between-Group Comparison"
}

view GoodmanAnovaWindowClose {
  kind action
  class fw-btn
  prop tag = "button"
  prop buttonType = "button"
  prop label = "Close"
  interactions {
    on click self deliver GoodmanCloseAnovaWindowRequested
  }
}

view GoodmanAnovaWindowHeader {
  kind header
  class fw-tb
  children {
    GoodmanAnovaWindowTitle
    GoodmanAnovaWindowClose
  }
}

view GoodmanAnovaWindowBody {
  kind body
  class fw-body
  children {
    GoodmanAnovaEmptyMessage
  }
}

view GoodmanAnovaEmptyMessage {
  kind text
  class goodman-window-empty-message
  prop tag = "p"
  prop text = "Need >=2 groups with failed bolts for ANOVA."
}

view GoodmanAnovaWindow {
  kind floating-window
  class fw goodman-window anova-window
  prop hidden = true
  bindings {
    visible from state GoodmanAnovaWindowVisible
  }
  children {
    GoodmanAnovaWindowHeader
    GoodmanAnovaWindowBody
  }
}

view GoodmanWindowLayer {
  kind window-layer
  class goodman-window-layer
  prop domId = "wl"
  children {
    GoodmanCdfWindow
    GoodmanStatsWindow
    GoodmanAnovaWindow
  }
}

view GoodmanChartArea {
  kind viewer
  class goodman-chart-area
  prop domId = "chart-area"
  children {
    GoodmanScrubber
    GoodmanChartRegion
    GoodmanWindowLayer
  }
}

view GoodmanBody {
  kind body
  class goodman-body
  prop domId = "body"
  children {
    GoodmanSidebar
    GoodmanChartArea
  }
}

view EngentusApp {
  kind app-shell
  class engentus-app
  process EngentusShellNavigation
  capabilities {
    chart.render
  }
  prop domId = "view-goodman"
  prop documentTitle = "Goodman Fatigue Diagram"
  prop routeKey = "goodman"
  prop routePath = "/engentus/goodman"
  prop mountMode = "mounted-panel"
  children {
    EngentusAppChrome
    GoodmanBody
  }
}

