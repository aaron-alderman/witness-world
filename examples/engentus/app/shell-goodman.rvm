  kind group
  class info-box goodman-probe-comparison
  children {
    GoodmanProbeIntro
    GoodmanProbeComparisonRows
  }
}

view GoodmanSaveStaticSimulationAction {
  kind action
  class save-sim-btn
  prop tag = "button"
  prop buttonType = "button"
  prop label = "⊕ Save as Simulation"
  interactions {
    on click self deliver GoodmanSaveStaticSimulationRequested
  }
}

view GoodmanSimulationNewAction {
  kind action
  class add-sim-btn
  prop label = "+ New simulation"
  prop tag = "button"
  prop buttonType = "button"
  interactions {
    on click self deliver GoodmanCreateSimulationRequested
  }
}

view GoodmanSimulationTitleLabel {
  kind text
  prop tag = "span"
  prop text = "Simulations"
}

view GoodmanSimulationTitleNewAction {
  kind section-action
  prop label = "+ New"
  prop tag = "button"
  prop buttonType = "button"
  interactions {
    on click self deliver GoodmanCreateSimulationRequested
  }
}

view GoodmanSimulationTitle {
  kind section-header
  class ssec-title
  children {
    GoodmanSimulationTitleLabel
    GoodmanSimulationTitleNewAction
  }
}

view GoodmanSimulationEmptyState {
  kind text
  class goodman-simulation-empty
  prop tag = "p"
  prop text = "No simulations yet."
}

view GoodmanSimulationList {
  kind list
  class goodman-simulation-list
  children {
    GoodmanSimulationEmptyState
    GoodmanSimulationNewAction
  }
}

view GoodmanSimulationSection {
  kind section
  class ssec goodman-simulation-section
  prop hidden = true
  bindings {
    visible from state GoodmanActiveMode map mc true default false
  }
  children {
    GoodmanSimulationTitle
    GoodmanSimulationList
  }
}

view GoodmanRunConfigBoltsPerSetField {
  kind form-field
  class mc-row goodman-run-field
  prop label = "Bolts per set"
  prop inputType = "number"
  prop inputId = "cfg-n"
  prop value = 500
  prop min = 50
  prop max = 5000
  prop step = 50
  bindings {
    value from state GoodmanRunBoltsPerSet
    disabled from state GoodmanRunStatusState map running true paused true done true default false
  }
  interactions {
    on input self set GoodmanRunBoltsPerSet eventValue
  }
}

view GoodmanRunConfigDurationField {
  kind form-field
  class mc-row goodman-run-field
  prop label = "Duration (months)"
  prop inputType = "number"
  prop inputId = "cfg-tmax"
  prop value = 24
  prop min = 3
  prop max = 60
  prop step = 1
  bindings {
    value from state GoodmanRunDurationMonths
    disabled from state GoodmanRunStatusState map running true paused true done true default false
  }
  interactions {
    on input self set GoodmanRunDurationMonths eventValue
  }
}

view GoodmanRunConfigStepField {
  kind form-field
  class mc-row goodman-run-field
  prop label = "Time step (months)"
  prop inputType = "number"
  prop inputId = "cfg-dt"
  prop value = 0.5
  prop min = 0.1
  prop max = 2
  prop step = 0.1
  bindings {
    value from state GoodmanRunStepMonths
    disabled from state GoodmanRunStatusState map running true paused true done true default false
  }
  interactions {
    on input self set GoodmanRunStepMonths eventValue
  }
}

view GoodmanRunActionStart {
  kind action
  class rbtn go
  prop label = "▶ Run"
  prop actionKey = "run"
  prop tag = "button"
  prop buttonType = "button"
  bindings {
    disabled from state GoodmanRunStatusState map running true paused true default false
  }
  interactions {
    on click self deliver GoodmanRunRequested
  }
}

view GoodmanRunActionPause {
  kind action
  class rbtn pause
  prop label = "⏸"
  prop actionKey = "pause"
  prop disabled = true
  prop tag = "button"
  prop buttonType = "button"
  bindings {
    visible from state GoodmanRunStatusState map running true default false
    disabled from state GoodmanRunStatusState map running false default true
  }
  interactions {
    on click self deliver GoodmanPauseRunRequested
  }
}

view GoodmanRunActionResume {
  kind action
  class rbtn pause
  prop label = "▶ Resume"
  prop actionKey = "resume"
  prop hidden = true
  prop tag = "button"
  prop buttonType = "button"
  bindings {
    visible from state GoodmanRunStatusState map paused true default false
    disabled from state GoodmanRunStatusState map paused false default true
  }
  interactions {
    on click self deliver GoodmanResumeRunRequested
  }
}

view GoodmanRunActionStop {
  kind action
  class rbtn stop
  prop label = "■"
  prop actionKey = "stop"
  prop disabled = true
  prop tag = "button"
  prop buttonType = "button"
  bindings {
    disabled from state GoodmanRunStatusState map running false paused false default true
  }
  interactions {
    on click self deliver GoodmanStopRunRequested
  }
}

view GoodmanRunActionGroup {
  kind action-group
  class run-row goodman-run-actions
  children {
    GoodmanRunActionStart
    GoodmanRunActionPause
    GoodmanRunActionResume
    GoodmanRunActionStop
  }
}

view GoodmanRunProgressFill {
  kind progress-fill
  class prog-fill
  prop domId = "prog-fill"
  bindings {
    style from state GoodmanRunStatusState map running "width:0%;background:var(--blue);opacity:1" paused "width:0%;background:var(--blue);opacity:.4" done "width:100%;background:var(--grn);opacity:1" stopped "width:0%;background:var(--ylw);opacity:1" default "width:0%;background:var(--blue);opacity:1"
  }
}

view GoodmanRunProgressLabel {
  kind progress-label
  class prog-lbl
  prop domId = "prog-lbl"
  prop text = "Ready"
  bindings {
    text from state GoodmanRunStatusState map ready Ready running "Running…" paused "⏸ Paused" done "Complete ✓" stopped "■ Stopped" default Ready
  }
}

view GoodmanRunProgress {
  kind progress
  class prog-wrap goodman-run-progress
  children {
    GoodmanRunProgressFill
    GoodmanRunProgressLabel
  }
}

view GoodmanRunLockNote {
  kind note
  class goodman-run-lock-note
  prop text = "Simulation running…"
  prop hidden = true
  bindings {
    visible from state GoodmanRunStatusState map running true paused true done true default false
    text from state GoodmanRunStatusState map running "⏳ Simulation running…" paused "⏸ Simulation paused — config locked" done "🔒 Config locked — clone or create a new simulation to change" default ""
  }
}

view GoodmanRunConfigTitle {
  kind text
  class ssec-title
  prop tag = "div"
  prop text = "Run Config"
}

view GoodmanRunConfigSection {
  kind section
  class ssec goodman-run-config-section
  prop hidden = true
  bindings {
    visible from state GoodmanRunConfigVisible map true true default false
  }
  children {
    GoodmanRunConfigTitle
    GoodmanRunConfigBoltsPerSetField
    GoodmanRunConfigDurationField
    GoodmanRunConfigStepField
    GoodmanRunLockNote
    GoodmanRunActionGroup
    GoodmanRunProgress
  }
}

