view GoodmanChartBand1Label {
  kind text
  class efield-label
  prop tag = "label"
  prop text = "Band 1"
}

view GoodmanChartBand1Input {
  kind input
  class efield-input
  prop tag = "input"
  prop inputType = "color"
  prop value = "#bbf7d0"
  bindings {
    value from state GoodmanChartBandFill1
