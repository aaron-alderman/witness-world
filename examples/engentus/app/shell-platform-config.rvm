import desire/v3-alpha

collection PlatformConfigSecrets
collection PlatformConfigDatasources
collection PlatformConfigIdentities
collection PlatformConfigFeaturePolicies
collection PlatformConfigAuthorityGrants
collection PlatformConfigAuthorityActors
collection PlatformConfigAuthRoles
collection PlatformConfigPipelineSyncs
collection PlatformConfigPipelineSchedules
collection PlatformConfigPipelineBindings
collection PlatformConfigPipelineRuns
collection PlatformConfigPipelineChildRuns
collection PlatformConfigPipelineRunLogs

view PlatformConfigSecretOptionTemplate {
  kind option
  prop tag = "option"
  prop value = "${item.id}"
  prop text = "${item.title}"
  prop template = true
}

view PlatformConfigDatasourceOptionTemplate {
  kind option
  prop tag = "option"
  prop value = "${item.id}"
  prop text = "${item.title}"
  prop template = true
}

view PlatformConfigSecretTableRowAction {
  kind action
  prop tag = "button"
  prop buttonType = "button"
  prop value = "${item.id}"
  prop text = "Edit"
  class platform-config-row-action
  interactions {
    on click self set PlatformConfigSecretSelectedId eventValue
    on click self deliver PlatformConfigLoadSecretRequested
  }
}

view PlatformConfigSecretTableRowTemplate {
  kind region
  prop tag = "tr"
  prop template = true
  children {
    PlatformConfigSecretTableRowTitle
    PlatformConfigSecretTableRowStatus
    PlatformConfigSecretTableRowValue
    PlatformConfigSecretTableRowUpdated
    PlatformConfigSecretTableRowActionCell
  }
}

view PlatformConfigSecretTableRowTitle {
  kind text
  prop tag = "td"
  prop text = "${item.title}"
}

view PlatformConfigSecretTableRowStatus {
  kind text
  prop tag = "td"
  prop text = "${item.status}"
}

view PlatformConfigSecretTableRowValue {
  kind text
  prop tag = "td"
  prop text = "${item.hasValueText}"
}

view PlatformConfigSecretTableRowUpdated {
  kind text
  prop tag = "td"
  prop text = "${item.updatedAtText}"
  prop title = "${item.updatedAtTitle}"
}

view PlatformConfigSecretTableRowActionCell {
  kind region
  prop tag = "td"
  children {
    PlatformConfigSecretTableRowAction
  }
}

view PlatformConfigDatasourceTableRowAction {
  kind action
  prop tag = "button"
  prop buttonType = "button"
  prop value = "${item.id}"
  prop text = "Edit"
  class platform-config-row-action
  interactions {
    on click self set PlatformConfigDatasourceSelectedId eventValue
    on click self deliver PlatformConfigLoadDatasourceRequested
  }
}

view PlatformConfigDatasourceTableRowTemplate {
  kind region
  prop tag = "tr"
  prop template = true
  children {
    PlatformConfigDatasourceTableRowTitle
    PlatformConfigDatasourceTableRowProvider
    PlatformConfigDatasourceTableRowStatus
    PlatformConfigDatasourceTableRowTest
    PlatformConfigDatasourceTableRowUpdated
    PlatformConfigDatasourceTableRowActionCell
  }
}

view PlatformConfigDatasourceTableRowTitle {
  kind text
  prop tag = "td"
  prop text = "${item.title}"
}

view PlatformConfigDatasourceTableRowProvider {
  kind text
  prop tag = "td"
  prop text = "${item.providerText}"
}

view PlatformConfigDatasourceTableRowStatus {
  kind text
  prop tag = "td"
  prop text = "${item.status}"
}

view PlatformConfigDatasourceTableRowTest {
  kind text
  prop tag = "td"
  prop text = "${item.lastTestResultText}"
}

view PlatformConfigDatasourceTableRowUpdated {
  kind text
  prop tag = "td"
  prop text = "${item.updatedAtText}"
  prop title = "${item.updatedAtTitle}"
}

view PlatformConfigDatasourceTableRowActionCell {
  kind region
  prop tag = "td"
  children {
    PlatformConfigDatasourceTableRowAction
  }
}

view PlatformConfigPageTitle {
  kind screen-header
  prop tag = "h2"
  class platform-config-title
  prop text = "Platform Config"
}

view PlatformConfigPageIntro {
  kind text
  prop tag = "p"
  class platform-config-intro
  prop text = "Runner-scoped secrets, datasources, and script plumbing are managed here as an authored Engentus app."
}

view PlatformConfigPageHero {
  kind region
  class platform-config-hero
  children {
    PlatformConfigPageTitle
    PlatformConfigPageIntro
  }
}

view PlatformConfigNotice {
  kind text
  prop tag = "div"
  class platform-config-notice
  prop domId = "platform-config-notice"
  bindings {
    text from state PlatformConfigNoticeText
    className from state PlatformConfigNoticeTone map success "platform-config-notice success" error "platform-config-notice error" warn "platform-config-notice warn" default "platform-config-notice"
  }
}

view PlatformConfigSidebarTitle {
  kind text
  prop tag = "h3"
  class platform-config-sidebar-title
  prop text = "Admin Areas"
}

view PlatformConfigSidebarHint {
  kind text
  prop tag = "p"
  class platform-config-sidebar-hint
  prop text = "Route-backed operator tooling for this runner."
}

view PlatformConfigSidebarOperatorAction {
  kind action
  prop tag = "button"
  prop buttonType = "button"
  prop text = "Operator"
  class platform-config-side-link
  bindings {
    className from state EngentusShellActiveRoute map platform-config-operator "platform-config-side-link active" default "platform-config-side-link"
  }
  interactions {
    on click self deliver PlatformConfigOpenOperatorRequested
  }
}

view PlatformConfigSidebarSecretsAction {
  kind action
  prop tag = "button"
  prop buttonType = "button"
  prop text = "Secrets"
  class platform-config-side-link
  bindings {
    className from state EngentusShellActiveRoute map platform-config-secrets "platform-config-side-link active" default "platform-config-side-link"
  }
  interactions {
    on click self deliver PlatformConfigOpenSecretsRequested
  }
}

view PlatformConfigSidebarDatasourcesAction {
  kind action
  prop tag = "button"
  prop buttonType = "button"
  prop text = "Data Sources"
  class platform-config-side-link
  bindings {
    className from state EngentusShellActiveRoute map platform-config-datasources "platform-config-side-link active" default "platform-config-side-link"
  }
  interactions {
    on click self deliver PlatformConfigOpenDatasourcesRequested
  }
}

view PlatformConfigSidebarScriptsAction {
  kind action
  prop tag = "button"
  prop buttonType = "button"
  prop text = "Scripts"
  class platform-config-side-link
  bindings {
    className from state EngentusShellActiveRoute map platform-config-scripts "platform-config-side-link active" default "platform-config-side-link"
  }
  interactions {
    on click self deliver PlatformConfigOpenScriptsRequested
  }
}

view PlatformConfigSidebarAccessAction {
  kind action
  prop tag = "button"
  prop buttonType = "button"
  prop text = "Access"
  class platform-config-side-link
  bindings {
    className from state EngentusShellActiveRoute map platform-config-access "platform-config-side-link active" default "platform-config-side-link"
  }
  interactions {
    on click self deliver PlatformConfigOpenAccessRequested
  }
}

view PlatformConfigSidebarNav {
  kind region
  class platform-config-sidebar-nav
  children {
    PlatformConfigSidebarOperatorAction
    PlatformConfigSidebarSecretsAction
    PlatformConfigSidebarDatasourcesAction
    PlatformConfigSidebarScriptsAction
    PlatformConfigSidebarAccessAction
  }
}

view PlatformConfigSidebar {
  kind aside
  class platform-config-sidebar
  prop domId = "platform-config-sidebar"
  children {
    PlatformConfigSidebarTitle
    PlatformConfigSidebarHint
    PlatformConfigSidebarNav
  }
}

view PlatformConfigOperatorSectionTitle {
  kind text
  prop tag = "h3"
  class platform-config-section-title
  prop text = "Operator Session"
}

view PlatformConfigOperatorSectionIntro {
  kind text
  prop tag = "p"
  class platform-config-hint
  prop text = "This area reflects the signed-in session and runner-scoped platform capability state."
}

view PlatformConfigOperatorSummary {
  kind text
  prop tag = "pre"
  class platform-config-output
  bindings {
    text from state PlatformConfigNoticeText
  }
}

view PlatformConfigOperatorContent {
  kind section
  class platform-config-content-card
  prop domId = "platform-config-operator-content"
  children {
    PlatformConfigOperatorSectionTitle
    PlatformConfigOperatorSectionIntro
    PlatformConfigOperatorSummary
  }
}

view PlatformConfigSectionShell {
  kind region
  class platform-config-section-shell
  children {
    PlatformConfigPageHero
    PlatformConfigNotice
  }
}

view PlatformConfigSecretsSectionTitle {
  kind text
  prop tag = "h3"
  class platform-config-section-title
  prop text = "Secrets"
}

view PlatformConfigSecretsSectionIntro {
  kind text
  prop tag = "p"
  class platform-config-hint
  prop text = "Labels are operator-facing. Internal ids are generated quietly and secret values stay write-only."
}

view PlatformConfigSecretSearchField {
  kind form-field
  class platform-config-field
  prop label = "Search secrets"
  prop inputId = "platform-config-secret-search"
  prop inputClass = "platform-config-input"
  prop placeholder = "Search by label"
  bindings {
    value from state PlatformConfigSecretSearchText
    visible from state PlatformConfigSecretSearchVisible
    disabled from state PlatformConfigSecretBusy
  }
  interactions {
    on input self set PlatformConfigSecretSearchText eventValue
  }
}

view PlatformConfigSecretSearchAction {
  kind action
  class rbtn
  prop tag = "button"
  prop buttonType = "button"
  prop label = "Search"
  bindings {
    visible from state PlatformConfigSecretSearchVisible
    disabled from state PlatformConfigSecretBusy
  }
  interactions {
    on click self deliver PlatformConfigSearchSecretsRequested
  }
}

view PlatformConfigSecretTableHeader {
  kind region
  prop tag = "thead"
  children {
    PlatformConfigSecretTableHeaderRow
  }
}

view PlatformConfigSecretTableHeaderRow {
  kind region
  prop tag = "tr"
  children {
    PlatformConfigSecretTableHeaderTitle
    PlatformConfigSecretTableHeaderStatus
    PlatformConfigSecretTableHeaderValue
    PlatformConfigSecretTableHeaderUpdated
    PlatformConfigSecretTableHeaderActions
  }
}

view PlatformConfigSecretTableHeaderTitle {
  kind text
  prop tag = "th"
  prop text = "Label"
}

view PlatformConfigSecretTableHeaderStatus {
  kind text
  prop tag = "th"
  prop text = "Status"
}

view PlatformConfigSecretTableHeaderValue {
  kind text
  prop tag = "th"
  prop text = "Has Value"
}

view PlatformConfigSecretTableHeaderUpdated {
  kind text
  prop tag = "th"
  prop text = "Updated"
}

view PlatformConfigSecretTableHeaderActions {
  kind text
  prop tag = "th"
  prop text = "Actions"
}

view PlatformConfigSecretTableBody {
  kind region
  prop tag = "tbody"
  prop domId = "platform-config-secret-table-body"
  repeat {
    collection PlatformConfigSecrets
    template PlatformConfigSecretTableRowTemplate
    itemAs item
    indexAs index
  }
}

view PlatformConfigSecretsTable {
  kind region
  prop tag = "table"
  class platform-config-table
  children {
    PlatformConfigSecretTableHeader
    PlatformConfigSecretTableBody
  }
}

view PlatformConfigSecretLabelField {
  kind form-field
  class platform-config-field
  prop label = "Secret label"
  prop inputId = "platform-config-secret-label"
  prop inputClass = "platform-config-input"
  prop placeholder = "Primary Postgres password"
  bindings {
    value from state PlatformConfigSecretLabel
    disabled from state PlatformConfigSecretBusy
  }
  interactions {
    on input self set PlatformConfigSecretLabel eventValue
  }
}

view PlatformConfigSecretValueField {
  kind form-field
  class platform-config-field
  prop label = "Secret value"
  prop inputType = "password"
  prop inputId = "platform-config-secret-value"
  prop inputClass = "platform-config-input"
  prop placeholder = "password"
  bindings {
    value from state PlatformConfigSecretValue
    disabled from state PlatformConfigSecretBusy
  }
  interactions {
    on input self set PlatformConfigSecretValue eventValue
  }
}

view PlatformConfigSecretActions {
  kind region
  class run-row platform-config-actions
  children {
    PlatformConfigSecretNewAction
    PlatformConfigSecretCreateAction
    PlatformConfigSecretOverwriteAction
    PlatformConfigSecretDeleteAction
    PlatformConfigSecretRefreshAction
  }
}

