view PlatformConfigDatasourceUserField {
  kind form-field
  class platform-config-field
  prop label = "User"
  prop inputId = "platform-config-datasource-user"
  prop inputClass = "platform-config-input"
  prop placeholder = "pipeline_user"
  bindings {
    value from state PlatformConfigDatasourceUser
    disabled from state PlatformConfigDatasourceBusy
  }
  interactions {
    on input self set PlatformConfigDatasourceUser eventValue
  }
}

view PlatformConfigDatasourcePasswordSecretLabel {
  kind text
  prop tag = "label"
  class platform-config-field-label
  prop text = "Password secret"
  prop for = "platform-config-datasource-password-secret"
}

view PlatformConfigDatasourcePasswordSecretSelect {
  kind select
  prop tag = "select"
  prop domId = "platform-config-datasource-password-secret"
  class platform-config-input
  bindings {
    value from state PlatformConfigDatasourcePasswordSecretId
    disabled from state PlatformConfigDatasourceBusy
  }
  interactions {
    on change self set PlatformConfigDatasourcePasswordSecretId eventValue
  }
  repeat {
