view PlatformConfigScriptSectionTitle {
  kind text
  prop tag = "h3"
  class platform-config-section-title
  prop text = "Scripts"
}

view PlatformConfigScriptSectionIntro {
  kind text
  prop tag = "p"
  class platform-config-hint
  prop text = "This remains demo-app behavior only. It does not introduce a new platform capability."
}

view PlatformConfigScriptNameField {
  kind form-field
  class platform-config-field
  prop label = "Script name"
  prop inputId = "platform-config-script-name"
  prop inputClass = "platform-config-input"
  prop placeholder = "engentus-pipeline-demo"
