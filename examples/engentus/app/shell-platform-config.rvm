  kind action
  class rbtn
  prop tag = "button"
  prop buttonType = "button"
  prop label = "Update Selected"
  bindings {
    disabled from state PlatformConfigDatasourceBusy
  }
  interactions {
    on click self deliver PlatformConfigUpdateDatasourceRequested
