view PlatformConfigDatasourceTableBody {
  kind region
  prop tag = "tbody"
  prop domId = "platform-config-datasource-table-body"
  repeat {
    collection PlatformConfigDatasources
    template PlatformConfigDatasourceTableRowTemplate
    itemAs item
    indexAs index
  }
}

view PlatformConfigDatasourcesTable {
  kind region
  prop tag = "table"
  class platform-config-table
  children {
    PlatformConfigDatasourceTableHeader
    PlatformConfigDatasourceTableBody
  }
}

view PlatformConfigDatasourceLabelField {
  kind form-field
  class platform-config-field
  prop label = "Datasource label"
  prop inputId = "platform-config-datasource-label"
  prop inputClass = "platform-config-input"
  prop placeholder = "Primary Postgres"
  bindings {
    value from state PlatformConfigDatasourceLabel
    disabled from state PlatformConfigDatasourceBusy
  }
  interactions {
    on input self set PlatformConfigDatasourceLabel eventValue
  }
}

view PlatformConfigDatasourceProviderLabel {
  kind text
  prop tag = "label"
  class platform-config-field-label
  prop text = "Provider"
  prop for = "platform-config-datasource-provider"
}

view PlatformConfigDatasourceProviderPostgres {
  kind option
  prop tag = "option"
  prop value = "postgres"
  prop text = "postgres"
}

view PlatformConfigDatasourceProviderMysql {
  kind option
  prop tag = "option"
  prop value = "mysql"
  prop text = "mysql"
}

view PlatformConfigDatasourceProviderSelect {
  kind select
  prop tag = "select"
  prop domId = "platform-config-datasource-provider"
  class platform-config-input
  bindings {
    value from state PlatformConfigDatasourceProvider
    disabled from state PlatformConfigDatasourceBusy
  }
  interactions {
    on change self set PlatformConfigDatasourceProvider eventValue
  }
  children {
    PlatformConfigDatasourceProviderPostgres
    PlatformConfigDatasourceProviderMysql
  }
}

view PlatformConfigDatasourceProviderField {
  kind region
  class platform-config-field
  children {
    PlatformConfigDatasourceProviderLabel
    PlatformConfigDatasourceProviderSelect
  }
}

view PlatformConfigDatasourceNetworkFields {
  kind region
  class platform-config-field-stack
  bindings {
    visible from state PlatformConfigDatasourceProvider map postgres true mysql true default false
  }
  children {
    PlatformConfigDatasourceHostField
    PlatformConfigDatasourcePortField
    PlatformConfigDatasourceDatabaseField
    PlatformConfigDatasourceUserField
    PlatformConfigDatasourcePasswordSecretField
    PlatformConfigDatasourceSslField
  }
}

view PlatformConfigDatasourceHostField {
  kind form-field
  class platform-config-field
  prop label = "Host"
  prop inputId = "platform-config-datasource-host"
  prop inputClass = "platform-config-input"
  prop placeholder = "127.0.0.1"
  bindings {
    value from state PlatformConfigDatasourceHost
    disabled from state PlatformConfigDatasourceBusy
  }
  interactions {
    on input self set PlatformConfigDatasourceHost eventValue
  }
}

view PlatformConfigDatasourcePortField {
  kind form-field
  class platform-config-field
  prop label = "Port"
  prop inputId = "platform-config-datasource-port"
  prop inputClass = "platform-config-input"
  prop placeholder = "5432 or 3306"
  bindings {
    value from state PlatformConfigDatasourcePort
    disabled from state PlatformConfigDatasourceBusy
  }
  interactions {
    on input self set PlatformConfigDatasourcePort eventValue
  }
}

view PlatformConfigDatasourceDatabaseField {
  kind form-field
  class platform-config-field
  prop label = "Database"
  prop inputId = "platform-config-datasource-database"
  prop inputClass = "platform-config-input"
  prop placeholder = "engentus"
  bindings {
    value from state PlatformConfigDatasourceDatabase
    disabled from state PlatformConfigDatasourceBusy
  }
  interactions {
    on input self set PlatformConfigDatasourceDatabase eventValue
  }
}

view PlatformConfigDatasourceUserField {
  kind form-field
  class platform-config-field
  prop label = "User"
  prop inputId = "platform-config-datasource-user"
  prop inputClass = "platform-config-input"
  prop placeholder = "pipeline_user"
  bindings {
    value from state PlatformConfigDatasourceUser
    disabled from state PlatformConfigDatasourceBusy
  }
  interactions {
    on input self set PlatformConfigDatasourceUser eventValue
  }
}

view PlatformConfigDatasourcePasswordSecretLabel {
  kind text
  prop tag = "label"
  class platform-config-field-label
  prop text = "Password secret"
  prop for = "platform-config-datasource-password-secret"
}

view PlatformConfigDatasourcePasswordSecretSelect {
  kind select
  prop tag = "select"
  prop domId = "platform-config-datasource-password-secret"
  class platform-config-input
  bindings {
    value from state PlatformConfigDatasourcePasswordSecretId
    disabled from state PlatformConfigDatasourceBusy
  }
  interactions {
    on change self set PlatformConfigDatasourcePasswordSecretId eventValue
  }
