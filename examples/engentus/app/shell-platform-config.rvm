  kind region
  prop tag = "thead"
  children {
    PlatformConfigDatasourceTableHeaderRow
  }
}

view PlatformConfigDatasourceTableHeaderRow {
  kind region
  prop tag = "tr"
  children {
    PlatformConfigDatasourceTableHeaderTitle
    PlatformConfigDatasourceTableHeaderProvider
    PlatformConfigDatasourceTableHeaderStatus
    PlatformConfigDatasourceTableHeaderTest
    PlatformConfigDatasourceTableHeaderUpdated
