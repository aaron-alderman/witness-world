view PlatformConfigDatasourceTableHeaderTitle {
  kind text
  prop tag = "th"
  prop text = "Label"
}

view PlatformConfigDatasourceTableHeaderProvider {
  kind text
  prop tag = "th"
  prop text = "Provider"
}

view PlatformConfigDatasourceTableHeaderStatus {
  kind text
  prop tag = "th"
  prop text = "Status"
}

view PlatformConfigDatasourceTableHeaderTest {
  kind text
  prop tag = "th"
  prop text = "Last Test"
