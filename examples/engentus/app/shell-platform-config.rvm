  prop tag = "h3"
  class platform-config-section-title
  prop text = "Scripts"
}

view PlatformConfigScriptSectionIntro {
  kind text
  prop tag = "p"
  class platform-config-hint
  prop text = "Manual pipeline runs use authored sync definitions, runner-scoped logical bindings, and job-backed execution."
}

view PlatformConfigPipelineSyncOptionTemplate {
  kind option
  prop tag = "option"
  prop value = "${item.id}"
  prop text = "${item.title}"
  prop template = true
}

view PlatformConfigPipelineSyncLabel {
  kind text
  prop tag = "label"
  class platform-config-field-label
  prop text = "Pipeline sync"
  prop for = "platform-config-pipeline-sync-id"
}

view PlatformConfigPipelineSyncSelect {
  kind select
  prop tag = "select"
  prop domId = "platform-config-pipeline-sync-id"
  class platform-config-input
  bindings {
    value from state PlatformConfigPipelineSyncSelectedId
    disabled from state PlatformConfigScriptBusy
  }
  interactions {
