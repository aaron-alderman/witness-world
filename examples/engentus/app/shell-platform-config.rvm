view PlatformConfigDatasourcePathField {
  kind form-field
  class platform-config-field
  prop label = "SQLite path"
  prop inputId = "platform-config-datasource-path"
  prop inputClass = "platform-config-input"
  prop placeholder = "db/main.sqlite"
  bindings {
    value from state PlatformConfigDatasourcePath
    disabled from state PlatformConfigDatasourceBusy
  }
  interactions {
    on input self set PlatformConfigDatasourcePath eventValue
  }
}

view PlatformConfigDatasourceSslField {
  kind checkbox-field
  class platform-config-checkbox
  prop label = "Require SSL"
  prop inputId = "platform-config-datasource-ssl"
  prop inputType = "checkbox"
  bindings {
    checked from state PlatformConfigDatasourceSsl
    disabled from state PlatformConfigDatasourceBusy
  }
  interactions {
    on change self set PlatformConfigDatasourceSsl eventChecked
  }
}

view PlatformConfigDatasourceActions {
  kind region
  class run-row platform-config-actions
  children {
    PlatformConfigDatasourceNewAction
    PlatformConfigDatasourceCreateAction
    PlatformConfigDatasourceUpdateAction
    PlatformConfigDatasourceDeleteAction
    PlatformConfigDatasourceTestAction
    PlatformConfigDatasourceRefreshAction
  }
}

view PlatformConfigDatasourceNewAction {
  kind action
  class rbtn
  prop tag = "button"
  prop buttonType = "button"
  prop label = "New"
  interactions {
    on click self deliver PlatformConfigNewDatasourceRequested
  }
}

