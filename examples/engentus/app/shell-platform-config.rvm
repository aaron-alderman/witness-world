  kind action
  class rbtn stop
  prop tag = "button"
  prop buttonType = "button"
  prop label = "Delete Selected"
  bindings {
    disabled from state PlatformConfigDatasourceBusy
  }
  interactions {
    on click self deliver PlatformConfigDeleteDatasourceRequested
  }
}

view PlatformConfigDatasourceTestAction {
  kind action
  class rbtn
  prop tag = "button"
  prop buttonType = "button"
  prop label = "Test Selected"
  bindings {
