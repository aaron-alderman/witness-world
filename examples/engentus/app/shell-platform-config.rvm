  }
}

view PlatformConfigDatasourceSummary {
  kind text
  prop tag = "pre"
  class platform-config-output
  prop domId = "platform-config-datasource-summary"
  bindings {
    text from state PlatformConfigDatasourceSummary
  }
}

view PlatformConfigDatasourcesSection {
  kind section
  class ssec platform-config-card
  prop domId = "platform-config-datasources"
  children {
    PlatformConfigDatasourcesSectionTitle
    PlatformConfigDatasourcesSectionIntro
    PlatformConfigDatasourceSelectField
    PlatformConfigDatasourceSearchField
    PlatformConfigDatasourceSearchAction
    PlatformConfigDatasourceResults
    PlatformConfigDatasourceLabelField
    PlatformConfigDatasourceProviderField
    PlatformConfigDatasourceHostField
    PlatformConfigDatasourcePortField
    PlatformConfigDatasourceDatabaseField
    PlatformConfigDatasourceUserField
    PlatformConfigDatasourcePasswordSecretField
    PlatformConfigDatasourcePathField
    PlatformConfigDatasourceSslField
    PlatformConfigDatasourceActions
    PlatformConfigDatasourceSummary
  }
}

view PlatformConfigScriptSectionTitle {
  kind text
  prop tag = "h3"
  class platform-config-card-title
  prop text = "Script Stub"
}

view PlatformConfigScriptSectionIntro {
  kind text
  prop tag = "p"
  class platform-config-hint
  prop text = "This remains demo-app behavior only. It does not introduce a new platform capability."
}

view PlatformConfigScriptNameField {
  kind form-field
  class platform-config-field
  prop label = "Script name"
  prop inputId = "platform-config-script-name"
  prop inputClass = "platform-config-input"
  prop placeholder = "engentus-pipeline-demo"
  bindings {
    value from state PlatformConfigScriptName
    disabled from state PlatformConfigScriptBusy
  }
  interactions {
    on input self set PlatformConfigScriptName eventValue
  }
}

view PlatformConfigScriptDatasourceLabel {
  kind text
  prop tag = "label"
  class platform-config-field-label
  prop text = "Datasource"
  prop for = "platform-config-script-datasource-id"
}

view PlatformConfigScriptDatasourceSelect {
  kind select
  prop tag = "select"
  prop domId = "platform-config-script-datasource-id"
  class platform-config-input
  bindings {
    value from state PlatformConfigScriptDatasourceId
    disabled from state PlatformConfigScriptBusy
  }
  interactions {
    on change self set PlatformConfigScriptDatasourceId eventValue
  }
  repeat {
    collection PlatformConfigDatasources
    template PlatformConfigDatasourceOptionTemplate
    itemAs item
    indexAs index
  }
}

view PlatformConfigScriptDatasourceField {
  kind region
  class platform-config-field
  children {
    PlatformConfigScriptDatasourceLabel
    PlatformConfigScriptDatasourceSelect
  }
}

view PlatformConfigScriptRunAction {
  kind action
  class rbtn go
  prop tag = "button"
  prop buttonType = "button"
  prop label = "Run Stub"
  bindings {
    disabled from state PlatformConfigScriptBusy
  }
  interactions {
    on click self deliver PlatformConfigRunScriptRequested
  }
}

view PlatformConfigScriptResult {
  kind text
  prop tag = "pre"
  class platform-config-output
  prop domId = "platform-config-script-result"
  bindings {
    text from state PlatformConfigScriptResult
  }
}

view PlatformConfigScriptSection {
  kind section
  class ssec platform-config-card
  prop domId = "platform-config-script"
  children {
    PlatformConfigScriptSectionTitle
    PlatformConfigScriptSectionIntro
    PlatformConfigScriptNameField
    PlatformConfigScriptDatasourceField
    PlatformConfigScriptRunAction
    PlatformConfigScriptResult
  }
}

view PlatformConfigCards {
  kind region
  class platform-config-grid
  prop domId = "platform-config-grid"
  children {
    PlatformConfigActorSection
    PlatformConfigSecretsSection
    PlatformConfigDatasourcesSection
    PlatformConfigScriptSection
  }
}

view EngentusPlatformConfigBody {
  kind body
  class engentus-platform-body
  prop domId = "platform-config-body"
  children {
    PlatformConfigHero
    PlatformConfigNotice
    PlatformConfigCards
  }
}

view EngentusPlatformConfigApp {
  kind app-shell
  class engentus-platform-app
  process EngentusShellNavigation
  prop domId = "view-platform-config"
  prop documentTitle = "Platform Config"
  prop routeKey = "platform-config"
  prop routePath = "/engentus/platform-config"
  prop mountMode = "mounted-panel"
  children {
    EngentusModuleChrome
    EngentusPlatformConfigBody
  }
}
