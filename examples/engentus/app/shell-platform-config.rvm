  kind action
  class rbtn go
  prop tag = "button"
  prop buttonType = "button"
  prop label = "Create"
  bindings {
    disabled from state PlatformConfigDatasourceBusy
  }
  interactions {
    on click self deliver PlatformConfigCreateDatasourceRequested
  }
}

