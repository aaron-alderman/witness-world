  handles {
    EngentusSignInRequested
    EngentusSignOutRequested
    EngentusSignBackInRequested
    EngentusSessionOpened
    EngentusSessionOpenFailed
    EngentusSessionClosed
    EngentusNavigateHomeRequested
    EngentusNavigateGoodmanRequested
    EngentusNavigateMillChargeRequested
    EngentusNavigateMillForceRequested
    EngentusNavigatePlatformConfigRequested
    PlatformConfigOpenOperatorRequested
    PlatformConfigOpenSecretsRequested
    PlatformConfigOpenDatasourcesRequested
    PlatformConfigOpenScriptsRequested
    PlatformConfigRefreshScriptsRequested
    PlatformConfigSaveScriptBindingRequested
    PlatformConfigSaveScriptScheduleRequested
    PlatformConfigOpenAccessRequested
    PlatformConfigRefreshSecretsRequested
    PlatformConfigSearchSecretsRequested
    PlatformConfigLoadSecretRequested
    PlatformConfigNewSecretRequested
    PlatformConfigCreateSecretRequested
    PlatformConfigOverwriteSecretRequested
    PlatformConfigDeleteSecretRequested
    PlatformConfigStateLoaded
    PlatformConfigStateLoadFailed
    PlatformConfigSecretMutationFailed
    PlatformConfigRefreshDatasourcesRequested
    PlatformConfigSearchDatasourcesRequested
    PlatformConfigLoadDatasourceRequested
    PlatformConfigNewDatasourceRequested
    PlatformConfigCreateDatasourceRequested
    PlatformConfigUpdateDatasourceRequested
    PlatformConfigDeleteDatasourceRequested
    PlatformConfigTestDatasourceRequested
    PlatformConfigDatasourceMutationFailed
    PlatformConfigLoadAccessIdentityRequested
    PlatformConfigUpdateAccessIdentityRequested
    PlatformConfigLoadAccessFeatureRequested
    PlatformConfigUpdateAccessFeatureRequested
    PlatformConfigCreateAuthorityGrantRequested
    PlatformConfigRevokeAuthorityGrantRequested
    PlatformConfigOpenAssumedSessionRequested
    PlatformConfigReturnDirectSessionRequested
    PlatformConfigAccessMutationFailed
    PlatformConfigRunScriptRequested
    PlatformConfigScriptSucceeded
    PlatformConfigScriptFailed
    MillForceShowCrossSectionRequested
    MillForceShowForceVsAngleRequested
    MillForceShowForceRoseRequested
    MillForceShowSingleModeRequested
    MillForceShowCompareModeRequested
    MillForceShowMonteCarloModeRequested
    MillForceSelectGroundedModelRequested
    MillForceSelectFaithfulModelRequested
    MillForceRunMonteCarloRequested
    MillForceClearMonteCarloRequested
    GoodmanShowStaticRequested
    GoodmanShowMonteCarloRequested
    GoodmanShowEditRequested
    GoodmanSaveStaticSimulationRequested
    GoodmanCreateSimulationRequested
    GoodmanToggleCdfWindowRequested
    GoodmanToggleStatsWindowRequested
    GoodmanToggleAnovaWindowRequested
    GoodmanCloseCdfWindowRequested
    GoodmanCloseStatsWindowRequested
    GoodmanCloseAnovaWindowRequested
    GoodmanRunRequested
    GoodmanPauseRunRequested
    GoodmanResumeRunRequested
    GoodmanStopRunRequested
    MillChargePresetHardOreRequested
    MillChargePresetAverageOreRequested
    MillChargePresetClayeyOreRequested
    MillChargePresetDenseSlurryRequested
  }
  emits {
    EngentusOpenSession
    EngentusCloseSession
    EngentusSaveGuidedTourSession
    PlatformConfigLoadSnapshot
    PlatformConfigLoadSecret
    PlatformConfigCreateSecret
    PlatformConfigOverwriteSecret
    PlatformConfigDeleteSecret
    PlatformConfigLoadDatasource
    PlatformConfigCreateDatasource
    PlatformConfigUpdateDatasource
    PlatformConfigDeleteDatasource
    PlatformConfigTestDatasource
    PlatformConfigLoadAccessIdentity
    PlatformConfigUpdateAccessIdentity
    PlatformConfigLoadAccessFeature
    PlatformConfigUpdateAccessFeature
    PlatformConfigCreateAuthorityGrant
    PlatformConfigRevokeAuthorityGrant
    PlatformConfigOpenAssumedSession
    PlatformConfigReturnDirectSession
    PlatformConfigSaveScriptBinding
    PlatformConfigRunScript
  }
  rules {
    on EngentusSignInRequested {
      set EngentusShellAuthStatus pending
      set EngentusAuthNotice ""
      command EngentusOpenSession
    }
    on EngentusSessionOpened {
      option config.presentation.guidedTour {
        real {
          command EngentusSaveGuidedTourSession
        }
        else {
          delay 1250ms
        }
      }
      set EngentusShellAuthStatus folding
      delay 920ms
      set EngentusShellAuthStatus signedIn
    }
    on EngentusSessionOpenFailed {
      set EngentusProfileMenuVisible false
      set EngentusShellActiveRoute login
    }
    on EngentusSignOutRequested {
      set EngentusProfileMenuVisible false
      set EngentusShellAuthStatus signingOut
      set EngentusShellActiveRoute signout
      command EngentusCloseSession
      delay 950ms
      set EngentusShellAuthStatus signedOut
    }
    on EngentusSignBackInRequested {
      set EngentusShellActiveRoute login
      set EngentusShellAuthStatus idle
      set EngentusAuthNotice "Demo accounts: aaron / aaron or callan / callan."
      set EngentusPendingRouteKey ""
      set EngentusPendingFeatureId ""
      set EngentusPendingRoutePath ""
    }
    on EngentusNavigatePlatformConfigRequested {
      set EngentusShellActiveRoute platform-config-operator
      set PlatformConfigSecretBusy true
      set PlatformConfigDatasourceBusy true
      set PlatformConfigAccessBusy true
      set PlatformConfigNoticeTone warn
      set PlatformConfigNoticeText "Loading platform config..."
      command PlatformConfigLoadSnapshot
    }
    on PlatformConfigOpenOperatorRequested {
      set EngentusShellActiveRoute platform-config-operator
      set PlatformConfigSecretBusy true
      set PlatformConfigDatasourceBusy true
      set PlatformConfigAccessBusy true
      set PlatformConfigNoticeTone warn
      set PlatformConfigNoticeText "Loading platform config..."
      command PlatformConfigLoadSnapshot
    }
    on PlatformConfigOpenSecretsRequested {
      set EngentusShellActiveRoute platform-config-secrets
      set PlatformConfigSecretBusy true
      set PlatformConfigNoticeTone warn
      set PlatformConfigNoticeText "Loading secret metadata..."
      command PlatformConfigLoadSnapshot
    }
    on PlatformConfigOpenDatasourcesRequested {
      set EngentusShellActiveRoute platform-config-datasources
      set PlatformConfigDatasourceBusy true
      set PlatformConfigNoticeTone warn
      set PlatformConfigNoticeText "Loading data sources..."
      command PlatformConfigLoadSnapshot
    }
    on PlatformConfigOpenScriptsRequested {
      set EngentusShellActiveRoute platform-config-scripts
      set PlatformConfigScriptBusy true
      set PlatformConfigNoticeTone warn
      set PlatformConfigNoticeText "Loading pipelines, bindings, and run history..."
      command PlatformConfigLoadSnapshot
    }
    on PlatformConfigRefreshScriptsRequested {
      set PlatformConfigScriptBusy true
      set PlatformConfigNoticeTone warn
      set PlatformConfigNoticeText "Refreshing pipeline scripts..."
      command PlatformConfigLoadSnapshot
    }
    on PlatformConfigSaveScriptBindingRequested {
      set PlatformConfigScriptBusy true
      set PlatformConfigNoticeTone warn
      set PlatformConfigNoticeText "Saving pipeline binding..."
      command PlatformConfigSaveScriptBinding
    }
    on PlatformConfigSaveScriptScheduleRequested {
      set PlatformConfigScriptBusy true
      set PlatformConfigNoticeTone warn
      set PlatformConfigNoticeText "Saving pipeline schedule..."
      command PlatformConfigSaveScriptSchedule
    }
    on PlatformConfigOpenAccessRequested {
      set EngentusShellActiveRoute platform-config-access
      set PlatformConfigAccessBusy true
      set PlatformConfigNoticeTone warn
      set PlatformConfigNoticeText "Loading identities and feature policies..."
      command PlatformConfigLoadSnapshot
    }
    on PlatformConfigRefreshSecretsRequested {
      set PlatformConfigSecretBusy true
      set PlatformConfigNoticeTone warn
      set PlatformConfigNoticeText "Loading secret metadata..."
      command PlatformConfigLoadSnapshot
    }
    on PlatformConfigSearchSecretsRequested {
      set PlatformConfigSecretBusy true
      set PlatformConfigNoticeTone warn
      set PlatformConfigNoticeText "Searching secrets..."
      command PlatformConfigLoadSnapshot
    }
    on PlatformConfigLoadSecretRequested {
      set PlatformConfigSecretBusy true
      set PlatformConfigNoticeTone warn
      set PlatformConfigNoticeText "Loading secret..."
      command PlatformConfigLoadSecret
    }
    on PlatformConfigCreateSecretRequested {
      set PlatformConfigSecretBusy true
      set PlatformConfigNoticeTone warn
      set PlatformConfigNoticeText "Creating secret..."
      command PlatformConfigCreateSecret
    }
    on PlatformConfigOverwriteSecretRequested {
      set PlatformConfigSecretBusy true
      set PlatformConfigNoticeTone warn
      set PlatformConfigNoticeText "Overwriting secret value..."
      command PlatformConfigOverwriteSecret
    }
    on PlatformConfigDeleteSecretRequested {
      set PlatformConfigSecretBusy true
      set PlatformConfigNoticeTone warn
      set PlatformConfigNoticeText "Deleting secret..."
      command PlatformConfigDeleteSecret
    }
    on PlatformConfigRefreshDatasourcesRequested {
      set PlatformConfigDatasourceBusy true
      set PlatformConfigNoticeTone warn
      set PlatformConfigNoticeText "Loading datasources..."
      command PlatformConfigLoadSnapshot
    }
    on PlatformConfigSearchDatasourcesRequested {
      set PlatformConfigDatasourceBusy true
      set PlatformConfigNoticeTone warn
      set PlatformConfigNoticeText "Searching datasources..."
      command PlatformConfigLoadSnapshot
    }
    on PlatformConfigLoadDatasourceRequested {
      set PlatformConfigDatasourceBusy true
      set PlatformConfigNoticeTone warn
      set PlatformConfigNoticeText "Loading datasource..."
      command PlatformConfigLoadDatasource
    }
    on PlatformConfigCreateDatasourceRequested {
      set PlatformConfigDatasourceBusy true
      set PlatformConfigNoticeTone warn
      set PlatformConfigNoticeText "Creating datasource..."
      command PlatformConfigCreateDatasource
    }
    on PlatformConfigUpdateDatasourceRequested {
      set PlatformConfigDatasourceBusy true
      set PlatformConfigNoticeTone warn
      set PlatformConfigNoticeText "Updating datasource..."
      command PlatformConfigUpdateDatasource
    }
    on PlatformConfigDeleteDatasourceRequested {
      set PlatformConfigDatasourceBusy true
      set PlatformConfigNoticeTone warn
      set PlatformConfigNoticeText "Deleting datasource..."
      command PlatformConfigDeleteDatasource
    }
    on PlatformConfigTestDatasourceRequested {
      set PlatformConfigDatasourceBusy true
      set PlatformConfigNoticeTone warn
      set PlatformConfigNoticeText "Testing datasource connection..."
      command PlatformConfigTestDatasource
    }
    on PlatformConfigLoadAccessIdentityRequested {
      set PlatformConfigAccessBusy true
      set PlatformConfigNoticeTone warn
      set PlatformConfigNoticeText "Loading identity..."
      command PlatformConfigLoadAccessIdentity
    }
    on PlatformConfigUpdateAccessIdentityRequested {
      set PlatformConfigAccessBusy true
      set PlatformConfigNoticeTone warn
      set PlatformConfigNoticeText "Updating identity access..."
      command PlatformConfigUpdateAccessIdentity
    }
    on PlatformConfigLoadAccessFeatureRequested {
      set PlatformConfigAccessBusy true
      set PlatformConfigNoticeTone warn
      set PlatformConfigNoticeText "Loading feature policy..."
      command PlatformConfigLoadAccessFeature
    }
    on PlatformConfigUpdateAccessFeatureRequested {
      set PlatformConfigAccessBusy true
      set PlatformConfigNoticeTone warn
      set PlatformConfigNoticeText "Updating feature policy..."
      command PlatformConfigUpdateAccessFeature
    }
    on PlatformConfigCreateAuthorityGrantRequested {
      set PlatformConfigAccessBusy true
      set PlatformConfigNoticeTone warn
      set PlatformConfigNoticeText "Creating authority grant..."
      command PlatformConfigCreateAuthorityGrant
    }
    on PlatformConfigRevokeAuthorityGrantRequested {
      set PlatformConfigAccessBusy true
      set PlatformConfigNoticeTone warn
      set PlatformConfigNoticeText "Revoking authority grant..."
      command PlatformConfigRevokeAuthorityGrant
    }
    on PlatformConfigOpenAssumedSessionRequested {
      set PlatformConfigAccessBusy true
      set PlatformConfigNoticeTone warn
      set PlatformConfigNoticeText "Opening assumed session..."
      command PlatformConfigOpenAssumedSession
    }
    on PlatformConfigReturnDirectSessionRequested {
      set PlatformConfigAccessBusy true
      set PlatformConfigNoticeTone warn
      set PlatformConfigNoticeText "Returning to direct session..."
      command PlatformConfigReturnDirectSession
    }
    on PlatformConfigRunScriptRequested {
      set PlatformConfigScriptBusy true
      set PlatformConfigNoticeTone warn
      set PlatformConfigNoticeText "Queueing pipeline run..."
      command PlatformConfigRunScript
    }
    on MillForceRunMonteCarloRequested {
      set MillForceActiveAnalysisMode mc
      set MillForceMcConfigOpen true
      set MillForceMcStatusState calculating
      delay 120ms
      set MillForceChartAnalysisMode mc
      set MillForceMcStatusState running
    }
    on GoodmanRunRequested {
      set GoodmanActiveMode mc
      set GoodmanSimulationSelected true
      set GoodmanRunConfigVisible true
      set GoodmanRunStatusState running
      delay 220ms
      set GoodmanRunStatusState done
    }
  }
}


view EngentusRoot {
  kind app-root
  class engentus-spa
  process EngentusShellNavigation
  prop stylesheetHref = "/engentus/__generated/engentus-shell.css"
  children {
    EngentusLogin
    EngentusHome
    EngentusApp
    EngentusMillChargeApp
    EngentusMillForceApp
    EngentusAccessDenied
    EngentusNotFound
    EngentusPlatformConfigApp
    EngentusPlatformConfigSecretsApp
    EngentusPlatformConfigDatasourcesApp
    EngentusPlatformConfigScriptsApp
    EngentusPlatformConfigAccessApp
    EngentusSignout
  }
}
