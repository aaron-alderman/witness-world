event EngentusSignInRequested {
}

event EngentusSignOutRequested {
  writes {
    EngentusShellAuthStatus: signedOut
    EngentusShellActiveRoute: signout
  }
}

event EngentusSignBackInRequested {
}

event EngentusNavigateHomeRequested {
  writes {
    EngentusShellActiveRoute: home
  }
}

event EngentusNavigateGoodmanRequested {
  writes {
    EngentusShellActiveRoute: goodman
  }
}

event EngentusNavigateMillChargeRequested {
  writes {
    EngentusShellActiveRoute: mill-charge
  }
}

event EngentusNavigateMillForceRequested {
  writes {
    EngentusShellActiveRoute: mill-force
  }
}

event MillForceShowCrossSectionRequested {
  writes {
    MillForceActiveChartTab: cross
  }
}

event MillForceShowForceVsAngleRequested {
  writes {
    MillForceActiveChartTab: force
  }
}

event MillForceShowForceRoseRequested {
  writes {
    MillForceActiveChartTab: rose
  }
}

event MillForceShowSingleModeRequested {
  writes {
    MillForceActiveAnalysisMode: static
  }
}

event MillForceShowCompareModeRequested {
  writes {
    MillForceActiveAnalysisMode: compare
  }
}

event MillForceShowMonteCarloModeRequested {
  writes {
    MillForceActiveAnalysisMode: mc
  }
}

event MillForceSelectGroundedModelRequested {
  writes {
    MillForceActiveModel: grounded
  }
}

event MillForceSelectFaithfulModelRequested {
  writes {
    MillForceActiveModel: faithful
  }
}

event MillForceRunMonteCarloRequested {
  writes {
    MillForceActiveAnalysisMode: mc
    MillForceMcStatusState: running
  }
}

event MillForceClearMonteCarloRequested {
  writes {
    MillForceMcStatusState: cleared
  }
}

event GoodmanShowStaticRequested {
  writes {
    GoodmanActiveMode: static
  }
}

event GoodmanShowMonteCarloRequested {
  writes {
    GoodmanActiveMode: mc
  }
}

event GoodmanShowEditRequested {
  writes {
    GoodmanActiveMode: edit
  }
}

event GoodmanSaveStaticSimulationRequested {
  writes {
    GoodmanActiveMode: mc
    GoodmanRunStatusState: ready
  }
}

event GoodmanToggleCdfWindowRequested {
  writes {
    GoodmanCdfWindowVisible: true
  }
}

event GoodmanToggleStatsWindowRequested {
  writes {
    GoodmanStatsWindowVisible: true
  }
}

event GoodmanToggleAnovaWindowRequested {
  writes {
    GoodmanAnovaWindowVisible: true
  }
}

event GoodmanCloseCdfWindowRequested {
  writes {
    GoodmanCdfWindowVisible: false
  }
}

event GoodmanCloseStatsWindowRequested {
  writes {
    GoodmanStatsWindowVisible: false
  }
}

event GoodmanCloseAnovaWindowRequested {
  writes {
    GoodmanAnovaWindowVisible: false
  }
}

event GoodmanRunRequested {
  writes {
    GoodmanRunStatusState: running
    GoodmanActiveMode: mc
  }
}

event GoodmanPauseRunRequested {
  writes {
    GoodmanRunStatusState: paused
  }
}

event GoodmanResumeRunRequested {
  writes {
    GoodmanRunStatusState: running
  }
}

event GoodmanStopRunRequested {
  writes {
    GoodmanRunStatusState: stopped
  }
}

event MillChargePresetHardOreRequested {
  writes {
    MillChargeInternalFriction: 42
    MillChargeBulkDensity: 2400
    MillChargeSlurryContent: 0.05
    MillChargeWallFriction: 0.65
  }
}

event MillChargePresetAverageOreRequested {
  writes {
    MillChargeInternalFriction: 35
    MillChargeBulkDensity: 1800
    MillChargeSlurryContent: 0.20
    MillChargeWallFriction: 0.50
  }
}

event MillChargePresetClayeyOreRequested {
  writes {
    MillChargeInternalFriction: 26
    MillChargeBulkDensity: 1600
    MillChargeSlurryContent: 0.50
    MillChargeWallFriction: 0.35
  }
}

event MillChargePresetDenseSlurryRequested {
  writes {
    MillChargeInternalFriction: 30
    MillChargeBulkDensity: 2100
    MillChargeSlurryContent: 0.72
    MillChargeWallFriction: 0.40
  }
}

command EngentusSaveGuidedTourSession {
  fields {
    purpose: "auth-transition"
  }
}

process EngentusShellNavigation {
  states {
    EngentusShellActiveRoute
    EngentusShellAuthStatus
    EngentusProfileMenuVisible
    EngentusPasswordRevealed
    MillChargeSpeedFrac
    MillChargeFillFrac
    MillChargeSlurryContent
    MillChargeWallFriction
    MillChargeInternalFriction
    MillChargeBulkDensity
    MillForceActiveChartTab
    MillForceActiveAnalysisMode
    MillForcePercentCrit
    MillForceMu
    MillForceRadius
    MillForceBetaPrimeDeg
    MillForceSegmentCount
    MillForceTotalFill
    MillForceBallFill
    MillForceVoidFraction
    MillForcePercentSolids
    MillForceBallDensity
    MillForceOreDensity
    MillForceDepth
    MillForceLinerMass
    MillForceLinerHeight
    MillForceActiveModel
    MillForceMcStatusState
    MillForceMcSamples
    MillForceMcJTotalFree
    MillForceMcPercentCritFree
    MillForceMcPercentSolidsFree
    MillForceMcHeightFree
    GoodmanActiveMode
    GoodmanCdfWindowVisible
    GoodmanStatsWindowVisible
    GoodmanAnovaWindowVisible
    GoodmanRunStatusState
    GoodmanRunBoltsPerSet
    GoodmanRunDurationMonths
    GoodmanRunStepMonths
    GoodmanStaticAppliedShear
    GoodmanStaticRpm
    GoodmanStaticEnduranceLimit
    GoodmanStaticSlope
    GoodmanStaticProbeMeanStress
    GoodmanScrubTimeMonths
    GoodmanPlaybackSpeed
    GoodmanTrailVisible
    GoodmanChartGridVisible
    GoodmanChartAnnotationsVisible
    GoodmanChartPointSize
    GoodmanChartTitle
    GoodmanChartXAxisLabel
    GoodmanChartYAxisLabel
    GoodmanChartTitleSize
    GoodmanChartAxisSize
    GoodmanChartBandFill1
    GoodmanChartBandFill2
    GoodmanChartBandFill3
    GoodmanChartBandFill4
    GoodmanBoltPrimaryNameState
    GoodmanBoltPrimaryColorState
    GoodmanBoltPrimaryUts
    GoodmanBoltPrimaryUtsFree
    GoodmanBoltPrimaryUtsDist
    GoodmanBoltPrimaryEnduranceLimit
    GoodmanBoltPrimaryEnduranceFree
    GoodmanBoltPrimaryEnduranceDist
    GoodmanBoltPrimarySnSlope
    GoodmanBoltPrimarySnSlopeFree
    GoodmanBoltPrimarySnSlopeDist
    GoodmanBoltPrimaryYieldStress
    GoodmanBoltPrimaryYieldFree
    GoodmanBoltPrimaryYieldDist
  }
  handles {
    EngentusSignInRequested
    EngentusSignOutRequested
    EngentusSignBackInRequested
    EngentusNavigateHomeRequested
    EngentusNavigateGoodmanRequested
    EngentusNavigateMillChargeRequested
    EngentusNavigateMillForceRequested
    MillForceShowCrossSectionRequested
    MillForceShowForceVsAngleRequested
    MillForceShowForceRoseRequested
    MillForceShowSingleModeRequested
    MillForceShowCompareModeRequested
    MillForceShowMonteCarloModeRequested
    MillForceSelectGroundedModelRequested
    MillForceSelectFaithfulModelRequested
    MillForceRunMonteCarloRequested
    MillForceClearMonteCarloRequested
    GoodmanShowStaticRequested
    GoodmanShowMonteCarloRequested
    GoodmanShowEditRequested
    GoodmanSaveStaticSimulationRequested
    GoodmanToggleCdfWindowRequested
    GoodmanToggleStatsWindowRequested
    GoodmanToggleAnovaWindowRequested
    GoodmanCloseCdfWindowRequested
    GoodmanCloseStatsWindowRequested
    GoodmanCloseAnovaWindowRequested
    GoodmanRunRequested
    GoodmanPauseRunRequested
    GoodmanResumeRunRequested
    GoodmanStopRunRequested
    MillChargePresetHardOreRequested
    MillChargePresetAverageOreRequested
    MillChargePresetClayeyOreRequested
    MillChargePresetDenseSlurryRequested
  }
  emits {
    EngentusSaveGuidedTourSession
  }
  rules {
    on EngentusSignInRequested {
      set EngentusShellAuthStatus pending
      option config.presentation.guidedTour {
        real {
          command EngentusSaveGuidedTourSession
        }
        else {
          delay 1250ms
        }
      }
      set EngentusShellAuthStatus folding
      delay 920ms
      set EngentusShellActiveRoute home
      set EngentusShellAuthStatus signedIn
    }
    on EngentusSignOutRequested {
      set EngentusProfileMenuVisible false
      set EngentusShellAuthStatus signingOut
      set EngentusShellActiveRoute signout
      delay 950ms
      set EngentusShellAuthStatus signedOut
    }
    on EngentusSignBackInRequested {
      set EngentusShellActiveRoute login
      set EngentusShellAuthStatus idle
    }
  }
}

view EngentusAuthBrandLogo {
  kind image
  prop tag = "img"
  prop src = "/app-static/img/engentus.png"
  prop alt = "Engentus"
  prop style = "height:17px;width:auto;flex-shrink:0"
}

view EngentusAuthBrandDivider {
  kind divider
