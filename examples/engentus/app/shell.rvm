import desire/v3-alpha

// Engentus is authored here as a composed shell definition first.
// Shared navigation intent, interaction bindings, and shell state projection
// are declared semantically rather than being smuggled through app-local JS.

enum EngentusShellRoute {
  cases {
    login
    home
    goodman
    mill-charge
    mill-force
    access-denied
    not-found
    platform-config
    platform-config-operator
    platform-config-secrets
    platform-config-datasources
    platform-config-scripts
    platform-config-access
    signout
  }
}

enum EngentusShellAuthState {
  cases {
    idle
    pending
    folding
    signedIn
    signingOut
    signedOut
    returning
  }
}

enum MillForceChartTab {
  cases {
    cross
    force
    rose
  }
}

enum MillForceAnalysisMode {
  cases {
    static
    compare
    mc
  }
}

enum MillForceModelSelection {
  cases {
    grounded
    faithful
  }
}

enum MillForceMcStatus {
  cases {
    ready
    calculating
    running
    cleared
  }
}

enum GoodmanMode {
  cases {
    static
    mc
    edit
  }
}

enum GoodmanRunStatus {
  cases {
    ready
    running
    paused
    done
    stopped
  }
}

