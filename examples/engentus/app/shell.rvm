  source MillForceBallFill
  prop digits = 2
}

derive MillForceVoidFractionText {
  kind format
  source MillForceVoidFraction
  prop digits = 2
}

derive MillForcePercentSolidsText {
  kind format
  source MillForcePercentSolids
  prop digits = 2
}

derive MillForceBallDensityText {
