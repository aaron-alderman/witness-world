import desire/v3-alpha

// Engentus is authored here as a composed shell definition first.
// Shared navigation intent, interaction bindings, and shell state projection
// are declared semantically rather than being smuggled through app-local JS.

enum EngentusShellRoute {
  cases {
    login
    home
    goodman
    mill-charge
    mill-force
    signout
  }
}

enum EngentusShellAuthState {
  cases {
    idle
    pending
    folding
    signedIn
    signingOut
    signedOut
    returning
  }
}

enum MillForceChartTab {
  cases {
    cross
    force
    rose
  }
}

enum MillForceAnalysisMode {
  cases {
    static
    compare
    mc
  }
}

enum MillForceModelSelection {
  cases {
    grounded
    faithful
  }
}

enum MillForceMcStatus {
  cases {
    ready
    calculating
    running
    cleared
  }
}

enum GoodmanMode {
  cases {
    static
    mc
    edit
  }
}

enum GoodmanRunStatus {
  cases {
    ready
    running
    paused
    done
    stopped
  }
}

state EngentusProfileMenuVisible: bool {
  initial false
}

state EngentusPasswordRevealed: bool {
  initial false
}

state EngentusShellActiveRoute: EngentusShellRoute {
  initial login
}

state EngentusShellAuthStatus: EngentusShellAuthState {
  initial idle
}

state MillForceActiveChartTab: MillForceChartTab {
  initial cross
}

state MillForceActiveAnalysisMode: MillForceAnalysisMode {
  initial static
}

state MillForceChartAnalysisMode: MillForceAnalysisMode {
  initial static
}

state MillForceActiveModel: MillForceModelSelection {
  initial grounded
}

state MillForceMcStatusState: MillForceMcStatus {
  initial ready
}

state MillForceMcConfigOpen: bool {
  initial false
}

state MillForceMcSamples: number {
  initial 200
}

state MillForceMcJTotalFree: bool {
  initial false
}

state MillForceMcPercentCritFree: bool {
  initial false
}

state MillForceMcPercentSolidsFree: bool {
  initial false
}

state MillForceMcHeightFree: bool {
  initial false
}

state GoodmanActiveMode: GoodmanMode {
  initial static
}

state GoodmanCdfWindowVisible: bool {
  initial false
}

state GoodmanStatsWindowVisible: bool {
  initial false
}

state GoodmanAnovaWindowVisible: bool {
  initial false
}

state GoodmanRunStatusState: GoodmanRunStatus {
  initial ready
}

state GoodmanSimulationSelected: bool {
  initial false
}

state GoodmanRunConfigVisible: bool {
  initial false
}

state GoodmanRunBoltsPerSet: number {
  initial 500
}

state GoodmanRunDurationMonths: number {
  initial 24
}

state GoodmanRunStepMonths: number {
  initial 0.5
}

state GoodmanStaticAppliedShear: number {
  initial 10000
}

state GoodmanStaticRpm: number {
  initial 11
}

state GoodmanStaticEnduranceLimit: number {
  initial 50
}

state GoodmanStaticSlope: number {
  initial 4.6
}

state GoodmanStaticProbeMeanStress: number {
  initial 300
}

state GoodmanScrubTimeMonths: number {
  initial 0
}

state GoodmanPlaybackSpeed: number {
  initial 1
}

state GoodmanTrailVisible: bool {
  initial false
}

state GoodmanChartGridVisible: bool {
  initial true
}

state GoodmanChartTitle: string {
  initial "Goodman Fatigue Diagram — M48 Mill Liner Bolt"
}

state GoodmanChartXAxisLabel: string {
  initial "Preload / Mean Stress  (MPa)"
}

state GoodmanChartYAxisLabel: string {
  initial "Alternating Bending Stress  (MPa)"
}

state GoodmanChartTitleSize: number {
  initial 13
}

state GoodmanChartAxisSize: number {
  initial 12
}

state GoodmanChartBandFill1: string {
  initial "#bbf7d0"
}

state GoodmanChartBandFill2: string {
  initial "#d9f99d"
}

state GoodmanChartBandFill3: string {
  initial "#fef08a"
}

state GoodmanChartBandFill4: string {
  initial "#fde68a"
}

state GoodmanBoltPrimaryNameState: string {
  initial "No Jemtec"
}

state GoodmanBoltPrimaryColorState: string {
  initial "#dc2626"
}

state GoodmanBoltMaintenanceNameState: string {
  initial "Jemtec"
}

state GoodmanBoltMaintenanceColorState: string {
  initial "#8CC4D4"
}

state GoodmanBoltPrimaryParamsOpen: bool {
  initial false
}

state GoodmanBoltMaintenanceParamsOpen: bool {
  initial false
}

state GoodmanBoltPrimaryEditVisible: bool {
  initial false
}

state GoodmanBoltMaintenanceEditVisible: bool {
  initial false
}

state GoodmanBoltPrimaryUts: number {
  initial 1040
}

state GoodmanBoltPrimaryUtsFree: bool {
  initial true
}

state GoodmanBoltPrimaryUtsDist: string {
  initial "normal"
}

state GoodmanBoltPrimaryEnduranceLimit: number {
  initial 50
}

state GoodmanBoltPrimaryEnduranceFree: bool {
  initial true
}

state GoodmanBoltPrimaryEnduranceDist: string {
  initial "normal"
}

state GoodmanBoltPrimarySnSlope: number {
  initial 4.6
}

state GoodmanBoltPrimarySnSlopeFree: bool {
  initial false
}

state GoodmanBoltPrimarySnSlopeDist: string {
  initial "fixed"
}

state GoodmanBoltPrimaryYieldStress: number {
  initial 600
}

state GoodmanBoltPrimaryYieldFree: bool {
  initial false
}

state GoodmanBoltPrimaryYieldDist: string {
  initial "fixed"
}

state MillForcePercentCrit: number {
  initial 0.90
}

state MillForceMu: number {
  initial 0.30
}

state MillForceRadius: number {
  initial 6.00
}

state MillForceBetaPrimeDeg: number {
  initial 50
}

state MillForceSegmentCount: number {
  initial 39
}

state MillForceTotalFill: number {
  initial 0.30
}

state MillForceBallFill: number {
  initial 0.10
}

state MillForceVoidFraction: number {
  initial 0.40
}

state MillForcePercentSolids: number {
  initial 0.75
}

state MillForceBallDensity: number {
  initial 7.80
}

state MillForceOreDensity: number {
  initial 3.10
}

state MillForceDepth: number {
  initial 1.50
}

state MillForceLinerMass: number {
  initial 0
}

state MillForceLinerHeight: number {
  initial 0.50
}

state MillChargeSpeedFrac: number {
  initial 0.75
}

state MillChargeFillFrac: number {
  initial 0.30
}

state MillChargeSlurryContent: number {
  initial 0.20
}

state MillChargeWallFriction: number {
  initial 0.50
}

state MillChargeInternalFriction: number {
  initial 35
}

state MillChargeBulkDensity: number {
  initial 1800
}

derive MillChargeSpeedText {
  kind format
  source MillChargeSpeedFrac
  prop style = "percent"
  prop digits = 0
}

derive MillChargeFillText {
  kind format
  source MillChargeFillFrac
  prop style = "percent"
  prop digits = 0
}

derive MillChargeSlurryText {
  kind format
  source MillChargeSlurryContent
  prop digits = 2
}

derive MillChargeWallFrictionText {
  kind format
  source MillChargeWallFriction
  prop digits = 2
}

derive MillChargeInternalFrictionText {
  kind format
  source MillChargeInternalFriction
  prop digits = 0
  prop suffix = "°"
}

derive MillChargeBulkDensityText {
  kind format
  source MillChargeBulkDensity
  prop digits = 0
}

derive MillForcePercentCritText {
  kind format
  source MillForcePercentCrit
  prop digits = 2
}

derive MillForceMuText {
  kind format
  source MillForceMu
  prop digits = 2
}

derive MillForceRadiusText {
  kind format
  source MillForceRadius
  prop digits = 1
  prop suffix = " m"
}

derive MillForceBetaPrimeText {
  kind format
  source MillForceBetaPrimeDeg
  prop digits = 0
  prop suffix = "°"
}

derive MillForceSegmentCountText {
  kind format
  source MillForceSegmentCount
  prop digits = 0
}

derive MillForceTotalFillText {
  kind format
  source MillForceTotalFill
  prop digits = 2
}

derive MillForceBallFillText {
  kind format
  source MillForceBallFill
  prop digits = 2
}

derive MillForceVoidFractionText {
  kind format
  source MillForceVoidFraction
  prop digits = 2
}

derive MillForcePercentSolidsText {
  kind format
  source MillForcePercentSolids
  prop digits = 2
}

derive MillForceBallDensityText {
  kind format
  source MillForceBallDensity
  prop digits = 1
  prop suffix = " SG"
}

derive MillForceOreDensityText {
  kind format
  source MillForceOreDensity
  prop digits = 1
  prop suffix = " SG"
}

derive MillForceDepthText {
  kind format
  source MillForceDepth
  prop digits = 1
  prop suffix = " m"
}

derive MillForceLinerMassText {
  kind format
  source MillForceLinerMass
  prop digits = 0
  prop suffix = " kg"
}

derive MillForceLinerHeightText {
  kind format
  source MillForceLinerHeight
  prop digits = 2
  prop suffix = " m"
}

derive GoodmanRunBoltsPerSetText {
  kind format
  source GoodmanRunBoltsPerSet
  prop digits = 0
}

derive GoodmanRunDurationText {
  kind format
  source GoodmanRunDurationMonths
  prop digits = 0
  prop suffix = " mo"
}

derive GoodmanRunStepText {
  kind format
  source GoodmanRunStepMonths
  prop digits = 1
  prop suffix = " mo"
}

derive GoodmanScrubTimeText {
  kind format
  source GoodmanScrubTimeMonths
  prop digits = 1
  prop suffix = " mo"
}

derive GoodmanPlaybackSpeedText {
  kind format
  source GoodmanPlaybackSpeed
  prop digits = 1
  prop suffix = "x"
}

derive GoodmanStaticAppliedShearText {
  kind format
  source GoodmanStaticAppliedShear
  prop digits = 0
  prop suffix = " N"
}

derive GoodmanStaticRpmText {
  kind format
  source GoodmanStaticRpm
  prop digits = 1
  prop suffix = " RPM"
}

derive GoodmanStaticEnduranceLimitText {
  kind format
  source GoodmanStaticEnduranceLimit
  prop digits = 0
  prop suffix = " MPa"
}

derive GoodmanStaticSlopeText {
  kind format
  source GoodmanStaticSlope
  prop digits = 1
}

derive GoodmanStaticProbeMeanStressText {
  kind format
  source GoodmanStaticProbeMeanStress
  prop digits = 0
  prop suffix = " MPa"
}

event EngentusSignInRequested {
}

event EngentusSignOutRequested {
  writes {
    EngentusShellAuthStatus: signedOut
    EngentusShellActiveRoute: signout
  }
}

event EngentusSignBackInRequested {
}

event EngentusNavigateHomeRequested {
  writes {
    EngentusShellActiveRoute: home
  }
}

event EngentusNavigateGoodmanRequested {
  writes {
    EngentusShellActiveRoute: goodman
  }
}

event EngentusNavigateMillChargeRequested {
  writes {
    EngentusShellActiveRoute: mill-charge
  }
}

event EngentusNavigateMillForceRequested {
  writes {
    EngentusShellActiveRoute: mill-force
  }
}

event MillForceShowCrossSectionRequested {
  writes {
    MillForceActiveChartTab: cross
  }
}

event MillForceShowForceVsAngleRequested {
  writes {
    MillForceActiveChartTab: force
  }
}

event MillForceShowForceRoseRequested {
  writes {
    MillForceActiveChartTab: rose
  }
}

event MillForceShowSingleModeRequested {
  writes {
    MillForceActiveAnalysisMode: static
    MillForceChartAnalysisMode: static
    MillForceMcConfigOpen: false
  }
}

event MillForceShowCompareModeRequested {
  writes {
    MillForceActiveAnalysisMode: compare
    MillForceChartAnalysisMode: compare
    MillForceMcConfigOpen: false
  }
}

event MillForceShowMonteCarloModeRequested {
  writes {
    MillForceActiveAnalysisMode: mc
    MillForceChartAnalysisMode: static
    MillForceMcConfigOpen: true
  }
}

event MillForceSelectGroundedModelRequested {
  writes {
    MillForceActiveModel: grounded
  }
}

event MillForceSelectFaithfulModelRequested {
  writes {
    MillForceActiveModel: faithful
  }
}

event MillForceRunMonteCarloRequested {
  writes {
    MillForceActiveAnalysisMode: mc
    MillForceChartAnalysisMode: mc
    MillForceMcConfigOpen: true
    MillForceMcStatusState: running
  }
}

event MillForceClearMonteCarloRequested {
  writes {
    MillForceChartAnalysisMode: static
    MillForceMcStatusState: cleared
  }
}

event GoodmanShowStaticRequested {
  writes {
    GoodmanActiveMode: static
    GoodmanRunConfigVisible: false
  }
}

event GoodmanShowMonteCarloRequested {
  writes {
    GoodmanActiveMode: mc
  }
}

event GoodmanShowEditRequested {
  writes {
    GoodmanActiveMode: edit
    GoodmanRunConfigVisible: false
  }
}

event GoodmanSaveStaticSimulationRequested {
  writes {
    GoodmanActiveMode: mc
    GoodmanSimulationSelected: true
    GoodmanRunConfigVisible: true
    GoodmanRunStatusState: ready
  }
}

event GoodmanCreateSimulationRequested {
  writes {
    GoodmanActiveMode: mc
    GoodmanSimulationSelected: true
    GoodmanRunConfigVisible: true
    GoodmanRunStatusState: ready
  }
}

event GoodmanToggleCdfWindowRequested {
  writes {
    GoodmanCdfWindowVisible: true
  }
}

event GoodmanToggleStatsWindowRequested {
  writes {
    GoodmanStatsWindowVisible: true
  }
}

event GoodmanToggleAnovaWindowRequested {
  writes {
    GoodmanAnovaWindowVisible: true
  }
}

event GoodmanCloseCdfWindowRequested {
  writes {
    GoodmanCdfWindowVisible: false
  }
}

event GoodmanCloseStatsWindowRequested {
  writes {
    GoodmanStatsWindowVisible: false
  }
}

event GoodmanCloseAnovaWindowRequested {
  writes {
    GoodmanAnovaWindowVisible: false
  }
}

event GoodmanRunRequested {
  writes {
    GoodmanRunStatusState: running
    GoodmanActiveMode: mc
    GoodmanSimulationSelected: true
    GoodmanRunConfigVisible: true
  }
}

event GoodmanPauseRunRequested {
  writes {
    GoodmanRunStatusState: paused
  }
}

event GoodmanResumeRunRequested {
  writes {
    GoodmanRunStatusState: running
  }
}

event GoodmanStopRunRequested {
  writes {
    GoodmanRunStatusState: stopped
  }
}

event MillChargePresetHardOreRequested {
  writes {
    MillChargeInternalFriction: 42
    MillChargeBulkDensity: 2400
    MillChargeSlurryContent: 0.05
    MillChargeWallFriction: 0.65
  }
}

event MillChargePresetAverageOreRequested {
  writes {
    MillChargeInternalFriction: 35
    MillChargeBulkDensity: 1800
    MillChargeSlurryContent: 0.20
    MillChargeWallFriction: 0.50
  }
}

event MillChargePresetClayeyOreRequested {
  writes {
    MillChargeInternalFriction: 26
    MillChargeBulkDensity: 1600
    MillChargeSlurryContent: 0.50
    MillChargeWallFriction: 0.35
  }
}

event MillChargePresetDenseSlurryRequested {
  writes {
    MillChargeInternalFriction: 30
    MillChargeBulkDensity: 2100
    MillChargeSlurryContent: 0.72
    MillChargeWallFriction: 0.40
  }
}

command EngentusSaveGuidedTourSession {
  fields {
    purpose: "auth-transition"
  }
}

process EngentusShellNavigation {
  states {
    EngentusShellActiveRoute
    EngentusShellAuthStatus
    EngentusProfileMenuVisible
    EngentusPasswordRevealed
    MillChargeSpeedFrac
    MillChargeFillFrac
    MillChargeSlurryContent
    MillChargeWallFriction
    MillChargeInternalFriction
    MillChargeBulkDensity
    MillForceActiveChartTab
    MillForceActiveAnalysisMode
    MillForceChartAnalysisMode
    MillForcePercentCrit
    MillForceMu
    MillForceRadius
    MillForceBetaPrimeDeg
    MillForceSegmentCount
    MillForceTotalFill
    MillForceBallFill
    MillForceVoidFraction
    MillForcePercentSolids
    MillForceBallDensity
    MillForceOreDensity
    MillForceDepth
    MillForceLinerMass
    MillForceLinerHeight
    MillForceActiveModel
    MillForceMcStatusState
    MillForceMcConfigOpen
    MillForceMcSamples
    MillForceMcJTotalFree
    MillForceMcPercentCritFree
    MillForceMcPercentSolidsFree
    MillForceMcHeightFree
    GoodmanActiveMode
    GoodmanCdfWindowVisible
    GoodmanStatsWindowVisible
    GoodmanAnovaWindowVisible
    GoodmanRunStatusState
    GoodmanSimulationSelected
    GoodmanRunConfigVisible
    GoodmanRunBoltsPerSet
    GoodmanRunDurationMonths
    GoodmanRunStepMonths
    GoodmanStaticAppliedShear
    GoodmanStaticRpm
    GoodmanStaticEnduranceLimit
    GoodmanStaticSlope
    GoodmanStaticProbeMeanStress
    GoodmanScrubTimeMonths
    GoodmanPlaybackSpeed
    GoodmanTrailVisible
    GoodmanChartGridVisible
    GoodmanChartTitle
    GoodmanChartXAxisLabel
    GoodmanChartYAxisLabel
    GoodmanChartTitleSize
    GoodmanChartAxisSize
    GoodmanChartBandFill1
    GoodmanChartBandFill2
    GoodmanChartBandFill3
    GoodmanChartBandFill4
    GoodmanBoltPrimaryNameState
    GoodmanBoltPrimaryColorState
    GoodmanBoltMaintenanceNameState
    GoodmanBoltMaintenanceColorState
    GoodmanBoltPrimaryUts
    GoodmanBoltPrimaryUtsFree
    GoodmanBoltPrimaryUtsDist
    GoodmanBoltPrimaryEnduranceLimit
    GoodmanBoltPrimaryEnduranceFree
    GoodmanBoltPrimaryEnduranceDist
    GoodmanBoltPrimarySnSlope
    GoodmanBoltPrimarySnSlopeFree
    GoodmanBoltPrimarySnSlopeDist
    GoodmanBoltPrimaryYieldStress
    GoodmanBoltPrimaryYieldFree
    GoodmanBoltPrimaryYieldDist
  }
  handles {
    EngentusSignInRequested
    EngentusSignOutRequested
    EngentusSignBackInRequested
    EngentusNavigateHomeRequested
    EngentusNavigateGoodmanRequested
    EngentusNavigateMillChargeRequested
    EngentusNavigateMillForceRequested
    MillForceShowCrossSectionRequested
    MillForceShowForceVsAngleRequested
    MillForceShowForceRoseRequested
    MillForceShowSingleModeRequested
    MillForceShowCompareModeRequested
    MillForceShowMonteCarloModeRequested
    MillForceSelectGroundedModelRequested
    MillForceSelectFaithfulModelRequested
    MillForceRunMonteCarloRequested
    MillForceClearMonteCarloRequested
    GoodmanShowStaticRequested
    GoodmanShowMonteCarloRequested
    GoodmanShowEditRequested
    GoodmanSaveStaticSimulationRequested
    GoodmanCreateSimulationRequested
    GoodmanToggleCdfWindowRequested
    GoodmanToggleStatsWindowRequested
    GoodmanToggleAnovaWindowRequested
    GoodmanCloseCdfWindowRequested
    GoodmanCloseStatsWindowRequested
    GoodmanCloseAnovaWindowRequested
    GoodmanRunRequested
    GoodmanPauseRunRequested
    GoodmanResumeRunRequested
    GoodmanStopRunRequested
    MillChargePresetHardOreRequested
    MillChargePresetAverageOreRequested
    MillChargePresetClayeyOreRequested
    MillChargePresetDenseSlurryRequested
  }
  emits {
    EngentusSaveGuidedTourSession
  }
  rules {
    on EngentusSignInRequested {
      set EngentusShellAuthStatus pending
      option config.presentation.guidedTour {
        real {
          command EngentusSaveGuidedTourSession
        }
        else {
          delay 1250ms
        }
      }
      set EngentusShellAuthStatus folding
      delay 920ms
      set EngentusShellActiveRoute home
      set EngentusShellAuthStatus signedIn
    }
    on EngentusSignOutRequested {
      set EngentusProfileMenuVisible false
      set EngentusShellAuthStatus signingOut
      set EngentusShellActiveRoute signout
      delay 950ms
      set EngentusShellAuthStatus signedOut
    }
    on EngentusSignBackInRequested {
      set EngentusShellActiveRoute login
      set EngentusShellAuthStatus idle
    }
    on MillForceRunMonteCarloRequested {
      set MillForceActiveAnalysisMode mc
      set MillForceMcConfigOpen true
      set MillForceMcStatusState calculating
      delay 120ms
      set MillForceChartAnalysisMode mc
      set MillForceMcStatusState running
    }
    on GoodmanRunRequested {
      set GoodmanActiveMode mc
      set GoodmanSimulationSelected true
      set GoodmanRunConfigVisible true
      set GoodmanRunStatusState running
      delay 220ms
      set GoodmanRunStatusState done
    }
  }
}


view EngentusRoot {
  kind app-root
  class engentus-spa
  process EngentusShellNavigation
  prop stylesheetHref = "/app-static/app/engentus-shell.css"
  children {
    EngentusLogin
    EngentusHome
    EngentusApp
    EngentusMillChargeApp
    EngentusMillForceApp
    EngentusSignout
  }
}
