derive MillChargeSpeedText {
  kind format
  source MillChargeSpeedFrac
  prop style = "percent"
  prop digits = 0
}

derive MillChargeFillText {
  kind format
  source MillChargeFillFrac
  prop style = "percent"
  prop digits = 0
}

derive MillChargeSlurryText {
  kind format
  source MillChargeSlurryContent
  prop digits = 2
}

derive MillChargeWallFrictionText {
  kind format
  source MillChargeWallFriction
  prop digits = 2
}

derive MillChargeInternalFrictionText {
  kind format
  source MillChargeInternalFriction
  prop digits = 0
  prop suffix = "°"
}

derive MillChargeBulkDensityText {
  kind format
  source MillChargeBulkDensity
  prop digits = 0
}

derive MillForcePercentCritText {
  kind format
  source MillForcePercentCrit
  prop digits = 2
}

derive MillForceMuText {
  kind format
  source MillForceMu
  prop digits = 2
}

derive MillForceRadiusText {
  kind format
  source MillForceRadius
  prop digits = 1
  prop suffix = " m"
}

derive MillForceBetaPrimeText {
  kind format
  source MillForceBetaPrimeDeg
  prop digits = 0
  prop suffix = "°"
}

derive MillForceSegmentCountText {
  kind format
  source MillForceSegmentCount
  prop digits = 0
}

derive MillForceTotalFillText {
  kind format
  source MillForceTotalFill
  prop digits = 2
}

derive MillForceBallFillText {
