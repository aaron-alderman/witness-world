view ModuleGrid {
  kind grid
  class module-grid
  prop domId = "module-grid"
  children {
    ModuleCardMillCharge
    ModuleCardGoodman
    ModuleCardMillForce
    ModuleCardTensionTimeSeries
    ModuleCardBoltLoadDistribution
    ModuleCardChannelHealthMonitor
    ModuleCardCalibrationWorkspace
    ModuleCardMaintenanceForecaster
    ModuleCardSensorFleetOverview
    ModuleCardReportBuilder
    ModuleCardAlertTimeline
    ModuleCardMillComparison
    ModuleCardTorqueAnalysis
    ModuleCardVibrationSpectrum
    ModuleCardLifeCycleEstimator
    ModuleCardApiDataExplorer
    ModuleCardHistoricalArchive
    ModuleCardComplianceDashboard
  }
}

view EngentusHome {
  kind app-shell
  class engentus-home
  prop domId = "view-home"
  prop shellTemplate = "sidebar-grid"
  prop routeKey = "home"
  prop routePath = "/engentus/home"
  prop mainRegionDomId = "module-area"
  prop title = "Analysis Modules"
  prop subtitle = "Select a module to begin analysis"
  prop pillClass = "mill-pill"
  prop pillText = "⚙ M48 – Goldfields"
  prop signoutHref = "/engentus/signout"
  children {
    EngentusToolbar
    NewsPanel
    ModuleGrid
  }
}

view GoodmanSidebar {
  kind sidebar
  class goodman-controls
  prop domId = "sb"
  prop scrollDomId = "sb-scroll"
  prop section1Title = "Scenario View"
  prop section1DomId = "sec-static"
  prop section1ContentHtml = "<div id='static-params-html'></div>"
  prop section2Title = "Simulations"
  prop section2DomId = "sec-mc"
  prop section2Style = "display:none"
  prop section2TitleActionLabel = "+ New"
  prop section2TitleActionDomId = "new-sim-btn"
  prop section2ContentHtml = "<div id='sim-list'></div>"
  prop section3Title = "Run Config"
  prop section3DomId = "sec-run"
  prop section3Style = "display:none"
  prop section3ContentHtml = "<div class='mc-row'><label>Bolts per set</label><input type='number' id='cfg-n' value='500' min='50' max='5000' step='50'></div><div class='mc-row'><label>Duration (months)</label><input type='number' id='cfg-tmax' value='24' min='3' max='60' step='1'></div><div class='mc-row'><label>Time step (months)</label><input type='number' id='cfg-dt' value='0.5' min='0.1' max='2' step='0.1'></div><div class='run-row'><button class='rbtn go' id='btn-run'>▶ Run</button><button class='rbtn pause' id='btn-pause' disabled>⏸</button><button class='rbtn stop' id='btn-stop' disabled>■</button></div><div class='prog-wrap'><div class='prog-fill' id='prog-fill'></div></div><div class='prog-lbl' id='prog-lbl'>Ready</div>"
  prop section4Title = "Chart Style"
  prop section4DomId = "sec-edit"
  prop section4Style = "display:none"
  prop section4ContentHtml = "<div id='edit-panel-html'></div>"
  prop section5Title = "Bolt Sets"
  prop section5TitleActionLabel = "+ New"
  prop section5TitleActionDomId = "new-bs-btn"
  prop section5ContentHtml = "<div id='bs-list'></div>"
  prop section6Title = "Fatigue Life Regions"
  prop section6ContentHtml = "<div id='legend-html'></div>"
  prop section6NoteHtml = "<p style='font-size:9.5px;color:var(--t2);margin-top:6px;line-height:1.5'>Hannover M48 combined SN, 50% survival, m=4.6. Goodman line: &sigma;<sub>a</sub> = &sigma;<sub>lim</sub>(1&minus;&sigma;<sub>m</sub>/UTS).</p>"
}

view EngentusApp {
  kind app-shell
  class engentus-app
  prop domId = "view-goodman"
  prop routeKey = "goodman"
  prop routePath = "/engentus/goodman"
  prop shellTemplate = "viewer-sidebar-main"
  prop shellBodyDomId = "body"
  prop mainRegionDomId = "chart-area"
  prop mainBeforeFrameHtml = "<div id='scr' class='hidden'><button id='play-btn' type='button'>&#9654;</button><input type='range' id='time-sl' min='0' max='24' step='0.05' value='0'><span id='t-lbl'>t = 0.0 mo</span><span class='fail-badge' id='fail-badge'></span><div id='spd-wrap'><label style='font-size:10px;color:var(--t2);flex-shrink:0'>Speed</label><input type='range' id='spd-sl' min='0.1' max='20' step='0.1' value='1'><span id='spd-lbl'>1.0&times;</span></div><div id='trail-wrap'><input type='checkbox' id='trail-cb'><label for='trail-cb'>Trail</label></div></div>"
  prop mainAfterFrameHtml = "<div id='wl' style='display:block'></div>"
  prop frameWrapDomId = "chart-wrap"
  prop frameDomId = "chart-svg"
  prop toolsDomId = "tb-goodman-tools"
  prop clientConfigHref = "/app-static/app/runtime/goodman-shell.json"
  prop dependsOnCapabilities = "chart.render"
  prop title = "Goodman Fatigue Diagram"
  prop subtitle = "SN curve analysis with Monte Carlo simulation"
  prop mountMode = "mounted-panel"
  prop brandClickable = "true"
  prop backHref = "/engentus/home"
  prop signoutHref = "/engentus/signout"
  prop toolbarMode1Label = "Static"
  prop toolbarMode1Key = "static"
  prop toolbarMode2Label = "Monte Carlo"
  prop toolbarMode2Key = "mc"
  prop toolbarMode3Label = "✏ Edit"
  prop toolbarMode3Key = "edit"
  prop toolbarAction1Label = "📈 CDF"
  prop toolbarAction1Key = "cdf"
  prop toolbarAction2Label = "📊 Stats"
  prop toolbarAction2Key = "stats"
  prop toolbarAction3Label = "🔬 ANOVA"
  prop toolbarAction3Key = "anova"
  children {
    EngentusToolbar
    GoodmanSidebar
    GoodmanDiagram
    GoodmanMCBands
  }
}

view MillChargeSidebar {
  kind sidebar
  class mill-charge-controls
  prop domId = "mill-sb"
  prop scrollDomId = "mill-sb-scroll"
}

view MillChargeMetrics {
  kind sidebar
  class mill-charge-metrics
  prop role = "metrics"
  prop domId = "mill-metrics"
  prop headerDomId = "mill-metrics-hdr"
  prop panelDomId = "mill-metrics-panel"
  prop headerLabel = "Metrics"
}

view EngentusMillChargeApp {
  kind app-shell
  class engentus-mill-charge
  prop domId = "view-mill"
  prop routeKey = "mill-charge"
  prop routePath = "/engentus/mill-charge"
  prop shellTemplate = "viewer-sidebar-main-metrics"
  prop shellBodyDomId = "mill-body"
  prop mainRegionDomId = "mill-main"
  prop frameWrapDomId = "mill-canvas-wrap"
  prop frameDomId = "mill-canvas"
  prop title = "Mill Charge Motion"
  prop subtitle = "2D charge shape, regime and power proxy"
  prop mountMode = "mounted-panel"
  prop dependsOnCapabilities = "chart.render"
  prop brandClickable = "true"
  prop backHref = "/engentus/home"
  prop signoutHref = "/engentus/signout"
  children {
    EngentusToolbar
    MillChargeSidebar
    MillChargeMetrics
    MillChargeCrossSection
  }
}

view MillForceSidebar {
  kind sidebar
  class mill-force-controls
  prop domId = "mill-force-sb"
  prop scrollDomId = "mill-force-sb-scroll"
}

view EngentusMillForceApp {
  kind app-shell
  class engentus-mill-force
  prop domId = "view-mill-force"
  prop routeKey = "mill-force"
  prop routePath = "/engentus/mill-force"
  prop shellTemplate = "viewer-sidebar-tabs"
  prop shellBodyDomId = "mill-force-body"
  prop mainRegionDomId = "mill-force-chart-area"
  prop tabsDomId = "mill-force-chart-tabs"
  prop frameWrapDomId = "mill-force-chart-wrap"
  prop frameIdPrefix = "mill-force-svg-"
  prop tabClass = "mill-force-cht-tab"
  prop title = "Mill Force Analysis"
  prop subtitle = "Liner force distribution with dual-model comparison"
  prop mountMode = "mounted-panel"
  prop dependsOnCapabilities = "chart.render"
  prop brandClickable = "true"
  prop backHref = "/engentus/home"
  prop signoutHref = "/engentus/signout"
  prop chartTab1Label = "Cross-section"
  prop chartTab1Key = "cross"
  prop chartTab2Label = "Force vs Angle"
  prop chartTab2Key = "force"
  prop chartTab3Label = "Force Rose"
  prop chartTab3Key = "rose"
  children {
    EngentusToolbar
    MillForceSidebar
    MillForceCross
    MillForceAngle
    MillForceRose
  }
}

view EngentusRoot {
  kind app-root
  class engentus-spa
  prop stylesheetHref = "/app-static/app/engentus-shell.css"
  prop clientRendererHref = "/app-static/app/runtime/engentus-browser-runtime.js"
  prop clientRendererExport = "mountEngentusSurface"
  prop brandName = "Engentus"
  prop productName = "Mill-iQ™"
  prop brandLogoSrc = "/app-static/img/engentus.png"
  prop productLogoSrc = "/app-static/img/mill-iq.png"
  prop heroProductLogoSrc = "/app-static/img/mill-iq.png"
  prop profileInitials = "AA"
  prop profileName = "Aaron A."
  prop profileRole = "Lead Engineer"
  prop siteLabel = "Mill: M48 – Goldfields"
  prop homeHref = "/engentus/home"
  prop signoutHref = "/engentus/signout"
  prop footerText = "© 2025 Engentus Pty Ltd. All rights reserved."
  children {
    EngentusLogin
    EngentusHome
    EngentusApp
    EngentusMillChargeApp
    EngentusMillForceApp
    EngentusSignout
  }
}
