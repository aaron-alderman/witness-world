  children {
    EngentusLoginForm
  }
}

view EngentusLoginBook {
  kind region
  class auth-book
  bindings {
    className from state EngentusShellAuthStatus map folding folding default ""
  }
  children {
    EngentusLoginLeft
    EngentusLoginRight
  }
}

