  }
}

adapter PlatformConfigSnapshotHttp using HTTP {
  command PlatformConfigLoadSnapshot
  kind command
  method POST
  route /api/pipeline/platform-config/snapshot
  host_operation engentus.platform.snapshot
  success_event PlatformConfigStateLoaded
  failure_event PlatformConfigStateLoadFailed
  loading_state PlatformConfigSecretBusy
  collection_outputs = {
    PlatformConfigSecrets = "secrets"
    PlatformConfigDatasources = "datasources"
    PlatformConfigIdentities = "identities"
    PlatformConfigFeaturePolicies = "featurePolicies"
    PlatformConfigAuthorityGrants = "authorityGrants"
    PlatformConfigAuthorityActors = "authorityActors"
    PlatformConfigAuthRoles = "authRoles"
    PlatformConfigPipelineSyncs = "pipelineSyncs"
    PlatformConfigPipelineSchedules = "pipelineSchedules"
    PlatformConfigPipelineBindings = "pipelineBindings"
    PlatformConfigPipelineRuns = "pipelineRuns"
    PlatformConfigPipelineChildRuns = "pipelineChildRuns"
    PlatformConfigPipelineRunLogs = "pipelineRunLogs"
  }
}

