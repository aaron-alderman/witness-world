view EngentusLoginHeader {
  kind screen-header
  prop tag = "h2"
  class auth-form-title
  prop text = "Welcome back"
}

view EngentusLoginSubtitle {
  kind text
  prop tag = "p"
  class auth-form-sub
  prop text = "Sign in to your Engentus account"
}

view EngentusLoginEmailField {
  kind form-field
  class auth-field
  prop label = "Email address"
  prop inputType = "email"
  prop inputId = "login-email"
  prop inputClass = "auth-input"
  prop placeholder = "you@company.com"
  prop autocomplete = "email"
}

view EngentusLoginPasswordField {
  kind form-field
  class auth-field
  prop label = "Password"
  prop inputType = "password"
  prop inputId = "login-pw"
  prop inputClass = "auth-input"
  prop placeholder = "••••••••"
  prop autocomplete = "current-password"
  prop inputStyle = "padding-right:36px"
  prop inputWrapClass = "auth-pw-wrap"
  bindings {
    inputType from state EngentusPasswordRevealed map true text false password default password
  }
  children {
    EngentusLoginPasswordToggle
  }
}

view EngentusLoginRememberField {
  kind checkbox-field
  class login-remember-field
  prop label = "Remember this device"
  prop inputId = "login-remember"
}

view EngentusLoginPrimaryAction {
  kind action
  prop tag = "button"
  class ms-btn
  prop href = "/engentus/home"
  prop messageRef = "EngentusSignInRequested"
  bindings {
    className from state EngentusShellAuthStatus map pending pending folding pending default ""
    disabled from state EngentusShellAuthStatus map pending true folding true default false
  }
  interactions {
    on click self deliver EngentusSignInRequested
  }
  children {
    EngentusLoginMicrosoftIcon
    EngentusLoginMicrosoftLabel
  }
}

view EngentusLoginMicrosoftIcon {
  kind leaf
  prop rawHtml = "<svg width='18' height='18' viewBox='0 0 21 21' xmlns='http://www.w3.org/2000/svg'><rect x='0' y='0' width='10' height='10' fill='#f25022'/><rect x='11' y='0' width='10' height='10' fill='#7fba00'/><rect x='0' y='11' width='10' height='10' fill='#00a4ef'/><rect x='11' y='11' width='10' height='10' fill='#ffb900'/></svg>"
}

view EngentusLoginMicrosoftLabel {
  kind text
  prop tag = "span"
  prop text = "Sign in with Microsoft"
  bindings {
    text from state EngentusShellAuthStatus map pending "Signing in…" folding "Signing in…" default "Sign in with Microsoft"
  }
}

view EngentusLoginDividerLeft {
  kind region
  class auth-divider-line
}

view EngentusLoginDividerText {
  kind text
  prop tag = "span"
  class auth-divider-text
  prop text = "or continue with email"
}

view EngentusLoginDividerRight {
  kind region
  class auth-divider-line
}

view EngentusLoginDivider {
  kind region
  class auth-divider
  children {
    EngentusLoginDividerLeft
    EngentusLoginDividerText
    EngentusLoginDividerRight
  }
}

view EngentusLoginPasswordToggle {
  kind action
  class auth-pw-toggle
  prop tag = "button"
  prop buttonType = "button"
  interactions {
    on click self set EngentusPasswordRevealed toggle
  }
  children {
    EngentusLoginPasswordToggleGlyph
  }
}

view EngentusLoginPasswordToggleGlyph {
  kind text
  prop tag = "span"
  prop text = "◉"
  bindings {
    text from state EngentusPasswordRevealed map true "◎" false "◉" default "◉"
  }
}

view EngentusLoginForgotAction {
  kind action
  prop label = "Forgot password?"
  prop href = "#"
}

view EngentusLoginForgotRow {
  kind region
  class auth-forgot
  children {
    EngentusLoginForgotAction
  }
}

view EngentusLoginSubmitAction {
  kind action
  prop tag = "button"
  class auth-submit
  prop href = "/engentus/home"
  prop messageRef = "EngentusSignInRequested"
  bindings {
    disabled from state EngentusShellAuthStatus map pending true folding true default false
  }
  interactions {
    on click self deliver EngentusSignInRequested
  }
  children {
    EngentusLoginSubmitLabel
  }
}

view EngentusLoginSubmitLabel {
  kind text
  prop tag = "span"
  prop text = "Sign in"
}

view EngentusLoginFormLogo {
  kind form-logo
  class auth-form-logo
  children {
    EngentusFormLogoImage
  }
}

view EngentusLoginForm {
  kind form-region
