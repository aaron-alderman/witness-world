}

state GoodmanCdfWindowVisible: bool {
  initial false
}

state GoodmanStatsWindowVisible: bool {
  initial false
}

state GoodmanAnovaWindowVisible: bool {
  initial false
}

state GoodmanRunStatusState: GoodmanRunStatus {
  initial ready
}

state GoodmanRunBoltsPerSet: number {
  initial 500
}

state GoodmanRunDurationMonths: number {
  initial 24
}

state GoodmanRunStepMonths: number {
  initial 0.5
}

state GoodmanStaticAppliedShear: number {
  initial 10000
}

state GoodmanStaticRpm: number {
