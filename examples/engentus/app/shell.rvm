  prop rawHtml = "<svg viewBox='0 0 66 50' fill='none' xmlns='http://www.w3.org/2000/svg' style='width:100%;height:100%'><rect width='66' height='50' fill='rgba(0,0,0,.25)' rx='4'/><rect x='6' y='6' width='12' height='10' fill='rgba(255,255,255,.25)' rx='1'/><rect x='20' y='6' width='12' height='10' fill='rgba(255,255,255,.1)' rx='1'/><rect x='34' y='6' width='12' height='10' fill='rgba(255,255,255,.2)' rx='1'/><rect x='48' y='6' width='12' height='10' fill='rgba(255,255,255,.08)' rx='1'/><rect x='6' y='19' width='12' height='10' fill='rgba(255,255,255,.08)' rx='1'/><rect x='20' y='19' width='12' height='10' fill='rgba(255,255,255,.28)' rx='1'/><rect x='34' y='19' width='12' height='10' fill='rgba(255,255,255,.12)' rx='1'/><rect x='48' y='19' width='12' height='10' fill='rgba(255,255,255,.22)' rx='1'/><rect x='6' y='32' width='12' height='10' fill='rgba(255,255,255,.15)' rx='1'/><rect x='20' y='32' width='12' height='10' fill='rgba(255,255,255,.06)' rx='1'/><rect x='34' y='32' width='12' height='10' fill='rgba(255,255,255,.3)' rx='1'/><rect x='48' y='32' width='12' height='10' fill='rgba(255,255,255,.14)' rx='1'/></svg>"
}

