  class engentus-mill-charge
  process EngentusShellNavigation
  prop domId = "view-mill"
  prop documentTitle = "Mill Charge Motion"
  prop routeKey = "mill-charge"
  prop routePath = "/engentus/mill-charge"
  prop mountMode = "mounted-panel"
  children {
    EngentusAppChrome
    MillChargeBody
  }
}

view MillForceHeader {
  kind screen-header
  class mill-force-header
  prop title = "Mill Force Analysis"
  prop subtitle = "Liner force distribution with dual-model comparison"
  prop backHref = "/engentus/home"
}

view MillForceControlHost {
  kind host
  class mill-force-control-host
  prop domId = "mill-force-controls"
}

view MillForceModelHost {
  kind host
  class mill-force-model-host
  prop domId = "mill-force-models"
}

view MillForceSidebar {
  kind sidebar
  class mill-force-controls
  prop domId = "mill-force-sb"
  prop scrollDomId = "mill-force-sb-scroll"
  children {
    MillForceControlHost
    MillForceModelHost
  }
}

view MillForceTabCrossSection {
  kind tab
  class mill-force-cht-tab
  prop label = "Cross-section"
  prop tabKey = "cross"
  bindings {
    className from state MillForceActiveChartTab map cross active default ""
  }
  interactions {
    on click self deliver MillForceShowCrossSectionRequested
  }
}

view MillForceTabForceVsAngle {
  kind tab
  class mill-force-cht-tab
  prop label = "Force vs Angle"
  prop tabKey = "force"
  bindings {
    className from state MillForceActiveChartTab map force active default ""
  }
  interactions {
    on click self deliver MillForceShowForceVsAngleRequested
  }
}

view MillForceTabForceRose {
  kind tab
  class mill-force-cht-tab
  prop label = "Force Rose"
  prop tabKey = "rose"
  bindings {
    className from state MillForceActiveChartTab map rose active default ""
  }
  interactions {
    on click self deliver MillForceShowForceRoseRequested
  }
}

view MillForceTabs {
  kind tab-strip
  class mill-force-chart-tabs
  prop domId = "mill-force-chart-tabs"
  children {
    MillForceTabCrossSection
    MillForceTabForceVsAngle
    MillForceTabForceRose
  }
}

view MillForceViewer {
  kind viewer
  class mill-force-viewer
  prop domId = "mill-force-chart-area"
  children {
    MillForceCross
    MillForceAngle
    MillForceRose
  }
}

view EngentusMillForceApp {
  kind app-shell
  class engentus-mill-force
  process EngentusShellNavigation
  capabilities {
    chart.render
  }
  prop domId = "view-mill-force"
  prop documentTitle = "Mill Force Analysis"
  prop routeKey = "mill-force"
  prop routePath = "/engentus/mill-force"
  prop mountMode = "mounted-panel"
  children {
    EngentusAppChrome
    MillForceHeader
    MillForceSidebar
    MillForceTabs
    MillForceViewer
  }
}

view EngentusRoot {
  kind app-root
  class engentus-spa
  process EngentusShellNavigation
  prop stylesheetHref = "/app-static/app/engentus-shell.css"
  children {
    EngentusLogin
    EngentusHome
    EngentusApp
    EngentusMillChargeApp
    EngentusMillForceApp
    EngentusSignout
  }
}
