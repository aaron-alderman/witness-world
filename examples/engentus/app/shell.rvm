import desire/v3-alpha

// Engentus is authored here as a composed shell definition first.
// Shared navigation intent, interaction bindings, and shell state projection
// are declared semantically rather than being smuggled through app-local JS.

enum EngentusShellRoute {
  cases {
    login
    home
    goodman
    mill-charge
    mill-force
    signout
  }
}

enum EngentusShellAuthState {
  cases {
    idle
    pending
    folding
    signedIn
    signingOut
    signedOut
    returning
  }
}

enum MillForceChartTab {
  cases {
    cross
    force
    rose
  }
}

enum MillForceAnalysisMode {
  cases {
    static
    compare
    mc
  }
}

enum MillForceModelSelection {
  cases {
    grounded
    faithful
  }
}

enum MillForceMcStatus {
  cases {
    ready
    running
    cleared
  }
}

enum GoodmanMode {
  cases {
    static
    mc
    edit
  }
}

enum GoodmanRunStatus {
  cases {
    ready
    running
    paused
    stopped
  }
}

state EngentusProfileMenuVisible: bool {
  initial false
}

state EngentusPasswordRevealed: bool {
  initial false
}

state EngentusShellActiveRoute: EngentusShellRoute {
  initial login
}

state EngentusShellAuthStatus: EngentusShellAuthState {
  initial idle
}

state MillForceActiveChartTab: MillForceChartTab {
  initial cross
}

state MillForceActiveAnalysisMode: MillForceAnalysisMode {
  initial static
}

state MillForceActiveModel: MillForceModelSelection {
  initial grounded
}

state MillForceMcStatusState: MillForceMcStatus {
  initial ready
}

state MillForceMcSamples: number {
  initial 200
}

state MillForceMcJTotalFree: bool {
  initial false
}

state MillForceMcPercentCritFree: bool {
  initial false
}

state MillForceMcPercentSolidsFree: bool {
  initial false
}

state MillForceMcHeightFree: bool {
  initial false
}

state GoodmanActiveMode: GoodmanMode {
