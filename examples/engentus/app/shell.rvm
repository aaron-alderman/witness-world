view EngentusSignout {
  kind auth-screen
  class engentus-signout surface-auth-view
  process EngentusShellNavigation
  prop domId = "view-signout"
  prop documentTitle = "You've been signed out"
  prop routeKey = "signout"
  prop routePath = "/engentus/signout"
  bindings {
