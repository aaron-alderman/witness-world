  source MillForceDepth
  prop digits = 1
  prop suffix = " m"
}

derive MillForceLinerMassText {
  kind format
  source MillForceLinerMass
  prop digits = 0
  prop suffix = " kg"
}

derive MillForceLinerHeightText {
  kind format
  source MillForceLinerHeight
  prop digits = 2
  prop suffix = " m"
}

derive GoodmanRunBoltsPerSetText {
