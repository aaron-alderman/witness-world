import desire/v3-alpha

// Engentus shell authored as DESIRE surfaces.
// The shell owns login, home, module routing, and signout.
// The mini-app content behind the shell stays route-backed through plugin.chart-runtime.

view EngentusToolbar {
  kind sidebar
  class engentus-toolbar
  prop role = "toolbar"
}

view EngentusLogin {
  kind auth-screen
  class engentus-login
  prop domId = "view-login"
  prop routeKey = "login"
  prop routePath = "/engentus/login"
  prop title = "Welcome back"
  prop subtitle = "Sign in to your Engentus account"
  prop heroTitle = "Structural Intelligence for SAG Mills"
  prop heroAccent = "SAG Mills"
  prop heroBody = "Real-time fatigue monitoring and predictive analysis for critical liner fasteners — from bolt load to remaining life."
  prop feature1Title = "Real-time bolt load monitoring"
  prop feature2Title = "Goodman fatigue diagram analysis"
  prop feature3Title = "Monte Carlo life prediction"
  prop feature4Title = "Multi-site fleet management"
  prop secondaryActionHref = "/engentus/home"
  prop primaryActionLabel = "Sign in"
  prop primaryActionHref = "/engentus/home"
  prop helpLabel = "Forgot password?"
  prop helpHref = "#"
  prop footnoteHtml = "By signing in you agree to Engentus's <a href=\"#\">Terms of Service</a> and <a href=\"#\">Privacy Policy</a>."
  prop footnote = "By signing in you agree to Engentus's Terms of Service and Privacy Policy."
  prop footerText = "© 2025 Engentus Pty Ltd. All rights reserved."
  children {
    EngentusToolbar
  }
}

view EngentusSignout {
  kind auth-screen
  class engentus-signout
  prop domId = "view-signout"
  prop routeKey = "signout"
  prop routePath = "/engentus/signout"
  prop title = "You've been signed out"
  prop subtitle = "Your session has ended securely.\nThank you for using Mill-iQ™."
  prop heroTitle = "Structural Intelligence for SAG Mills"
  prop heroAccent = "SAG Mills"
  prop heroBody = "Real-time fatigue monitoring and predictive analysis for critical liner fasteners — from bolt load to remaining life."
  prop feature1Title = "Real-time bolt load monitoring"
  prop feature2Title = "Goodman fatigue diagram analysis"
  prop feature3Title = "Monte Carlo life prediction"
  prop feature4Title = "Multi-site fleet management"
  prop primaryActionLabel = "Sign back in"
  prop primaryActionHref = "/engentus/login"
  prop footnote = "Mill-iQ™ is a product of Engentus Pty Ltd"
  prop footerText = "© 2025 Engentus Pty Ltd. All rights reserved."
  children {
    EngentusToolbar
  }
}

view NewsPanel {
  kind sidebar
  class news-rail
  prop role = "news"
  prop domId = "news-panel"
  prop headerLabel = "Feed"
  prop liveLabel = "Live"
  prop item1Tone = "alert"
  prop item1Category = "Alert"
  prop item1Title = "Sensor B7 on M48 reporting anomalous load readings — review recommended before next measurement window"
  prop item1Time = "2h ago"
  prop item2Tone = "platform"
  prop item2Category = "Platform"
  prop item2Title = "Scheduled maintenance window: API gateway Sunday 02:00–04:00 AWST"
  prop item2Time = "6h ago"
  prop item3Tone = "product"
  prop item3Category = "Product"
  prop item3Title = "Mill-iQ™ Fatigue Module v2.1.0 — Goodman diagram now supports multi-scenario ANOVA export"
  prop item3Time = "1d ago"
  prop item4Tone = "product"
  prop item4Category = "Product"
  prop item4Title = "M48 maintenance window complete — 3 bolt sets recalibrated and re-zeroed"
  prop item4Time = "2d ago"
  prop item5Tone = "industry"
  prop item5Category = "Industry"
  prop item5Title = "AS 4024 annex revision published — updated fatigue factors for mining fasteners now available"
  prop item5Time = "3d ago"
  prop item6Tone = "platform"
  prop item6Category = "Platform"
  prop item6Title = "New firmware v2.3.1 available for LinerSense o310 sensors"
  prop item6Time = "4d ago"
  prop item7Tone = "industry"
  prop item7Category = "Industry"
  prop item7Title = "MCA publishes updated guidelines on real-time structural monitoring for SAG mills"
  prop item7Time = "1w ago"
}

view ModuleCardMillCharge {
  kind module-card
  class active
  prop routeKey = "mill-charge"
  prop href = "/engentus/mill-charge"
  prop assetSrc = "/app-static/app/assets/module-mill-charge.svg"
  prop title = "Mill Charge Motion"
  prop description = "2D charge shape, regime & power proxy"
  prop state = "available"
  prop statusLabel = "Available"
  prop assetRef = "CHARGE"
}

view ModuleCardGoodman {
  kind module-card
  class active
  prop routeKey = "goodman"
  prop href = "/engentus/goodman"
  prop assetSrc = "/app-static/app/assets/module-goodman.svg"
  prop title = "Goodman Fatigue Diagram"
  prop description = "SN curve analysis with Monte Carlo simulation"
  prop state = "available"
  prop statusLabel = "Available"
  prop assetRef = "GOODMAN"
}

view ModuleCardMillForce {
  kind module-card
