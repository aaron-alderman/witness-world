}

view EngentusAuthProductLogo {
  kind image
  prop tag = "img"
  prop src = "/app-static/img/mill-iq.png"
  prop alt = "Mill-iQ™"
  prop style = "height:19px;width:auto;flex-shrink:0"
}

view EngentusAuthBrand {
