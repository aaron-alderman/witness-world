event EngentusSignInRequested {
}

event EngentusSignOutRequested {
}

event EngentusSignBackInRequested {
}

event EngentusSessionOpened {
  payload {
    actor: EngentusSessionActor
    identity: EngentusSessionIdentityId
    displayName: EngentusProfileDisplayName
    jobTitle: EngentusProfileJobTitle
    initials: EngentusProfileInitials
    resumeRouteKey: EngentusShellActiveRoute
    featureAccess__engentus_mill_force: EngentusMillForceAccess
    featureAccess__engentus_platform_config: EngentusPlatformConfigAccess
    PlatformConfigAccessRolesHint: PlatformConfigAccessRolesHint
    PlatformConfigAuthorityAuthenticatedIdentity: PlatformConfigAuthorityAuthenticatedIdentity
    PlatformConfigAuthorityAuthenticatedActor: PlatformConfigAuthorityAuthenticatedActor
    PlatformConfigAuthorityEffectiveIdentity: PlatformConfigAuthorityEffectiveIdentity
    PlatformConfigAuthorityEffectiveActor: PlatformConfigAuthorityEffectiveActor
    PlatformConfigAuthorityMode: PlatformConfigAuthorityMode
    PlatformConfigAuthorityAssumptionGrantId: PlatformConfigAuthorityAssumptionGrantId
    PlatformConfigAuthoritySummary: PlatformConfigAuthoritySummary
    PlatformConfigGrantSourceIdentityId: PlatformConfigGrantSourceIdentityId
    PlatformConfigGrantTargetActor: PlatformConfigGrantTargetActor
    PlatformConfigGrantSummary: PlatformConfigGrantSummary
    PlatformConfigAssumeIdentityId: PlatformConfigAssumeIdentityId
    PlatformConfigAssumeTargetActor: PlatformConfigAssumeTargetActor
    PlatformConfigAssumeSummary: PlatformConfigAssumeSummary
  }
  writes {
    EngentusAuthNotice: ""
    EngentusPasswordRevealed: false
    EngentusProfileMenuVisible: false
    EngentusPendingRouteKey: ""
    EngentusPendingFeatureId: ""
    EngentusPendingRoutePath: ""
  }
}

event EngentusSessionOpenFailed {
  payload {
    error: EngentusAuthNotice
  }
  writes {
    EngentusShellAuthStatus: idle
  }
}

event EngentusSessionClosed {
  writes {
    EngentusAuthNotice: "Signed out. Demo accounts: aaron / aaron or callan / callan."
    EngentusPasswordRevealed: false
    EngentusSessionActor: ""
    EngentusSessionIdentityId: ""
    EngentusProfileDisplayName: ""
    EngentusProfileJobTitle: ""
    EngentusProfileInitials: ""
    EngentusPendingRouteKey: ""
    EngentusPendingFeatureId: ""
    EngentusPendingRoutePath: ""
    EngentusCurrentPath: ""
    EngentusMillForceAccess: "login"
    EngentusPlatformConfigAccess: "hidden"
  }
}

