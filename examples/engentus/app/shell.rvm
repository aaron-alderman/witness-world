    PlatformConfigSecretSelectedId: PlatformConfigSecretSelectedId
    PlatformConfigSecretLabel: PlatformConfigSecretLabel
    PlatformConfigSecretValue: PlatformConfigSecretValue
    PlatformConfigSecretSearchVisible: PlatformConfigSecretSearchVisible
    PlatformConfigSecretSummary: PlatformConfigSecretSummary
    PlatformConfigDatasourceSelectedId: PlatformConfigDatasourceSelectedId
    PlatformConfigDatasourceLabel: PlatformConfigDatasourceLabel
    PlatformConfigDatasourceProvider: PlatformConfigDatasourceProvider
    PlatformConfigDatasourceHost: PlatformConfigDatasourceHost
    PlatformConfigDatasourcePort: PlatformConfigDatasourcePort
    PlatformConfigDatasourceDatabase: PlatformConfigDatasourceDatabase
    PlatformConfigDatasourceUser: PlatformConfigDatasourceUser
    PlatformConfigDatasourcePasswordSecretId: PlatformConfigDatasourcePasswordSecretId
    PlatformConfigDatasourcePath: PlatformConfigDatasourcePath
    PlatformConfigDatasourceSsl: PlatformConfigDatasourceSsl
    PlatformConfigDatasourceSearchVisible: PlatformConfigDatasourceSearchVisible
    PlatformConfigDatasourceSummary: PlatformConfigDatasourceSummary
    PlatformConfigPipelineSyncSelectedId: PlatformConfigPipelineSyncSelectedId
    PlatformConfigPipelineBindingSelectedName: PlatformConfigPipelineBindingSelectedName
    PlatformConfigPipelineBindingDatasourceId: PlatformConfigPipelineBindingDatasourceId
    PlatformConfigPipelineRunSelectedId: PlatformConfigPipelineRunSelectedId
    PlatformConfigPipelineLogRunSelectedId: PlatformConfigPipelineLogRunSelectedId
    PlatformConfigPipelineRowLimit: PlatformConfigPipelineRowLimit
    PlatformConfigPipelineMaxBatches: PlatformConfigPipelineMaxBatches
    PlatformConfigPipelineRunMode: PlatformConfigPipelineRunMode
    PlatformConfigPipelineScheduleEnabled: PlatformConfigPipelineScheduleEnabled
    PlatformConfigPipelineScheduleIntervalMs: PlatformConfigPipelineScheduleIntervalMs
    PlatformConfigScriptDatasourceId: PlatformConfigScriptDatasourceId
    PlatformConfigScriptResult: PlatformConfigScriptResult
    PlatformConfigAccessIdentitySelectedId: PlatformConfigAccessIdentitySelectedId
    PlatformConfigAccessIdentityUsername: PlatformConfigAccessIdentityUsername
    PlatformConfigAccessIdentityDisplayName: PlatformConfigAccessIdentityDisplayName
    PlatformConfigAccessIdentityJobTitle: PlatformConfigAccessIdentityJobTitle
    PlatformConfigAccessIdentityInitials: PlatformConfigAccessIdentityInitials
    PlatformConfigAccessIdentityRoles: PlatformConfigAccessIdentityRoles
    PlatformConfigAccessIdentitySummary: PlatformConfigAccessIdentitySummary
    PlatformConfigAccessFeatureSelectedId: PlatformConfigAccessFeatureSelectedId
    PlatformConfigAccessFeatureLabel: PlatformConfigAccessFeatureLabel
    PlatformConfigAccessFeatureVisibilityMode: PlatformConfigAccessFeatureVisibilityMode
    PlatformConfigAccessFeatureAllowedRoles: PlatformConfigAccessFeatureAllowedRoles
    PlatformConfigAccessFeatureSummary: PlatformConfigAccessFeatureSummary
    PlatformConfigAuthorityAuthenticatedIdentity: PlatformConfigAuthorityAuthenticatedIdentity
    PlatformConfigAuthorityAuthenticatedActor: PlatformConfigAuthorityAuthenticatedActor
    PlatformConfigAuthorityEffectiveIdentity: PlatformConfigAuthorityEffectiveIdentity
    PlatformConfigAuthorityEffectiveActor: PlatformConfigAuthorityEffectiveActor
    PlatformConfigAuthorityMode: PlatformConfigAuthorityMode
    PlatformConfigAuthorityAssumptionGrantId: PlatformConfigAuthorityAssumptionGrantId
    PlatformConfigAuthoritySummary: PlatformConfigAuthoritySummary
    PlatformConfigGrantSourceIdentityId: PlatformConfigGrantSourceIdentityId
    PlatformConfigGrantTargetActor: PlatformConfigGrantTargetActor
    PlatformConfigGrantSelectedId: PlatformConfigGrantSelectedId
    PlatformConfigGrantSummary: PlatformConfigGrantSummary
    PlatformConfigAssumeIdentityId: PlatformConfigAssumeIdentityId
    PlatformConfigAssumeTargetActor: PlatformConfigAssumeTargetActor
    PlatformConfigAssumeSummary: PlatformConfigAssumeSummary
    PlatformConfigAccessRolesHint: PlatformConfigAccessRolesHint
    message: PlatformConfigNoticeText
  }
  writes {
    PlatformConfigSecretBusy: false
    PlatformConfigDatasourceBusy: false
    PlatformConfigScriptBusy: false
    PlatformConfigAccessBusy: false
    PlatformConfigNoticeTone: success
  }
}

event PlatformConfigStateLoadFailed {
  payload {
    summary: PlatformConfigNoticeText
    message: PlatformConfigNoticeText
  }
  writes {
    PlatformConfigSecretBusy: false
    PlatformConfigDatasourceBusy: false
    PlatformConfigScriptBusy: false
    PlatformConfigAccessBusy: false
    PlatformConfigNoticeTone: error
  }
}

event PlatformConfigSecretMutationFailed {
  payload {
    summary: PlatformConfigSecretSummary
    message: PlatformConfigNoticeText
  }
  writes {
    PlatformConfigSecretBusy: false
    PlatformConfigNoticeTone: error
  }
}

event PlatformConfigDatasourceMutationFailed {
  payload {
    summary: PlatformConfigDatasourceSummary
    message: PlatformConfigNoticeText
  }
  writes {
    PlatformConfigDatasourceBusy: false
    PlatformConfigNoticeTone: error
  }
}

event PlatformConfigAccessMutationFailed {
  payload {
    summary: PlatformConfigAccessIdentitySummary
    featureSummary: PlatformConfigAccessFeatureSummary
    grantSummary: PlatformConfigGrantSummary
    authoritySummary: PlatformConfigAuthoritySummary
    assumeSummary: PlatformConfigAssumeSummary
    message: PlatformConfigNoticeText
  }
  writes {
    PlatformConfigAccessBusy: false
    PlatformConfigNoticeTone: error
  }
}

event PlatformConfigRunScriptRequested {
}

event PlatformConfigScriptSucceeded {
  payload {
    summary: PlatformConfigScriptResult
    message: PlatformConfigNoticeText
  }
  writes {
    PlatformConfigScriptBusy: false
    PlatformConfigNoticeTone: warn
  }
}

event PlatformConfigScriptFailed {
  payload {
    summary: PlatformConfigScriptResult
    message: PlatformConfigNoticeText
  }
  writes {
    PlatformConfigScriptBusy: false
    PlatformConfigNoticeTone: error
  }
}

command PlatformConfigLoadSnapshot {
  fields {
    secretQuery: PlatformConfigSecretSearchText
    datasourceQuery: PlatformConfigDatasourceSearchText
    scriptSyncId: PlatformConfigPipelineSyncSelectedId
    scriptBindingName: PlatformConfigPipelineBindingSelectedName
    scriptRunId: PlatformConfigPipelineRunSelectedId
    scriptLogRunId: PlatformConfigPipelineLogRunSelectedId
    scriptRowLimit: PlatformConfigPipelineRowLimit
    scriptMaxBatches: PlatformConfigPipelineMaxBatches
    scriptRunMode: PlatformConfigPipelineRunMode
    scriptScheduleEnabled: PlatformConfigPipelineScheduleEnabled
    scriptScheduleIntervalMs: PlatformConfigPipelineScheduleIntervalMs
  }
}

command EngentusOpenSession {
  fields {
    username: EngentusLoginUsername
    password: EngentusLoginPassword
    pendingRouteKey: EngentusPendingRouteKey
    pendingFeatureId: EngentusPendingFeatureId
    defaultRouteKey: "home"
    forbiddenRouteKey: "access-denied"
    notFoundRouteKey: "not-found"
  }
}

command EngentusCloseSession {
}

command PlatformConfigLoadSecret {
  fields {
    id: PlatformConfigSecretSelectedId
  }
}

command PlatformConfigCreateSecret {
  fields {
    title: PlatformConfigSecretLabel
    value: PlatformConfigSecretValue
  }
}

command PlatformConfigOverwriteSecret {
  fields {
    id: PlatformConfigSecretSelectedId
    title: PlatformConfigSecretLabel
    value: PlatformConfigSecretValue
  }
}

command PlatformConfigDeleteSecret {
  fields {
    id: PlatformConfigSecretSelectedId
  }
}

command PlatformConfigLoadDatasource {
  fields {
    id: PlatformConfigDatasourceSelectedId
  }
}

command PlatformConfigCreateDatasource {
  fields {
    title: PlatformConfigDatasourceLabel
    provider: PlatformConfigDatasourceProvider
    host: PlatformConfigDatasourceHost
    port: PlatformConfigDatasourcePort
    database: PlatformConfigDatasourceDatabase
    user: PlatformConfigDatasourceUser
    passwordSecretId: PlatformConfigDatasourcePasswordSecretId
    path: PlatformConfigDatasourcePath
    ssl: PlatformConfigDatasourceSsl
  }
}

command PlatformConfigUpdateDatasource {
  fields {
    id: PlatformConfigDatasourceSelectedId
    title: PlatformConfigDatasourceLabel
    provider: PlatformConfigDatasourceProvider
    host: PlatformConfigDatasourceHost
    port: PlatformConfigDatasourcePort
    database: PlatformConfigDatasourceDatabase
    user: PlatformConfigDatasourceUser
    passwordSecretId: PlatformConfigDatasourcePasswordSecretId
    path: PlatformConfigDatasourcePath
    ssl: PlatformConfigDatasourceSsl
  }
}

command PlatformConfigDeleteDatasource {
  fields {
    id: PlatformConfigDatasourceSelectedId
  }
}

command PlatformConfigTestDatasource {
  fields {
    id: PlatformConfigDatasourceSelectedId
    title: PlatformConfigDatasourceLabel
    provider: PlatformConfigDatasourceProvider
    host: PlatformConfigDatasourceHost
    port: PlatformConfigDatasourcePort
    database: PlatformConfigDatasourceDatabase
    user: PlatformConfigDatasourceUser
    passwordSecretId: PlatformConfigDatasourcePasswordSecretId
    ssl: PlatformConfigDatasourceSsl
  }
}

command PlatformConfigRunScript {
  fields {
    syncId: PlatformConfigPipelineSyncSelectedId
    mode: PlatformConfigPipelineRunMode
    rowLimit: PlatformConfigPipelineRowLimit
    maxBatches: PlatformConfigPipelineMaxBatches
  }
}

command PlatformConfigSaveScriptBinding {
  fields {
    syncId: PlatformConfigPipelineSyncSelectedId
    bindingName: PlatformConfigPipelineBindingSelectedName
