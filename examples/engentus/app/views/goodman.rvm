import desire/v3-alpha

// ── Goodman fatigue diagram (DESIRE `chart` form) ──────────────────────────────
//
// Grammar-of-graphics over BoltFatigue's axes. Each layer is a mark bound to a
// model channel; the layer stack maps 1:1 onto the SPA's <g id="g-*"> groups in
// example-ports/engentus js/chart.js (bands → curves → slip → yield → probe).
// dtypes drive the 80% defaults; explicit encodings reach the 20%. The renderer
// (D3) is the only thing lowered — the spec itself is honest IR.

chart GoodmanDiagram of BoltFatigue {
  frame cartesian
  prop pageStylesheetHref = "/app-static/app/engentus-chart-pages.css"
  prop bodyClass = "chart-page chart-page--goodman"
  prop viewportClass = "chart-page__viewport"
  prop hostClass = "chart-page__host chart-page__host--goodman"
  prop mountId = "chart-svg"
  prop mountClass = "chart-page__mount chart-page__mount--goodman"
  prop mountTag = "svg"
  prop functionsModules = "/app-static/app/chart-functions/goodman-stdlib.js"
  prop functionsExports = "goodmanFunctions"
  prop overlayCanvasId = "mc-canvas"
  prop overlayCanvasClass = "chart-page__overlay-canvas"
  prop tooltipId = "chart-tip"
  prop tooltipClass = "chart-page__tooltip chart-page__tooltip--goodman"
  prop pageBackground = "#ffffff"
  bindings {
    visible from state GoodmanActiveMode map mc false default true
    presentation.title from state GoodmanChartTitle
    presentation.xLabel from state GoodmanChartXAxisLabel
    presentation.yLabel from state GoodmanChartYAxisLabel
    presentation.titleSize from state GoodmanChartTitleSize
    presentation.axisSize from state GoodmanChartAxisSize
    presentation.showGrid from state GoodmanChartGridVisible
    presentation.showAnnotations from state GoodmanChartAnnotationsVisible
    presentation.pointSize from state GoodmanChartPointSize
    presentation.bandFills.0 from state GoodmanChartBandFill1
    presentation.bandFills.1 from state GoodmanChartBandFill2
    presentation.bandFills.2 from state GoodmanChartBandFill3
    presentation.bandFills.3 from state GoodmanChartBandFill4
    param.F_alt_applied_N from state GoodmanStaticAppliedShear
    param.rpm from state GoodmanStaticRpm
    param.sigma_lim from state GoodmanStaticEnduranceLimit
    param.m_slope from state GoodmanStaticSlope
    param.probe_sm from state GoodmanStaticProbeMeanStress
    param.uts from state GoodmanBoltPrimaryUts
    param.ys from state GoodmanBoltPrimaryYieldStress
  }

  x sm
  x.domain 0 650
  x.label "Mean stress σm (MPa)"

  y sigma_a
  y.domain 0 auto
  y.label "Alternating bending stress σa (MPa)"

  // first-class, witnessed representation choices (edit mode in the SPA)
  editable title, x.label, y.label, band.fills, annotations

  // layer stack (drawn bottom→top), each bound to a BoltFatigue channel
  layer bands  = area over lifetime | y:band fill:band.fills opacity:0.9
  layer glines = line over lifetime | y:band stroke:ylw width:1.2 dash:true opacity:0.9
  layer curves = line over sm | y:curve stroke:blue width:2.2 tooltip.sigma_m_MPa:sm tooltip.sigma_a_MPa:curve tooltip.F_shear_N:F_shear tooltip.damage_per_cycle_x10_6:damage_per_million
  layer slip   = rule | x:slip dash:true stroke:slate
  layer yield  = line over sm | y:yield_line stroke:pur width:1.5 dash:true
  layer curve_label = text | x:curve_label_x y:curve_label_y label:"No Jemtec" fill:blue size:11 weight:600
  layer probe  = rule | x:probe_sm stroke:slate width:1 dash:true opacity:0.5
  layer probe_point = point | x:probe_sm y:curve_probe fill:blue stroke:"#ffffff" width:2 size:5.5
}

// ── Goodman Monte-Carlo bands (over BoltFatigueMC) ─────────────────────────────
//
// The same σa-vs-σm frame, now showing the ensemble: a faint per-sample `cloud`, the
// p10..p90 `band`, and the p50 median line. Exercises the generic GoG runtime's new
// band/cloud marks over the reduced fields produced by `reduce … over sample`.
chart GoodmanMCBands of BoltFatigueMC {
  frame cartesian
  prop pageStylesheetHref = "/app-static/app/engentus-chart-pages.css"
  prop bodyClass = "chart-page chart-page--goodman"
  prop viewportClass = "chart-page__viewport"
  prop hostClass = "chart-page__host chart-page__host--goodman"
  prop mountId = "chart-svg-mc"
  prop mountClass = "chart-page__mount chart-page__mount--goodman"
  prop mountTag = "svg"
  prop functionsModules = "/app-static/app/chart-functions/goodman-stdlib.js,/app-static/app/chart-functions/sampling.js"
  prop functionsExports = "goodmanFunctions,samplingFunctions"
  prop overlayCanvasId = "mc-canvas-mc"
  prop overlayCanvasClass = "chart-page__overlay-canvas"
  prop tooltipId = "chart-tip-mc"
  prop tooltipClass = "chart-page__tooltip chart-page__tooltip--goodman"
  prop pageBackground = "#ffffff"
  bindings {
    visible from state GoodmanActiveMode map mc true default false
    presentation.title from state GoodmanChartTitle
    presentation.xLabel from state GoodmanChartXAxisLabel
    presentation.yLabel from state GoodmanChartYAxisLabel
    presentation.titleSize from state GoodmanChartTitleSize
    presentation.axisSize from state GoodmanChartAxisSize
    presentation.showGrid from state GoodmanChartGridVisible
    presentation.showAnnotations from state GoodmanChartAnnotationsVisible
    presentation.pointSize from state GoodmanChartPointSize
    presentation.bandFills.0 from state GoodmanChartBandFill1
    presentation.bandFills.1 from state GoodmanChartBandFill2
    presentation.bandFills.2 from state GoodmanChartBandFill3
    presentation.bandFills.3 from state GoodmanChartBandFill4
    param.F_alt_applied_N from state GoodmanStaticAppliedShear
    param.n_samples from state GoodmanRunBoltsPerSet
    param.uts from state GoodmanBoltPrimaryUts
    param.ys from state GoodmanBoltPrimaryYieldStress
  }

  x sm
  x.domain 0 650
  x.label "Mean stress σm (MPa)"
  y sigma_a
  y.domain 0 auto
  y.label "Alternating bending stress σa (MPa)"

  layer cloud = cloud over sample | x:sm y:curve_s stroke:slate
  layer band  = band over sm | x:sm y0:sa_p10 y1:sa_p90 fill:blue opacity:0.25
  layer med   = line over sm | y:sa_p50 stroke:blue width:2.2
}
