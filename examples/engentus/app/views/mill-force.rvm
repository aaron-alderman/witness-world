import desire/v3-alpha

// ── Mill-force charts ──────────────────────────────────────────────────────────
//
// Three grammar-of-graphics views over the MillForce model. They exercise the
// generic GoG runtime's new reach: a `where` slice (pick the `method` axis),
// x-from-a-field (the segment angle tBar), and the polar frame with polygon /
// wedge marks. Mirrors example-ports/engentus js/mill_force_charts.js.

// Force vs angle (cartesian): radial / tangential / resultant for the grounded model
chart MillForceAngle of MillForce {
  frame cartesian
  prop pageStylesheetHref = "/app-static/app/engentus-chart-pages.css"
  prop bodyClass = "chart-page chart-page--mill-force"
  prop viewportClass = "chart-page__viewport"
  prop hostClass = "chart-page__host chart-page__host--mill-force"
  prop mountId = "mill-force-svg-force"
  prop mountClass = "chart-page__mount chart-page__mount--mill-force"
  prop mountTag = "svg"
  prop functionsModules = "/app-static/app/chart-functions/mill-force-kernels.js"
  prop functionsExports = "millForceKernels"
  prop overlayCanvasId = "mill-force-force-canvas"
  prop overlayCanvasClass = "chart-page__overlay-canvas"
  prop tooltipId = "mill-force-force-tip"
  prop tooltipClass = "chart-page__tooltip chart-page__tooltip--mill-force"
  prop pageBackground = "#ffffff"
  bindings {
    visible from state MillForceActiveChartTab map force true default false
    param.percent_crit from state MillForcePercentCrit
    param.mu from state MillForceMu
    param.radius from state MillForceRadius
    param.beta_prime_deg from state MillForceBetaPrimeDeg
    param.N_segments from state MillForceSegmentCount
    param.J_total from state MillForceTotalFill
    param.J_balls from state MillForceBallFill
    param.J_voids from state MillForceVoidFraction
    param.percent_solids from state MillForcePercentSolids
    param.rho_ball from state MillForceBallDensity
    param.rho_ore from state MillForceOreDensity
    param.depth from state MillForceDepth
    param.m_liner from state MillForceLinerMass
    param.height from state MillForceLinerHeight
    param.active_method from state MillForceActiveModel
  }

  x tBar
  x.domain 0 auto
  x.label "Segment angle θ (rad)"
  y force
  y.domain 0 auto
  y.label "Force (N)"
  layer fr   = line over segment | x:tBar y:F_r where:method=param.active_method stroke:blue
  layer ft   = line over segment | x:tBar y:F_t where:method=param.active_method stroke:red
  layer fres = line over segment | x:tBar y:F_resultant where:method=param.active_method stroke:ylw width:2.4
}

// Force rose (polar): resultant magnitude per segment, traced as a closed polygon
chart MillForceRose of MillForce {
  frame polar
  prop pageStylesheetHref = "/app-static/app/engentus-chart-pages.css"
  prop bodyClass = "chart-page chart-page--mill-force"
  prop viewportClass = "chart-page__viewport"
  prop hostClass = "chart-page__host chart-page__host--mill-force"
  prop mountId = "mill-force-svg-rose"
  prop mountClass = "chart-page__mount chart-page__mount--mill-force"
  prop mountTag = "svg"
  prop functionsModules = "/app-static/app/chart-functions/mill-force-kernels.js"
  prop functionsExports = "millForceKernels"
  prop overlayCanvasId = "mill-force-rose-canvas"
  prop overlayCanvasClass = "chart-page__overlay-canvas"
  prop tooltipId = "mill-force-rose-tip"
  prop tooltipClass = "chart-page__tooltip chart-page__tooltip--mill-force"
  prop pageBackground = "#ffffff"
  bindings {
    visible from state MillForceActiveChartTab map rose true default false
    param.percent_crit from state MillForcePercentCrit
    param.mu from state MillForceMu
    param.radius from state MillForceRadius
    param.beta_prime_deg from state MillForceBetaPrimeDeg
    param.N_segments from state MillForceSegmentCount
    param.J_total from state MillForceTotalFill
    param.J_balls from state MillForceBallFill
    param.J_voids from state MillForceVoidFraction
    param.percent_solids from state MillForcePercentSolids
    param.rho_ball from state MillForceBallDensity
    param.rho_ore from state MillForceOreDensity
    param.depth from state MillForceDepth
    param.m_liner from state MillForceLinerMass
    param.height from state MillForceLinerHeight
    param.active_method from state MillForceActiveModel
  }

  theta tBar
  r F_resultant
  r.domain 0 auto
  layer rose = polygon over segment | theta:tBar r:F_resultant where:method=param.active_method stroke:blue fill:blue
}

// Cross-section (polar): per-segment wedge coloured by resultant force
chart MillForceCross of MillForce {
  frame polar
  prop pageStylesheetHref = "/app-static/app/engentus-chart-pages.css"
  prop bodyClass = "chart-page chart-page--mill-force"
  prop viewportClass = "chart-page__viewport"
  prop hostClass = "chart-page__host chart-page__host--mill-force"
  prop mountId = "mill-force-svg-cross"
  prop mountClass = "chart-page__mount chart-page__mount--mill-force"
  prop mountTag = "svg"
  prop functionsModules = "/app-static/app/chart-functions/mill-force-kernels.js"
  prop functionsExports = "millForceKernels"
  prop overlayCanvasId = "mill-force-cross-canvas"
  prop overlayCanvasClass = "chart-page__overlay-canvas"
  prop tooltipId = "mill-force-cross-tip"
  prop tooltipClass = "chart-page__tooltip chart-page__tooltip--mill-force"
  prop pageBackground = "#ffffff"
  bindings {
    visible from state MillForceActiveChartTab map cross true default false
    param.percent_crit from state MillForcePercentCrit
    param.mu from state MillForceMu
    param.radius from state MillForceRadius
    param.beta_prime_deg from state MillForceBetaPrimeDeg
    param.N_segments from state MillForceSegmentCount
    param.J_total from state MillForceTotalFill
    param.J_balls from state MillForceBallFill
    param.J_voids from state MillForceVoidFraction
    param.percent_solids from state MillForcePercentSolids
    param.rho_ball from state MillForceBallDensity
    param.rho_ore from state MillForceOreDensity
    param.depth from state MillForceDepth
    param.m_liner from state MillForceLinerMass
    param.height from state MillForceLinerHeight
    param.active_method from state MillForceActiveModel
  }

  theta tBar
  r F_resultant
  r.domain 0 auto
  layer liners = wedge over segment | theta0:t1 theta1:t2 value:F_resultant where:method=param.active_method
}
