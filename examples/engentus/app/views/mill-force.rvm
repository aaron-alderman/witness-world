import desire/v3-alpha

// ── Mill-force charts ──────────────────────────────────────────────────────────
//
// Three grammar-of-graphics views over the MillForce model. They exercise the
// generic GoG runtime's new reach: a `where` slice (pick the `method` axis),
// x-from-a-field (the segment angle tBar), and the polar frame with polygon /
// wedge marks. Mirrors example-ports/engentus js/mill_force_charts.js.

// Force vs angle (cartesian): radial / tangential / resultant for the grounded model
chart MillForceAngle of MillForce {
  frame cartesian
  prop pageStylesheetHref = "/app-static/app/engentus-chart-pages.css"
  prop bodyClass = "chart-page chart-page--mill-force"
  prop viewportClass = "chart-page__viewport"
  prop hostClass = "chart-page__host chart-page__host--mill-force"
  prop mountId = "mill-force-svg-force"
  prop mountClass = "chart-page__mount chart-page__mount--mill-force"
  prop mountTag = "svg"
  prop functionsModules = "/app-static/app/chart-functions/mill-force-kernels.js"
  prop functionsExports = "millForceKernels"
  prop overlayCanvasId = "mill-force-force-canvas"
  prop overlayCanvasClass = "chart-page__overlay-canvas"
  prop tooltipId = "mill-force-force-tip"
  prop tooltipClass = "chart-page__tooltip chart-page__tooltip--mill-force"
  prop pageBackground = "#ffffff"
  bindings {
    visible from state MillForceActiveChartTab map force true default false
    param.percent_crit from state MillForcePercentCrit
    param.mu from state MillForceMu
    param.radius from state MillForceRadius
    param.beta_prime_deg from state MillForceBetaPrimeDeg
    param.N_segments from state MillForceSegmentCount
    param.J_total from state MillForceTotalFill
    param.J_balls from state MillForceBallFill
    param.J_voids from state MillForceVoidFraction
    param.percent_solids from state MillForcePercentSolids
    param.rho_ball from state MillForceBallDensity
    param.rho_ore from state MillForceOreDensity
    param.depth from state MillForceDepth
    param.m_liner from state MillForceLinerMass
    param.height from state MillForceLinerHeight
    param.active_method from state MillForceActiveModel
    param.analysis_mode from state MillForceActiveAnalysisMode
  }

  x tBar
  x.domain 0 auto
  x.label "Segment angle θ (rad)"
  y force
  y.domain 0 auto
  y.label "Force (N)"
  layer fr   = line over segment | x:tBar y:F_r where:method=param.active_method stroke:blue tooltip.liner:segment tooltip.method:param.active_method tooltip.F_r_N:F_r tooltip.F_t_N:F_t tooltip.F_resultant_N:F_resultant unless:param.analysis_mode=compare
  layer ft   = line over segment | x:tBar y:F_t where:method=param.active_method stroke:red tooltip.liner:segment tooltip.method:param.active_method tooltip.F_r_N:F_r tooltip.F_t_N:F_t tooltip.F_resultant_N:F_resultant unless:param.analysis_mode=compare
  layer fres = line over segment | x:tBar y:F_resultant where:method=param.active_method stroke:ylw width:2.4 tooltip.liner:segment tooltip.method:param.active_method tooltip.F_r_N:F_r tooltip.F_t_N:F_t tooltip.F_resultant_N:F_resultant unless:param.analysis_mode=compare
  layer grounded_fr   = line over segment | x:tBar y:F_r where:method=grounded stroke:blue tooltip.liner:segment tooltip.method:grounded tooltip.F_r_N:F_r tooltip.F_t_N:F_t tooltip.F_resultant_N:F_resultant when:param.analysis_mode=compare
  layer grounded_ft   = line over segment | x:tBar y:F_t where:method=grounded stroke:red tooltip.liner:segment tooltip.method:grounded tooltip.F_r_N:F_r tooltip.F_t_N:F_t tooltip.F_resultant_N:F_resultant when:param.analysis_mode=compare
  layer grounded_fres = line over segment | x:tBar y:F_resultant where:method=grounded stroke:ylw width:2.4 tooltip.liner:segment tooltip.method:grounded tooltip.F_r_N:F_r tooltip.F_t_N:F_t tooltip.F_resultant_N:F_resultant when:param.analysis_mode=compare
  layer faithful_fr   = line over segment | x:tBar y:F_r where:method=faithful stroke:slate dash:true tooltip.liner:segment tooltip.method:faithful tooltip.F_r_N:F_r tooltip.F_t_N:F_t tooltip.F_resultant_N:F_resultant when:param.analysis_mode=compare
  layer faithful_ft   = line over segment | x:tBar y:F_t where:method=faithful stroke:pur dash:true tooltip.liner:segment tooltip.method:faithful tooltip.F_r_N:F_r tooltip.F_t_N:F_t tooltip.F_resultant_N:F_resultant when:param.analysis_mode=compare
  layer faithful_fres = line over segment | x:tBar y:F_resultant where:method=faithful stroke:dk width:2.4 dash:true tooltip.liner:segment tooltip.method:faithful tooltip.F_r_N:F_r tooltip.F_t_N:F_t tooltip.F_resultant_N:F_resultant when:param.analysis_mode=compare
}

// Force rose (polar): resultant magnitude per segment, traced as a closed polygon
chart MillForceRose of MillForce {
  frame polar
  prop pageStylesheetHref = "/app-static/app/engentus-chart-pages.css"
  prop bodyClass = "chart-page chart-page--mill-force"
  prop viewportClass = "chart-page__viewport"
  prop hostClass = "chart-page__host chart-page__host--mill-force"
  prop mountId = "mill-force-svg-rose"
  prop mountClass = "chart-page__mount chart-page__mount--mill-force"
  prop mountTag = "svg"
  prop functionsModules = "/app-static/app/chart-functions/mill-force-kernels.js"
  prop functionsExports = "millForceKernels"
  prop overlayCanvasId = "mill-force-rose-canvas"
  prop overlayCanvasClass = "chart-page__overlay-canvas"
  prop tooltipId = "mill-force-rose-tip"
  prop tooltipClass = "chart-page__tooltip chart-page__tooltip--mill-force"
  prop pageBackground = "#ffffff"
  bindings {
    visible from state MillForceActiveChartTab map rose true default false
    param.percent_crit from state MillForcePercentCrit
    param.mu from state MillForceMu
    param.radius from state MillForceRadius
    param.beta_prime_deg from state MillForceBetaPrimeDeg
    param.N_segments from state MillForceSegmentCount
    param.J_total from state MillForceTotalFill
    param.J_balls from state MillForceBallFill
    param.J_voids from state MillForceVoidFraction
    param.percent_solids from state MillForcePercentSolids
    param.rho_ball from state MillForceBallDensity
    param.rho_ore from state MillForceOreDensity
    param.depth from state MillForceDepth
    param.m_liner from state MillForceLinerMass
    param.height from state MillForceLinerHeight
    param.active_method from state MillForceActiveModel
    param.analysis_mode from state MillForceActiveAnalysisMode
  }

  theta tBar
  r F_resultant
  r.domain 0 auto
  layer rose = polygon over segment | theta:tBar r:F_resultant where:method=param.active_method stroke:blue fill:blue tooltip.liner:segment tooltip.method:param.active_method tooltip.F_resultant_N:F_resultant unless:param.analysis_mode=compare
  layer grounded_rose = polygon over segment | theta:tBar r:F_resultant where:method=grounded stroke:blue fill:blue tooltip.liner:segment tooltip.method:grounded tooltip.F_resultant_N:F_resultant when:param.analysis_mode=compare
  layer faithful_rose = polygon over segment | theta:tBar r:F_resultant where:method=faithful stroke:ylw fill:ylw tooltip.liner:segment tooltip.method:faithful tooltip.F_resultant_N:F_resultant when:param.analysis_mode=compare
}

// Cross-section (polar): per-segment wedge coloured by resultant force
chart MillForceCross of MillForce {
  frame polar
  prop pageStylesheetHref = "/app-static/app/engentus-chart-pages.css"
  prop bodyClass = "chart-page chart-page--mill-force"
  prop viewportClass = "chart-page__viewport"
  prop hostClass = "chart-page__host chart-page__host--mill-force"
  prop mountId = "mill-force-svg-cross"
  prop mountClass = "chart-page__mount chart-page__mount--mill-force"
  prop mountTag = "svg"
  prop functionsModules = "/app-static/app/chart-functions/mill-force-kernels.js"
  prop functionsExports = "millForceKernels"
  prop overlayCanvasId = "mill-force-cross-canvas"
  prop overlayCanvasClass = "chart-page__overlay-canvas"
  prop tooltipId = "mill-force-cross-tip"
  prop tooltipClass = "chart-page__tooltip chart-page__tooltip--mill-force"
  prop pageBackground = "#ffffff"
  bindings {
    visible from state MillForceActiveChartTab map cross true default false
    param.percent_crit from state MillForcePercentCrit
    param.mu from state MillForceMu
    param.radius from state MillForceRadius
    param.beta_prime_deg from state MillForceBetaPrimeDeg
    param.N_segments from state MillForceSegmentCount
    param.J_total from state MillForceTotalFill
    param.J_balls from state MillForceBallFill
    param.J_voids from state MillForceVoidFraction
    param.percent_solids from state MillForcePercentSolids
    param.rho_ball from state MillForceBallDensity
    param.rho_ore from state MillForceOreDensity
    param.depth from state MillForceDepth
    param.m_liner from state MillForceLinerMass
    param.height from state MillForceLinerHeight
    param.active_method from state MillForceActiveModel
    param.analysis_mode from state MillForceActiveAnalysisMode
  }

  theta tBar
  r radius
  r.domain 0 radius
  layer shell = circle | r:radius stroke:slate width:1.5
  layer inner = circle | r:rInner stroke:slate width:0.8 dash:true opacity:0.65
  layer liners = annular-wedge over segment | theta0:t1 theta1:t2 r0:rInner r1:radius value:F_resultant where:method=param.active_method tooltip.liner:segment tooltip.method:param.active_method tooltip.mass_kg:m_charge tooltip.F_r_N:F_r tooltip.F_t_N:F_t tooltip.F_resultant_N:F_resultant unless:param.analysis_mode=compare
  layer grounded_liners = annular-wedge over segment | theta0:t1 theta1:t2 r0:rCompareMid r1:radius value:F_resultant where:method=grounded tooltip.liner:segment tooltip.method:grounded tooltip.mass_kg:m_charge tooltip.F_r_N:F_r tooltip.F_t_N:F_t tooltip.F_resultant_N:F_resultant when:param.analysis_mode=compare
  layer faithful_liners = annular-wedge over segment | theta0:t1 theta1:t2 r0:rInner r1:rCompareMid value:F_resultant where:method=faithful fill:ylw stroke:dk opacity:0.74 tooltip.liner:segment tooltip.method:faithful tooltip.mass_kg:m_charge tooltip.F_r_N:F_r tooltip.F_t_N:F_t tooltip.F_resultant_N:F_resultant when:param.analysis_mode=compare
}
