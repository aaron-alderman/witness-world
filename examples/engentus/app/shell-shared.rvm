view EngentusHomeHeaderTitle {
  kind text
  prop tag = "h2"
  prop text = "Analysis Modules"
}

view EngentusHomeHeaderSubtitle {
  kind text
  prop tag = "p"
  prop text = "Select a module to begin analysis"
}

view EngentusHomeContextPill {
  kind context-pill
  class mill-pill
  prop text = "⚙ M48 – Goldfields"
}

view EngentusHomeHeaderMeta {
  kind header-meta
  class mod-area-meta
  children {
    EngentusHomeHeaderSubtitle
    EngentusHomeContextPill
  }
}

view EngentusHomeHeader {
  kind screen-header
  class mod-area-hdr
  children {
    EngentusHomeHeaderTitle
    EngentusHomeHeaderMeta
  }
}

view EngentusHomeMain {
  kind main-region
  prop domId = "module-area"
  children {
    EngentusHomeHeader
    ModuleGrid
  }
}

view EngentusHomeBody {
  kind body
  prop domId = "body"
  children {
    NewsPanel
    EngentusHomeMain
  }
}

view EngentusHome {
  kind app-shell
  class engentus-home
  process EngentusShellNavigation
  prop domId = "view-home"
  prop documentTitle = "Analysis Modules"
  prop routeKey = "home"
  prop routePath = "/engentus/home"
  children {
    EngentusHomeChrome
    EngentusHomeBody
  }
}

