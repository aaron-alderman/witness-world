import desire/v3-alpha

view EngentusAuthBrandLogo {
  kind image
  prop tag = "img"
  prop src = "/app-static/img/engentus.png"
  prop alt = "Engentus"
  prop style = "height:17px;width:auto;flex-shrink:0"
}

view EngentusAuthBrandDivider {
  kind divider
  class auth-brand-div
}

view EngentusAuthProductLogo {
  kind image
  prop tag = "img"
  prop src = "/app-static/img/mill-iq.png"
  prop alt = "Mill-iQ™"
  prop style = "height:19px;width:auto;flex-shrink:0"
}

view EngentusAuthBrand {
  kind brand
  class auth-brand
  children {
    EngentusAuthBrandLogo
    EngentusAuthBrandDivider
    EngentusAuthProductLogo
  }
}

view EngentusToolbarBrandDivider {
  kind divider
  prop domId = "tb-divider"
}

view EngentusToolbarBrandLogo {
  kind image
  prop tag = "img"
  prop src = "/app-static/img/engentus.png"
  prop alt = "Engentus"
  prop style = "height:20px;width:auto;flex-shrink:0"
}

view EngentusToolbarProductLogo {
  kind image
  prop tag = "img"
  prop src = "/app-static/img/mill-iq.png"
  prop alt = "Mill-iQ™"
  prop style = "height:22px;width:auto;flex-shrink:0"
}

view EngentusAppBrand {
  kind brand
  prop domId = "tb-brand"
  prop href = "/engentus/home"
  interactions {
    on click self deliver EngentusNavigateHomeRequested
  }
  children {
    EngentusToolbarBrandLogo
    EngentusToolbarBrandDivider
    EngentusToolbarProductLogo
  }
}

view EngentusSiteSummary {
  kind site-summary
  class tb-site-summary
  prop text = "Mill: M48 – Goldfields"
}

view EngentusToolbarMiddle {
  kind toolbar-region
  prop domId = "tb-goodman-tools"
  children {
    GoodmanModesToolbar
    GoodmanWindowToolbar
  }
}

view EngentusProfileAvatar {
  kind avatar
  prop domId = "up-avatar"
  prop text = "AA"
}

view EngentusProfileName {
  kind text
  prop domId = "up-name"
  prop text = "Aaron A."
}

view EngentusProfileRole {
  kind text
  prop domId = "up-role"
  prop text = "Lead Engineer"
}

view EngentusProfileInfo {
  kind profile-info
  prop domId = "up-info"
  children {
    EngentusProfileName
    EngentusProfileRole
  }
}

view EngentusProfileCaret {
  kind text
  prop domId = "up-caret"
  prop tag = "span"
  prop text = "▾"
}

view EngentusProfileMenuProfileIcon {
  kind text
  class up-mi-icon
  prop tag = "span"
  prop text = "👤"
}

view EngentusProfileMenuProfile {
  kind menu-item
  class up-mi
  prop text = "Profile"
  children {
    EngentusProfileMenuProfileIcon
  }
}

view EngentusProfileMenuSettingsIcon {
  kind text
  class up-mi-icon
  prop tag = "span"
  prop text = "⚙"
}

view EngentusProfileMenuSettings {
  kind menu-item
  class up-mi
  prop text = "Settings"
  children {
    EngentusProfileMenuSettingsIcon
  }
}

view EngentusProfileMenuExportIcon {
  kind text
  class up-mi-icon
  prop tag = "span"
  prop text = "📋"
}

view EngentusProfileMenuExport {
  kind menu-item
  class up-mi
  prop text = "Report export"
  children {
    EngentusProfileMenuExportIcon
  }
}

view EngentusProfileMenuSeparatorPrimary {
  kind divider
  class up-sep
}

view EngentusProfileMenuMillIcon {
  kind text
  class up-mi-icon
  prop tag = "span"
  prop text = "🏭"
}

view EngentusProfileMenuMill {
  kind menu-item
  class up-mi
  prop text = "Mill: M48 – Goldfields"
  children {
    EngentusProfileMenuMillIcon
  }
}

view EngentusProfileMenuSeparatorSecondary {
  kind divider
  class up-sep
}

view EngentusProfileMenuSignoutIcon {
  kind text
  class up-mi-icon
  prop tag = "span"
  prop text = "↩"
}

view EngentusProfileMenuSignout {
  kind menu-item
  class up-mi up-mi-signout
  prop style = "color:#f87171;cursor:pointer"
  prop text = "Sign out"
  prop messageRef = "EngentusSignOutRequested"
  interactions {
    on click self deliver EngentusSignOutRequested
  }
  children {
    EngentusProfileMenuSignoutIcon
  }
}

view EngentusProfileMenu {
  kind menu
  prop domId = "up-menu"
  bindings {
    className from state EngentusProfileMenuVisible map true open default ""
  }
  children {
    EngentusProfileMenuProfile
    EngentusProfileMenuSettings
    EngentusProfileMenuExport
    EngentusProfileMenuSeparatorPrimary
    EngentusProfileMenuMill
    EngentusProfileMenuSeparatorSecondary
    EngentusProfileMenuSignout
  }
}

view EngentusProfileSummary {
  kind profile-summary
  prop domId = "user-prof"
  interactions {
    on click self set EngentusProfileMenuVisible toggle
  }
  children {
    EngentusProfileAvatar
    EngentusProfileInfo
    EngentusProfileCaret
    EngentusProfileMenu
  }
}

view EngentusHomeBrand {
  kind brand
  prop domId = "tb-brand"
  interactions {
    on click self deliver EngentusNavigateHomeRequested
  }
  children {
    EngentusToolbarBrandLogo
    EngentusToolbarBrandDivider
    EngentusToolbarProductLogo
  }
}

view EngentusHomeToolbarModeStatic {
  kind action
  class mode-btn on
  prop tag = "button"
  prop label = "Static"
}

view EngentusHomeToolbarModeMonteCarlo {
  kind action
  class mode-btn
  prop tag = "button"
  prop label = "Monte Carlo"
}

view EngentusHomeToolbarModeEdit {
  kind action
  class mode-btn
  prop tag = "button"
  prop label = "✏ Edit"
}

view EngentusHomeToolbarModes {
  kind toolbar-modes
  class mode-pill
  children {
    EngentusHomeToolbarModeStatic
    EngentusHomeToolbarModeMonteCarlo
    EngentusHomeToolbarModeEdit
  }
}

view EngentusHomeToolbarWinCdf {
  kind action
  class tbw
  prop tag = "button"
  prop label = "📈 CDF"
}

view EngentusHomeToolbarWinStats {
  kind action
  class tbw
  prop tag = "button"
  prop label = "📊 Stats"
}

view EngentusHomeToolbarWinAnova {
  kind action
  class tbw
  prop tag = "button"
  prop label = "🔬 ANOVA"
}

view EngentusHomeToolbarWins {
  kind toolbar-actions
  prop domId = "tb-wins"
  children {
    EngentusHomeToolbarWinCdf
    EngentusHomeToolbarWinStats
    EngentusHomeToolbarWinAnova
  }
}

view EngentusHomeToolbarMiddle {
  kind toolbar-region
  prop domId = "tb-goodman-tools"
  prop style = "display: none;"
  children {
    EngentusHomeToolbarModes
    EngentusHomeToolbarWins
  }
}

view EngentusHomeChrome {
  kind chrome
  prop domId = "tb"
  children {
    EngentusHomeBrand
    EngentusProfileSummary
  }
}

view EngentusAppChrome {
  kind chrome
  prop domId = "tb"
  children {
    EngentusAppBrand
    EngentusToolbarMiddle
    EngentusProfileSummary
  }
}

view EngentusModuleChrome {
  kind chrome
  prop domId = "tb"
  children {
    EngentusAppBrand
    EngentusProfileSummary
  }
}

view EngentusAuthFooter {
  kind footer
  class auth-footer
  prop text = "© 2025 Engentus Pty Ltd. All rights reserved."
}

view EngentusHeroLogo {
  kind image
  prop tag = "img"
  prop src = "/app-static/img/mill-iq.png"
  prop alt = "Mill-iQ™"
  prop style = "height:42px;width:auto;margin-bottom:28px"
}

view EngentusFormLogoImage {
  kind image
  prop tag = "img"
  prop src = "/app-static/img/mill-iq.png"
  prop alt = "Mill-iQ™"
  prop style = "height:30px;width:auto"
}

view EngentusHeroTagline {
  kind text
  class auth-tagline
  prop rawHtml = "Structural Intelligence<br>for <em>SAG Mills</em>"
}

view EngentusHeroSubtitle {
  kind text
  class auth-sub
  prop text = "Real-time fatigue monitoring and predictive analysis for critical liner fasteners — from bolt load to remaining life."
}

view EngentusFeatureRealtimeLoadDot {
  kind bullet-dot
  class auth-bullet-dot
}

view EngentusFeatureRealtimeLoadText {
  kind text
  prop text = "Real-time bolt load monitoring"
}

view EngentusFeatureRealtimeLoad {
  kind feature-item
  class auth-bullet
  prop tag = "li"
  children {
    EngentusFeatureRealtimeLoadDot
    EngentusFeatureRealtimeLoadText
  }
}

view EngentusFeatureGoodmanAnalysisDot {
  kind bullet-dot
  class auth-bullet-dot
}

view EngentusFeatureGoodmanAnalysisText {
  kind text
  prop text = "Goodman fatigue diagram analysis"
}

view EngentusFeatureGoodmanAnalysis {
  kind feature-item
  class auth-bullet
  prop tag = "li"
  children {
    EngentusFeatureGoodmanAnalysisDot
    EngentusFeatureGoodmanAnalysisText
  }
}

view EngentusFeatureMonteCarloDot {
  kind bullet-dot
  class auth-bullet-dot
}

view EngentusFeatureMonteCarloText {
  kind text
  prop text = "Monte Carlo life prediction"
}

view EngentusFeatureMonteCarlo {
  kind feature-item
  class auth-bullet
  prop tag = "li"
  children {
    EngentusFeatureMonteCarloDot
    EngentusFeatureMonteCarloText
  }
}

view EngentusFeatureFleetManagementDot {
  kind bullet-dot
  class auth-bullet-dot
}

view EngentusFeatureFleetManagementText {
  kind text
  prop text = "Multi-site fleet management"
}

view EngentusFeatureFleetManagement {
  kind feature-item
  class auth-bullet
  prop tag = "li"
  children {
    EngentusFeatureFleetManagementDot
    EngentusFeatureFleetManagementText
  }
}

view EngentusValueFeatures {
  kind feature-list
  class auth-bullets
  prop tag = "ul"
  children {
    EngentusFeatureRealtimeLoad
    EngentusFeatureGoodmanAnalysis
    EngentusFeatureMonteCarlo
    EngentusFeatureFleetManagement
  }
}

view EngentusValueHero {
  kind hero
  class auth-hero
  children {
    EngentusHeroLogo
    EngentusHeroTagline
    EngentusHeroSubtitle
    EngentusValueFeatures
  }
}


view NewsFeedHeader {
  kind section-header
  class news-hdr
  children {
    NewsFeedHeaderLabel
    NewsFeedLiveStatus
  }
}

view NewsFeedHeaderLabel {
  kind text
  prop text = "Feed"
}

view NewsFeedLiveStatus {
  kind group
  class news-live
  children {
    NewsFeedLiveDot
    NewsFeedLiveLabel
  }
}

view NewsFeedLiveDot {
  kind decoration
  class news-live-dot
}

view NewsFeedLiveLabel {
  kind text
  prop text = "Live"
}

view NewsFeedAlertReading {
  kind item
  class news-item ni-alert
  children {
    NewsFeedAlertReadingCategory
    NewsFeedAlertReadingTitle
    NewsFeedAlertReadingTime
  }
}

view NewsFeedAlertReadingCategory {
  kind text
  class ni-cat
  prop text = "Alert"
}

view NewsFeedAlertReadingTitle {
  kind text
  class ni-title
  prop text = "Sensor B7 on M48 reporting anomalous load readings — review recommended before next measurement window"
}

view NewsFeedAlertReadingTime {
  kind text
  class ni-time
  prop text = "2h ago"
}

view NewsFeedMaintenanceWindow {
  kind item
  class news-item ni-platform
  children {
    NewsFeedMaintenanceWindowCategory
    NewsFeedMaintenanceWindowTitle
    NewsFeedMaintenanceWindowTime
  }
}

view NewsFeedMaintenanceWindowCategory {
  kind text
  class ni-cat
  prop text = "Platform"
}

view NewsFeedMaintenanceWindowTitle {
  kind text
  class ni-title
  prop text = "Scheduled maintenance window: API gateway Sunday 02:00–04:00 AWST"
}

view NewsFeedMaintenanceWindowTime {
  kind text
  class ni-time
  prop text = "6h ago"
}

view NewsFeedGoodmanRelease {
  kind item
  class news-item ni-product
  children {
    NewsFeedGoodmanReleaseCategory
    NewsFeedGoodmanReleaseTitle
    NewsFeedGoodmanReleaseTime
  }
}

view NewsFeedGoodmanReleaseCategory {
  kind text
  class ni-cat
  prop text = "Product"
}

view NewsFeedGoodmanReleaseTitle {
  kind text
  class ni-title
  prop text = "Mill-iQ™ Fatigue Module v2.1.0 — Goodman diagram now supports multi-scenario ANOVA export"
}

view NewsFeedGoodmanReleaseTime {
  kind text
  class ni-time
  prop text = "1d ago"
}

view NewsFeedRecalibration {
  kind item
  class news-item ni-product
  children {
    NewsFeedRecalibrationCategory
    NewsFeedRecalibrationTitle
    NewsFeedRecalibrationTime
  }
}

view NewsFeedRecalibrationCategory {
  kind text
  class ni-cat
  prop text = "Product"
}

view NewsFeedRecalibrationTitle {
  kind text
  class ni-title
  prop text = "M48 maintenance window complete — 3 bolt sets recalibrated and re-zeroed"
}

view NewsFeedRecalibrationTime {
  kind text
  class ni-time
  prop text = "2d ago"
}

view NewsFeedStandardsUpdate {
  kind item
  class news-item ni-industry
  children {
    NewsFeedStandardsUpdateCategory
    NewsFeedStandardsUpdateTitle
    NewsFeedStandardsUpdateTime
  }
}

view NewsFeedStandardsUpdateCategory {
  kind text
  class ni-cat
  prop text = "Industry"
}

view NewsFeedStandardsUpdateTitle {
  kind text
  class ni-title
  prop text = "AS 4024 annex revision published — updated fatigue factors for mining fasteners now available"
}

view NewsFeedStandardsUpdateTime {
  kind text
  class ni-time
  prop text = "3d ago"
}

view NewsFeedFirmwareUpdate {
  kind item
  class news-item ni-platform
  children {
    NewsFeedFirmwareUpdateCategory
    NewsFeedFirmwareUpdateTitle
    NewsFeedFirmwareUpdateTime
  }
}

view NewsFeedFirmwareUpdateCategory {
  kind text
  class ni-cat
  prop text = "Platform"
}

view NewsFeedFirmwareUpdateTitle {
  kind text
  class ni-title
  prop text = "New firmware v2.3.1 available for LinerSense o310 sensors"
}

view NewsFeedFirmwareUpdateTime {
  kind text
  class ni-time
  prop text = "4d ago"
}

view NewsFeedMonitoringGuidance {
  kind item
  class news-item ni-industry
  children {
    NewsFeedMonitoringGuidanceCategory
    NewsFeedMonitoringGuidanceTitle
    NewsFeedMonitoringGuidanceTime
  }
}

view NewsFeedMonitoringGuidanceCategory {
  kind text
  class ni-cat
  prop text = "Industry"
}

view NewsFeedMonitoringGuidanceTitle {
  kind text
  class ni-title
  prop text = "MCA publishes updated guidelines on real-time structural monitoring for SAG mills"
}

view NewsFeedMonitoringGuidanceTime {
  kind text
  class ni-time
  prop text = "1w ago"
}

view NewsFeedList {
  kind list
  class news-list
  children {
    NewsFeedAlertReading
    NewsFeedMaintenanceWindow
    NewsFeedGoodmanRelease
    NewsFeedRecalibration
    NewsFeedStandardsUpdate
    NewsFeedFirmwareUpdate
    NewsFeedMonitoringGuidance
  }
}

view NewsPanel {
  kind sidebar
  prop domId = "news-panel"
  children {
    NewsFeedHeader
    NewsFeedList
  }
}

view ModuleIconCharge {
  kind host
  class mod-icon
  prop rawHtml = "<svg viewBox='0 0 66 50' fill='none' xmlns='http://www.w3.org/2000/svg' style='width:100%;height:100%'><rect width='66' height='50' fill='#0d1a2e' rx='4'/><circle cx='33' cy='25' r='20' stroke='#475569' stroke-width='1.5' fill='none'/><path d='M 33 25 L 53 25 A 20 20 0 1 1 22 9 Z' fill='rgba(124,94,26,0.75)'/><line x1='22' y1='9' x2='53' y2='25' stroke='#c9913a' stroke-width='1.5'/><circle cx='22' cy='9' r='3' fill='#fbbf24'/><circle cx='53' cy='25' r='3' fill='#f87171'/><circle cx='33' cy='25' r='2' fill='#475569'/></svg>"
}

