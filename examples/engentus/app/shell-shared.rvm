  kind host
  class mod-icon
  prop rawHtml = "<svg viewBox='0 0 66 50' fill='none' xmlns='http://www.w3.org/2000/svg' style='width:100%;height:100%'><rect width='66' height='50' fill='rgba(0,0,0,.25)' rx='4'/><rect x='8' y='27' width='9' height='16' fill='rgba(255,255,255,.18)' rx='1'/><rect x='20' y='19' width='9' height='24' fill='rgba(255,255,255,.18)' rx='1'/><rect x='32' y='13' width='9' height='30' fill='rgba(255,255,255,.18)' rx='1'/><rect x='44' y='21' width='9' height='22' fill='rgba(255,255,255,.18)' rx='1'/><line x1='4' y1='43' x2='62' y2='43' stroke='rgba(255,255,255,.1)' stroke-width='1'/><line x1='4' y1='43' x2='4' y2='7' stroke='rgba(255,255,255,.1)' stroke-width='1'/></svg>"
