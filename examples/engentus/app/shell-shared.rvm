  kind host
  class mod-icon
  prop rawHtml = "<svg viewBox='0 0 66 50' fill='none' xmlns='http://www.w3.org/2000/svg' style='width:100%;height:100%'><rect width='66' height='50' fill='rgba(0,0,0,.25)' rx='4'/><circle cx='14' cy='35' r='2.2' fill='rgba(255,255,255,.22)'/><circle cx='23' cy='27' r='2.2' fill='rgba(255,255,255,.22)'/><circle cx='33' cy='18' r='2.2' fill='rgba(255,255,255,.22)'/><circle cx='19' cy='39' r='2.2' fill='rgba(255,255,255,.22)'/><circle cx='43' cy='30' r='2.2' fill='rgba(255,255,255,.22)'/><circle cx='53' cy='22' r='2.2' fill='rgba(255,255,255,.22)'/><circle cx='47' cy='13' r='2.2' fill='rgba(255,255,255,.22)'/><circle cx='29' cy='38' r='2.2' fill='rgba(255,255,255,.22)'/><line x1='4' y1='43' x2='62' y2='43' stroke='rgba(255,255,255,.1)' stroke-width='1'/><line x1='4' y1='43' x2='4' y2='7' stroke='rgba(255,255,255,.1)' stroke-width='1'/></svg>"
