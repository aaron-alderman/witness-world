method = "GET"
path = "/engentus/__generated/wcss/schema"
serves = "engentusWcssSchema"
handler = "wcss.schema.read"
params = { adapterModule = "./app/engentus-wcss-adapter.js", adapterExport = "loadEngentusWcssAuthoringAdapter" }

[[serve]]
