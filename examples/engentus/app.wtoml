serverRunner = "engentus_server"
route = "engentus_wcss_schema_route"

[[route]]
actor = "aaron"
id = "engentus_wcss_preview_session_create_route"
method = "POST"
path = "/engentus/__generated/wcss/preview-session"
serves = "engentusWcssPreviewSessionCreate"
handler = "wcss.preview.session.create"
params = { adapterModule = "./app/engentus-wcss-adapter.js", adapterExport = "loadEngentusWcssAuthoringAdapter" }

[[serve]]
actor = "aaron"
serverRunner = "engentus_server"
route = "engentus_wcss_preview_session_create_route"

[[route]]
actor = "aaron"
id = "engentus_wcss_preview_tokens_patch_route"
method = "PATCH"
path = "/engentus/__generated/wcss/preview-session"
serves = "engentusWcssPreviewTokensPatch"
handler = "wcss.preview.document.patch"
params = { adapterModule = "./app/engentus-wcss-adapter.js", adapterExport = "loadEngentusWcssAuthoringAdapter" }

[[serve]]
actor = "aaron"
serverRunner = "engentus_server"
route = "engentus_wcss_preview_tokens_patch_route"

[[route]]
actor = "aaron"
id = "engentus_wcss_preview_session_clear_route"
method = "DELETE"
path = "/engentus/__generated/wcss/preview-session"
serves = "engentusWcssPreviewSessionClear"
handler = "wcss.preview.session.clear"
params = { adapterModule = "./app/engentus-wcss-adapter.js", adapterExport = "loadEngentusWcssAuthoringAdapter" }

[[serve]]
actor = "aaron"
serverRunner = "engentus_server"
route = "engentus_wcss_preview_session_clear_route"

[[route]]
actor = "aaron"
id = "engentus_alias_route"
method = "GET"
path = "/engentus"
serves = "engentusShell"
handler = "page.surface"
params = { rootSurface = "EngentusRoot", defaultScreen = "login", routeState = { process = "EngentusShellNavigation", state = "EngentusShellActiveRoute" } }

[[serve]]
actor = "aaron"
serverRunner = "engentus_server"
