[app]
id = "engentus_frontend_app"
imports = ["../_lib/common.wtoml", "./app/models/burst-fit.rvm", "./app/models/clip.rvm", "./app/models/goodman.rvm", "./app/models/goodman-bolt-sets.rvm", "./app/models/health.rvm", "./app/models/kalman.rvm", "./app/models/mill-charge.rvm", "./app/models/mill-force.rvm", "./app/views/goodman.rvm", "./app/views/mill-charge.rvm", "./app/views/mill-force.rvm", "./app/pipelines/ingest-sensor-sync.rvm", "./app/shell-shared.rvm", "./app/shell-auth.rvm", "./app/shell-goodman.rvm", "./app/shell-mill-charge.rvm", "./app/shell-mill-force.rvm", "./app/shell-platform-config.rvm", "./app/shell.rvm"]
spawn = ["backend", "frontend"]

[[serverRunner]]
actor = "aaron"
id = "engentus_server"
backendHost = "backendHost"
frontendHost = "frontendHost"
default = true
allowActorHeader = false
runtimeConfig = { "mcp.engentus_mcp.token" = { value = "engentus-dev-token" } }

[[materializedView]]
actor = "aaron"
id = "platform.view.overview.summary"
title = "Platform overview summary"
kind = "platformSlice"
sliceKey = "overview"
modelView = "summary"
maintenance = "on-demand"
storageClass = "memory"
resourceBudgetClass = "interactive"
blocking = true
ttlMs = 1500
sourceProjectors = ["serverRunners", "runtimePluginInstalls", "branches", "changeSets", "telemetrySamples", "telemetryWindows", "performanceRegressions"]
sourceWitnessProcesses = ["defineServerRunner", "installRuntimePlugin", "platform.changeSet.validate", "platform.test.run.finish"]

[[materializedView]]
actor = "aaron"
id = "platform.view.telemetry"
title = "Platform telemetry view"
kind = "platformSlice"
sliceKey = "telemetry"
modelView = "telemetry"
maintenance = "on-demand"
storageClass = "memory"
resourceBudgetClass = "interactive"
blocking = true
ttlMs = 2000
sourceProjectors = ["telemetrySamples", "telemetryWindows", "performanceRegressions", "materializedViewStates", "resourceProbeOperations"]
sourceWitnessProcesses = ["platform.changeSet.validate", "platform.test.run.finish"]

[[runtimePluginInstall]]
actor = "aaron"
serverRunner = "engentus_server"
plugin = "plugin.chart-runtime"

[[runtimePluginInstall]]
actor = "aaron"
serverRunner = "engentus_server"
plugin = "plugin.wcss-runtime"

[[runtimePluginInstall]]
actor = "aaron"
serverRunner = "engentus_server"
plugin = "plugin.wcss-authoring"

[[runtimePluginInstall]]
actor = "aaron"
serverRunner = "engentus_server"
plugin = "plugin.secret"

[[runtimePluginInstall]]
actor = "aaron"
serverRunner = "engentus_server"
plugin = "plugin.sql"

[[runtimePluginInstall]]
actor = "aaron"
serverRunner = "engentus_server"
plugin = "plugin.pipeline-runtime"

[[runtimePluginInstall]]
actor = "aaron"
serverRunner = "engentus_server"
plugin = "plugin.mcp"

[[runtimePluginInstall]]
actor = "aaron"
serverRunner = "engentus_server"
plugin = "plugin.mcp-authoring"

[[runtimePluginInstall]]
actor = "aaron"
serverRunner = "engentus_server"
plugin = "plugin.engentus-dev-diagnostics"

[[runtimePreload]]
actor = "aaron"
id = "engentus_chart_runtime_boot"
when = { kind = "boot" }
targets = [{ kind = "capability", capability = "chart.render", load = ["assets"] }]

[[runtimePreload]]
actor = "aaron"
id = "engentus_goodman_idle_after_home"
when = { kind = "idleAfterRoute", route = "home", delayMs = 1000 }
targets = [{ kind = "route", route = "goodman", load = ["manifest", "capabilityAssets"] }]

[[mcpServer]]
actor = "aaron"
id = "engentus_mcp"
label = "Engentus MCP"
serverRunner = "engentus_server"
serviceIdentity = "aaron"
transports = ["stdio", "http"]

[[mcpToolInstall]]
actor = "aaron"
server = "engentus_mcp"
tool = "world.read"
actingMode = "service"

[[mcpToolInstall]]
actor = "aaron"
server = "engentus_mcp"
tool = "authoring.write"
actingMode = "service"

[[authRole]]
actor = "aaron"
id = "engentus_user"
label = "Engentus User"
description = "Base signed-in access for Engentus."

[[authRole]]
actor = "aaron"
id = "platform_admin"
label = "Platform Admin"
description = "Can access Platform Config and manage access policy."

[[authRole]]
actor = "aaron"
id = "mill_force_access"
label = "Mill Force Access"
description = "Can access the Mill Force Analysis module."

[[identityRoleGrant]]
actor = "aaron"
identityId = "identity.aaron"
roleId = "engentus_user"

[[identityRoleGrant]]
actor = "aaron"
identityId = "identity.aaron"
roleId = "platform_admin"

[[identityRoleGrant]]
actor = "aaron"
identityId = "identity.aaron"
roleId = "mill_force_access"

[[identityRoleGrant]]
actor = "aaron"
identityId = "identity.callan"
roleId = "engentus_user"

[[appFeatureAccessPolicy]]
actor = "aaron"
featureId = "engentus.home"
label = "Home"
appId = "engentus_frontend_app"
requireAuth = true
visibilityMode = "normal"
allowedRoles = ["engentus_user"]
guestBehavior = "login"
deniedBehavior = "403"

[[appFeatureAccessPolicy]]
actor = "aaron"
featureId = "engentus.goodman"
label = "Goodman Fatigue Diagram"
appId = "engentus_frontend_app"
requireAuth = true
visibilityMode = "normal"
allowedRoles = ["engentus_user"]
guestBehavior = "login"
deniedBehavior = "403"

[[appFeatureAccessPolicy]]
actor = "aaron"
featureId = "engentus.mill_charge"
label = "Mill Charge Motion"
appId = "engentus_frontend_app"
requireAuth = true
visibilityMode = "normal"
allowedRoles = ["engentus_user"]
guestBehavior = "login"
deniedBehavior = "403"

[[appFeatureAccessPolicy]]
actor = "aaron"
featureId = "engentus.mill_force"
label = "Mill Force Analysis"
appId = "engentus_frontend_app"
requireAuth = true
visibilityMode = "locked"
allowedRoles = ["mill_force_access"]
guestBehavior = "login"
deniedBehavior = "403"

[[appFeatureAccessPolicy]]
actor = "aaron"
featureId = "engentus.platform_config"
label = "Platform Config"
appId = "engentus_frontend_app"
requireAuth = true
visibilityMode = "hidden"
allowedRoles = ["platform_admin"]
guestBehavior = "login"
deniedBehavior = "404"

[[route]]
actor = "aaron"
id = "engentus_root_route"
method = "GET"
path = "/"
serves = "engentusShell"
handler = "page.surface"
params = { rootSurface = "EngentusRoot", defaultScreen = "login", routeState = { process = "EngentusShellNavigation", state = "EngentusShellActiveRoute" } }

[[serve]]
actor = "aaron"
serverRunner = "engentus_server"
route = "engentus_root_route"

[[route]]
actor = "aaron"
id = "engentus_shell_stylesheet_route"
method = "GET"
path = "/engentus/__generated/engentus-shell.css"
serves = "engentusShellStylesheet"
handler = "wcss.stylesheet.read"
params = { asset = "shell", adapterModule = "./app/engentus-wcss-adapter.js", adapterExport = "loadEngentusWcssAuthoringAdapter" }

[[serve]]
actor = "aaron"
serverRunner = "engentus_server"
route = "engentus_shell_stylesheet_route"

[[route]]
actor = "aaron"
id = "engentus_chart_stylesheet_route"
method = "GET"
path = "/engentus/__generated/engentus-chart-pages.css"
serves = "engentusChartStylesheet"
handler = "wcss.stylesheet.read"
params = { asset = "chart", adapterModule = "./app/engentus-wcss-adapter.js", adapterExport = "loadEngentusWcssAuthoringAdapter" }

[[serve]]
actor = "aaron"
serverRunner = "engentus_server"
route = "engentus_chart_stylesheet_route"

[[route]]
actor = "aaron"
id = "engentus_wcss_document_route"
method = "GET"
path = "/engentus/__generated/wcss/document"
serves = "engentusWcssDocument"
handler = "wcss.document.read"
params = { adapterModule = "./app/engentus-wcss-adapter.js", adapterExport = "loadEngentusWcssAuthoringAdapter" }

[[serve]]
actor = "aaron"
serverRunner = "engentus_server"
