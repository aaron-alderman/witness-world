# this.folder.wtoml
#
# Auto-generated structural baseline (initial).
# 
# - Contains the folder entity and direct "contains" relations.
# - This is the starting point for folder metadata.
# - Hand-edit to add richer knowledge (facets, custom relations to intents/docs/code, etc.).
# - Future runs of the generator (or smarter variants) can refresh the structural "contains" section
#   while preserving other human/automation-added content.
# - Staleness is tolerated: if children change, re-generate or use reapers to manage debt.
# - Aligns with project: append-only friendly, visible drift, multi-source (auto + hand + server).
#
# Ids follow platform conventions (see platform-model.js and knowledge-relations.wtoml).
#

[folder]
id = "folder:plugins/search"
path = "plugins/search"
label = "search"
summary = "Auto-generated folder metadata for plugins/search."
facet = ["system"]
lifecycle = ["author", "steward"]
owner = "plugin.platform"

# --- Structural containment (auto-generated baseline) ---
# Direct children at generation time.
# Re-run generator to update this section (preserves hand-maintained content).

[[relation]]
from = "folder:plugins/search"
rel = "contains"
to = "file:plugins/search/db-search-services.js"

[[relation]]
from = "folder:plugins/search"
rel = "contains"
to = "file:plugins/search/handler-catalog.js"

[[relation]]
from = "folder:plugins/search"
rel = "contains"
to = "file:plugins/search/handlers.js"

[[relation]]
from = "folder:plugins/search"
rel = "contains"
to = "json:plugins/search/plugin.json"

[[relation]]
from = "folder:plugins/search"
rel = "contains"
to = "file:plugins/search/projections.js"

[[relation]]
from = "folder:plugins/search"
rel = "contains"
to = "file:plugins/search/provider-runtime.js"

[[relation]]
from = "folder:plugins/search"
rel = "contains"
to = "file:plugins/search/runtime.js"

[[relation]]
from = "folder:plugins/search"
rel = "contains"
to = "file:plugins/search/search.test.js"

[[relation]]
from = "folder:plugins/search"
rel = "contains"
to = "wtoml:plugins/search/this.folder.wtoml"

