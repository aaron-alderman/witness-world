view PlatformSecurityPage {
  kind page
  class platform-model
  prop pageId = "security"
  prop modelView = "security"
  prop summaryCards = "Policies=authorityPolicies@count|Decisions=authorityDecisions@count|Denials=authorityDecisions@countWhere:decision=deny"
  prop title = "Security"
  prop summary = "Authority policies, allow and deny decisions, and linked governance context."
  children {
    PlatformSecurityList
    PlatformSecurityDetail
  }
