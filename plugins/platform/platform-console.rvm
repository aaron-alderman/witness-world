import desire/v3-alpha

module plugin.platform.console {
  in plugin.platform
}

enum PlatformLifecycle {
  cases {
    author
    transform
    execute
    observe
    verify
    ship
    steward
  }
}

collection PlatformNodes
collection PlatformEdges
collection PlatformGaps
collection PlatformProfiles
collection PlatformProposals
collection PlatformProposalActions

query PlatformModelRead {
  kind http
  route /api/platform-model
  response_schema PlatformModel
}

query PlatformGapsRead {
  kind http
  route /api/platform-gaps
  response_schema PlatformGaps
}

command PlatformProposalCreate {
  kind http
  route /api/platform-proposals
  request_schema PlatformProposalDraft
  response_schema PlatformProposalResult
}

command PlatformProposalApprove {
  kind http
  route /api/platform-proposals/:id/approve
  request_schema PlatformProposalReview
  response_schema PlatformProposalResult
}

command PlatformProposalReject {
  kind http
  route /api/platform-proposals/:id/reject
  request_schema PlatformProposalReview
  response_schema PlatformProposalResult
}

view PlatformConsolePage {
  identity surface:platform
  kind page
  class platform-console
  prop title = "Platform Console"
  prop summary = "RVM-authored platform pages for overview, workflow, verification, knowledge, signals, and model inspection."
  capabilities {
    platform.self
  }
  children {
    PlatformOverviewPage
    PlatformWorkflowPage
    PlatformVerificationPage
    PlatformKnowledgePage
    PlatformSignalsPage
    PlatformModelPage
  }
}

view PlatformOverviewPage {
  kind page
  class platform-overview
  prop pageId = "overview"
  prop modelView = "overview"
  prop summaryCards = "Plugins=nodes@countKind:plugin|Bundles=nodes@countKind:bundle|Handlers=nodes@countKind:handler|Routes=nodes@countKind:route|Docs=docs@count|Change Sets=changeSets@count|Test Gates=testGates@count|Gaps=gaps@count"
  prop title = "Overview"
  prop summary = "Counts, authored surface ownership, lifecycle, and quick platform links."
  children {
    PlatformConsoleSummary
    PlatformAuthoredSurfaceTree
    PlatformLifecycleBoard
    PlatformMap
    PlatformProfileComparison
  }
}

view PlatformWorkflowPage {
  kind page
  class platform-workflow
  prop pageId = "workflow"
  prop modelView = "workflow"
  prop summaryCards = "Branches=branches@count|Change Sets=changeSets@count|Open Proposals=proposals@countWhere:status=open|Candidate Snapshots=candidateSnapshots@count"
  prop title = "Workflow"
  prop summary = "Branches, change sets, proposals, and authoring commands."
  children {
    PlatformBranchBoard
    PlatformWorkflowList
    PlatformWorkflowDetail
    PlatformProposalPanel
    PlatformProposalReviewList
    PlatformBranchCreatePanel
    PlatformChangeSetCreatePanel
    PlatformChangeSetEditPanel
    PlatformChangeSetValidatePanel
    PlatformChangeSetApplyPanel
    PlatformChangeSetLifecyclePanel
  }
}

view PlatformVerificationPage {
  kind page
  class platform-verification
  prop pageId = "verification"
  prop modelView = "verification"
  prop summaryCards = "Test Gates=testGates@count|Test Runs=testRuns@count|Runtime Revisions=runtimeRevisions@count|Snapshot Builds=snapshotBuilds@count"
  prop title = "Verification"
  prop summary = "Live test runs, RVM-authored reports, candidate snapshots, failures, regressions, and runtime revisions."
  children {
    PlatformVerificationList
    PlatformVerificationDetail
    PlatformVerificationStreams
    PlatformBranchRedGreenList
    PlatformChangeSetRedGreenList
    PlatformTestRunPanel
    PlatformSelectedTestRunPanel
  }
}

view PlatformKnowledgePage {
  kind page
  class platform-knowledge
  prop pageId = "knowledge"
  prop modelView = "knowledge"
  prop summaryCards = "Governed Docs=docs@count|Roadmap Tasks=roadmapTasks@count|Epics=epics@count|Features=features@count"
  prop title = "Knowledge"
  prop summary = "Governed docs, roadmap tasks, epics, features, and intent-linked knowledge."
  children {
    PlatformKnowledgeList
    PlatformKnowledgeDetail
  }
}

view PlatformSignalsPage {
  kind page
  class platform-signals
  prop pageId = "signals"
  prop modelView = "signals"
  prop summaryCards = "Gaps=gaps@count|Telemetry Metrics=nodes@countKind:telemetryMetric|Defect Clusters=nodes@countKind:defectCluster|Boundaries=nodes@countKind:boundary"
  prop title = "Signals"
  prop summary = "Gaps, telemetry, defect clusters, and boundary actors."
  children {
    PlatformGapList
    PlatformSignalList
    PlatformSignalDetail
  }
}

view PlatformModelPage {
  kind page
  class platform-model
  prop pageId = "model"
  prop modelView = "model"
  prop summaryCards = "Platform Objects=nodes@count|Relationships=edges@count|Profiles=profiles@count|Coverage Edges=coverageEdges@count"
  prop title = "Model"
  prop summary = "Platform objects, relationships, runtime profiles, and dependency evidence."
  children {
    PlatformProfileComparison
    PlatformModelList
    PlatformModelDetail
    PlatformCoverageMatrix
  }
}

view PlatformConsoleSummary {
  kind region
  class platform-summary
  prop title = "Platform Summary"
  prop summaryPageId = "overview"
  prop summary = "Snapshot counts for the current platform model."
  projections {
    PlatformModelRead
  }
}

view PlatformAuthoredSurfaceTree {
  kind region
  class platform-surface-tree
  prop title = "Authored Surface Tree"
  prop summary = "Inspectable page and section ownership compiled from the authored console RVM."
  prop surfaceFields = "View=pageId||name|Kind=surfaceKind|Class=className|Process=processRoute|Projection=projectionRoutesText|Summary=summary|Sections=sectionTitles"
}

view PlatformLifecycleBoard {
  kind region
  class platform-board
  prop title = "Lifecycle Board"
  prop summary = "Lifecycle-oriented chips sourced from the platform model."
  prop boardSource = "lifecycleBoard"
  prop laneTitlePath = "title"
  prop laneMetaFields = "Count=countLabel"
  prop laneItemsPath = "nodes"
  prop itemTitlePath = "titleLink"
  prop itemTitleMode = "concept"
  prop itemFields = "Kind=kind"
  prop itemLimit = "14"
  prop itemEmptyState = "No platform objects in this lifecycle lane."
  projections {
    PlatformModelRead
  }
}

view PlatformBranchBoard {
  kind region
  class platform-board
  prop title = "Branch Board"
  prop summary = "Lifecycle lanes for branch-backed work."
  prop boardSource = "branchBoard"
  prop laneTitlePath = "title"
  prop laneMetaFields = "Count=countLabel"
  prop laneItemsPath = "branches"
  prop itemTitlePath = "titleLink"
  prop itemTitleMode = "concept"
  prop itemFields = "Status=status|Activity=activitySummary|Latest Candidate Snapshot=latestCandidateSnapshotId@concept"
  prop itemLimit = "14"
  prop itemEmptyState = "No branches in this lifecycle lane."
  projections {
    PlatformModelRead
  }
}

view PlatformMap {
  kind table
  class platform-map
  prop title = "Platform Map"
  prop summary = "Primary platform objects projected from the live model."
  prop tableSource = "platformMapRows"
  prop columns = "Kind|Resource|Lifecycle|Status|Source"
  prop rowFields = "Kind=kind|Resource=id@concept|Lifecycle=lifecycleText|Status=status|Source=source"
  prop emptyState = "No platform objects."
  prop rowLimit = "12"
  projections {
    PlatformModelRead
  }
}

view PlatformWorkflowList {
  kind table
  class platform-workflow-list
  prop title = "Workflow Items"
  prop summary = "Paginated list of branches, change sets, and proposals."
  prop listSource = "workflowItems"
  prop columns = "Kind|Status|Resource|Scope|Summary"
  prop rowFields = "Kind=pageKind|Status=status|Resource=id@concept|Scope=scope@value|Summary=summary"
  prop sortOptions = "kind=pageKind|status=status|resource=title|scope=scope|summary=summary"
  prop defaultSort = "kind:asc"
  prop emptyState = "No workflow rows."
  prop pageSize = "20"
  projections {
    PlatformModelRead
  }
}

view PlatformWorkflowDetail {
  kind region
  class platform-workflow-detail
  prop title = "Workflow Detail"
  prop summary = "Properties and linked resources for the selected workflow item."
  prop detailSource = "workflow"
  prop detailSelectionSources = "branches|changeSets|proposals"
  prop branchIdPrefixes = "branch:"
  prop changeSetIdPrefixes = "changeSet:|changeset."
  prop proposalIdPrefixes = "proposal:"
  prop emptyTitle = "Detail"
  prop emptyState = "No workflow rows are projected yet."
  children {
    PlatformWorkflowPrimaryPanel
    PlatformWorkflowRelatedPanel
    PlatformWorkflowSnapshotHistory
    PlatformWorkflowEditHistory
  }
  projections {
    PlatformModelRead
  }
}

view PlatformWorkflowPrimaryPanel {
  kind region
  class platform-workflow-primary
  prop title = "Primary Detail"
  prop summary = "Selected workflow object properties and long-tail fields."
  prop longTailCardTitle = "Properties"
  prop longTailValueKinds = "string|number|boolean|scalarList"
  prop branchLongTailExcludedFields = "changeSetIds|affectedSystemSummaries|telemetryImpactSummaries"
  prop branchCardTitle = "Branch Detail"
  prop branchFields = "Branch=id@concept|Status=status|Title=title|Lane=lifecycleLane|Owner=owner|Parent=parentBranchId@concept|Epic=epic@concept|Feature=feature@concept|Defect=defect@concept|Runtime profile=runtimeProfile|Docs freshness=docsFreshness.status|Red / green=testRedGreen.status|Latest candidate=latestCandidateSnapshotId@concept|API resource=id@api"
  prop changeSetLongTailExcludedFields = "changedPaths"
  prop changeSetCardTitle = "Change Set Detail"
  prop changeSetFields = "Change set=id@concept|Status=status|Title=title|Branch=branchId@concept|Owner=owner|Reason=reason|Edits=editCount|Red / green=testRedGreen.status|Latest candidate=latestCandidateSnapshotId@concept|API resource=id@api"
  prop proposalCardTitle = "Proposal Detail"
  prop proposalFields = "Proposal=id@concept|Status=status|Target process=targetProcess|Target=targetId@concept|Reason=reason|API resource=id@api"
}

view PlatformWorkflowRelatedPanel {
  kind region
  class platform-workflow-related
  prop title = "Related Resources"
  prop summary = "Linked resources and supporting context for the selected workflow object."
  prop cardItemLimit = "12"
  prop branchLinkCards = "Change Sets=changeSetIds"
  prop branchLinkCardEmptyStates = "Change Sets=No change sets linked to this branch."
  prop branchTextCards = "Affected Systems=affectedSystemSummaries@label|Telemetry Impacts=telemetryImpactSummaries@label"
  prop branchTextCardEmptyStates = "Affected Systems=No affected system summaries.|Telemetry Impacts=No telemetry impact summaries."
  prop changeSetLinkCards = "Changed Paths=changedPaths"
  prop changeSetLinkCardEmptyStates = "Changed Paths=No changed paths staged for this change set."
  prop proposalLinkCards = "Target Resource=targetId"
  prop proposalLinkCardEmptyStates = "Target Resource=No linked target resource."
}

view PlatformWorkflowSnapshotHistory {
  kind table
  class platform-workflow-snapshots
  prop title = "Candidate Snapshots"
  prop summary = "Candidate snapshot history for the selected workflow object when available."
  prop columns = "Status|Snapshot|Revision|Change Set|Errors"
  prop rowFields = "Status=status|Snapshot=id@concept|Revision=revision|Change Set=changeSetId@concept|Errors=errorCount"
  prop emptyState = "No candidate snapshots for this branch."
  prop changeSetEmptyState = "No candidate snapshots for this change set."
  prop rowLimit = "12"
}

view PlatformWorkflowEditHistory {
  kind table
  class platform-workflow-edits
  prop title = "Staged Edits"
  prop summary = "Staged overlay edits for the selected change set when available."
  prop columns = "Path|Language|Previous Hash|Next Hash"
  prop rowFields = "Path=path|Language=sourceLanguage|Previous Hash=previousHashShort|Next Hash=nextHashShort"
  prop emptyState = "No staged edits."
  prop rowLimit = "20"
}

view PlatformBranchCreatePanel {
  kind form
  class platform-branch-create-panel
  prop title = "Create Branch"
  prop summary = "Create a branch from the shared platform mutation lane."
  prop formId = "platform-branch-create-form"
  prop clientAction = "branch.create"
  prop statusId = "branch-create-status"
  prop submitLabel = "Create Branch"
  prop formFields = "Branch id=id@text|Title=title@text|Parent branch=parentBranchId@text|Epic=epic@text|Feature=feature@text|Defect=defect@text"
  prop fieldDefaults = "id=branch:{generatedId}|title=Platform branch"
  prop fieldPlaceholders = "parentBranchId=Optional parent branch id|epic=Optional epic tag|feature=Optional feature tag|defect=Optional defect tag"
}

view PlatformChangeSetCreatePanel {
  kind form
  class platform-change-set-create-panel
  prop title = "Create Change Set"
  prop summary = "Create a staged change set attached to a branch."
  prop formId = "platform-change-set-create-form"
  prop clientAction = "changeSet.create"
  prop statusId = "change-set-create-status"
  prop submitLabel = "Create Change Set"
  prop formFields = "Change set id=id@text|Branch id=branchId@text|Title=title@text|Reason=reason@text"
  prop fieldDefaults = "id=changeSet:{generatedId}|branchId=branch:platform-console|title=Platform console change|reason=Stage platform console edits"
}

view PlatformChangeSetEditPanel {
  kind form
  class platform-change-set-edit-panel
  prop title = "Stage Edit"
  prop summary = "Stage an authored source edit into the selected change set."
  prop formId = "platform-change-set-edit-form"
  prop clientAction = "changeSet.edit"
  prop statusId = "change-set-edit-status"
  prop submitLabel = "Stage Edit"
  prop formFields = "Change set=changeSetId@select:changeSetOptions|Path=path@text|Content=content@textarea"
  prop fieldDefaults = "path=plugins/platform/platform-console.rvm"
  prop fieldRows = "content=8"
}

view PlatformChangeSetValidatePanel {
  kind form
  class platform-change-set-validate-panel
  prop title = "Validate Change Set"
  prop summary = "Validate the selected change set without mutating the active runtime."
  prop formId = "platform-change-set-validate-form"
  prop clientAction = "changeSet.validate"
  prop statusId = "change-set-validate-status"
  prop submitLabel = "Validate Change Set"
  prop formFields = "Change set=changeSetId@select:changeSetOptions"
}

view PlatformChangeSetApplyPanel {
  kind form
  class platform-change-set-apply-panel
  prop title = "Apply Change Set"
  prop summary = "Apply a validated change set through the shared platform handler lane."
  prop formId = "platform-change-set-apply-form"
  prop clientAction = "changeSet.apply"
  prop statusId = "change-set-apply-status"
  prop submitLabel = "Apply Change Set"
  prop formFields = "Change set=changeSetId@select:changeSetOptions"
}

view PlatformChangeSetLifecyclePanel {
  kind form
  class platform-change-set-lifecycle-panel
  prop title = "Change Set Lifecycle"
  prop summary = "Reject or abandon a change set through the shared platform handler lane."
  prop formId = "platform-change-set-lifecycle-form"
  prop clientAction = "changeSet.lifecycle"
  prop statusId = "change-set-lifecycle-status"
  prop submitLabel = "Update Change Set"
  prop formFields = "Change set=changeSetId@select:changeSetOptions|Action=action@select:lifecycleActions|Reason=reason@text"
  prop fieldDefaults = "action=reject"
  prop fieldPlaceholders = "reason=Optional lifecycle reason"
}

view PlatformProposalPanel {
  kind form
  class platform-proposal-panel
  process PlatformProposalCreate
  prop title = "Proposal Panel"
  prop summary = "Create guarded platform proposals through the shared mutation lane."
  prop formId = "platform-proposal-form"
  prop clientAction = "proposal.create"
  prop statusId = "proposal-status"
  prop submitLabel = "Create Proposal"
  prop formFields = "Action=action@select:proposalActionOptions|Proposal id=id@text|Target kind override=targetKind@text|Target id override=targetId@text|Reason=reason@text|Body JSON=bodyJson@textarea"
  prop fieldDefaults = "id=proposal.platform.{generatedId}|reason=Platform stewardship change|bodyJson={}"
  prop fieldPlaceholders = "targetKind=derived from body|targetId=derived from body"
  prop fieldRows = "bodyJson=8"
  projections {
    PlatformModelRead
  }
}

view PlatformProposalReviewList {
  kind form
  class platform-review-panel
  process PlatformProposalApprove
  prop title = "Review Proposals"
  prop summary = "Approve or reject open platform proposals."
  prop formId = "platform-review-form"
  prop clientAction = "proposal.review"
  prop statusId = "review-status"
  prop formFields = "Open proposal=id@select:openProposalOptions|Reject reason=reason@text"
  prop fieldPlaceholders = "reason=Only used when rejecting"
  prop actionButtons = "Approve=approve|Reject=reject"
  prop actionButtonName = "reviewAction"
  projections {
    PlatformModelRead
  }
}

view PlatformVerificationList {
  kind table
  class platform-verification-list
  prop title = "Verification Items"
  prop summary = "Paginated list of gates, runs, candidate snapshots, and runtime revisions."
  prop listSource = "verificationItems"
  prop columns = "Kind|Status|Resource|Scope|Summary"
  prop rowFields = "Kind=pageKind|Status=status|Resource=id@concept|Scope=scope@value|Summary=summary"
  prop sortOptions = "kind=pageKind|status=status|resource=title|scope=scope|summary=summary"
  prop defaultSort = "kind:asc"
  prop emptyState = "No verification rows."
  prop pageSize = "20"
  projections {
    PlatformModelRead
  }
}

view PlatformVerificationDetail {
  kind region
  class platform-verification-detail
  prop title = "Verification Detail"
  prop summary = "Properties and linked resources for the selected verification object."
  prop detailSource = "verification"
  prop detailSelectionSources = "testGates|runtimeRevisions|testRuns|candidateSnapshots"
  prop gateIdPrefixes = "gate:"
  prop runtimeRevisionIdPrefixes = "runtimeRevision:|backendRevision:|frontendRevision:"
  prop candidateSnapshotIdPrefixes = "candidateSnapshot:"
  prop testRunIdPrefixes = "testRun:"
  prop emptyTitle = "Detail"
  prop emptyState = "No verification rows are projected yet."
  children {
    PlatformVerificationPrimaryPanel
    PlatformVerificationRelatedPanel
    PlatformVerificationRunHistory
    PlatformVerificationBuildHistory
    PlatformVerificationBuildErrors
  }
  projections {
    PlatformModelRead
  }
}

view PlatformVerificationPrimaryPanel {
  kind region
  class platform-verification-primary
  prop title = "Primary Detail"
  prop summary = "Selected verification object properties and long-tail fields."
  prop longTailCardTitle = "Properties"
  prop longTailValueKinds = "string|number|boolean|scalarList"
  prop gateLongTailExcludedFields = "protectedObjects|selectedByBranches|selectedByChangeSets"
  prop gateCardTitle = "Test Gate Detail"
  prop gateFields = "Gate=id@concept|Runner=runner|Environment=environment|Timeout=timeoutMs|Cost=costEstimate|Command=command|Latest result=lastResult@statusExit|API resource=id@api"
  prop runtimeRevisionLongTailExcludedFields = "candidateBranchCount"
  prop runtimeRevisionCardTitle = "Runtime Revision Detail"
  prop runtimeRevisionFields = "Revision=id@concept|Status=status|Trigger=trigger|Branch=branchId@concept|Change set=changeSetId@concept|Changed sources=changedSources@count|Build errors=buildErrorCount|API resource=id@api"
  prop candidateSnapshotLongTailExcludedFields = "files|errors"
  prop candidateSnapshotCardTitle = "Candidate Snapshot Detail"
  prop candidateSnapshotFields = "Snapshot=id@concept|Status=status|Branch=branchId@concept|Change set=changeSetId@concept|Revision=revision|API resource=id@api"
  prop testRunCardTitle = "Test Run Detail"
  prop testRunFields = "Run=id@concept|Status=status|Gate=gateId@concept|Branch=branchId@concept|Change set=changeSetId@concept|Candidate snapshot=candidateSnapshotId@concept|Duration=durationMs|Exit=exitCode|API resource=id@api"
}

view PlatformVerificationRelatedPanel {
  kind region
  class platform-verification-related
  prop title = "Related Resources"
  prop summary = "Linked verification resources, streams, and supporting context."
  prop cardItemLimit = "12"
  prop gateLinkCards = "Protected Objects=protectedObjects|Selected Branches=selectedByBranches|Selected Change Sets=selectedByChangeSets"
  prop gateLinkCardEmptyStates = "Protected Objects=No protected objects linked to this gate.|Selected Branches=No branches currently select this gate.|Selected Change Sets=No change sets currently select this gate."
  prop runtimeRevisionLinkCards = "Changed Sources=changedSources"
  prop runtimeRevisionLinkCardEmptyStates = "Changed Sources=No changed sources recorded for this revision."
  prop runtimeRevisionPropertyCardTitle = "Snapshot Diagnostics"
  prop runtimeRevisionPropertyFields = "Active revision=snapshotDiagnostics.appRevision|Last good=snapshotDiagnostics.lastGoodAppRevision|Pending dirty=snapshotDiagnostics.pendingDirtySources@count|Monitor status=testMonitorDiagnostics.status|Queued sources=testMonitorDiagnostics.pendingSourceCount|Queued change sets=testMonitorDiagnostics.pendingChangeSetCount|Backend revision event stream=backendRevisionEventsHref@href"
  prop candidateSnapshotTextCards = "Files=files@path|Errors=errors@errorMessage"
  prop candidateSnapshotTextCardEmptyStates = "Files=No files captured in this candidate snapshot.|Errors=No build or validation errors."
  prop testRunPropertyCardTitle = "Verification Streams"
  prop testRunPropertyFields = "Test run event stream=testRunEventsHref@href|Backend revision event stream=backendRevisionEventsHref@href"
}

view PlatformVerificationRunHistory {
  kind table
  class platform-verification-runs
  prop title = "Recent Test Runs"
  prop summary = "Recent test-run history for the selected verification object when available."
  prop columns = "Status|Run|Branch|Duration|Exit"
  prop rowFields = "Status=status|Run=id@concept|Branch=branchId@concept|Duration=durationMs|Exit=exitCode"
  prop emptyState = "No runs for this gate yet."
  prop rowLimit = "12"
}

view PlatformVerificationBuildHistory {
  kind table
  class platform-verification-builds
  prop title = "Snapshot Builds"
  prop summary = "Snapshot build history for the selected runtime revision when available."
  prop columns = "Status|Build|Candidate Snapshot|Branch|Errors"
  prop rowFields = "Status=status|Build=id@concept|Candidate Snapshot=candidateSnapshotId@concept|Branch=branchId@concept|Errors=errorCount"
  prop emptyState = "No snapshot builds for this revision."
  prop rowLimit = "12"
}

view PlatformVerificationBuildErrors {
  kind table
  class platform-verification-build-errors
  prop title = "Build Errors"
  prop summary = "Build errors for the selected runtime revision when available."
  prop columns = "Build|Path|Kind|Message"
  prop rowFields = "Build=snapshotBuildId@concept|Path=path|Kind=kind|Message=message"
  prop emptyState = "No build errors for this revision."
  prop rowLimit = "12"
}

view PlatformVerificationStreams {
  kind region
  class platform-verification-streams
  prop title = "Verification Streams"
  prop summary = "Links to live test-run and backend-revision event streams."
  prop propertyCardTitle = "Event Streams"
  prop propertyFields = "Test run event stream=testRunEventsHref@href|Backend revision event stream=backendRevisionEventsHref@href"
  prop propertyValues = "testRunEventsHref=/api/platform-test-runs/events|backendRevisionEventsHref=/api/runtime/backend-revisions/events"
}

view PlatformBranchRedGreenList {
  kind table
  class platform-branch-red-green
  prop title = "Branch Red / Green"
  prop summary = "Selected-gate status for branches."
  prop tableSource = "branchRedGreenRows"
  prop columns = "Status|Branch|Selected|Passed|Failed|Summary"
  prop rowFields = "Status=status|Branch=branchId@concept|Selected=totalSelectedGates|Passed=passedCount|Failed=failedCount|Summary=summary"
  prop emptyState = "No branch red/green summaries."
  prop rowLimit = "12"
  projections {
    PlatformModelRead
  }
}

view PlatformChangeSetRedGreenList {
  kind table
  class platform-change-set-red-green
  prop title = "Change Set Red / Green"
  prop summary = "Selected-gate status for change sets."
  prop tableSource = "changeSetRedGreenRows"
  prop columns = "Status|Change Set|Selected|Passed|Failed|Summary"
  prop rowFields = "Status=status|Change Set=changeSetId@concept|Selected=totalSelectedGates|Passed=passedCount|Failed=failedCount|Summary=summary"
  prop emptyState = "No change-set red/green summaries."
  prop rowLimit = "12"
  projections {
    PlatformModelRead
  }
}

view PlatformTestRunPanel {
  kind form
  class platform-test-run-panel
  prop title = "Run Test Gate"
  prop summary = "Run a single modeled verification gate."
  prop formId = "platform-test-run-form"
  prop clientAction = "testRun.single"
  prop statusId = "test-run-status"
  prop submitLabel = "Run Test Gate"
  prop formFields = "Test gate=gateId@select:testGateOptions|Branch id=branchId@text|Change set id=changeSetId@text|Candidate snapshot id=candidateSnapshotId@text"
  prop fieldPlaceholders = "branchId=Optional branch id|changeSetId=Optional change set id|candidateSnapshotId=Optional candidate snapshot id"
}

view PlatformSelectedTestRunPanel {
  kind form
  class platform-selected-test-run-panel
  prop title = "Run Selected Gates"
  prop summary = "Run the selected verification gates for a branch, change set, or candidate snapshot."
  prop formId = "platform-selected-test-run-form"
  prop clientAction = "testRun.selected"
  prop statusId = "selected-test-run-status"
  prop submitLabel = "Run Selected Gates"
  prop formFields = "Branch id=branchId@text|Change set id=changeSetId@text|Candidate snapshot id=candidateSnapshotId@text"
  prop fieldPlaceholders = "branchId=Optional branch id|changeSetId=Optional change set id|candidateSnapshotId=Optional candidate snapshot id"
}

view PlatformGapList {
  kind table
  class platform-gaps
  prop title = "Platform Gaps"
  prop summary = "Projected platform gaps and meta-defects."
  prop tableSource = "gapRows"
  prop columns = "Severity|Kind|Target|Reason"
  prop rowFields = "Severity=severity|Kind=kind|Target=target@concept|Reason=reason"
  prop emptyState = "No gaps."
  prop rowLimit = "12"
  projections {
    PlatformGapsRead
  }
}

view PlatformCoverageMatrix {
  kind table
  class platform-coverage-matrix
  prop title = "Coverage Matrix"
  prop summary = "Gate-to-target coverage rows for the current modeled platform."
  prop tableSource = "coverageRows"
  prop columns = "Gate|Target|Kind"
  prop rowFields = "Gate=gateId@concept|Target=targetId||targetLabel@concept|Kind=coverageKind"
  prop emptyState = "No coverage edges."
  prop rowLimit = "12"
  projections {
    PlatformModelRead
  }
}

view PlatformSignalList {
  kind table
  class platform-signal-list
  prop title = "Signals"
  prop summary = "Paginated list of gaps, telemetry metrics, defect clusters, and boundaries."
  prop listSource = "signalItems"
  prop columns = "Kind|Status|Resource|Scope|Summary"
  prop rowFields = "Kind=pageKind|Status=status|Resource=id@concept|Scope=scope@value|Summary=summary"
