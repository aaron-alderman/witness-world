import desire/v3-alpha

module plugin.platform.console {
  in plugin.platform
}

enum PlatformLifecycle {
  cases {
    author
    transform
    execute
    observe
    verify
    ship
    steward
  }
}

collection PlatformNodes
collection PlatformEdges
collection PlatformGaps
collection PlatformProfiles
collection PlatformProposals
collection PlatformProposalActions

query PlatformModelRead {
  kind http
  route /api/platform-model
  response_schema PlatformModel
}

query PlatformGapsRead {
  kind http
  route /api/platform-gaps
  response_schema PlatformGaps
}

command PlatformProposalCreate {
  kind http
  route /api/platform-proposals
  request_schema PlatformProposalDraft
  response_schema PlatformProposalResult
}

command PlatformProposalApprove {
  kind http
  route /api/platform-proposals/:id/approve
  request_schema PlatformProposalReview
  response_schema PlatformProposalResult
}

command PlatformProposalReject {
  kind http
  route /api/platform-proposals/:id/reject
  request_schema PlatformProposalReview
  response_schema PlatformProposalResult
}

view PlatformConsolePage {
  identity surface:platform
  kind page
  class platform-console
  prop title = "Platform Console"
  prop summary = "RVM-authored platform pages for overview, workflow, verification, telemetry, defects, security, artifacts, sessions, knowledge, signals compatibility, model inspection, and supplemental governance/model seams."
  capabilities {
    platform.self
  }
  children {
    PlatformOverviewPage
    PlatformWorkflowPage
    PlatformWorkflowBranchesPage
    PlatformWorkflowChangeSetsPage
    PlatformWorkflowPushesPage
    PlatformWorkflowShipsPage
    PlatformWorkflowProposalsPage
    PlatformVerificationPage
    PlatformVerificationStatusPage
    PlatformVerificationRunsPage
    PlatformVerificationRuntimePage
    PlatformTelemetryPage
    PlatformDefectsPage
    PlatformSecurityPage
    PlatformArtifactsPage
    PlatformSessionsPage
    PlatformKnowledgePage
    PlatformKnowledgeDocsPage
    PlatformKnowledgeFoldersPage
    PlatformKnowledgeRoadmapPage
    PlatformSignalsPage
    PlatformSignalsGapsPage
    PlatformSignalsCatalogPage
    PlatformModelPage
    PlatformModelObjectsPage
    PlatformModelProfilesPage
    PlatformModelCoveragePage
    PlatformBridgesPage
    PlatformGovernancePage
    PlatformSemanticsPage
    PlatformPackageCoexistencePage
    PlatformPackageConvergencePage
    PlatformPackageApplyPreviewPage
  }
}

view PlatformOverviewPage {
  kind page
  class platform-overview
  prop pageId = "overview"
  prop modelView = "overview"
  prop summaryCards = "Plugins=nodes@countKind:plugin|Bundles=nodes@countKind:bundle|Handlers=nodes@countKind:handler|Routes=nodes@countKind:route|Docs=docs@count|Change Sets=changeSets@count|Test Gates=testGates@count|Gaps=gaps@count"
  prop title = "Overview"
  prop summary = "Counts, authored surface ownership, lifecycle, and quick platform links."
  children {
    PlatformConsoleSummary
    PlatformAuthoredSurfaceTree
    PlatformLifecycleBoard
    PlatformMap
    PlatformProfileComparison
  }
}

view PlatformWorkflowPage {
  kind page
  class platform-workflow
  prop pageId = "workflow"
  prop modelView = "workflowOverview"
  prop summaryCards = "Branches=branches@count|Change Sets=changeSets@count|Open Proposals=proposals@countWhere:status=open|Candidate Snapshots=candidateSnapshots@count"
  prop title = "Workflow"
  prop summary = "Workflow landing page for branch activity and links into narrower authored workflow pages."
  children {
    PlatformBranchBoard
  }
}

view PlatformWorkflowBranchesPage {
  kind page
  class platform-workflow
  prop pageId = "workflowBranches"
  prop modelView = "workflowBranches"
  prop summaryCards = "Branches=branches@count|Draft=branches@countWhere:status=draft|Active=branches@countWhere:status=active|Candidate Snapshots=candidateSnapshots@count"
  prop title = "Workflow Branches"
  prop summary = "Branch lifecycle, linked change sets, and branch authoring."
  children {
    PlatformBranchBoard
    PlatformWorkflowBranchesList
    PlatformWorkflowDetail
    PlatformBranchCreatePanel
  }
}

view PlatformWorkflowChangeSetsPage {
  kind page
  class platform-workflow
  prop pageId = "workflowChangeSets"
  prop modelView = "workflowChangeSets"
  prop summaryCards = "Change Sets=changeSets@count|Draft=changeSets@countWhere:status=draft|Validated=changeSets@countWhere:status=validated|Candidate Snapshots=candidateSnapshots@count"
  prop title = "Workflow Change Sets"
  prop summary = "Staged change sets, overlays, candidate snapshots, and change-set operations."
  children {
    PlatformWorkflowChangeSetsList
    PlatformWorkflowDetail
    PlatformChangeSetCreatePanel
    PlatformChangeSetEditPanel
    PlatformChangeSetValidatePanel
    PlatformChangeSetApplyPanel
    PlatformChangeSetLifecyclePanel
  }
}

view PlatformWorkflowPushesPage {
  kind page
  class platform-workflow
  prop pageId = "workflowPushes"
  prop modelView = "pushes"
  prop summaryCards = "Push Records=pushRecords@count|Pushed=pushRecords@countWhere:status=pushed|Dry Runs=pushRecords@countWhere:status=dryRun|Failed=pushRecords@countWhere:status=failed|Remotes=gitRemotes@count"
  prop title = "Workflow Pushes"
  prop summary = "Platform-managed Git push records, remote metadata, and linked branch push detail."
