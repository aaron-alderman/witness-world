  prop title = "Security Detail"
  prop summary = "Selected policy or authority decision properties and long-tail fields."
  prop detailSource = "security"
  prop detailCardTitle = "Security Detail"
  prop primaryFields = "Object=objectLink@concept|Kind=pageKind|Decision=decision||sensitivity|Authority=requiredAuthority||accessClass|Actor=effectiveActor||authenticatedActor|Target=targetObjectId@concept"
  prop longTailCardTitle = "Properties"
  prop longTailExcludedFields = "title|scope|summary|objectLink|scopeValue"
  prop emptyTitle = "Security Detail"
  prop emptyState = "No security object selected."
}

view PlatformSessionsList {
  kind table
  class platform-model-list
  prop title = "Sessions"
  prop summary = "Paginated list of sessions, executions, session tags, execution artifacts, and linked authority decisions."
  prop listSource = "sessionItems"
  prop columns = "Kind|Status|Resource|Scope|Summary"
  prop rowFields = "Kind=pageKind|Status=status|Resource=id@concept|Scope=scope@value|Summary=summary"
  prop sortOptions = "kind=pageKind|status=status|resource=title|scope=scope|summary=summary"
  prop defaultSort = "kind:asc"
  prop emptyState = "No session rows."
  prop pageSize = "20"
  projections {
    PlatformModelRead
  }
}

view PlatformSessionsDetail {
  kind region
  class platform-model-detail
  prop title = "Session Detail"
  prop summary = "Properties and linked relationships for the selected session concept."
  prop detailSource = "sessions"
  prop detailSelectionSources = "sessions|executions|sessionTags|executionArtifacts|authorityDecisions"
  prop emptyTitle = "Session Detail"
  prop emptyState = "No session detail is available yet."
  children {
    PlatformSessionsPrimaryPanel
    PlatformSessionsRelatedPanel
    PlatformSessionsRelationships
  }
