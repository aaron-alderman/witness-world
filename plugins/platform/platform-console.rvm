}

view PlatformWorkflowShipsPage {
  kind page
  class platform-workflow
  prop pageId = "workflowShips"
  prop modelView = "ships"
  prop summaryCards = "Ship Records=shipRecords@count|Local Ships=shipRecords@countWhere:status=shipped|Recorded=shipRecords@countWhere:status=recorded|Channels=releaseChannels@count|Rollback Proposals=proposals@countWhere:targetProcess=branch.rollback"
