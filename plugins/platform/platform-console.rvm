view PlatformArtifactsPage {
  kind page
  class platform-model
  prop pageId = "artifacts"
  prop modelView = "artifacts"
  prop summaryCards = "Artifacts=artifacts@count|Runs=testRuns@count|Sessions=sessions@count|Branches=branches@count|Snapshots=candidateSnapshots@count"
  prop title = "Artifacts"
  prop summary = "Cross-cutting durable artifacts, producer metadata, and linked execution context."
  children {
    PlatformArtifactsList
    PlatformArtifactsDetail
  }
}

view PlatformSessionsPage {
  kind page
  class platform-model
  prop pageId = "sessions"
  prop modelView = "sessions"
  prop summaryCards = "Sessions=sessions@count|Executions=executions@count|Tags=sessionTags@count|Artifacts=executionArtifacts@count|Decisions=authorityDecisions@count"
  prop title = "Sessions"
  prop summary = "Sessions, executions, work-context tags, and execution artifacts."
  children {
    PlatformSessionsList
    PlatformSessionsDetail
  }
}

view PlatformArtifactsList {
  kind table
  class platform-model-list
  prop title = "Artifacts"
  prop summary = "Paginated list of durable artifacts, producer metadata, and linked execution context."
  prop listSource = "artifactItems"
  prop columns = "Kind|Producer|Artifact|Content Type|Summary"
  prop rowFields = "Kind=scope|Producer=status|Artifact=id@concept|Content Type=contentType|Summary=summary"
  prop sortOptions = "kind=scope|producer=status|artifact=title|contentType=contentType|summary=summary"
  prop defaultSort = "artifact:asc"
  prop emptyState = "No artifacts."
  prop pageSize = "20"
  projections {
    PlatformModelRead
  }
}

view PlatformArtifactsDetail {
  kind region
  class platform-model-detail
  prop title = "Artifact Detail"
  prop summary = "Properties and linked relationships for the selected artifact."
  prop detailSource = "artifacts"
  prop detailSelectionSources = "artifacts"
  prop emptyTitle = "Artifact Detail"
  prop emptyState = "No artifact detail is available yet."
  children {
    PlatformArtifactsPrimaryPanel
    PlatformArtifactsRelatedPanel
    PlatformArtifactsRelationships
  }
  projections {
    PlatformModelRead
  }
}

view PlatformArtifactsPrimaryPanel {
  kind region
  class platform-model-primary
  prop detailPanelRole = "primary"
  prop detailKinds = "artifact"
  prop title = "Primary Detail"
  prop summary = "Selected artifact properties and long-tail fields."
  prop longTailCardTitle = "Properties"
  prop longTailValueKinds = "string|number|boolean|scalarList"
  prop artifactCardTitle = "Artifact Detail"
  prop artifactFields = "Artifact=id@concept|Kind=artifactKind|Producer=producerKind|Producer id=producerId@concept|Content Type=contentType|Bytes=sizeBytes|Preview=preview|Content=contentUrl@href|API resource=id@api"
}

view PlatformArtifactsRelatedPanel {
  kind region
  class platform-model-related
  prop detailPanelRole = "related"
  prop detailKinds = "artifact"
  prop title = "Related Resources"
  prop summary = "Linked sessions, executions, branches, runs, and other platform context."
  prop cardItemLimit = "12"
  prop artifactLinkCards = "Session=sessionId|Execution=executionId|Branch=branchId|Change Set=changeSetId|Candidate Snapshot=candidateSnapshotId|Proposal=proposalId|Test Run=testRunId|Result=resultId|Gate=gateId|Compatibility Artifact=artifactSourceId"
  prop artifactLinkCardEmptyStates = "Session=No linked session.|Execution=No linked execution.|Branch=No linked branch.|Change Set=No linked change set.|Candidate Snapshot=No linked candidate snapshot.|Proposal=No linked proposal.|Test Run=No linked test run.|Result=No linked result.|Gate=No linked gate.|Compatibility Artifact=No compatibility artifact."
  prop artifactTextCards = "File=fileName|Preview=preview|Content Ref=contentRef"
  prop artifactTextCardEmptyStates = "File=No file name.|Preview=No preview.|Content Ref=No durable content reference."
}

view PlatformArtifactsRelationships {
  kind table
  class platform-model-relationships
  prop detailPanelRole = "relationships"
  prop detailKinds = "artifact"
  prop title = "Related Relationships"
  prop summary = "Linked graph relationships for the selected artifact when available."
  prop columns = "From|Relation|To"
  prop rowFields = "From=from@concept|Relation=rel|To=to@concept"
  prop emptyState = "No related relationships."
  prop rowLimit = "20"
}

