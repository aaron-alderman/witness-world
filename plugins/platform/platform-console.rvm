  prop pageId = "telemetry"
  prop modelView = "telemetry"
  prop summaryCards = "Metrics=telemetryMetrics@count|Samples=telemetrySamples@count|Windows=telemetryWindows@count|Regressions=performanceRegressions@count|Probe Ops=resourceProbeOperations@count|Views=materializedViewStates@count"
