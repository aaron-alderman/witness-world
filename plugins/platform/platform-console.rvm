  prop pageId = "workflowProposals"
  prop modelView = "workflowProposals"
  prop summaryCards = "Open Proposals=proposals@countWhere:status=open|Approved=proposals@countWhere:status=approved|Rejected=proposals@countWhere:status=rejected"
