  kind page
  class platform-verification
  prop pageId = "verificationRuntime"
  prop modelView = "verificationRuntime"
  prop summaryCards = "Runtime Revisions=runtimeRevisions@count|Candidate Snapshots=candidateSnapshots@count|Snapshot Builds=snapshotBuilds@count|Build Errors=snapshotBuildErrors@count"
  prop title = "Verification Runtime"
  prop summary = "Candidate snapshots, runtime revisions, snapshot builds, and runtime rebuild diagnostics."
  children {
