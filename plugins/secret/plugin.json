{
  "id": "plugin.secret",
  "version": "0.1.0",
  "displayName": "Runner Secret Store Plugin Runtime",
  "description": "Owns runner-scoped secret metadata, write-only secret value storage, and secret management routes.",
  "kind": "plugin",
  "runtime": {
    "entry": "./runtime.js"
  },
  "activatesBundles": [
    "bundle-secret"
  ],
  "contributes": {
    "capabilities": [
      {
        "id": "secret.store"
      }
    ],
    "routes": [
      {
        "method": "GET",
        "path": "/api/secrets",
        "handler": "secret.store.list"
      },
      {
        "method": "GET",
        "pattern": "^/api/secrets/([^/]+)$",
        "handler": "secret.store.read"
      },
      {
        "method": "POST",
        "path": "/api/secrets",
        "handler": "secret.store.create"
      },
      {
        "method": "PUT",
        "pattern": "^/api/secrets/([^/]+)/value$",
        "handler": "secret.store.write"
      },
      {
        "method": "DELETE",
        "pattern": "^/api/secrets/([^/]+)$",
        "handler": "secret.store.delete"
      }
    ],
    "surfaces": [],
    "providers": [
      {
        "id": "secret.store.handlers",
        "kind": "runtime-handler-catalog"
      }
    ]
  }
}
