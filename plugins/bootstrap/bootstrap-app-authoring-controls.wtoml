[[defaults]]
actor = "frontendHost"
context = "frontend"

[[box]]
id = "bootstrap_context_authoring_controls_root"
class = "surface-stack"
children = ["bootstrap_context_form", "bootstrap_context_status", "bootstrap_perspective_form", "bootstrap_perspective_status"]

[[form]]
id = "bootstrap_context_form"
domId = "context-form"
class = "surface-stack surface-mono"
guidanceTarget = "context-form"
children = ["bootstrap_context_grid_primary", "bootstrap_context_grid_secondary", "bootstrap_context_actions"]

[[box]]
id = "bootstrap_context_grid_primary"
class = "surface-grid-2"
children = ["bootstrap_context_id_field", "bootstrap_context_label_field"]

[[box]]
id = "bootstrap_context_id_field"
class = "surface-stack"
children = ["bootstrap_context_id_text", "bootstrap_context_id_input"]

[[text]]
id = "bootstrap_context_id_text"
text = "Context Id"

[[input]]
id = "bootstrap_context_id_input"
name = "id"
placeholder = "team.platform"

[[box]]
id = "bootstrap_context_label_field"
class = "surface-stack"
children = ["bootstrap_context_label_text", "bootstrap_context_label_input"]

[[text]]
id = "bootstrap_context_label_text"
text = "Label"

[[input]]
id = "bootstrap_context_label_input"
name = "label"
placeholder = "Platform Team"

[[box]]
id = "bootstrap_context_grid_secondary"
class = "surface-grid-2"
children = ["bootstrap_context_parent_field", "bootstrap_context_stewards_field"]

[[box]]
id = "bootstrap_context_parent_field"
class = "surface-stack"
children = ["bootstrap_context_parent_text", "bootstrap_context_parent_select"]

[[text]]
id = "bootstrap_context_parent_text"
text = "Parent"

[[select]]
id = "bootstrap_context_parent_select"
domId = "context-parent"
name = "parent"

[[box]]
id = "bootstrap_context_stewards_field"
class = "surface-stack"
children = ["bootstrap_context_stewards_text", "bootstrap_context_stewards_input"]

[[text]]
id = "bootstrap_context_stewards_text"
text = "Initial Stewards JSON"

[[textarea]]
id = "bootstrap_context_stewards_input"
name = "stewardsJson"
text = "[]"

[[box]]
id = "bootstrap_context_actions"
class = "surface-actions"
children = ["bootstrap_context_submit"]

[[button]]
id = "bootstrap_context_submit"
text = "Create Context"
type = "submit"

[[text]]
id = "bootstrap_context_status"
domId = "context-status"
class = "surface-status"
text = ""

[[form]]
id = "bootstrap_perspective_form"
domId = "perspective-form"
class = "surface-stack surface-mono"
children = ["bootstrap_perspective_grid_primary", "bootstrap_perspective_grid_secondary", "bootstrap_perspective_actions"]

[[box]]
id = "bootstrap_perspective_grid_primary"
class = "surface-grid-2"
children = ["bootstrap_perspective_id_field", "bootstrap_perspective_title_field"]

[[box]]
id = "bootstrap_perspective_id_field"
class = "surface-stack"
children = ["bootstrap_perspective_id_text", "bootstrap_perspective_id_input"]

[[text]]
id = "bootstrap_perspective_id_text"
text = "Perspective Id"

[[input]]
id = "bootstrap_perspective_id_input"
name = "id"
placeholder = "aaron:workspace"

[[box]]
id = "bootstrap_perspective_title_field"
class = "surface-stack"
children = ["bootstrap_perspective_title_text", "bootstrap_perspective_title_input"]

[[text]]
id = "bootstrap_perspective_title_text"
text = "Title"

[[input]]
id = "bootstrap_perspective_title_input"
name = "title"
placeholder = "Aaron Workspace"

[[box]]
id = "bootstrap_perspective_grid_secondary"
class = "surface-grid-2"
children = ["bootstrap_perspective_context_field", "bootstrap_perspective_spacer"]

[[box]]
id = "bootstrap_perspective_context_field"
class = "surface-stack"
children = ["bootstrap_perspective_context_text", "bootstrap_perspective_context_select"]

[[text]]
id = "bootstrap_perspective_context_text"
text = "Context"

[[select]]
id = "bootstrap_perspective_context_select"
domId = "perspective-context"
name = "context"

[[box]]
id = "bootstrap_perspective_spacer"
class = "surface-stack"

[[box]]
id = "bootstrap_perspective_actions"
class = "surface-actions"
children = ["bootstrap_perspective_submit"]

[[button]]
id = "bootstrap_perspective_submit"
text = "Create Perspective"
type = "submit"

[[text]]
id = "bootstrap_perspective_status"
domId = "perspective-status"
class = "surface-status"
text = ""

[[frontendProgram]]
id = "bootstrap_context_authoring_controls_program"
rootWidget = "bootstrap_context_authoring_controls_root"

[[step]]
program = "bootstrap_context_authoring_controls_program"
order = 0
op = "setText"
on = "submit:bootstrap_context_form"
widget = "bootstrap_context_status"
text = "Saving..."

[[step]]
program = "bootstrap_context_authoring_controls_program"
order = 1
op = "dispatchDomEvent"
on = "submit:bootstrap_context_form"
eventName = "witness:bootstrap-app-authoring-submit"
detail = { source = "bootstrap-app-authoring-controls", family = "context", formId = "context-form", statusId = "context-status" }

[[step]]
program = "bootstrap_context_authoring_controls_program"
order = 0
op = "setText"
on = "submit:bootstrap_perspective_form"
widget = "bootstrap_perspective_status"
text = "Saving..."

[[step]]
program = "bootstrap_context_authoring_controls_program"
order = 1
op = "dispatchDomEvent"
on = "submit:bootstrap_perspective_form"
eventName = "witness:bootstrap-app-authoring-submit"
detail = { source = "bootstrap-app-authoring-controls", family = "perspective", formId = "perspective-form", statusId = "perspective-status" }

[[box]]
id = "bootstrap_widget_authoring_controls_root"
class = "surface-stack"
children = ["bootstrap_widget_form", "bootstrap_widget_status"]

[[form]]
