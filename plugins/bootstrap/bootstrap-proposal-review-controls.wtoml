[[defaults]]
actor = "frontendHost"
context = "frontend"
program = "bootstrap_proposal_review_controls_program"

[[box]]
id = "bootstrap_proposal_review_controls_root"
class = "surface-stack"
children = ["bootstrap_proposal_approve_form", "bootstrap_proposal_approve_status", "bootstrap_proposal_reject_form", "bootstrap_proposal_reject_status"]

[[form]]
id = "bootstrap_proposal_approve_form"
domId = "proposal-approve-form"
class = "surface-stack"
children = ["bootstrap_proposal_approve_grid", "bootstrap_proposal_approve_help", "bootstrap_proposal_approve_actions"]

[[box]]
id = "bootstrap_proposal_approve_grid"
class = "surface-grid-2"
children = ["bootstrap_proposal_approve_id_field", "bootstrap_proposal_approve_spacer"]

[[box]]
id = "bootstrap_proposal_approve_id_field"
class = "surface-stack"
children = ["bootstrap_proposal_approve_id_text", "bootstrap_proposal_approve_id_select"]

[[text]]
id = "bootstrap_proposal_approve_id_text"
text = "Open Proposal"

[[select]]
id = "bootstrap_proposal_approve_id_select"
domId = "proposal-approve-id"
name = "id"

[[box]]
id = "bootstrap_proposal_approve_spacer"

[[text]]
id = "bootstrap_proposal_approve_help"
domId = "proposal-approve-help"
class = "surface-note surface-note-callout"
text = ""

[[box]]
id = "bootstrap_proposal_approve_actions"
class = "surface-actions"
children = ["bootstrap_proposal_approve_submit"]

[[button]]
id = "bootstrap_proposal_approve_submit"
text = "Approve Proposal"
type = "submit"

[[text]]
id = "bootstrap_proposal_approve_status"
domId = "proposal-approve-status"
class = "surface-status"
text = ""

[[form]]
id = "bootstrap_proposal_reject_form"
domId = "proposal-reject-form"
class = "surface-stack"
children = ["bootstrap_proposal_reject_grid", "bootstrap_proposal_reject_actions"]

[[box]]
id = "bootstrap_proposal_reject_grid"
class = "surface-grid-2"
children = ["bootstrap_proposal_reject_id_field", "bootstrap_proposal_reject_reason_field"]

[[box]]
id = "bootstrap_proposal_reject_id_field"
class = "surface-stack"
children = ["bootstrap_proposal_reject_id_text", "bootstrap_proposal_reject_id_select"]

[[text]]
id = "bootstrap_proposal_reject_id_text"
text = "Open Proposal"

[[select]]
id = "bootstrap_proposal_reject_id_select"
domId = "proposal-reject-id"
name = "id"

[[box]]
id = "bootstrap_proposal_reject_reason_field"
class = "surface-stack"
children = ["bootstrap_proposal_reject_reason_text", "bootstrap_proposal_reject_reason_input"]

[[text]]
id = "bootstrap_proposal_reject_reason_text"
text = "Reason"

[[input]]
id = "bootstrap_proposal_reject_reason_input"
name = "reason"
placeholder = "optional rejection reason"

[[box]]
id = "bootstrap_proposal_reject_actions"
class = "surface-actions"
children = ["bootstrap_proposal_reject_submit"]

[[button]]
id = "bootstrap_proposal_reject_submit"
text = "Reject Proposal"
type = "submit"

[[text]]
id = "bootstrap_proposal_reject_status"
domId = "proposal-reject-status"
class = "surface-status"
text = ""

[[frontendProgram]]
id = "bootstrap_proposal_review_controls_program"
rootWidget = "bootstrap_proposal_review_controls_root"

[[step]]
order = 0
op = "dispatchDomEvent"
on = "change:bootstrap_proposal_approve_id_select"
eventName = "witness:bootstrap-proposal-approve-help-sync"
detail = { source = "bootstrap-proposal-review-controls", trigger = "approve-id" }

[[step]]
order = 0
op = "setText"
on = "submit:bootstrap_proposal_approve_form"
widget = "bootstrap_proposal_approve_status"
text = "Approving..."

[[step]]
order = 1
op = "readForm"
on = "submit:bootstrap_proposal_approve_form"
widget = "bootstrap_proposal_approve_form"
into = "bootstrapProposalApproveDraft"

[[step]]
order = 2
op = "dispatchDomEvent"
on = "submit:bootstrap_proposal_approve_form"
eventName = "witness:bootstrap-proposal-submit"
detail = { source = "bootstrap-proposal-review-controls", family = "approve", formId = "proposal-approve-form", statusId = "proposal-approve-status", id = "${state.bootstrapProposalApproveDraft.id}" }

[[step]]
order = 0
op = "setText"
on = "submit:bootstrap_proposal_reject_form"
widget = "bootstrap_proposal_reject_status"
text = "Rejecting..."

[[step]]
order = 1
op = "readForm"
on = "submit:bootstrap_proposal_reject_form"
widget = "bootstrap_proposal_reject_form"
into = "bootstrapProposalRejectDraft"

[[step]]
order = 2
op = "dispatchDomEvent"
on = "submit:bootstrap_proposal_reject_form"
eventName = "witness:bootstrap-proposal-submit"
detail = { source = "bootstrap-proposal-review-controls", family = "reject", formId = "proposal-reject-form", statusId = "proposal-reject-status", id = "${state.bootstrapProposalRejectDraft.id}", reason = "${state.bootstrapProposalRejectDraft.reason || ''}" }

[[step]]
order = 0
op = "setText"
on = "error"
when = { path = "event.event", equals = "submit:bootstrap_proposal_approve_form" }
widget = "bootstrap_proposal_approve_status"
text = "${event.message}"

[[step]]
order = 0
op = "setText"
on = "error"
when = { path = "event.event", equals = "submit:bootstrap_proposal_reject_form" }
widget = "bootstrap_proposal_reject_status"
text = "${event.message}"
