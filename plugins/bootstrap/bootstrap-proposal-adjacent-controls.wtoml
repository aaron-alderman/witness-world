[[defaults]]
actor = "frontendHost"
context = "frontend"

[[box]]
id = "bootstrap_runtime_plugin_install_proposal_controls_root"
class = "stack"
children = ["bootstrap_runtime_plugin_install_proposal_form", "bootstrap_runtime_plugin_install_proposal_help", "bootstrap_runtime_plugin_install_proposal_status"]

[[form]]
id = "bootstrap_runtime_plugin_install_proposal_form"
domId = "runtime-plugin-install-proposal-form"
class = "stack"
children = ["bootstrap_runtime_plugin_install_proposal_row_one", "bootstrap_runtime_plugin_install_proposal_row_two", "bootstrap_runtime_plugin_install_proposal_actions"]

[[box]]
id = "bootstrap_runtime_plugin_install_proposal_row_one"
class = "grid two"
children = ["bootstrap_runtime_plugin_install_proposal_id_field", "bootstrap_runtime_plugin_install_proposal_runner_field"]

[[box]]
id = "bootstrap_runtime_plugin_install_proposal_id_field"
class = "stack"
children = ["bootstrap_runtime_plugin_install_proposal_id_text", "bootstrap_runtime_plugin_install_proposal_id_input"]

[[text]]
id = "bootstrap_runtime_plugin_install_proposal_id_text"
text = "Proposal Id"

[[input]]
id = "bootstrap_runtime_plugin_install_proposal_id_input"
name = "id"
placeholder = "proposal.runtimePlugin.install.inspect"

[[box]]
id = "bootstrap_runtime_plugin_install_proposal_runner_field"
class = "stack"
children = ["bootstrap_runtime_plugin_install_proposal_runner_text", "bootstrap_runtime_plugin_install_proposal_runner_select"]

[[text]]
id = "bootstrap_runtime_plugin_install_proposal_runner_text"
text = "Server Runner"

[[select]]
id = "bootstrap_runtime_plugin_install_proposal_runner_select"
domId = "runtime-plugin-install-proposal-runner"
name = "serverRunner"

[[box]]
id = "bootstrap_runtime_plugin_install_proposal_row_two"
class = "grid two"
children = ["bootstrap_runtime_plugin_install_proposal_plugin_field", "bootstrap_runtime_plugin_install_proposal_reason_field"]

[[box]]
id = "bootstrap_runtime_plugin_install_proposal_plugin_field"
class = "stack"
children = ["bootstrap_runtime_plugin_install_proposal_plugin_text", "bootstrap_runtime_plugin_install_proposal_plugin_select"]

[[text]]
id = "bootstrap_runtime_plugin_install_proposal_plugin_text"
text = "Plugin"

[[select]]
id = "bootstrap_runtime_plugin_install_proposal_plugin_select"
domId = "runtime-plugin-install-proposal-plugin"
name = "plugin"

[[box]]
id = "bootstrap_runtime_plugin_install_proposal_reason_field"
class = "stack"
children = ["bootstrap_runtime_plugin_install_proposal_reason_text", "bootstrap_runtime_plugin_install_proposal_reason_input"]

[[text]]
id = "bootstrap_runtime_plugin_install_proposal_reason_text"
text = "Reason"

[[input]]
id = "bootstrap_runtime_plugin_install_proposal_reason_input"
name = "reason"
placeholder = "why this plugin should be enabled"

[[box]]
id = "bootstrap_runtime_plugin_install_proposal_actions"
class = "actions"
children = ["bootstrap_runtime_plugin_install_proposal_submit"]

[[button]]
id = "bootstrap_runtime_plugin_install_proposal_submit"
text = "Propose Runtime Plugin Install"
type = "submit"

[[text]]
id = "bootstrap_runtime_plugin_install_proposal_help"
domId = "runtime-plugin-install-proposal-help"
class = "note muted"
text = ""

[[text]]
id = "bootstrap_runtime_plugin_install_proposal_status"
domId = "runtime-plugin-install-proposal-status"
class = "status"
text = ""

[[frontendProgram]]
id = "bootstrap_runtime_plugin_install_proposal_controls_program"
rootWidget = "bootstrap_runtime_plugin_install_proposal_controls_root"

[[step]]
program = "bootstrap_runtime_plugin_install_proposal_controls_program"
order = 0
op = "dispatchDomEvent"
on = "change:bootstrap_runtime_plugin_install_proposal_runner_select"
eventName = "witness:bootstrap-proposal-adjacent-sync"
detail = { source = "bootstrap-proposal-adjacent-controls", family = "runtime-plugin-install", trigger = "server-runner" }

[[step]]
program = "bootstrap_runtime_plugin_install_proposal_controls_program"
order = 0
op = "dispatchDomEvent"
on = "change:bootstrap_runtime_plugin_install_proposal_plugin_select"
eventName = "witness:bootstrap-proposal-adjacent-sync"
detail = { source = "bootstrap-proposal-adjacent-controls", family = "runtime-plugin-install", trigger = "plugin" }

[[step]]
program = "bootstrap_runtime_plugin_install_proposal_controls_program"
order = 0
op = "setText"
on = "submit:bootstrap_runtime_plugin_install_proposal_form"
widget = "bootstrap_runtime_plugin_install_proposal_status"
text = "Saving..."

[[step]]
program = "bootstrap_runtime_plugin_install_proposal_controls_program"
order = 1
op = "readForm"
on = "submit:bootstrap_runtime_plugin_install_proposal_form"
widget = "bootstrap_runtime_plugin_install_proposal_form"
into = "bootstrapRuntimePluginInstallProposalDraft"

[[step]]
program = "bootstrap_runtime_plugin_install_proposal_controls_program"
order = 2
op = "dispatchDomEvent"
on = "submit:bootstrap_runtime_plugin_install_proposal_form"
eventName = "witness:bootstrap-proposal-adjacent-submit"
detail = { source = "bootstrap-proposal-adjacent-controls", family = "runtime-plugin-install", formId = "runtime-plugin-install-proposal-form", statusId = "runtime-plugin-install-proposal-status", id = "${state.bootstrapRuntimePluginInstallProposalDraft.id}", serverRunner = "${state.bootstrapRuntimePluginInstallProposalDraft.serverRunner}", plugin = "${state.bootstrapRuntimePluginInstallProposalDraft.plugin}", reason = "${state.bootstrapRuntimePluginInstallProposalDraft.reason}" }

