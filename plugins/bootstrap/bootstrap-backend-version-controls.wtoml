[[defaults]]
actor = "frontendHost"
context = "frontend"
program = "bootstrap_backend_version_controls_program"

[[box]]
id = "bootstrap_backend_version_controls_root"
class = "surface-stack"
children = ["bootstrap_backend_activate_form", "bootstrap_backend_activate_status", "bootstrap_backend_rollback_form", "bootstrap_backend_rollback_status"]

[[form]]
id = "bootstrap_backend_activate_form"
domId = "backend-program-activate-form"
class = "surface-stack surface-mono"
children = ["bootstrap_backend_activate_grid", "bootstrap_backend_activate_help", "bootstrap_backend_activate_actions"]

[[box]]
id = "bootstrap_backend_activate_grid"
class = "surface-grid-2"
children = ["bootstrap_backend_activate_soul_field", "bootstrap_backend_activate_version_field"]

[[box]]
id = "bootstrap_backend_activate_soul_field"
class = "surface-stack"
children = ["bootstrap_backend_activate_soul_text", "bootstrap_backend_activate_soul_select"]

[[text]]
id = "bootstrap_backend_activate_soul_text"
text = "Program Soul"

[[select]]
id = "bootstrap_backend_activate_soul_select"
domId = "backend-program-activate-soul"
name = "soul"

[[box]]
id = "bootstrap_backend_activate_version_field"
class = "surface-stack"
children = ["bootstrap_backend_activate_version_text", "bootstrap_backend_activate_version_select"]

[[text]]
id = "bootstrap_backend_activate_version_text"
text = "Version"

[[select]]
id = "bootstrap_backend_activate_version_select"
domId = "backend-program-activate-version"
name = "version"

[[text]]
id = "bootstrap_backend_activate_help"
domId = "backend-program-activate-help"
class = "surface-note surface-note-callout"
text = ""

[[box]]
id = "bootstrap_backend_activate_actions"
class = "surface-actions"
children = ["bootstrap_backend_activate_submit"]

[[button]]
id = "bootstrap_backend_activate_submit"
text = "Activate Version"
type = "submit"

[[text]]
id = "bootstrap_backend_activate_status"
domId = "backend-program-activate-status"
class = "surface-status"
text = ""

[[form]]
id = "bootstrap_backend_rollback_form"
domId = "backend-program-rollback-form"
class = "surface-stack surface-mono"
children = ["bootstrap_backend_rollback_grid", "bootstrap_backend_rollback_help", "bootstrap_backend_rollback_actions"]

[[box]]
id = "bootstrap_backend_rollback_grid"
class = "surface-grid-2"
children = ["bootstrap_backend_rollback_soul_field", "bootstrap_backend_rollback_spacer"]

[[box]]
id = "bootstrap_backend_rollback_soul_field"
class = "surface-stack"
children = ["bootstrap_backend_rollback_soul_text", "bootstrap_backend_rollback_soul_select"]

[[text]]
id = "bootstrap_backend_rollback_soul_text"
text = "Program Soul"

[[select]]
id = "bootstrap_backend_rollback_soul_select"
domId = "backend-program-rollback-soul"
name = "soul"

[[box]]
id = "bootstrap_backend_rollback_spacer"

[[text]]
id = "bootstrap_backend_rollback_help"
domId = "backend-program-rollback-help"
class = "surface-note surface-note-callout"
text = ""

[[box]]
id = "bootstrap_backend_rollback_actions"
class = "surface-actions"
children = ["bootstrap_backend_rollback_submit"]

[[button]]
id = "bootstrap_backend_rollback_submit"
text = "Rollback Version"
type = "submit"
class = "surface-button-secondary"

[[text]]
id = "bootstrap_backend_rollback_status"
domId = "backend-program-rollback-status"
class = "surface-status"
text = ""

[[frontendProgram]]
id = "bootstrap_backend_version_controls_program"
rootWidget = "bootstrap_backend_version_controls_root"

[[step]]
order = 0
op = "setText"
on = "submit:bootstrap_backend_activate_form"
widget = "bootstrap_backend_activate_status"
text = "Activating version..."

[[step]]
order = 1
op = "readForm"
on = "submit:bootstrap_backend_activate_form"
widget = "bootstrap_backend_activate_form"
into = "bootstrapBackendActivateDraft"

[[step]]
order = 0
op = "setText"
on = "submit:bootstrap_backend_rollback_form"
widget = "bootstrap_backend_rollback_status"
text = "Rolling back version..."

[[step]]
order = 1
op = "readForm"
on = "submit:bootstrap_backend_rollback_form"
widget = "bootstrap_backend_rollback_form"
into = "bootstrapBackendRollbackDraft"

[[step]]
order = 0
op = "setText"
on = "error"
when = { path = "event.event", equals = "submit:bootstrap_backend_activate_form" }
widget = "bootstrap_backend_activate_status"
text = "${event.message}"

[[step]]
order = 0
op = "setText"
on = "error"
when = { path = "event.event", equals = "submit:bootstrap_backend_rollback_form" }
widget = "bootstrap_backend_rollback_status"
text = "${event.message}"
