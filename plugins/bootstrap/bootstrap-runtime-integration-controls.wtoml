[[defaults]]
actor = "frontendHost"
context = "frontend"

[[box]]
id = "bootstrap_runtime_plugin_install_controls_root"
class = "surface-stack"
children = ["bootstrap_runtime_plugin_install_form", "bootstrap_runtime_plugin_install_help", "bootstrap_runtime_plugin_install_status"]

[[form]]
id = "bootstrap_runtime_plugin_install_form"
domId = "runtime-plugin-install-form"
guidanceTarget = "runtime-plugin-install-form"
class = "surface-stack"
children = ["bootstrap_runtime_plugin_install_grid", "bootstrap_runtime_plugin_install_actions"]

[[box]]
id = "bootstrap_runtime_plugin_install_grid"
class = "surface-grid-2"
children = ["bootstrap_runtime_plugin_install_runner_field", "bootstrap_runtime_plugin_install_plugin_field"]

[[box]]
id = "bootstrap_runtime_plugin_install_runner_field"
class = "surface-stack"
children = ["bootstrap_runtime_plugin_install_runner_text", "bootstrap_runtime_plugin_install_runner_select"]

[[text]]
id = "bootstrap_runtime_plugin_install_runner_text"
text = "Server Runner"

[[select]]
id = "bootstrap_runtime_plugin_install_runner_select"
domId = "runtime-plugin-install-runner"
name = "serverRunner"

[[box]]
id = "bootstrap_runtime_plugin_install_plugin_field"
class = "surface-stack"
children = ["bootstrap_runtime_plugin_install_plugin_text", "bootstrap_runtime_plugin_install_plugin_select"]

[[text]]
id = "bootstrap_runtime_plugin_install_plugin_text"
text = "Plugin"

[[select]]
id = "bootstrap_runtime_plugin_install_plugin_select"
domId = "runtime-plugin-install-plugin"
name = "plugin"

[[box]]
id = "bootstrap_runtime_plugin_install_actions"
class = "surface-actions"
children = ["bootstrap_runtime_plugin_install_submit"]

[[button]]
id = "bootstrap_runtime_plugin_install_submit"
text = "Install Runtime Plugin"
type = "submit"

[[text]]
id = "bootstrap_runtime_plugin_install_help"
domId = "runtime-plugin-install-help"
class = "surface-note surface-note-callout"
text = ""

[[text]]
id = "bootstrap_runtime_plugin_install_status"
domId = "runtime-plugin-install-status"
class = "surface-status"
text = ""

[[frontendProgram]]
id = "bootstrap_runtime_plugin_install_controls_program"
rootWidget = "bootstrap_runtime_plugin_install_controls_root"

[[step]]
program = "bootstrap_runtime_plugin_install_controls_program"
order = 0
op = "setText"
on = "submit:bootstrap_runtime_plugin_install_form"
widget = "bootstrap_runtime_plugin_install_status"
text = "Saving..."

[[step]]
program = "bootstrap_runtime_plugin_install_controls_program"
order = 1
op = "readForm"
on = "submit:bootstrap_runtime_plugin_install_form"
widget = "bootstrap_runtime_plugin_install_form"
into = "bootstrapRuntimePluginInstallDraft"

[[step]]
program = "bootstrap_runtime_plugin_install_controls_program"
order = 0
op = "setText"
on = "error"
when = { path = "event.event", equals = "submit:bootstrap_runtime_plugin_install_form" }
widget = "bootstrap_runtime_plugin_install_status"
text = "${event.message}"

[[box]]
id = "bootstrap_mcp_server_controls_root"
class = "surface-stack"
children = ["bootstrap_mcp_server_form", "bootstrap_mcp_server_help", "bootstrap_mcp_server_status"]

[[form]]
id = "bootstrap_mcp_server_form"
domId = "mcp-server-form"
guidanceTarget = "mcp-server-form"
class = "surface-stack"
children = ["bootstrap_mcp_server_row_one", "bootstrap_mcp_server_row_two", "bootstrap_mcp_server_row_three", "bootstrap_mcp_server_actions"]

[[box]]
id = "bootstrap_mcp_server_row_one"
class = "surface-grid-2"
children = ["bootstrap_mcp_server_id_field", "bootstrap_mcp_server_label_field"]

[[box]]
id = "bootstrap_mcp_server_id_field"
class = "surface-stack"
children = ["bootstrap_mcp_server_id_text", "bootstrap_mcp_server_id_input"]

[[text]]
id = "bootstrap_mcp_server_id_text"
text = "Server Id"

[[input]]
id = "bootstrap_mcp_server_id_input"
name = "id"
placeholder = "personal_mcp"

[[box]]
id = "bootstrap_mcp_server_label_field"
class = "surface-stack"
children = ["bootstrap_mcp_server_label_text", "bootstrap_mcp_server_label_input"]

[[text]]
id = "bootstrap_mcp_server_label_text"
text = "Label"

[[input]]
id = "bootstrap_mcp_server_label_input"
name = "label"
placeholder = "Personal MCP"

[[box]]
id = "bootstrap_mcp_server_row_two"
class = "surface-grid-2"
children = ["bootstrap_mcp_server_runner_field", "bootstrap_mcp_server_context_field"]

[[box]]
id = "bootstrap_mcp_server_runner_field"
class = "surface-stack"
children = ["bootstrap_mcp_server_runner_text", "bootstrap_mcp_server_runner_select"]

[[text]]
id = "bootstrap_mcp_server_runner_text"
text = "Server Runner"

[[select]]
id = "bootstrap_mcp_server_runner_select"
domId = "mcp-server-runner"
name = "serverRunner"

[[box]]
id = "bootstrap_mcp_server_context_field"
class = "surface-stack"
children = ["bootstrap_mcp_server_context_text", "bootstrap_mcp_server_context_select"]

[[text]]
id = "bootstrap_mcp_server_context_text"
text = "Context"

[[select]]
id = "bootstrap_mcp_server_context_select"
domId = "mcp-server-context"
name = "context"

[[box]]
id = "bootstrap_mcp_server_row_three"
class = "surface-grid-2"
children = ["bootstrap_mcp_server_service_identity_field", "bootstrap_mcp_server_transports_field"]

[[box]]
id = "bootstrap_mcp_server_service_identity_field"
class = "surface-stack"
children = ["bootstrap_mcp_server_service_identity_text", "bootstrap_mcp_server_service_identity_input"]

[[text]]
id = "bootstrap_mcp_server_service_identity_text"
text = "Service Identity"

[[input]]
id = "bootstrap_mcp_server_service_identity_input"
name = "serviceIdentity"
placeholder = "aaron"

[[box]]
id = "bootstrap_mcp_server_transports_field"
class = "surface-stack"
children = ["bootstrap_mcp_server_transports_text", "bootstrap_mcp_server_transports_input"]

[[text]]
id = "bootstrap_mcp_server_transports_text"
text = "Transports JSON"

[[textarea]]
id = "bootstrap_mcp_server_transports_input"
name = "transportsJson"
value = "[\"stdio\",\"http\"]"

[[box]]
id = "bootstrap_mcp_server_actions"
class = "surface-actions"
children = ["bootstrap_mcp_server_submit"]

[[button]]
id = "bootstrap_mcp_server_submit"
text = "Create MCP Server"
type = "submit"

[[text]]
id = "bootstrap_mcp_server_help"
domId = "mcp-server-help"
class = "surface-note surface-note-callout"
text = ""

[[text]]
id = "bootstrap_mcp_server_status"
domId = "mcp-server-status"
class = "surface-status"
text = ""

[[frontendProgram]]
id = "bootstrap_mcp_server_controls_program"
rootWidget = "bootstrap_mcp_server_controls_root"

[[step]]
program = "bootstrap_mcp_server_controls_program"
order = 0
op = "setText"
on = "submit:bootstrap_mcp_server_form"
widget = "bootstrap_mcp_server_status"
text = "Saving..."

[[step]]
program = "bootstrap_mcp_server_controls_program"
order = 1
op = "readForm"
on = "submit:bootstrap_mcp_server_form"
widget = "bootstrap_mcp_server_form"
into = "bootstrapMcpServerDraft"

[[step]]
program = "bootstrap_mcp_server_controls_program"
order = 0
op = "setText"
on = "error"
when = { path = "event.event", equals = "submit:bootstrap_mcp_server_form" }
widget = "bootstrap_mcp_server_status"
text = "${event.message}"

[[box]]
id = "bootstrap_mcp_tool_install_controls_root"
class = "surface-stack"
children = ["bootstrap_mcp_tool_install_form", "bootstrap_mcp_tool_install_help", "bootstrap_mcp_tool_install_status"]

[[form]]
id = "bootstrap_mcp_tool_install_form"
domId = "mcp-tool-install-form"
guidanceTarget = "mcp-tool-install-form"
class = "surface-stack"
children = ["bootstrap_mcp_tool_install_row_one", "bootstrap_mcp_tool_install_row_two", "bootstrap_mcp_tool_install_scope_contexts_field", "bootstrap_mcp_tool_install_scope_targets_field", "bootstrap_mcp_tool_install_actions"]

[[box]]
id = "bootstrap_mcp_tool_install_row_one"
class = "surface-grid-2"
children = ["bootstrap_mcp_tool_install_server_field", "bootstrap_mcp_tool_install_tool_field"]

[[box]]
id = "bootstrap_mcp_tool_install_server_field"
class = "surface-stack"
children = ["bootstrap_mcp_tool_install_server_text", "bootstrap_mcp_tool_install_server_select"]

[[text]]
id = "bootstrap_mcp_tool_install_server_text"
text = "Server"

[[select]]
id = "bootstrap_mcp_tool_install_server_select"
domId = "mcp-tool-install-server"
name = "server"

[[box]]
id = "bootstrap_mcp_tool_install_tool_field"
class = "surface-stack"
children = ["bootstrap_mcp_tool_install_tool_text", "bootstrap_mcp_tool_install_tool_select"]

[[text]]
id = "bootstrap_mcp_tool_install_tool_text"
text = "Tool"

[[select]]
id = "bootstrap_mcp_tool_install_tool_select"
domId = "mcp-tool-install-tool"
name = "tool"

[[box]]
id = "bootstrap_mcp_tool_install_row_two"
class = "surface-grid-2"
children = ["bootstrap_mcp_tool_install_acting_mode_field", "bootstrap_mcp_tool_install_spacer"]

[[box]]
id = "bootstrap_mcp_tool_install_acting_mode_field"
class = "surface-stack"
children = ["bootstrap_mcp_tool_install_acting_mode_text", "bootstrap_mcp_tool_install_acting_mode_select"]

[[text]]
id = "bootstrap_mcp_tool_install_acting_mode_text"
text = "Acting Mode"

[[select]]
id = "bootstrap_mcp_tool_install_acting_mode_select"
domId = "mcp-tool-install-acting-mode"
name = "actingMode"

[[box]]
id = "bootstrap_mcp_tool_install_spacer"

[[box]]
id = "bootstrap_mcp_tool_install_scope_contexts_field"
class = "surface-stack"
children = ["bootstrap_mcp_tool_install_scope_contexts_text", "bootstrap_mcp_tool_install_scope_contexts_input"]

[[text]]
id = "bootstrap_mcp_tool_install_scope_contexts_text"
text = "Scope Contexts JSON"

[[textarea]]
id = "bootstrap_mcp_tool_install_scope_contexts_input"
name = "scopeContextsJson"
value = "[]"

[[box]]
id = "bootstrap_mcp_tool_install_scope_targets_field"
class = "surface-stack"
children = ["bootstrap_mcp_tool_install_scope_targets_text", "bootstrap_mcp_tool_install_scope_targets_input"]

[[text]]
id = "bootstrap_mcp_tool_install_scope_targets_text"
text = "Scope Targets JSON"

[[textarea]]
id = "bootstrap_mcp_tool_install_scope_targets_input"
name = "scopeTargetsJson"
value = "[]"

[[box]]
id = "bootstrap_mcp_tool_install_actions"
class = "surface-actions"
children = ["bootstrap_mcp_tool_install_submit"]

[[button]]
id = "bootstrap_mcp_tool_install_submit"
text = "Install MCP Tool"
type = "submit"

[[text]]
id = "bootstrap_mcp_tool_install_help"
domId = "mcp-tool-install-help"
class = "surface-note surface-note-callout"
text = ""

[[text]]
id = "bootstrap_mcp_tool_install_status"
domId = "mcp-tool-install-status"
class = "surface-status"
text = ""

[[frontendProgram]]
id = "bootstrap_mcp_tool_install_controls_program"
rootWidget = "bootstrap_mcp_tool_install_controls_root"

[[step]]
program = "bootstrap_mcp_tool_install_controls_program"
order = 0
op = "setText"
on = "submit:bootstrap_mcp_tool_install_form"
widget = "bootstrap_mcp_tool_install_status"
text = "Saving..."

[[step]]
program = "bootstrap_mcp_tool_install_controls_program"
order = 1
op = "readForm"
on = "submit:bootstrap_mcp_tool_install_form"
widget = "bootstrap_mcp_tool_install_form"
into = "bootstrapMcpToolInstallDraft"

[[step]]
program = "bootstrap_mcp_tool_install_controls_program"
order = 0
op = "setText"
on = "error"
when = { path = "event.event", equals = "submit:bootstrap_mcp_tool_install_form" }
widget = "bootstrap_mcp_tool_install_status"
text = "${event.message}"
