[[defaults]]
actor = "frontendHost"
context = "frontend"

[[box]]
id = "bootstrap_runtime_plugin_remove_controls_root"
class = "surface-stack"
children = ["bootstrap_runtime_plugin_remove_form", "bootstrap_runtime_plugin_remove_help", "bootstrap_runtime_plugin_remove_status"]

[[form]]
id = "bootstrap_runtime_plugin_remove_form"
domId = "runtime-plugin-remove-form"
class = "surface-stack"
children = ["bootstrap_runtime_plugin_remove_grid", "bootstrap_runtime_plugin_remove_actions"]

[[box]]
id = "bootstrap_runtime_plugin_remove_grid"
class = "surface-grid-2"
children = ["bootstrap_runtime_plugin_remove_runner_field", "bootstrap_runtime_plugin_remove_plugin_field"]

[[box]]
id = "bootstrap_runtime_plugin_remove_runner_field"
class = "surface-stack"
children = ["bootstrap_runtime_plugin_remove_runner_text", "bootstrap_runtime_plugin_remove_runner_select"]

[[text]]
id = "bootstrap_runtime_plugin_remove_runner_text"
text = "Server Runner"

[[select]]
id = "bootstrap_runtime_plugin_remove_runner_select"
domId = "runtime-plugin-remove-runner"
name = "serverRunner"

[[box]]
id = "bootstrap_runtime_plugin_remove_plugin_field"
class = "surface-stack"
children = ["bootstrap_runtime_plugin_remove_plugin_text", "bootstrap_runtime_plugin_remove_plugin_select"]

[[text]]
id = "bootstrap_runtime_plugin_remove_plugin_text"
text = "Plugin"

[[select]]
id = "bootstrap_runtime_plugin_remove_plugin_select"
domId = "runtime-plugin-remove-plugin"
name = "plugin"

[[box]]
id = "bootstrap_runtime_plugin_remove_actions"
class = "surface-actions"
children = ["bootstrap_runtime_plugin_remove_submit"]

[[button]]
id = "bootstrap_runtime_plugin_remove_submit"
class = "surface-button-secondary"
text = "Remove Runtime Plugin"
type = "submit"

[[text]]
id = "bootstrap_runtime_plugin_remove_help"
domId = "runtime-plugin-remove-help"
class = "surface-note surface-note-callout"
text = ""

[[text]]
id = "bootstrap_runtime_plugin_remove_status"
domId = "runtime-plugin-remove-status"
class = "surface-status"
text = ""

[[frontendProgram]]
id = "bootstrap_runtime_plugin_remove_controls_program"
rootWidget = "bootstrap_runtime_plugin_remove_controls_root"

[[step]]
program = "bootstrap_runtime_plugin_remove_controls_program"
order = 0
op = "setText"
on = "submit:bootstrap_runtime_plugin_remove_form"
widget = "bootstrap_runtime_plugin_remove_status"
text = "Removing..."

[[step]]
program = "bootstrap_runtime_plugin_remove_controls_program"
order = 1
op = "readForm"
on = "submit:bootstrap_runtime_plugin_remove_form"
widget = "bootstrap_runtime_plugin_remove_form"
into = "bootstrapRuntimePluginRemoveDraft"

[[step]]
program = "bootstrap_runtime_plugin_remove_controls_program"
order = 0
op = "setText"
on = "error"
when = { path = "event.event", equals = "submit:bootstrap_runtime_plugin_remove_form" }
widget = "bootstrap_runtime_plugin_remove_status"
text = "${event.message}"

