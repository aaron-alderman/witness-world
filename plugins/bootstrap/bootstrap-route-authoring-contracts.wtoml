[[bootstrapRouteAuthoringPolicy]]
routeKind = "backendProgram"
responseKind = "json"
enabledFields = ["backendProgramSoul"]
fieldSummary = "Enabled fields: backend program soul. Disabled fields: page, root widget, frontend program, live projection."
missingBackendProgramSoulIssue = "choose a backend program soul"

[[bootstrapRouteAuthoringPolicy]]
routeKind = "page"
responseKind = "page"
enabledFields = ["page", "rootWidget", "rootWidgetRef", "frontendProgram", "frontendProgramRef", "routeStateProcess", "routeStateProcessRef", "routeStateState", "routeStateStateRef", "liveProjection"]
fieldSummary = "Enabled fields: page, root widget, frontend program, route state, live projection."

[[bootstrapRouteAuthoringPolicy]]
routeKind = "stream"
responseKind = "stream"
enabledFields = []
fieldSummary = "Uses stream transport only. Page and backend-program fields are disabled."

[[bootstrapRouteAuthoringPolicy]]
routeKind = "json"
responseKind = "json"
enabledFields = []
fieldSummary = "Backend JSON route. Page and backend-program fields are disabled."

[[bootstrapRouteAuthoringPolicy]]
routeKind = "resource"
responseKind = "resource"
enabledFields = []
fieldSummary = "Backend resource route. Page and backend-program fields are disabled."

[[bootstrapRouteAuthoringHandlerRule]]
handler = "page.home"
requiresRootWidget = true
missingRootWidgetIssue = "choose a root widget for this page handler"

[[bootstrapRouteAuthoringHandlerRule]]
handler = "page.world"
requiresRootWidget = true
missingRootWidgetIssue = "choose a root widget for this page handler"
