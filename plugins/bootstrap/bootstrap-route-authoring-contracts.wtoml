[[bootstrapRouteAuthoringPolicy]]
routeKind = "backendProgram"
responseKind = "json"
enabledFields = ["backendProgramSoul"]
fieldSummary = "Enabled fields: backend program soul. Disabled fields: page, root widget, root surface, frontend program, route state, preload, and live projection."
missingBackendProgramSoulIssue = "choose a backend program soul"

[[bootstrapRouteAuthoringPolicy]]
routeKind = "page"
responseKind = "page"
enabledFields = ["page", "rootWidget", "rootWidgetRef", "rootSurface", "rootSurfaceRef", "routeStateProcess", "routeStateProcessRef", "routeStateState", "routeStateStateRef", "liveProjection"]
fieldSummary = "Enabled fields depend on the page handler. Canonical app hosting uses page.surface with root surface and route state. Legacy frontend-program route params are retired."

[[bootstrapRouteAuthoringPolicy]]
routeKind = "stream"
responseKind = "stream"
enabledFields = []
fieldSummary = "Uses stream transport only. Page and backend-program fields are disabled."

[[bootstrapRouteAuthoringPolicy]]
routeKind = "json"
responseKind = "json"
enabledFields = []
fieldSummary = "Backend JSON route. Page and backend-program fields are disabled."

[[bootstrapRouteAuthoringPolicy]]
routeKind = "resource"
responseKind = "resource"
enabledFields = []
fieldSummary = "Backend resource route. Page and backend-program fields are disabled."

[[bootstrapRouteAuthoringHandlerRule]]
handler = "page.surface"
requiresRootSurface = true
disabledFields = ["page", "rootWidget", "rootWidgetRef", "frontendProgram", "frontendProgramRef", "liveProjection"]
missingRootSurfaceIssue = "choose a root surface for this page handler"
