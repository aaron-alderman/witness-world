children = ["bootstrap_governance_stewardship_summary", "bootstrap_stewardship_create_slot", "bootstrap_stewardship_remove_slot"]

[[summary]]
id = "bootstrap_governance_stewardship_summary"
text = "Stewardship"

[[box]]
id = "bootstrap_stewardship_create_slot"
domId = "bootstrap-stewardship-create-slot"

[[box]]
id = "bootstrap_stewardship_remove_slot"
domId = "bootstrap-stewardship-remove-slot"

[[details]]
id = "bootstrap_governance_proposals"
children = ["bootstrap_governance_proposals_summary", "bootstrap_proposal_create_slot", "bootstrap_proposal_review_slot"]

[[summary]]
id = "bootstrap_governance_proposals_summary"
text = "Proposals"

[[box]]
id = "bootstrap_proposal_create_slot"
domId = "bootstrap-proposal-create-slot"

[[box]]
id = "bootstrap_proposal_review_slot"
domId = "bootstrap-proposal-review-slot"

[[box]]
id = "bootstrap_app_surface_card"
class = "surface-card surface-stack"
children = ["bootstrap_app_surface_badge", "bootstrap_app_surface_heading", "bootstrap_app_surface_copy", "bootstrap_widgets_details", "bootstrap_frontend_programs_details", "bootstrap_backend_programs_details", "bootstrap_route_mounts_details", "bootstrap_runtime_wiring_details", "bootstrap_runtime_plugins_details", "bootstrap_mcp_details", "bootstrap_capabilities_details"]

[[text]]
id = "bootstrap_app_surface_badge"
class = "surface-badge"
text = "App Surface"

[[heading]]
id = "bootstrap_app_surface_heading"
level = 2
text = "Focused Builders"

[[text]]
id = "bootstrap_app_surface_copy"
text = "These forms edit app-visible structures. Advanced step conditions and params use JSON when needed, but the main surface stays oriented around the app rather than the substrate."

[[details]]
id = "bootstrap_widgets_details"
open = true
children = ["bootstrap_widgets_summary", "bootstrap_widgets_slot"]

[[summary]]
id = "bootstrap_widgets_summary"
text = "Widgets"

[[box]]
id = "bootstrap_widgets_slot"
domId = "bootstrap-widgets-slot"

