[[defaults]]
actor = "frontendHost"
context = "frontend"

[[page]]
id = "bootstrap_page_main_root"
children = ["bootstrap_left_column", "bootstrap_right_column"]

[[box]]
id = "bootstrap_left_column"
class = "presentation-column column"
children = ["bootstrap_top_cards_slot", "bootstrap_governance_card", "bootstrap_app_surface_card", "bootstrap_starter_controls_slot"]

[[box]]
id = "bootstrap_top_cards_slot"
domId = "bootstrap-top-cards-slot"

[[box]]
id = "bootstrap_governance_card"
class = "surface-card surface-stack"
children = ["bootstrap_governance_badge", "bootstrap_governance_heading", "bootstrap_governance_copy", "bootstrap_governance_contexts", "bootstrap_governance_scope", "bootstrap_governance_stewardship", "bootstrap_governance_proposals"]

[[text]]
id = "bootstrap_governance_badge"
class = "surface-badge"
text = "Governance"

[[heading]]
id = "bootstrap_governance_heading"
level = 2
text = "Contexts, Stewardship, And Proposals"

[[text]]
id = "bootstrap_governance_copy"
text = "This slice makes authority explicit. Scoped objects can be authored under a context, stewardship can be delegated, and guarded writes can be proposed for later approval."

[[details]]
id = "bootstrap_governance_contexts"
open = true
children = ["bootstrap_governance_contexts_summary", "bootstrap_governance_contexts_slot"]

[[summary]]
id = "bootstrap_governance_contexts_summary"
text = "Contexts"

[[box]]
id = "bootstrap_governance_contexts_slot"
domId = "bootstrap-governance-contexts-slot"

[[details]]
id = "bootstrap_governance_scope"
children = ["bootstrap_governance_scope_summary", "bootstrap_context_binding_create_slot", "bootstrap_context_binding_remove_slot", "bootstrap_context_export_create_slot", "bootstrap_context_export_remove_slot", "bootstrap_context_import_create_slot", "bootstrap_context_import_remove_slot"]

[[summary]]
id = "bootstrap_governance_scope_summary"
text = "Naming And Scope"

[[box]]
id = "bootstrap_context_binding_create_slot"
domId = "bootstrap-context-binding-create-slot"

[[box]]
id = "bootstrap_context_binding_remove_slot"
domId = "bootstrap-context-binding-remove-slot"

[[box]]
id = "bootstrap_context_export_create_slot"
domId = "bootstrap-context-export-create-slot"

[[box]]
id = "bootstrap_context_export_remove_slot"
domId = "bootstrap-context-export-remove-slot"

[[box]]
