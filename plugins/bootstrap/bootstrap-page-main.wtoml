id = "bootstrap_runtime_wiring_summary"
text = "Runtime Wiring"

[[box]]
id = "bootstrap_runtime_wiring_slot"
domId = "bootstrap-runtime-wiring-slot"

[[details]]
id = "bootstrap_runtime_plugins_details"
children = ["bootstrap_runtime_plugins_summary", "bootstrap_runtime_plugins_note", "bootstrap_runtime_plugins_note_muted", "bootstrap_runtime_plugin_review_stack", "bootstrap_runtime_plugin_install_slot", "bootstrap_runtime_plugin_remove_slot", "bootstrap_runtime_plugin_install_proposal_slot", "bootstrap_runtime_plugin_remove_proposal_slot"]

[[summary]]
id = "bootstrap_runtime_plugins_summary"
text = "Runtime Plugins"

[[text]]
id = "bootstrap_runtime_plugins_note"
class = "surface-note surface-note-callout"
text = "Runtime plugin installs are authored on a specific server runner. Local plugin packages stay bundle-bridge only in this slice."

[[text]]
id = "bootstrap_runtime_plugins_note_muted"
class = "surface-note surface-note-callout"
text = "Bootstrap review shows durable authored runner intent only. CLI and environment plugin overlays are excluded here and remain visible in runtime diagnostics/startup reporting."

[[box]]
id = "bootstrap_runtime_plugin_review_stack"
class = "surface-stack"
children = ["bootstrap_runtime_plugin_review_grid", "bootstrap_runtime_plugin_review_note", "bootstrap_runtime_plugin_review_detail"]

[[box]]
id = "bootstrap_runtime_plugin_review_grid"
class = "surface-grid-2"
children = ["bootstrap_runtime_plugin_review_runner_label", "bootstrap_runtime_plugin_review_plugin_label"]

[[label]]
id = "bootstrap_runtime_plugin_review_runner_label"
children = ["bootstrap_runtime_plugin_review_runner_text", "bootstrap_runtime_plugin_review_runner_select"]

[[text]]
id = "bootstrap_runtime_plugin_review_runner_text"
text = "Review Server Runner"

[[select]]
id = "bootstrap_runtime_plugin_review_runner_select"
domId = "runtime-plugin-review-runner"
name = "runtimePluginReviewRunner"

[[label]]
id = "bootstrap_runtime_plugin_review_plugin_label"
children = ["bootstrap_runtime_plugin_review_plugin_text", "bootstrap_runtime_plugin_review_plugin_select"]

[[text]]
id = "bootstrap_runtime_plugin_review_plugin_text"
text = "Review Plugin"

[[select]]
id = "bootstrap_runtime_plugin_review_plugin_select"
domId = "runtime-plugin-review-plugin"
name = "runtimePluginReviewPlugin"

[[text]]
id = "bootstrap_runtime_plugin_review_note"
class = "surface-note surface-note-callout"
domId = "runtime-plugin-review-note"
text = ""

[[box]]
id = "bootstrap_runtime_plugin_review_detail"
domId = "runtime-plugin-review-detail"
class = "surface-state-list"

[[frontendProgram]]
id = "bootstrap_page_main_program"
rootWidget = "bootstrap_page_main_root"

[[box]]
id = "bootstrap_runtime_plugin_install_slot"
domId = "bootstrap-runtime-plugin-install-slot"

[[box]]
id = "bootstrap_runtime_plugin_remove_slot"
domId = "bootstrap-runtime-plugin-remove-slot"

[[box]]
id = "bootstrap_runtime_plugin_install_proposal_slot"
domId = "bootstrap-runtime-plugin-install-proposal-slot"

[[box]]
id = "bootstrap_runtime_plugin_remove_proposal_slot"
domId = "bootstrap-runtime-plugin-remove-proposal-slot"

[[details]]
id = "bootstrap_mcp_details"
children = ["bootstrap_mcp_summary", "bootstrap_mcp_note", "bootstrap_mcp_inventory_grid", "bootstrap_mcp_server_controls_slot", "bootstrap_mcp_tool_install_controls_slot", "bootstrap_mcp_tool_remove_controls_slot", "bootstrap_mcp_server_proposal_slot", "bootstrap_mcp_tool_install_proposal_slot", "bootstrap_mcp_tool_remove_proposal_slot"]

[[summary]]
id = "bootstrap_mcp_summary"
text = "MCP"

[[text]]
id = "bootstrap_mcp_note"
class = "surface-note surface-note-callout"
text = "MCP servers and tool installs stay shell-facing in this slice. Transport visibility is descriptive, delegated mode runs as the caller, service mode requires a configured serviceIdentity, and scope JSON narrows where an installed tool may act."

[[box]]
id = "bootstrap_mcp_inventory_grid"
class = "surface-grid-auto"
children = ["bootstrap_mcp_servers_inventory_box", "bootstrap_mcp_tools_inventory_box"]

[[box]]
