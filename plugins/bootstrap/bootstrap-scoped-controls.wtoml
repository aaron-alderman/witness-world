eventName = "witness:bootstrap-dependent-select-sync"
detail = { source = "bootstrap-scoped-controls", family = "stewardship-target", targetKindSelectId = "stewardship-target-kind", targetSelectId = "stewardship-target" }

[[step]]
program = "bootstrap_stewardship_create_controls_program"
order = 0
op = "setText"
on = "submit:bootstrap_stewardship_create_form"
