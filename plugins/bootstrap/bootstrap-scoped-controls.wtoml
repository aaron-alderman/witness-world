[[defaults]]
actor = "frontendHost"
context = "frontend"

[[box]]
id = "bootstrap_context_binding_create_controls_root"
class = "stack"
children = ["bootstrap_context_binding_create_form", "bootstrap_context_binding_create_status"]

[[form]]
id = "bootstrap_context_binding_create_form"
domId = "context-binding-form"
class = "stack"
children = ["bootstrap_context_binding_create_grid_one", "bootstrap_context_binding_create_grid_two", "bootstrap_context_binding_create_actions"]

[[box]]
id = "bootstrap_context_binding_create_grid_one"
class = "grid two"
children = ["bootstrap_context_binding_create_context_field", "bootstrap_context_binding_create_name_field"]

[[box]]
id = "bootstrap_context_binding_create_context_field"
class = "stack"
children = ["bootstrap_context_binding_create_context_text", "bootstrap_context_binding_create_context_select"]

[[text]]
id = "bootstrap_context_binding_create_context_text"
text = "Context"

[[select]]
id = "bootstrap_context_binding_create_context_select"
domId = "context-binding-context"
name = "context"

[[box]]
id = "bootstrap_context_binding_create_name_field"
class = "stack"
children = ["bootstrap_context_binding_create_name_text", "bootstrap_context_binding_create_name_input"]

[[text]]
id = "bootstrap_context_binding_create_name_text"
text = "Name"

[[input]]
id = "bootstrap_context_binding_create_name_input"
name = "name"
placeholder = "homePage"

[[box]]
id = "bootstrap_context_binding_create_grid_two"
class = "grid two"
children = ["bootstrap_context_binding_create_target_field", "bootstrap_context_binding_create_spacer"]

[[box]]
id = "bootstrap_context_binding_create_target_field"
class = "stack"
children = ["bootstrap_context_binding_create_target_text", "bootstrap_context_binding_create_target_select"]

[[text]]
id = "bootstrap_context_binding_create_target_text"
text = "Target"

[[select]]
id = "bootstrap_context_binding_create_target_select"
domId = "context-binding-target"
name = "target"

[[box]]
id = "bootstrap_context_binding_create_spacer"
class = "stack"

[[box]]
id = "bootstrap_context_binding_create_actions"
class = "actions"
children = ["bootstrap_context_binding_create_submit"]

[[button]]
id = "bootstrap_context_binding_create_submit"
text = "Bind Name"
type = "submit"

[[text]]
id = "bootstrap_context_binding_create_status"
domId = "context-binding-status"
class = "status"
text = ""

[[frontendProgram]]
id = "bootstrap_context_binding_create_controls_program"
rootWidget = "bootstrap_context_binding_create_controls_root"

[[step]]
program = "bootstrap_context_binding_create_controls_program"
order = 0
op = "dispatchDomEvent"
on = "change:bootstrap_context_binding_create_context_select"
eventName = "witness:bootstrap-dependent-select-sync"
detail = { source = "bootstrap-scoped-controls", family = "context-binding-target", contextSelectId = "context-binding-context", targetSelectId = "context-binding-target" }

[[step]]
program = "bootstrap_context_binding_create_controls_program"
order = 0
op = "setText"
on = "submit:bootstrap_context_binding_create_form"
widget = "bootstrap_context_binding_create_status"
text = "Saving..."

[[step]]
program = "bootstrap_context_binding_create_controls_program"
order = 1
op = "readForm"
on = "submit:bootstrap_context_binding_create_form"
widget = "bootstrap_context_binding_create_form"
into = "bootstrapContextBindingCreateDraft"

[[step]]
program = "bootstrap_context_binding_create_controls_program"
order = 2
op = "postJson"
on = "submit:bootstrap_context_binding_create_form"
url = "/api/context-bindings"
from = "bootstrapContextBindingCreateDraft"
into = "bootstrapContextBindingCreateResult"

[[step]]
program = "bootstrap_context_binding_create_controls_program"
order = 3
op = "setText"
on = "submit:bootstrap_context_binding_create_form"
widget = "bootstrap_context_binding_create_status"
text = "Saved."

[[step]]
program = "bootstrap_context_binding_create_controls_program"
order = 4
op = "clearForm"
on = "submit:bootstrap_context_binding_create_form"
widget = "bootstrap_context_binding_create_form"

[[step]]
program = "bootstrap_context_binding_create_controls_program"
order = 5
op = "dispatchDomEvent"
on = "submit:bootstrap_context_binding_create_form"
eventName = "witness:host-refresh"
detail = { source = "bootstrap-scoped-controls", reason = "context-binding-create" }

[[step]]
program = "bootstrap_context_binding_create_controls_program"
order = 0
op = "setText"
on = "error"
when = { path = "event.event", equals = "submit:bootstrap_context_binding_create_form" }
widget = "bootstrap_context_binding_create_status"
text = "${event.message}"

