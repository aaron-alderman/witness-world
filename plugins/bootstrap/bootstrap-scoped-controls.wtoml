[[frontendProgram]]
id = "bootstrap_context_export_create_controls_program"
rootWidget = "bootstrap_context_export_create_controls_root"

[[step]]
program = "bootstrap_context_export_create_controls_program"
order = 0
op = "dispatchDomEvent"
on = "change:bootstrap_context_export_create_context_select"
eventName = "witness:bootstrap-dependent-select-sync"
detail = { source = "bootstrap-scoped-controls", family = "context-export-target", contextSelectId = "context-export-context", targetSelectId = "context-export-target" }

[[step]]
program = "bootstrap_context_export_create_controls_program"
order = 0
op = "setText"
on = "submit:bootstrap_context_export_create_form"
widget = "bootstrap_context_export_create_status"
text = "Saving..."

[[step]]
program = "bootstrap_context_export_create_controls_program"
order = 1
op = "readForm"
on = "submit:bootstrap_context_export_create_form"
widget = "bootstrap_context_export_create_form"
into = "bootstrapContextExportCreateDraft"

[[step]]
program = "bootstrap_context_export_create_controls_program"
order = 2
op = "dispatchDomEvent"
on = "submit:bootstrap_context_export_create_form"
eventName = "witness:bootstrap-scoped-submit"
detail = { source = "bootstrap-scoped-controls", family = "context-export-create", formId = "context-export-form", statusId = "context-export-status", context = "${state.bootstrapContextExportCreateDraft.context}", name = "${state.bootstrapContextExportCreateDraft.name}", target = "${state.bootstrapContextExportCreateDraft.target}" }

[[step]]
program = "bootstrap_context_export_create_controls_program"
order = 0
op = "setText"
on = "error"
when = { path = "event.event", equals = "submit:bootstrap_context_export_create_form" }
widget = "bootstrap_context_export_create_status"
text = "${event.message}"

