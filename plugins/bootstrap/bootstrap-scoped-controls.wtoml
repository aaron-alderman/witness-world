[[step]]
program = "bootstrap_context_export_create_controls_program"
order = 4
op = "clearForm"
on = "submit:bootstrap_context_export_create_form"
widget = "bootstrap_context_export_create_form"

[[step]]
program = "bootstrap_context_export_create_controls_program"
order = 5
op = "dispatchDomEvent"
on = "submit:bootstrap_context_export_create_form"
eventName = "witness:host-refresh"
detail = { source = "bootstrap-scoped-controls", reason = "context-export-create" }

[[step]]
program = "bootstrap_context_export_create_controls_program"
order = 0
