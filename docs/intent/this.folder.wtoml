# this.folder.wtoml
#
# Folder-level metadata for docs/intent/
# 
# Philosophy:
# - Explicit, authored knowledge about the folder's structure and meaning.
# - Tolerates staleness (meta can lag the filesystem).
# - Append-only friendly: new relations, observations, or human notes can be added.
# - Continuity: when a child disappears, the relation becomes a "stale contains" that
#   ContextHub / reapers / tests can surface as alignment debt rather than breaking.
# - Multi-source: hand edits + automation + server touches + tests can all contribute.
#
# Lowering:
# This file is WTOML. It produces entity + relation forms that flow into
# the platform model, DESIRE, witnesses, ContextHub, and MCP surfaces.
#
# Id conventions (align with platform-model and knowledge-relations):
#   folder:docs/intent
#   doc:docs/intent/...
#   wtoml:docs/intent/...
#   intent:...
#   code:src/...

[folder]
id = "folder:docs/intent"
path = "docs/intent"
label = "Platform Intent Registry"
summary = "Canonical tree of the platform's core desires/intents, their documentation, and links to realizing code."
facet = ["system", "rationale", "product", "developer"]
lifecycle = ["author", "steward"]
owner = "plugin.platform"
lastHumanEdit = "2026-06-19"   # human can bump or leave; automation fills scannedAt

# --- Structural containment (auto-generatable base) ---
# These are the direct children we know about at authoring time.
# A generator script can refresh this section.
# "contains" relations are the primary structural truth here.

[[relation]]
from = "folder:docs/intent"
rel = "contains"
to = "doc:docs/intent/PRIMARY-INTENT.md"

[[relation]]
from = "folder:docs/intent"
rel = "contains"
to = "doc:docs/intent/01-foundational-philosophy-ontology.md"

