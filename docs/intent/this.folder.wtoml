# --- Observations / server touches (append-only zone) ---
# The running system (or a background scanner) can append facts here
# without disturbing human/automation content above.
# Example of what a reaper or server might add on load:

# [[relation]]
# from = "folder:docs/intent"
# rel = "lastScanned"
# to = "observation:2026-06-19T12:00:00Z"
# meta = { childrenFound = 17, missing = [], added = [] }

# --- Notes on lifecycle (human guidance) ---
#
# - Auto-generation target: the "contains" block + basic folder entity.
#   A script can rewrite only that section and preserve everything else.
#
# - Hand-maintained sections: the "models", "detailedBy", "references",
#   and any custom facets/descriptions. These are the valuable, slower-changing part.
#
# - Staleness handling: if a contained doc disappears, the "contains" relation
#   stays until a reaper or ContextHub marks it as alignmentDebt.
#   The relation itself is the witness of what used to be claimed.
#
# - Append-only meta: prefer adding new [[relation]] blocks with new
#   observations rather than mutating old ones.
#
# - Reaping: a future reaper process can find this.folder.wtoml files whose
#   path no longer exists, or whose contains targets are long-unreferenced,
#   and either archive them or emit a cleanup proposal.
#
# - Server interaction: the main platform server (or platform plugin) can
#   read these files at startup / on change and merge the entities/relations
#   into the live model, just like it does for knowledge-relations.wtoml today.
#
# - Tests: tests can assert presence of certain high-value relations
#   (e.g. "the intent folder must model the primary intent and reference
#    the knowledge-relations file").
#
# This file is intentionally tolerant of divergence because the platform's
# core truth (witness log + actual files + intent entities) is what matters.
# The meta is a helpful, repairable projection.

