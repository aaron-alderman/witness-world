# Platform Knowledge Relations (doc ↔ doc, doc ↔ code)
#
# This is an authored WTOML expression of the relationships between
# documentation nodes and between documentation and code.
#
# Goal: make ContextHub / intent registry relationships first-class
# in the witnessed model rather than only markdown links or JS inference.
#
# These lower via DESIRE (entity + relation forms) and can be projected
# into ContextHub surfaces, platform model, and LLM context packs.
#
# Id conventions align with platform-model.js where possible:
#   doc:docs/...md
#   code:src/... or code:plugins/...
#
# Key typed relations (from CONTEXTHUB-SPEC + common usage):
#   references, expands, explains, implements, isRealizedBy,
#   governs, affects, derivedFrom, nearbyTo

[context.platform-knowledge]
actor = "system"
owner = "plugin.platform"
capabilities = ["world.read", "entity.write"]

# -------------------------------------------------------------------
# Primary Intent Root Document
# -------------------------------------------------------------------

[[entity]]
id = "doc:docs/intent/PRIMARY-INTENT.md"
kind = "docNode"
label = "Primary Intent (Root)"
path = "docs/intent/PRIMARY-INTENT.md"
facet = ["system", "rationale", "product"]
lifecycle = ["author", "steward"]
owner = "plugin.platform"
description = "Executive summary and root node of the platform intent tree."

[[relation]]
actor = "system"
from = "doc:docs/intent/PRIMARY-INTENT.md"
rel = "references"
to = "doc:docs/SYSTEM.md"

[[relation]]
actor = "system"
from = "doc:docs/intent/PRIMARY-INTENT.md"
rel = "references"
to = "doc:docs/CAPABILITIES.md"

[[relation]]
actor = "system"
from = "doc:docs/intent/PRIMARY-INTENT.md"
rel = "references"
to = "doc:docs/EXPERIENCE.md"

